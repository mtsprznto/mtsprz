---
import "../styles/global.css";
import "../styles/fonts.css";
import CotizarModal from "../components/CotizarModal.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import CookieBanner from "../components/CookieBanner.astro";
import CookiePreferences from "../components/CookiePreferences.astro";
import { author } from "../data/author";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  article?: {
    title?: string;
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
    hasSpeakable?: boolean;
  };
  breadcrumbs?: { name: string; path: string }[];
  noindex?: boolean;
  video?: {
    url: string;
    name: string;
    description: string;
    thumbnailUrl?: string;
    uploadDate?: string;
    duration?: string;
  };
}

const {
  title,
  description,
  canonical,
  image,
  article,
  breadcrumbs,
  noindex,
  video,
} = Astro.props;
const site = "https://mtsprz.org";
const brand = "Mtsprz";
const defaultTitle = `${brand} | Soluciones Digitales`;
const fullTitle = title ? `${title} | ${brand}` : defaultTitle;
const ogImage = image
  ? (image.startsWith("/") ? `${site}${image}` : image)
  : `${site}/logo.jpg`;
const currentUrl = canonical || site;
const defaultBreadcrumbs: { name: string; path: string }[] = [];
if (canonical && canonical !== site) {
  const path = new URL(canonical).pathname;
  const segments = path.replace(/\/$/, "").split("/").filter(Boolean);
  let acc = "";
  for (const seg of segments) {
    acc += `/${seg}`;
    defaultBreadcrumbs.push({
      name: seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
      path: acc,
    });
  }
}
const resolvedBreadcrumbs = breadcrumbs && breadcrumbs.length > 0 ? breadcrumbs : defaultBreadcrumbs.length > 0 ? defaultBreadcrumbs : undefined;
const personSameAs = [
  "https://www.linkedin.com/company/mtsprz",
  "https://github.com/mtsprz",
  "https://www.google.com/maps/place/Mtsprz/@-41.3130329,-72.9944674,17z",
];
---

<!doctype html>
<html lang="es-CL" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl} />
    <link rel="alternate" hreflang="es-CL" href={currentUrl} />
    <link rel="alternate" hreflang="x-default" href={currentUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />

    <link rel="preconnect" href="https://d8j0ntlcm91z4.cloudfront.net" />
    <!-- Preload critical self-hosted fonts (LCP/CLS optimization) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/poppins-700-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/poppins-800-latin.woff2" crossorigin />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={brand} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#010101" />
    <meta name="author" content={`${author.name}, ${author.company}`} />
    <meta name="geo.region" content="CL-LL" />
    <meta name="geo.placename" content="Puerto Varas" />
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${site}/#person`,
          name: author.name,
          url: `${site}/nosotros`,
          image: `${site}${author.image}`,
          description: author.bio,
          jobTitle: author.role,
          sameAs: author.sameAs,
          knowsAbout: "Desarrollo web con Astro, SEO local, automatización de procesos, diseño gráfico, marketing digital, transformación digital para pymes, Google Business Profile, optimización para motores de búsqueda, integraciones CRM",
          worksFor: { "@id": `${site}/#organization` },
        },
        {
          "@type": "ProfessionalService",
          "@id": `${site}/#localbusiness`,
          name: "Mtsprz — Soluciones Digitales",
          image: `${site}/logo.jpg`,
          url: site,
          telephone: "+56966929818",
          email: "contacto@mtsprz.org",
          address: {
            "@type": "PostalAddress",
            streetAddress: "Puerto Varas",
            addressLocality: "Puerto Varas",
            addressRegion: "Los Lagos",
            addressCountry: "CL",
          },
          geo: {
            "@type": "GeoCoordinates",
            latitude: -41.3130329,
            longitude: -72.9944674,
          },
          openingHoursSpecification: {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "09:00",
            closes: "18:00",
          },
          priceRange: "$$",
          areaServed: [
            { "@type": "City", "name": "Puerto Varas" },
            { "@type": "City", "name": "Osorno" },
            { "@type": "City", "name": "Valdivia" },
            { "@type": "City", "name": "Puerto Montt" },
            { "@type": "AdministrativeArea", "name": "Región de Los Lagos" },
          ],
          sameAs: personSameAs,
        },
        {
          "@type": "Organization",
          "@id": `${site}/#organization`,
          name: "Mtsprz",
          url: site,
          logo: {
            "@type": "ImageObject",
            url: `${site}/logo.jpg`,
          },
          image: `${site}/logo.jpg`,
          description: "Soluciones Digitales en la Región de Los Lagos",
          foundingDate: "2024",
          priceRange: "$$",
          areaServed: [
            { "@type": "City", "name": "Puerto Varas" },
            { "@type": "City", "name": "Osorno" },
            { "@type": "City", "name": "Valdivia" },
            { "@type": "City", "name": "Puerto Montt" },
            { "@type": "AdministrativeArea", "name": "Región de Los Lagos" },
          ],
          address: {
            "@type": "PostalAddress",
            streetAddress: "Puerto Varas",
            addressLocality: "Puerto Varas",
            addressRegion: "Los Lagos",
            addressCountry: "CL",
          },
          geo: {
            "@type": "GeoCoordinates",
            latitude: -41.3130329,
            longitude: -72.9944674,
          },
          contactPoint: {
            "@type": "ContactPoint",
            contactType: "customer service",
            telephone: "+56966929818",
            email: "contacto@mtsprz.org",
            availableLanguage: ["Spanish"],
            areaServed: "CL-LL",
          },
          sameAs: personSameAs,
        },
        {
          "@type": "WebSite",
          "@id": `${site}/#website`,
          url: site,
          name: defaultTitle,
          description: "Soluciones digitales para pymes en la Región de Los Lagos",
          publisher: { "@id": `${site}/#organization` },
          potentialAction: {
            "@type": "SearchAction",
            target: {
              "@type": "EntryPoint",
              urlTemplate: `${site}/buscar?q={search_term_string}`,
            },
            "query-input": "required name=search_term_string",
          },
        },
        ...(video
          ? [
              {
                "@type": "VideoObject",
                "@id": `${currentUrl}#video`,
                name: video.name,
                description: video.description,
                thumbnailUrl: video.thumbnailUrl || `${site}/logo.jpg`,
                contentUrl: video.url,
                embedUrl: video.url,
                uploadDate: video.uploadDate || "2026-06-19",
                duration: video.duration || "PT30S",
              },
            ]
          : []),
        ...(article
          ? [
              {
                "@type": "Article",
                "@id": `${currentUrl}#article`,
                headline: article.title || title,
                description: description,
                image: ogImage,
                datePublished: article.publishedTime,
                ...(article.modifiedTime ? { dateModified: article.modifiedTime } : {}),
                author: { "@id": `${site}/#person` },
                publisher: {
                  "@type": "Organization",
                  "@id": `${site}/#organization`,
                },
                ...(article.tags && article.tags.length > 0
                  ? { keywords: article.tags.join(", ") }
                  : {}),
                mainEntityOfPage: {
                  "@type": "WebPage",
                  "@id": currentUrl,
                },
                ...(article.hasSpeakable
                  ? {
                      speakable: {
                        "@type": "SpeakableSpecification",
                        cssSelector: [".geo-answer"],
                      },
                    }
                  : {}),
              },
            ]
          : []),
        ...(resolvedBreadcrumbs
          ? [
              {
                "@type": "BreadcrumbList",
                "@id": `${currentUrl}#breadcrumb`,
                itemListElement: [
                  {
                    "@type": "ListItem",
                    position: 1,
                    name: "Inicio",
                    item: site,
                  },
                  ...resolvedBreadcrumbs.map((cr, i) => ({
                    "@type": "ListItem",
                    position: i + 2,
                    name: cr.name,
                    item: `${site}${cr.path}`,
                  })),
                ],
              },
            ]
          : []),
        {
          "@type": "WebPage",
          "@id": currentUrl,
          url: currentUrl,
          name: fullTitle,
          description: description,
          isPartOf: { "@id": `${site}/#website` },
          about: { "@id": `${site}/#organization` },
          lastReviewed: new Date().toISOString().split("T")[0],
          ...(article ? { datePublished: article.publishedTime, dateModified: article.modifiedTime } : {}),
        },
      ],
    })} />
  </head>
  <body class="min-h-screen bg-[#010101] text-text-primary antialiased">
    <a href="#main-content" class="skip-to-content">Saltar al contenido principal</a>
    <slot />
    <CotizarModal />
    <WhatsAppButton />
    <CookieBanner />
    <CookiePreferences />

    <!-- Cookie Consent Manager (must load before banner/preferences) -->
    <script>
      import "../lib/cookie-consent.ts";
      import "../lib/analytics.ts";
    </script>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        { threshold: 0.01, rootMargin: "0px 0px -20px 0px" }
      );

      document.querySelectorAll(".reveal, .reveal-group").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
