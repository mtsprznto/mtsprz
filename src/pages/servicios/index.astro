---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/ui/PageHero.astro";
import WebcoreWindow from "../../components/ui/WebcoreWindow.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import BlurText from "../../components/BlurText.astro";
import Footer from "../../components/Footer.astro";
import { query, initDb } from "../../lib/db";
import { toServiceDisplay } from "../../lib/service-display";

await initDb();
const dbRows = await query(
  `SELECT DISTINCT ON (LOWER(TRIM(category))) slug, name, description, category
   FROM services WHERE is_active = true AND category IS NOT NULL
   ORDER BY LOWER(TRIM(category)), is_popular DESC, id`
);
const services = dbRows.rows.map((row: any) => toServiceDisplay(row as any));

// Video hero · misma pieza cinematográfica del home (§5.4)
const heroVideo = "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4";

// Temporal realness · año SSR para el strip del hero
const anio = new Date().getFullYear();

---

<BaseLayout
  title="Servicios Digitales · Web, SEO y Automatización"
  description="Transformamos procesos manuales en software automatizado. Desarrollo web, automatización de procesos, dashboards de datos, bots WhatsApp, SEO local y más. Soluciones digitales para pymes en la Región de Los Lagos."
  image="/og/servicios.png"
  canonical="https://mtsprz.org/servicios"
  breadcrumbs={[{ name: "Servicios", path: "/servicios" }]}
  video={{
    url: heroVideo,
    name: "Mtsprz Servicios Digitales",
    description: "Soluciones digitales profesionales: desarrollo web, automatizaci\u00f3n de procesos, dashboards de datos, SEO local, marketing digital, diseño gr\u00e1fico y consultor\u00eda para pymes en la Regi\u00f3n de Los Lagos.",
    thumbnailUrl: "https://mtsprz.org/logo.jpg",
    uploadDate: "2026-06-19T19:13:46Z",
  }}
>
  <link rel="preload" as="video" href={heroVideo} fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Cuánto cuesta una página web profesional?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Landing pages desde $290.000, sitios corporativos (5-10 páginas) desde $690.000, tiendas online desde $1.500.000. Todos incluyen hosting, SSL, SEO básico y Analytics. Cotización personalizada sin compromiso."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué procesos puedo automatizar en mi pyme?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Automatizamos Excel (reportes que se generan solos), WhatsApp (bots 24/7 que atienden clientes), email marketing (secuencias que nutren y venden), integración CRM (datos que fluyen solos) y workflows completos. Una corredora típica ahorra 10+ horas semanales."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué es un dashboard de datos y para qué sirve?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Un dashboard muestra tus indicadores clave en tiempo real: ventas, clientes, inventario. Conectamos tus datos (Excel, base de datos, APIs) y creamos visualizaciones interactivas accesibles desde cualquier dispositivo. Decisiones basadas en datos."
        }
      },
      {
        "@type": "Question",
        "name": "¿En qué se diferencia Astro de WordPress?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Los sitios con Astro cargan en menos de 1.5 segundos vs 3-6 segundos de WordPress, obtienen puntaje superior a 95 en PageSpeed Insights, son más seguros al no depender de plugins, y tienen mejor SEO desde el día uno."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto cuesta el SEO local en Puerto Varas y Osorno?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El servicio empieza desde $190.000 para optimización Google Business Profile + SEO básico. El plan completo con gestión mensual y reportes va desde $290.000/mes."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto cuesta un bot de WhatsApp?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Desde $590.000 pago único para un bot con respuestas automáticas, menú interactivo y atención 24/7 con IA. Incluye hosting y soporte; mantenimiento mensual opcional $69.000/mes. Planes con integración CRM y dashboard desde $690.000."
        }
      }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ItemList",
        "itemListElement": [
          {
            "@type": "Service",
            "name": "Desarrollo Web",
            "description": "Landing pages, sitios corporativos, e-commerce y aplicaciones web a medida.",
            "provider": { "@id": "https://mtsprz.org/#organization" },
            "areaServed": "CL-LL",
            "audience": { "@type": "Audience", "audienceType": "pymes" }
          },
          {
            "@type": "Service",
            "name": "Automatizacion de Procesos",
            "description": "Bots WhatsApp, automatizacion Excel, flujos de email, CRM y workflows.",
            "provider": { "@id": "https://mtsprz.org/#organization" },
            "areaServed": "CL-LL",
            "audience": { "@type": "Audience", "audienceType": "pymes" }
          },
          {
            "@type": "Service",
            "name": "Datos e Inteligencia",
            "description": "Dashboards interactivos, scraping web, APIs a medida y procesamiento de documentos.",
            "provider": { "@id": "https://mtsprz.org/#organization" },
            "areaServed": "CL-LL",
            "audience": { "@type": "Audience", "audienceType": "pymes" }
          },
          {
            "@type": "Service",
            "name": "SEO Local",
            "description": "Posicionamiento en Google Maps y busquedas locales para la Region de Los Lagos.",
            "provider": { "@id": "https://mtsprz.org/#organization" },
            "areaServed": "CL-LL",
            "audience": { "@type": "Audience", "audienceType": "pymes" }
          },
          {
            "@type": "Service",
            "name": "Marketing Digital",
            "description": "Google Ads, redes sociales y estrategia de contenido con resultados medibles.",
            "provider": { "@id": "https://mtsprz.org/#organization" },
            "areaServed": "CL-LL",
            "audience": { "@type": "Audience", "audienceType": "pymes" }
          },
          {
            "@type": "Service",
            "name": "Diseno Grafico",
            "description": "Identidad corporativa, logotipos, manual de marca y papelería profesional.",
            "provider": { "@id": "https://mtsprz.org/#organization" },
            "areaServed": "CL-LL",
            "audience": { "@type": "Audience", "audienceType": "pymes" }
          },
          {
            "@type": "Service",
            "name": "Consultoria Digital",
            "description": "Diagnostico gratuito y hoja de ruta digital para pymes en el sur de Chile.",
            "provider": { "@id": "https://mtsprz.org/#organization" },
            "areaServed": "CL-LL",
            "audience": { "@type": "Audience", "audienceType": "pymes" }
          }
        ]
      }
    ]
  })} />
  <Header />

  <main id="main-content">
    <!-- Hero · primitiva reutilizable ui/PageHero (mismo patrón que el hero del home) -->
    <PageHero
      ledLabel={`${services.length} servicios activos`}
      eyebrow="// servicios · catálogo"
      title="Servicios digitales"
      titleAccent="Web, SEO y automatización."
      subtitle="Todo lo que tu negocio necesita para crecer en el entorno digital."
      note="Soluciones digitales diseñadas para pymes y empresas del sur de Chile."
      videoUrl={heroVideo}
      breadcrumbs={[{ name: "Servicios", path: "/servicios" }]}
      meta={`© ${anio} mtsprz · puerto varas`}
    >
      <Fragment slot="actions">
        <button
          type="button"
          onclick="window.openCotizarModal && window.openCotizarModal()"
          class="inline-flex items-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover sm:text-sm"
          >[ Cotizar Proyecto ]</button
        >
        <a
          href="#servicios"
          class="inline-flex items-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-wider text-text-primary transition-colors hover:border-accent hover:text-accent sm:text-sm"
          >[ Ver Catálogo ]</a
        >
      </Fragment>

      <Fragment slot="aside">
        <WebcoreWindow title="catálogo --list" variant="sunken">
          <ul class="divide-y divide-frame">
            {services.map((s, i) => (
              <li class="flex items-center gap-3 px-4 py-3">
                <span class="font-mono text-[11px] text-text-tertiary">
                  [{String(i + 1).padStart(2, "0")}]
                </span>
                <span class="truncate font-body text-sm text-text-primary">{s.title}</span>
                <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">
                  {s.slug}
                </span>
              </li>
            ))}
          </ul>
          <div class="flex items-center justify-between border-t border-frame px-4 py-2.5 font-mono text-[11px]">
            <span class="text-text-tertiary">{String(services.length).padStart(2, "0")} items</span>
            <a href="#servicios" class="text-text-secondary transition-colors hover:text-accent">
              catálogo completo ↓
            </a>
          </div>
        </WebcoreWindow>
      </Fragment>
    </PageHero>

    <!-- Servicios · catálogo v2: grid de WebcoreWindow (ServiceCard) · mismo criterio que el home -->
    <section id="servicios" class="relative w-full scroll-mt-16 bg-bg">
      <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
        <div class="reveal-group mb-12 md:mb-16">
          <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
            // nuestros servicios
          </p>
          <BlurText
            text="Todo lo que tu negocio necesita"
            as="h2"
            className="mt-4 max-w-3xl font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl"
            wordMs={60}
          />
          <p class="reveal-item mt-4 max-w-2xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base">
            Soluciones digitales diseñadas para pymes y empresas del sur de Chile
          </p>
        </div>

        <div class="reveal-group grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {services.map((s, i) => (
            <div class="reveal-item h-full">
              <ServiceCard
                icon={s.icon}
                title={s.title}
                description={s.description}
                tags={s.tags}
                number={i + 1}
                accent={s.accent}
                id={`servicio-${s.slug}`}
                href={s.landingUrl}
                stack={s.stack}
                ctaText={s.landingUrl ? "Explorar servicio" : "Cotizar"}
                ctaHref={s.landingUrl ?? "/cotizar"}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ · v2: header mono + accordion editorial full-width (mismo criterio que grilla/home) -->
    <section id="faq" class="relative w-full scroll-mt-16 bg-bg">
      <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
        <div class="reveal-group mb-12 md:mb-16">
          <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
            // preguntas frecuentes
          </p>
          <BlurText
            text="Resolvemos tus dudas"
            as="h2"
            className="mt-4 max-w-3xl font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl"
            wordMs={60}
          />
          <p class="reveal-item mt-4 max-w-2xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base">
            Lo que más nos preguntan antes de cotizar.
          </p>
        </div>

        <div class="reveal-group border-t border-frame/60">
          {[
            { q: "¿Cuánto cuesta una página web profesional?", a: "Landing pages desde $290.000, sitios corporativos (5-10 páginas) desde $690.000, tiendas online desde $1.500.000. Todos incluyen hosting, SSL, SEO básico y Analytics. Cotización personalizada sin compromiso." },
            { q: "¿Qué procesos puedo automatizar en mi pyme?", a: "Automatizamos Excel (reportes que se generan solos), WhatsApp (bots 24/7 que atienden clientes), email marketing (secuencias que nutren y venden), integración CRM (datos que fluyen solos) y workflows completos. Una corredora típica ahorra 10+ horas semanales." },
            { q: "¿Qué es un dashboard de datos y para qué sirve?", a: "Un dashboard muestra tus indicadores clave en tiempo real: ventas, clientes, inventario. Conectamos tus datos (Excel, base de datos, APIs) y creamos visualizaciones interactivas accesibles desde cualquier dispositivo. Decisiones basadas en datos." },
            { q: "¿En qué se diferencia Astro de WordPress?", a: "Los sitios con Astro cargan en menos de 1.5 segundos vs 3-6 segundos de WordPress, obtienen puntaje superior a 95 en PageSpeed Insights, son más seguros al no depender de plugins, y tienen mejor SEO desde el día uno." },
          ].map((faq, i) => (
            <details class="reveal-item group border-b border-frame/60">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-text-primary transition-colors hover:text-accent focus-visible:outline-none focus-visible:text-accent md:py-6 [&::-webkit-details-marker]:hidden">
                <span class="flex items-baseline gap-3 md:gap-4">
                  <span class="shrink-0 font-mono text-[11px] leading-none text-text-tertiary" aria-hidden="true">
                    [0{i + 1}]
                  </span>
                  <span class="font-heading text-base font-semibold leading-snug tracking-[-0.01em] md:text-lg">{faq.q}</span>
                </span>
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-[4px] border border-frame text-text-tertiary transition-colors duration-300 group-open:border-accent/60 group-open:text-accent"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="transition-transform duration-300 group-open:rotate-45"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                </span>
              </summary>
              <div class="pb-6 md:pb-7">
                <p class="max-w-3xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>

        <!-- CTA inferior · full width, alineado a la izquierda -->
        <div class="reveal-group">
          <div class="reveal-item mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between md:mt-10">
            <p class="font-body text-sm text-text-secondary">¿Tienes más preguntas?</p>
            <a
              href="/contacto"
              class="inline-flex w-fit items-center gap-2 rounded-[6px] border border-frame bg-surface px-5 py-3 font-mono text-xs font-bold uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
            >
              Hablemos
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA · v2: ventana de contacto canónica (mismo criterio que home §13[8]) -->
    <section id="contacto" class="relative w-full scroll-mt-16 bg-bg py-20 md:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="webcore-window">
          <!-- Title bar -->
          <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
            <span
              class="h-2 w-2 shrink-0 rounded-full bg-accent"
              style="box-shadow:0 0 8px var(--color-accent);"
              aria-hidden="true"></span>
            <span
              class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary"
              >contact — iniciar conversación</span
            >
          </div>

          <!-- Body -->
          <div class="reveal-group px-6 py-12 text-center sm:px-8 md:py-16">
            <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
              // hablemos
            </p>

            <h2
              class="reveal-item mx-auto mt-5 max-w-2xl font-heading text-3xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl"
            >
              ¿Listo para impulsar tu negocio?
            </h2>

            <p
              class="reveal-item mx-auto mt-5 max-w-xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base"
            >
              Conversemos sin compromiso. Te ayudamos a definir la mejor estrategia
              digital para tu empresa en el sur de Chile.
            </p>

            <div
              class="reveal-item mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row"
            >
              <button
                type="button"
                onclick="window.openCotizarModal && window.openCotizarModal()"
                class="inline-flex w-full items-center justify-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:w-auto"
              >
                [ Cotizar proyecto ]
              </button>
              <a
                href="/contacto"
                class="inline-flex w-full items-center justify-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:w-auto"
              >
                [ Contáctanos ]
              </a>
            </div>

            <p class="reveal-item mt-6 font-mono text-xs text-text-tertiary">
              o llama al <span class="text-text-secondary">+56 9 6692 9818</span>
            </p>

            <div
              class="reveal-item mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 border-t border-frame pt-8"
            >
              {
                ["Sin compromiso", "Respuesta en 24 hrs", "Atención personalizada"].map(
                  (t) => (
                    <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
                      <svg
                        class="h-3.5 w-3.5 text-accent"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      {t}
                    </span>
                  )
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
