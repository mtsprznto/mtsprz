---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/ui/PageHero.astro";
import WebcoreWindow from "../components/ui/WebcoreWindow.astro";
import BlurText from "../components/BlurText.astro";
import Footer from "../components/Footer.astro";
import projects from "../data/projects.json";

// Video hero · misma pieza cinematográfica del home (§5.4)
const heroVideo = "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4";

// Strip del hero · año de build (página prerender)
const anio = new Date().getFullYear();

// Datos derivados · una sola derivación para el aside y los spreads
// head/sub parten el título por "·" · host real · número editorial
const items = projects.map((p, idx) => {
  const [head, ...rest] = p.title.split(" · ");
  let host = p.url ?? "";
  try {
    host = new URL(p.url).host;
  } catch {
    /* host queda como url cruda */
  }
  return {
    ...p,
    head,
    sub: rest.join(" · "),
    host,
    num: String(idx + 1).padStart(2, "0"),
  };
});
---

<BaseLayout
  title="Portafolio de Desarrollo Web"
  description="Proyectos de desarrollo web y aplicaciones realizados por Mtsprz en la Región de Los Lagos. Sitios web modernos con Astro, React y Next.js para pymes en Chile."
  canonical="https://mtsprz.org/portafolio"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": "https://mtsprz.org/portafolio#collectionpage",
    url: "https://mtsprz.org/portafolio",
    name: "Portafolio · Mtsprz Soluciones Digitales",
    description: "Proyectos de desarrollo web y aplicaciones realizados por Mtsprz en la Región de Los Lagos.",
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: projects.length,
      itemListElement: projects.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: p.title,
        url: p.url,
        description: p.description
      }))
    }
  })} />
  <Header />
  <link rel="preload" as="video" href="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4" fetchpriority="high" />
  <main id="main-content">
    <!-- Hero · primitiva reutilizable ui/PageHero (mismo patrón que home y /servicios) -->
    <PageHero
      ledLabel={`${projects.length} proyectos en producción`}
      eyebrow="// portafolio · en producción"
      title="Portafolio"
      titleAccent="Web y aplicaciones a medida."
      subtitle="Proyectos que reflejan nuestro compromiso con la calidad y el diseño."
      videoUrl={heroVideo}
      breadcrumbs={[{ name: "Portafolio", path: "/portafolio" }]}
      meta={`© ${anio} mtsprz · puerto varas`}
    >
      <Fragment slot="actions">
        <button
          type="button"
          onclick="window.openCotizarModal && window.openCotizarModal()"
          class="inline-flex items-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover sm:text-sm"
          >[ Cotizar Proyecto ]</button
        >
        <a
          href="#proyectos"
          class="inline-flex items-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-wider text-text-primary transition-colors hover:border-accent hover:text-accent sm:text-sm"
          >[ Ver Proyectos ]</a
        >
      </Fragment>

      <Fragment slot="aside">
        <WebcoreWindow title="portafolio --list" variant="sunken">
          <ul class="divide-y divide-frame">
            {items.map((p) => (
              <li class="flex items-center gap-3 px-4 py-3">
                <span class="font-mono text-[11px] text-text-tertiary">
                  [{p.num}]
                </span>
                <span class="truncate font-body text-sm text-text-primary">{p.title}</span>
                <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">
                  {p.host}
                </span>
              </li>
            ))}
          </ul>
          <div class="flex items-center justify-between border-t border-frame px-4 py-2.5 font-mono text-[11px]">
            <span class="text-text-tertiary">{String(projects.length).padStart(2, "0")} items</span>
            <a href="#proyectos" class="text-text-secondary transition-colors hover:text-accent">
              ver detalle ↓
            </a>
          </div>
        </WebcoreWindow>
      </Fragment>
    </PageHero>

    <!-- Project editorial spreads · v2 -->
    {items.map((p, idx) => (
      <section
        id={idx === 0 ? "proyectos" : undefined}
        class={`group/project relative w-full overflow-hidden border-t border-frame/60 bg-bg${idx === 0 ? " scroll-mt-16" : ""}`}
      >
        <div class="grid w-full lg:grid-cols-12">
          <!-- Imagen · carrusel cinematográfico -->
          <div class="relative h-[300px] overflow-hidden border-b border-frame/60 sm:h-[420px] lg:col-span-7 lg:h-auto lg:min-h-[560px] lg:border-b-0 lg:border-r">
            <div class="project-carousel relative h-full w-full overflow-hidden">
              <div class="carousel-track flex h-full w-full transition-transform duration-500 ease-out">
                {p.images.map((img, iIdx) => {
                  const avifSrc = img.replace(/\.(png|jpg|jpeg)$/i, ".avif");
                  const webpSrc = img.replace(/\.(png|jpg|jpeg)$/i, ".webp");
                  return (
                    <div class="carousel-slide relative h-full w-full shrink-0">
                      <picture class="block h-full w-full">
                        <source srcset={avifSrc} type="image/avif" />
                        <source srcset={webpSrc} type="image/webp" />
                        <img
                          src={img}
                          alt={iIdx === 0 ? `Captura principal — ${p.title}` : `${p.title} — vista ${iIdx + 1}`}
                          loading={idx === 0 && iIdx === 0 ? "eager" : "lazy"}
                          decoding="async"
                          class="h-full w-full object-cover object-top"
                        />
                      </picture>
                    </div>
                  );
                })}
              </div>

              <!-- Scrim sutil · legibilidad de controles -->
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg/80 via-transparent to-transparent" />

              <!-- Controles del carrusel -->
              {p.images.length > 1 && (
                <div class="carousel-controls absolute bottom-5 left-5 z-30 flex items-center gap-3 opacity-90 transition-opacity duration-300 md:opacity-0 md:group-hover/project:opacity-100 md:group-focus-within/project:opacity-100">
                  <div class="carousel-dots flex items-center gap-1.5">
                    {p.images.map((_, i) => (
                      <button
                        class="h-1.5 w-1.5 cursor-pointer rounded-full bg-frame transition-all hover:bg-text-tertiary active:scale-125"
                        data-index={i}
                        aria-label={`Imagen ${i + 1}`}
                      />
                    ))}
                  </div>
                  <div class="flex gap-1">
                    <button class="carousel-prev flex h-8 w-8 cursor-pointer items-center justify-center rounded-[4px] border border-frame bg-surface/80 text-text-secondary transition-colors hover:border-accent hover:text-accent active:scale-95" aria-label="Anterior">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
                    </button>
                    <button class="carousel-next flex h-8 w-8 cursor-pointer items-center justify-center rounded-[4px] border border-frame bg-surface/80 text-text-secondary transition-colors hover:border-accent hover:text-accent active:scale-95" aria-label="Siguiente">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
                    </button>
                  </div>
                  <span class="carousel-indicator ml-1 font-mono text-[11px] tracking-[0.15em] text-text-tertiary">01 / {String(p.images.length).padStart(2, "0")}</span>
                </div>
              )}
            </div>
          </div>

          <!-- Contenido · ficha editorial -->
          <div class="flex items-center lg:col-span-5">
            <div class="reveal-group flex w-full max-w-2xl flex-col gap-5 px-6 py-12 sm:px-10 lg:px-12 lg:py-16 xl:px-16">
              <p class="reveal-item font-mono text-[11px] uppercase tracking-[0.2em] text-accent">
                // proyecto {p.num}
              </p>

              <div>
                <BlurText
                  text={p.head}
                  as="h2"
                  className="font-heading text-4xl font-bold leading-[0.95] tracking-[-1.5px] text-text-primary sm:text-5xl lg:text-6xl"
                />
                {p.sub && (
                  <p class="mt-2 font-heading text-lg font-semibold leading-snug text-accent sm:text-xl lg:text-2xl">
                    {p.sub}
                  </p>
                )}
              </div>

              <p class="reveal-item font-body text-sm font-light leading-[1.8] text-text-secondary lg:text-[15px]">
                {p.description}
              </p>

              <ul class="reveal-item flex flex-wrap gap-2">
                {p.tags.map((tag) => (
                  <li class="rounded-[4px] border border-frame bg-surface px-2 py-1 font-mono text-[11px] text-text-secondary">
                    {tag}
                  </li>
                ))}
              </ul>

              <div class="reveal-item mt-2 flex flex-wrap items-center gap-x-5 gap-y-3">
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-wider text-text-primary transition-colors hover:border-accent hover:text-accent sm:text-sm"
                >
                  [ Visitar proyecto ↗ ]
                </a>
                <span class="font-mono text-[11px] text-text-tertiary">{p.host}</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}

    <!-- CTA final · ventana de contacto v2 (canon §13[8]) -->
    <section id="contacto" class="relative w-full scroll-mt-16 bg-bg py-20 md:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="webcore-window">
          <!-- Title bar -->
          <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
            <span
              class="h-2 w-2 shrink-0 rounded-full bg-accent"
              style="box-shadow:0 0 8px var(--color-accent);"
              aria-hidden="true"></span>
            <span
              class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary"
              >contact — iniciar conversación</span
            >
          </div>

          <!-- Body -->
          <div class="reveal-group px-6 py-12 text-center sm:px-8 md:py-16">
            <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
              // contacto
            </p>

            <h2
              class="reveal-item mx-auto mt-5 max-w-2xl font-heading text-3xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl"
            >
              ¿Tienes un proyecto <span class="text-accent">en mente?</span>
            </h2>

            <p
              class="reveal-item mx-auto mt-5 max-w-xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base"
            >
              Cada proyecto inicia con una conversación. Trabajemos juntos para
              llevar tu idea al siguiente nivel.
            </p>

            <div
              class="reveal-item mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row"
            >
              <a
                href="/contacto"
                class="inline-flex w-full items-center justify-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:w-auto"
              >
                [ Contactar ]
              </a>
              <a
                href="https://portafolio.mtsprz.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:w-auto"
              >
                [ Portafolio completo ↗ ]
              </a>
            </div>

            <p class="reveal-item mt-6 font-mono text-xs text-text-tertiary">
              o llama al <span class="text-text-secondary">+56 9 6692 9818</span>
            </p>

            <div
              class="reveal-item mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 border-t border-frame pt-8"
            >
              {
                ["Sin compromiso", "Respuesta en 24 hrs", "Atención en el sur de Chile"].map(
                  (t) => (
                    <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
                      <svg
                        class="h-3.5 w-3.5 text-accent"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      {t}
                    </span>
                  )
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
  (function() {
    document.querySelectorAll('.project-carousel').forEach(function(carousel) {
      var track = carousel.querySelector('.carousel-track');
      var slides = carousel.querySelectorAll('.carousel-slide');
      var controls = carousel.querySelector('.carousel-controls');
      var dots = controls ? controls.querySelectorAll('.carousel-dots button') : [];
      var prev = controls ? controls.querySelector('.carousel-prev') : null;
      var next = controls ? controls.querySelector('.carousel-next') : null;
      var indicator = controls ? controls.querySelector('.carousel-indicator') : null;
      var section = carousel.closest('section');
      var total = slides.length;
      var current = 0;
      var autoTimer = null;
      var pauseTimer = null;
      var touchStartX = 0;
      var touchStartY = 0;
      var isDragging = false;

      if (total < 2) {
        if (controls) controls.style.display = 'none';
        return;
      }

      function updateIndicator() {
        if (!indicator) return;
        indicator.textContent = String(current + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');
      }

      function updateDots() {
        dots.forEach(function(d, j) {
          d.className = 'rounded-full transition-all duration-300 cursor-pointer ' + (j === current ? 'bg-accent w-2.5 h-1.5' : 'bg-frame w-1.5 h-1.5 hover:bg-text-tertiary active:scale-125');
        });
      }

      function goTo(i) {
        current = Math.max(0, Math.min(total - 1, i));
        track.style.transform = 'translateX(-' + (current * 100) + '%)';
        updateDots();
        updateIndicator();
      }

      function nextSlide() {
        if (current >= total - 1) goTo(0);
        else goTo(current + 1);
      }

      function prevSlide() {
        if (current <= 0) goTo(total - 1);
        else goTo(current - 1);
      }

      function startAuto() {
        stopAuto();
        autoTimer = setInterval(nextSlide, 4500);
      }

      function stopAuto() {
        if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
      }

      function pauseAuto(delay) {
        stopAuto();
        if (pauseTimer) clearTimeout(pauseTimer);
        pauseTimer = setTimeout(startAuto, delay || 8000);
      }

      // Manual navigation
      if (prev) prev.addEventListener('click', function(e) {
        e.stopPropagation();
        prevSlide();
        pauseAuto(8000);
      });

      if (next) next.addEventListener('click', function(e) {
        e.stopPropagation();
        nextSlide();
        pauseAuto(8000);
      });

      dots.forEach(function(d) {
        d.addEventListener('click', function() {
          goTo(parseInt(d.getAttribute('data-index')));
          pauseAuto(8000);
        });
      });

      // Pausar auto en hover del section desktop
      if (section) {
        section.addEventListener('mouseenter', stopAuto);
        section.addEventListener('mouseleave', function() {
          if (!pauseTimer) startAuto();
        });
      }

      // ── Touch / Swipe ──
      carousel.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
        isDragging = false;
      }, { passive: true });

      carousel.addEventListener('touchmove', function(e) {
        if (!touchStartX) return;
        var dx = Math.abs(e.changedTouches[0].screenX - touchStartX);
        var dy = Math.abs(e.changedTouches[0].screenY - touchStartY);
        if (dx > 10 || dy > 10) isDragging = true;
      }, { passive: true });

      carousel.addEventListener('touchend', function(e) {
        if (!isDragging) return;
        var diffX = e.changedTouches[0].screenX - touchStartX;
        if (Math.abs(diffX) > 40) {
          if (diffX > 0) prevSlide();
          else nextSlide();
          pauseAuto(8000);
        }
        touchStartX = 0;
        touchStartY = 0;
        isDragging = false;
      }, { passive: true });

      // ── Keyboard (solo si el carrusel es visible) ──
      carousel.setAttribute('tabindex', '0');
      carousel.setAttribute('role', 'region');
      carousel.setAttribute('aria-label', 'Galería de imágenes');
      carousel.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowLeft') { prevSlide(); pauseAuto(8000); }
        if (e.key === 'ArrowRight') { nextSlide(); pauseAuto(8000); }
      });

      // Init
      goTo(0);
      startAuto();
    });
  })();
  </script>
</BaseLayout>
