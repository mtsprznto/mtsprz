---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/ui/PageHero.astro";
import StatusLed from "../components/ui/StatusLed.astro";
import { query, initDb } from "../lib/db";

await initDb();
const result = await query("SELECT * FROM services WHERE is_active = true ORDER BY category, name");
interface Service {
  id: number;
  slug: string;
  name: string;
  description: string | null;
  price: number;
  promo_price: number | null;
  category: string | null;
  deliverables: string[] | null;
  includes_maintenance: boolean;
  maintenance_price: number;
  maintenance_description: string | null;
  is_active: boolean;
  is_popular: boolean;
  is_monthly: boolean;
}
const services = result.rows as Service[];

const cookieEmail = (Astro.cookies.get("mtsprz_verified")?.value || "").trim().toLowerCase();
const urlEmail = (Astro.url.searchParams.get("email") || "").trim().toLowerCase();
const candidateEmail = cookieEmail || urlEmail || "";
let verifiedEmail = "";
if (candidateEmail) {
  const verResult = await query("SELECT 1 FROM verified_emails WHERE email = $1", [candidateEmail]);
  if (verResult.rows.length > 0) {
    verifiedEmail = candidateEmail;
  }
}
const categories = [...new Set(services.map((s) => s.category).filter(Boolean))] as string[];
const effectivePrice = (s: Service) => (s.promo_price && s.promo_price > 0 ? s.promo_price : s.price);

const VIDEO_HERO = "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4";
---

<BaseLayout
  title={verifiedEmail ? "Cotización Personalizada" : "Cotizar tu Proyecto"}
  description={verifiedEmail ? "Simula tu cotización personalizada. Selecciona los servicios digitales que necesita tu negocio." : "Verifica tu correo para solicitar una cotización personalizada."}
  canonical="https://mtsprz.org/cotizar"
  noindex
>
  <Header />

  <main id="main-content">
  {!verifiedEmail ? (
    <>
      <PageHero
        ledLabel="acceso con código"
        eyebrow="// cotización · paso 1 de 2"
        title="Cotiza"
        titleAccent="gratis."
        subtitle="Te enviamos un código de verificación para comenzar la cotización."
        note="Sin cuentas ni claves: tu correo y un código de 6 dígitos."
        videoUrl={VIDEO_HERO}
        breadcrumbs={[{ name: "Cotización", path: "/cotizar" }]}
        meta="verificación en 2 pasos"
      >
        <Fragment slot="actions">
          <a
            href="/servicios"
            class="inline-flex items-center rounded-[4px] border border-frame bg-surface px-3.5 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary transition-colors hover:border-frame-hover hover:text-text-primary"
          >
            [ Explorar servicios ]
          </a>
        </Fragment>
        <Fragment slot="aside">
          <div class="webcore-window">
            <header class="flex h-9 items-center gap-3 border-b border-frame bg-surface px-3">
              <span class="flex items-center gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
                <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
                <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
              </span>
              <span class="truncate font-mono text-[11px] font-medium uppercase tracking-wider text-text-secondary">cotizar --como-funciona</span>
            </header>
            <div class="bg-surface-sunken px-5 py-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">// flujo</p>
              <div class="mt-4 flex flex-col gap-3">
                <div class="flex gap-3 border-b border-frame/60 pb-3">
                  <span class="shrink-0 font-mono text-[11px] text-text-tertiary">[01]</span>
                  <div>
                    <p class="font-heading text-sm font-semibold text-text-primary">Verifica tu correo</p>
                    <p class="mt-0.5 font-body text-xs leading-relaxed text-text-secondary">Un código de 6 dígitos. Sin cuentas ni claves.</p>
                  </div>
                </div>
                <div class="flex gap-3 border-b border-frame/60 pb-3">
                  <span class="shrink-0 font-mono text-[11px] text-text-tertiary">[02]</span>
                  <div>
                    <p class="font-heading text-sm font-semibold text-text-primary">Elige tus servicios</p>
                    <p class="mt-0.5 font-body text-xs leading-relaxed text-text-secondary">Catálogo con precios a la vista y packs con descuento.</p>
                  </div>
                </div>
                <div class="flex gap-3">
                  <span class="shrink-0 font-mono text-[11px] text-text-tertiary">[03]</span>
                  <div>
                    <p class="font-heading text-sm font-semibold text-text-primary">Recibe tu propuesta</p>
                    <p class="mt-0.5 font-body text-xs leading-relaxed text-text-secondary">Te contactamos en menos de 24 hrs.</p>
                  </div>
                </div>
              </div>
            </div>
            <footer class="flex h-8 items-center border-t border-frame bg-surface px-3">
              <StatusLed label="sin compromiso" />
            </footer>
          </div>
        </Fragment>
      </PageHero>

      <section class="w-full bg-bg px-4 py-16 sm:px-6 md:py-20 lg:px-8 xl:px-12">
        <div class="webcore-window mx-auto w-full max-w-md">
          <header class="flex h-9 items-center gap-3 border-b border-frame bg-surface px-3">
            <span class="flex items-center gap-1.5" aria-hidden="true">
              <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
              <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
              <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
            </span>
            <span class="truncate font-mono text-[11px] font-medium uppercase tracking-wider text-text-secondary">cotizar --verificación</span>
          </header>

          <div class="bg-surface-sunken px-6 py-7 sm:px-8 sm:py-8">

            <!-- STEP 1: Email -->
            <div id="verify-step-1">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">// paso 1 de 2</p>
              <h2 class="mt-3 font-heading text-2xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-3xl">
                Ingresa tu correo
              </h2>
              <p class="mt-3 font-body text-sm leading-relaxed text-text-secondary">
                Te enviamos un código de verificación para comenzar la cotización.
              </p>
              <div class="mt-6 flex flex-col gap-2.5">
                <input
                  type="email"
                  id="verify-email"
                  placeholder="tu@correo.com"
                  autocomplete="email"
                  class="w-full rounded-[4px] border border-frame bg-surface px-3.5 py-2.5 font-body text-sm text-text-primary outline-none transition-colors placeholder:text-text-tertiary focus:border-accent"
                />
                <p id="verify-email-error" class="hidden font-mono text-xs text-danger"></p>
                <button
                  id="verify-send-btn"
                  type="button"
                  class="flex w-full items-center justify-center gap-2.5 rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover"
                >
                  <span id="verify-send-text">Enviar código</span>
                  <svg id="verify-send-spinner" class="hidden h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.3"/><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>

            <!-- STEP 2: Código -->
            <div id="verify-step-2" class="hidden">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">// paso 2 de 2</p>
              <h2 class="mt-3 font-heading text-2xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-3xl">
                Código <span class="text-text-tertiary">de 6 dígitos</span>
              </h2>
              <p class="mt-3 font-body text-sm leading-relaxed text-text-secondary">
                Enviamos el código a <strong id="verify-email-display" class="font-medium text-text-primary"></strong>
              </p>
              <div class="mt-6 flex flex-col gap-2.5">
                <div class="flex justify-center gap-1.5 sm:gap-2">
                  <input type="text" id="verify-code-0" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="one-time-code" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
                  <input type="text" id="verify-code-1" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
                  <input type="text" id="verify-code-2" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
                  <span aria-hidden="true" class="flex items-center px-0.5 font-mono text-sm text-frame">·</span>
                  <input type="text" id="verify-code-3" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
                  <input type="text" id="verify-code-4" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
                  <input type="text" id="verify-code-5" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
                </div>
                <p id="verify-code-error" class="hidden text-center font-mono text-xs text-danger"></p>
                <button
                  id="verify-verify-btn"
                  type="button"
                  class="flex w-full items-center justify-center gap-2.5 rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover"
                >
                  <span id="verify-verify-text">Verificar código</span>
                  <svg id="verify-verify-spinner" class="hidden h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.3"/><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                </button>
                <button
                  id="verify-resend-btn"
                  type="button"
                  class="mt-1 self-center font-mono text-[11px] uppercase tracking-wider text-text-tertiary underline underline-offset-2 transition-colors hover:text-accent"
                >
                  Reenviar código
                </button>
              </div>
            </div>

          </div>

          <footer class="flex h-8 items-center border-t border-frame bg-surface px-3">
            <StatusLed label="verificación en 2 pasos" />
          </footer>
        </div>
      </section>
    </>

  ) : (

    <>
      <PageHero
        ledLabel="sesión verificada"
        eyebrow="// cotización · acceso verificado"
        title="Tu cotización"
        titleAccent="personalizada."
        subtitle="Selecciona los servicios digitales que necesita tu negocio y arma tu cotización al instante."
        note={`Sesión: ${verifiedEmail}`}
        videoUrl={VIDEO_HERO}
        breadcrumbs={[{ name: "Cotización", path: "/cotizar" }]}
        meta="sin compromiso · menos de 24 hrs"
      >
        <Fragment slot="aside">
          <div class="webcore-window">
            <header class="flex h-9 items-center gap-3 border-b border-frame bg-surface px-3">
              <span class="flex items-center gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
                <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
                <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
              </span>
              <span class="truncate font-mono text-[11px] font-medium uppercase tracking-wider text-text-secondary">acceso --verificado</span>
            </header>
            <div class="bg-surface-sunken px-5 py-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">// sesión</p>
              <div class="mt-4 flex flex-col gap-3">
                <div class="flex gap-3 border-b border-frame/60 pb-3">
                  <span class="shrink-0 font-mono text-[11px] text-text-tertiary">[01]</span>
                  <div class="min-w-0">
                    <p class="font-heading text-sm font-semibold text-text-primary break-all">{verifiedEmail}</p>
                    <p class="mt-0.5 font-body text-xs leading-relaxed text-text-secondary">Correo verificado con código de 6 dígitos.</p>
                  </div>
                </div>
                <div class="flex gap-3 border-b border-frame/60 pb-3">
                  <span class="shrink-0 font-mono text-[11px] text-text-tertiary">[02]</span>
                  <div>
                    <p class="font-heading text-sm font-semibold text-text-primary">{services.length} servicios disponibles</p>
                    <p class="mt-0.5 font-body text-xs leading-relaxed text-text-secondary">Selección múltiple sobre precios reales del catálogo.</p>
                  </div>
                </div>
                <div class="flex gap-3">
                  <span class="shrink-0 font-mono text-[11px] text-text-tertiary">[03]</span>
                  <div>
                    <p class="font-heading text-sm font-semibold text-text-primary">Descuentos por pack automáticos</p>
                    <p class="mt-0.5 font-body text-xs leading-relaxed text-text-secondary">El resumen se actualiza en vivo con cada selección.</p>
                  </div>
                </div>
              </div>
            </div>
            <footer class="flex h-8 items-center border-t border-frame bg-surface px-3">
              <StatusLed label="sesión activa" />
            </footer>
          </div>
        </Fragment>
      </PageHero>

      <section class="w-full bg-bg px-4 py-16 sm:px-6 md:py-20 lg:px-8 xl:px-12">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">

          <!-- Catálogo de servicios -->
          <div class="lg:col-span-8">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">// selecciona tus servicios</p>
            {categories.map((cat) => (
              <div class="mt-8 first-of-type:mt-5">
                <div class="mb-3 flex items-center gap-3 border-b border-frame/60 pb-2.5">
                  <span class="h-4 w-0.5 shrink-0 bg-accent" aria-hidden="true"></span>
                  <h2 class="font-mono text-xs font-medium uppercase tracking-wider text-text-secondary">{cat}</h2>
                  <span class="font-mono text-[11px] text-text-tertiary">[{services.filter((s) => s.category === cat).length}]</span>
                </div>
                <div class="flex flex-col gap-2">
                  {services.filter((s) => s.category === cat).map((s) => (
                    <label
                      class="cotizar-option flex cursor-pointer items-start gap-4 rounded-[6px] border border-frame/60 bg-surface px-4 py-3.5 transition-colors hover:border-frame-hover hover:bg-surface-hover has-[:checked]:border-accent/50 has-[:checked]:bg-accent-subtle sm:px-5"
                      data-price={effectivePrice(s)}
                      data-monthly={s.is_monthly ? "true" : "false"}
                      data-slug={s.slug}
                    >
                      <input type="checkbox" class="cotizar-checkbox mt-0.5 h-3.5 w-3.5 shrink-0 cursor-pointer accent-accent" />
                      <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-4">
                          <div class="flex flex-wrap items-center gap-2">
                            <span data-service-name class="font-heading text-sm font-semibold text-text-primary">{s.name}</span>
                            {s.is_popular && (
                              <span class="rounded-[4px] border border-accent/40 bg-accent-subtle px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-accent">Popular</span>
                            )}
                          </div>
                          <div class="shrink-0 text-right">
                            {s.promo_price && s.promo_price > 0 ? (
                              <div class="flex items-baseline gap-2">
                                <span class="font-heading text-sm font-bold text-text-primary">${(effectivePrice(s) / 1000).toFixed(0)}k</span>
                                <s class="font-mono text-xs text-text-tertiary">${(s.price / 1000).toFixed(0)}k</s>
                              </div>
                            ) : (
                              <span class="font-heading text-sm font-bold text-text-primary">${(s.price / 1000).toFixed(0)}k</span>
                            )}
                            {s.is_monthly && <span class="mt-0.5 block font-mono text-[10px] text-text-tertiary">/mes</span>}
                          </div>
                        </div>
                        <p class="mt-1 font-body text-xs leading-relaxed text-text-secondary">{s.description}</p>
                      </div>
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- Sidebar resumen -->
          <aside class="lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
            <div class="webcore-window">
              <header class="flex h-9 items-center gap-3 border-b border-frame bg-surface px-3">
                <span class="flex items-center gap-1.5" aria-hidden="true">
                  <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
                  <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
                  <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
                </span>
                <span class="truncate font-mono text-[11px] font-medium uppercase tracking-wider text-text-secondary">resumen --live</span>
              </header>
              <div class="bg-surface-sunken px-5 py-6">
                <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">// resumen</p>
                <h3 class="mt-2 font-heading text-xl font-bold tracking-[-0.02em] text-text-primary">Tu cotización</h3>

                <div id="cotizar-summary" class="mt-4 min-h-12" aria-live="polite">
                  <p class="font-body text-xs text-text-tertiary">Selecciona servicios para ver el total.</p>
                </div>

                <div class="border-t border-frame/60 pt-4">
                  <div class="mb-2 flex items-baseline justify-between">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-text-tertiary">Subtotal</span>
                    <span id="cotizar-subtotal" class="font-heading text-sm font-bold text-text-secondary">$0</span>
                  </div>
                  <div id="cotizar-discount-row" class="hidden items-baseline justify-between">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-accent">Descuento pack</span>
                    <span id="cotizar-discount" class="font-heading text-sm font-bold text-accent">-$0</span>
                  </div>
                  <div class="mt-1 flex items-baseline justify-between border-t border-frame/60 pt-3">
                    <span class="font-heading text-xs font-bold uppercase tracking-wider text-text-primary">Total</span>
                    <span id="cotizar-total" class="font-heading text-2xl font-bold tracking-[-0.02em] text-text-primary">$0</span>
                  </div>
                </div>

                <button
                  id="cotizar-submit-btn"
                  type="button"
                  data-verified-email={verifiedEmail}
                  class="mt-5 flex w-full items-center justify-center gap-2.5 rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg opacity-40 pointer-events-none transition-colors hover:bg-accent-hover"
                >
                  <span id="cotizar-submit-text">Enviar cotización</span>
                  <svg id="cotizar-submit-spinner" class="hidden h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.3"/><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                </button>

                <div class="mt-5 border-t border-frame/60 pt-4">
                  <label for="cotizar-phone" class="mb-2 block font-mono text-[11px] uppercase tracking-wider text-text-tertiary">Tu WhatsApp (opcional)</label>
                  <input
                    type="tel"
                    id="cotizar-phone"
                    placeholder="+56 9 1234 5678"
                    autocomplete="tel"
                    class="w-full rounded-[4px] border border-frame bg-surface px-3.5 py-2.5 font-body text-sm text-text-primary outline-none transition-colors placeholder:text-text-tertiary focus:border-accent"
                  />
                  <p id="cotizar-phone-error" class="mt-1.5 hidden font-mono text-xs text-danger"></p>
                  <p class="mt-2 font-body text-xs leading-relaxed text-text-tertiary">
                    Te contactamos por WhatsApp para agilizar tu proyecto.
                  </p>
                </div>

                <p class="mt-4 border-t border-frame/60 pt-4 text-center font-mono text-[11px] uppercase tracking-wider text-text-tertiary">
                  Sin compromiso · menos de 24 hrs
                </p>
              </div>
              <footer class="flex h-8 items-center border-t border-frame bg-surface px-3">
                <StatusLed label="cotización en vivo" />
              </footer>
            </div>
          </aside>

        </div>
      </section>
    </>
  )}

  </main>

  <Footer />
</BaseLayout>

{!verifiedEmail ? (
<script is:inline>
(function() {
  var $ = function(id) { return document.getElementById(id); };
  var step1 = $('verify-step-1');
  var step2 = $('verify-step-2');
  var emailInput = $('verify-email');
  var emailError = $('verify-email-error');
  var emailDisplay = $('verify-email-display');
  var sendBtn = $('verify-send-btn');
  var sendText = $('verify-send-text');
  var sendSpinner = $('verify-send-spinner');
  var verifyBtn = $('verify-verify-btn');
  var verifyText = $('verify-verify-text');
  var verifySpinner = $('verify-verify-spinner');
  var codeError = $('verify-code-error');
  var resendBtn = $('verify-resend-btn');
  var codeInputs = [
    $('verify-code-0'), $('verify-code-1'), $('verify-code-2'),
    $('verify-code-3'), $('verify-code-4'), $('verify-code-5'),
  ];
  var currentEmail = '';

  function showError(el, msg) {
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  function setLoading(btn, spinner, text, loading) {
    if (!btn || !spinner || !text) return;
    if (loading) {
      btn.disabled = true;
      spinner.classList.remove('hidden');
      text.textContent = '...';
    } else {
      btn.disabled = false;
      spinner.classList.add('hidden');
      text.textContent = text.getAttribute('data-restore') || text.textContent;
    }
  }

  if (emailInput) {
    emailInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && sendBtn) sendBtn.click();
    });
  }

  if (sendBtn) {
    sendBtn.addEventListener('click', async function() {
      if (!emailInput || !emailError || !sendText || !sendSpinner) return;
      var email = emailInput.value.trim().toLowerCase();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError(emailError, 'Ingresa un correo electrónico válido');
        return;
