---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ListChecks, Bot, MapPin, ArrowUpRight } from "@lucide/astro";
import { LEAD_MAGNETS } from "../lib/marketing/lead-magnets";

const magnets = [...LEAD_MAGNETS].sort((a, b) => a.order - b.order);
const iconMap = {
  "list-checks": ListChecks,
  bot: Bot,
  "map-pin": MapPin,
};
const site = "https://mtsprz.org";
---

<BaseLayout
  title="Recursos Gratis para Pymes del Sur | Guías, Checklists y Plantillas"
  description="Descarga gratis guías y checklists para pymes de Puerto Varas, Osorno, Puerto Montt y Valdivia: web que vende, automatizaciones con IA y Google Maps. Entrega por email en 1 minuto."
  canonical="https://mtsprz.org/recursos"
  breadcrumbs={[{ name: "Recursos", path: "/recursos" }]}
>
  <Header />
  <main id="main-content" style="overflow-x: hidden;">
    <!-- HERO -->
    <section class="relative flex min-h-[70vh] items-end overflow-hidden px-6 py-16 md:px-12 md:py-20" style="background:#010101;">
      <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse at 20% 90%, #06b6d414 0%, transparent 50%), radial-gradient(ellipse at 85% 10%, #0a0a2e 0%, transparent 60%);"></div>
      <div class="relative z-10 w-full">
        <div class="mx-auto w-full max-w-6xl">
          <p class="mb-6 font-body text-[10px] md:text-xs uppercase tracking-[0.35em] text-white/30">Biblioteca · Recursos gratis</p>
          <h1 class="m-0 font-heading font-extrabold uppercase leading-[0.9] tracking-[-0.03em] text-white" style="font-size:clamp(2.5rem, 7vw, 5.5rem);">
            Guías que<br />
            <span class="text-white/20">venden solas</span>
          </h1>
          <div class="mt-8 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            <p class="max-w-xl m-0 font-body text-sm md:text-base leading-[1.7] text-white/50">
              Checklists y guías para negocios de Los Lagos y Los Ríos: qué arreglar en tu web, qué automatizar con IA y cómo aparecer en Google Maps. Entrega por email en 1 minuto.
            </p>
            <dl class="grid shrink-0 grid-cols-3 gap-8 border-t border-white/10 pt-4">
              <div>
                <dt class="font-body text-[10px] uppercase tracking-[0.25em] text-white/30">Guías</dt>
                <dd class="m-0 mt-1 font-heading text-2xl font-bold text-white">{String(magnets.length).padStart(2, "0")}</dd>
              </div>
              <div>
                <dt class="font-body text-[10px] uppercase tracking-[0.25em] text-white/30">Costo</dt>
                <dd class="m-0 mt-1 font-heading text-2xl font-bold text-white">Gratis</dd>
              </div>
              <div>
                <dt class="font-body text-[10px] uppercase tracking-[0.25em] text-white/30">Entrega</dt>
                <dd class="m-0 mt-1 font-heading text-2xl font-bold text-white">Email</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- GRID DE MAGNETS -->
    <section class="px-6 py-20 md:px-12 md:py-28">
      <div class="reveal-group mx-auto grid w-full max-w-6xl grid-cols-1 gap-5 md:grid-cols-3">
        {magnets.map((m) => {
          const Icon = iconMap[m.icon] || ListChecks;
          return (
            <a
              href={`/recursos/${m.slug}`}
              class="reveal-item group relative flex flex-col border border-white/10 bg-white/[0.02] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#6366f1]/40 hover:bg-white/[0.04]"
              style="box-shadow: 0 0 0 rgba(0,0,0,0);"
              onmouseover="this.style.boxShadow='0 20px 50px -20px rgba(99,102,241,0.25)'" onmouseout="this.style.boxShadow='0 0 0 rgba(0,0,0,0)'"
            >
              <!-- Orden editorial fantasma -->
              <span class="pointer-events-none absolute right-6 top-5 font-heading text-6xl font-extrabold leading-none text-white/[0.05] transition-colors duration-300 group-hover:text-[#6366f1]/10">
                {String(m.order).padStart(2, "0")}
              </span>

              <div class="flex h-12 w-12 items-center justify-center border border-white/10 text-white/70 transition-all duration-300 group-hover:border-[#6366f1]/50 group-hover:text-[#a5b4fc]">
                <Icon size={22} stroke-width="1.5" />
              </div>

              <h2 class="mt-8 m-0 font-heading text-lg font-bold leading-snug tracking-[-0.01em] text-white">
                {m.title}
              </h2>
              <p class="mt-3 m-0 font-body text-sm leading-[1.7] text-white/55">
                {m.promise}
              </p>

              <p class="mt-8 mb-0 font-body text-[10px] uppercase tracking-[0.2em] text-white/30">
                {m.audience}
              </p>

              <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-5">
                <span class="font-body text-[11px] font-semibold uppercase tracking-[0.2em] text-[#a5b4fc]">
                  Ver guía
                </span>
                <ArrowUpRight
                  size={16}
                  stroke-width="2"
                  class="text-white/40 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-[#a5b4fc]"
                />
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- CÓMO FUNCIONA -->
    <section class="px-6 pb-24 md:px-12 md:pb-32">
      <div class="mx-auto w-full max-w-6xl">
        <p class="reveal-item mb-10 font-body text-[10px] md:text-xs uppercase tracking-[0.35em] text-white/30">Cómo funciona</p>
        <div class="reveal-group grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-white/10">
          <div class="reveal-item md:pr-10">
            <span class="font-heading text-6xl font-extrabold leading-none text-[#6366f1]/30">01</span>
            <h3 class="mt-6 m-0 font-heading text-base font-bold text-white">Deja tu email</h3>
            <p class="mt-2 mb-0 font-body text-sm leading-[1.7] text-white/50">Sin costo, sin tarjeta. Sin spam.</p>
          </div>
          <div class="reveal-item md:px-10">
            <span class="font-heading text-6xl font-extrabold leading-none text-[#6366f1]/30">02</span>
            <h3 class="mt-6 m-0 font-heading text-base font-bold text-white">Recibe la guía en tu correo</h3>
            <p class="mt-2 mb-0 font-body text-sm leading-[1.7] text-white/50">El contenido está en la web (siempre accesible) y te llega el resumen.</p>
          </div>
          <div class="reveal-item md:pl-10">
            <span class="font-heading text-6xl font-extrabold leading-none text-[#6366f1]/30">03</span>
            <h3 class="mt-6 m-0 font-heading text-base font-bold text-white">Diagnóstico gratis</h3>
            <p class="mt-2 mb-0 font-body text-sm leading-[1.7] text-white/50">Si quieres, revisamos tu caso en 20 minutos. Sin compromiso.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA DIAGNÓSTICO -->
    <section class="px-6 pb-24 md:px-12 md:pb-32">
      <div class="reveal-item mx-auto w-full max-w-6xl border border-[#6366f1]/25 px-8 py-14 text-center md:px-16" style="background: linear-gradient(135deg, rgba(99,102,241,0.07), rgba(139,92,246,0.03));">
        <p class="mb-4 font-body text-[10px] uppercase tracking-[0.35em] text-[#a5b4fc]">Sin compromiso</p>
        <h2 class="mx-auto m-0 max-w-2xl font-heading text-2xl font-bold leading-tight tracking-[-0.01em] text-white md:text-3xl">
          Aplica esto a tu negocio en 20 minutos
        </h2>
        <p class="mx-auto mt-4 mb-8 max-w-xl font-body text-sm leading-[1.7] text-white/55">
          Revisamos tu web, tu Google Maps y tu presencia en IA, y te dejamos 3 acciones concretas que puedes aplicar esta semana. Gratis, sin compromiso.
        </p>
        <a
          href="/diagnostico"
          class="group relative inline-flex items-center gap-2 px-8 py-4 font-body text-[11px] font-bold uppercase tracking-[0.2em] text-white transition-all duration-300"
          style="background: linear-gradient(135deg, #6366f1, #8b5cf6);"
        >
          <span class="absolute inset-0 rounded-sm opacity-0 transition-opacity duration-300 blur-xl group-hover:opacity-100" style="background: #6366f166;" />
          <span class="relative">Quiero mi diagnóstico gratis</span>
          <ArrowUpRight size={15} stroke-width="2.5" class="relative transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
