---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import TestimonioCaso from "../../components/casos/TestimonioCaso.astro";
import CasoNav from "../../components/casos/CasoNav.astro";
import OfertaFundador from "../../components/casos/OfertaFundador.astro";
import { CASOS } from "../../data/casos";
import { getCasoVisual } from "../../lib/caso-visuals";

export function getStaticPaths() {
  return CASOS.map((caso) => ({
    params: { slug: caso.slug },
    props: { caso },
  }));
}

interface Props {
  caso: (typeof CASOS)[number];
}

const { caso } = Astro.props;

const site = "https://mtsprz.org";
const url = `${site}/casos/${caso.slug}`;
const isFundador = caso.tipo === "Cliente fundador";

// Visual cinematográfico del caso · la "imagen" es el hero (DRY lib)
const visual = getCasoVisual(caso.slug);
const indice = String(CASOS.findIndex((c) => c.slug === caso.slug) + 1).padStart(2, "0");
---

<BaseLayout
  title={caso.titulo}
  description={caso.resumen}
  canonical={url}
  article={{ title: caso.titulo }}
  breadcrumbs={[
    { name: "Casos", path: "/casos" },
    { name: caso.titulo, path: `/casos/${caso.slug}` },
  ]}
>

  <Header />
  <main id="main-content">
    <!-- ===== Hero cinematográfico · la imagen es la tarjeta ===== -->
    <section class="relative overflow-hidden bg-[#010101]">
      <div class="absolute inset-0" style="background: #010101;" />
      <div class="absolute inset-0" style={`background: ${visual.bg};`} />
      <div class="absolute inset-0" style={`background-image: ${visual.patternUrl}; background-size: 48px 48px;`} />
      <div class="absolute inset-0" style="background: radial-gradient(60% 45% at 50% 0%, rgba(255,255,255,0.06), transparent 70%);" />
      <div class="absolute inset-0 opacity-[0.012] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noise)\' opacity=\'1\'/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;" />
      <!-- Overlay oscuro para legibilidad -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/20 to-[#010101]" />

      <div class="relative mx-auto max-w-6xl px-6 pt-32 pb-16 md:pt-40 md:pb-20">
        <Breadcrumbs
          items={[
            { name: "Casos", path: "/casos" },
            { name: caso.titulo, path: `/casos/${caso.slug}` },
          ]}
        />

        <div class="mt-10 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
          <div class="reveal-group max-w-3xl">
            <div class="reveal-item flex flex-wrap items-center gap-4">
              <span class={`inline-flex items-center gap-2 font-body text-[10px] uppercase tracking-[0.18em] ${
                isFundador ? "text-emerald-300" : "text-white/60"
              }`}>
                <span class={`h-1 w-1 rounded-full ${isFundador ? "bg-emerald-300" : "bg-white/40"}`} />
                {caso.tipo}
              </span>
              <span class="h-3 w-px bg-white/20" aria-hidden="true" />
              <span class="font-body text-[10px] uppercase tracking-[0.18em] text-white/40">{caso.industria}</span>
            </div>

            <h1 class="reveal-item mt-6 font-heading font-bold leading-[0.95] tracking-[-0.03em] text-white [font-size:clamp(2.5rem,6vw,4.75rem)]">
              {caso.titulo}
            </h1>
            <p class="reveal-item mt-6 max-w-xl font-body text-base font-light leading-[1.8] text-white/55 md:text-lg">
              {caso.resumen}
            </p>
          </div>

          <!-- Número editorial gigante (índice del caso) -->
          <div class="reveal-item hidden justify-end lg:flex">
            <span
              aria-hidden="true"
              class="select-none font-heading font-bold leading-none tracking-[-0.04em] text-white/[0.08] [font-size:clamp(8rem,16vw,14rem)]"
            >
              {indice}
            </span>
          </div>
        </div>

        <!-- Métricas · sin cajas, tabla abierta -->
        <div class="reveal-item mt-16 grid grid-cols-3 divide-x divide-white/10 border-t border-white/10 pt-6 md:mt-20">
          {caso.metricas.slice(0, 3).map((m, mi) => (
            <div class={`${mi === 0 ? "pl-0" : "pl-4"} pr-4 md:pl-5`}>
              <p class="font-body text-[9px] uppercase tracking-[0.14em] text-white/35 md:text-[10px]">{m.label}</p>
              <p class="mt-1.5 font-heading text-sm font-semibold text-white/90 md:text-lg">{m.valor}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== Problema ===== -->
    <section class="relative w-full bg-[#0A0A0A]" aria-label="El problema">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
          <div class="reveal-group">
            <p class="reveal-item font-body text-[10px] font-medium uppercase tracking-[0.25em] text-white/30">01 · El problema</p>
            <h2 class="reveal-item mt-2 font-heading text-3xl font-bold tracking-[-0.5px] text-white md:text-4xl">El dolor, en palabras simples</h2>
          </div>
          <div class="reveal-group">
            <p class="reveal-item font-body text-base font-light leading-[1.9] text-white/60 md:text-lg">{caso.problema}</p>

            <!-- Resultados como filas editoriales · ordinales, sin cajas -->
            <p class="reveal-item mt-10 font-body text-[10px] font-medium uppercase tracking-[0.25em] text-white/30">Lo que cambió</p>
            <div class="reveal-item mt-3 border-t border-white/[0.08]">
              {caso.resultado.map((r, i) => (
                <div class="group flex items-baseline gap-6 border-b border-white/[0.08] py-5">
                  <span class="font-mono text-xs text-white/25 transition-colors duration-500 group-hover:text-indigo-300/80">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <p class="font-body text-sm font-light leading-[1.8] text-white/50 transition-colors duration-500 group-hover:text-white/70">
                    {r}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Solución ===== -->
    <section class="relative w-full overflow-hidden bg-[#010101]" aria-label="La solución">
      <div class="absolute inset-0" style="background: #010101;" />
      <div class="absolute inset-0 opacity-60" style="background: radial-gradient(ellipse at 70% 0%, #8b5cf612 0%, transparent 55%);" />
      <div class="relative mx-auto max-w-6xl px-6 py-20 md:py-28">
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
          <div class="reveal-group">
            <p class="reveal-item font-body text-[10px] font-medium uppercase tracking-[0.25em] text-white/30">02 · La solución</p>
            <h2 class="reveal-item mt-2 font-heading text-3xl font-bold tracking-[-0.5px] text-white md:text-4xl">Cómo lo resolvimos</h2>
          </div>
          <div class="reveal-group">
            <p class="reveal-item font-body text-base font-light leading-[1.9] text-white/60 md:text-lg">{caso.solucion}</p>

            <!-- Métricas · tabla abierta (sin cards) -->
            <div class="reveal-item mt-10 grid grid-cols-3 divide-x divide-white/10 border-t border-white/10 pt-6">
              {caso.metricas.slice(0, 3).map((m, mi) => (
                <div class={`${mi === 0 ? "pl-0" : "pl-4"} pr-4 md:pl-5`}>
                  <p class="font-body text-[9px] uppercase tracking-[0.14em] text-white/35 md:text-[10px]">{m.label}</p>
                  <p class="mt-1.5 font-heading text-sm font-semibold text-white/90 md:text-lg">{m.valor}</p>
                </div>
              ))}
            </div>

            <!-- Stack como fila editorial mono -->
            {caso.stack && caso.stack.length > 0 && (
              <div class="reveal-item mt-10 border-t border-white/[0.08] pt-5">
                <p class="font-body text-[10px] font-medium uppercase tracking-[0.25em] text-white/30">Stack</p>
                <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
                  {caso.stack.map((tech, i) => (
                    <span class="inline-flex items-center gap-3 font-mono text-[11px] text-white/50">
                      {i > 0 && <span class="h-1 w-1 rounded-full bg-white/20" aria-hidden="true" />}
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonio · componente data-driven (null → butaca reservada, nunca inventado) -->
    <section class="relative w-full bg-[#0A0A0A]" aria-label="Testimonio">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <TestimonioCaso caso={caso} />
      </div>
    </section>

    <!-- CTA oferta fundador · componente reutilizable (variante compact, sin tabla) -->
    <OfertaFundador id="oferta" showPrecios={false} ctaLabel="Solicitar mi cupo fundador" />

    <!-- Navegación editorial prev/next · sección autosuficiente (sin mt externo) -->
    <CasoNav casos={CASOS} currentSlug={caso.slug} />
  </main>
  <Footer />
</BaseLayout>
