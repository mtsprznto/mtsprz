---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/ui/PageHero.astro";
import WebcoreWindow from "../components/ui/WebcoreWindow.astro";
import Footer from "../components/Footer.astro";
import { Phone, Mail, MapPin, Check, ArrowRight, ChevronDown } from "@lucide/astro";

// Video hero · misma pieza cinematográfica del home (§5.4)
const heroVideo = "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4";

// Strip del hero · año de build (página prerender)
const anio = new Date().getFullYear();

// Canales directos · datos reales (tel / mailto / ubicación — intactos)
const CONTACTO = [
  { icon: Phone, label: "Teléfono", value: "+56 9 6692 9818", href: "tel:+56966929818" },
  { icon: Mail, label: "Email", value: "contacto@mtsprz.org", href: "mailto:contacto@mtsprz.org" },
  { icon: MapPin, label: "Ubicación", value: "Puerto Varas, Región de Los Lagos, Chile", href: null },
];

// Señales de confianza · mismas del copy v1
const TRUST = ["Sin compromiso", "Respuesta en 24 hrs", "Atención personalizada"];

// Rangos de presupuesto · values intactos (payload del form)
const BUDGETS = [
  { value: "200-500", label: "$200K-$500K" },
  { value: "500-1000", label: "$500K-$1M" },
  { value: "1000+", label: "$1M+" },
];
---

<BaseLayout
  title="Contacto · Agencia Digital Puerto Varas"
  description="Contacta a Mtsprz en Puerto Varas, Región de Los Lagos. Solicita una cotización sin compromiso para tu página web, SEO local o automatización."
  canonical="https://mtsprz.org/contacto"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": "https://mtsprz.org/contacto#contactpage",
    url: "https://mtsprz.org/contacto",
    description: "Formulario de contacto y datos de Mtsprz en Puerto Varas, Región de Los Lagos.",
    mainEntity: {
      "@type": "Organization",
      "@id": "https://mtsprz.org/#organization"
    }
  })} />
  <Header />
  <link rel="preload" as="video" href={heroVideo} fetchpriority="high" />
  <main id="main-content">
    <!-- Hero · primitiva reutilizable ui/PageHero (mismo patrón que home, /servicios, /portafolio, /casos y /blog) -->
    <PageHero
      ledLabel="canal directo · respuesta en 24 hrs"
      eyebrow="// contacto · puerto varas"
      title="Hablemos de tu"
      titleAccent="próximo proyecto."
      subtitle="Cuéntanos qué necesitas — una web, SEO local o automatización — y te respondemos dentro de 24 horas con una propuesta clara: alcance, plazos y precio. Sin compromiso."
      videoUrl={heroVideo}
      breadcrumbs={[{ name: "Contacto", path: "/contacto" }]}
      meta={`© ${anio} mtsprz · puerto varas`}
    >
      <Fragment slot="actions">
        <a
          href="#formulario"
          class="inline-flex items-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover sm:text-sm"
          >[ Enviar mensaje ]</a
        >
        <a
          href="https://wa.me/56966929818?text=Hola,%20vi%20su%20p%C3%A1gina%20y%20quiero%20una%20cotizaci%C3%B3n"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-wider text-text-primary transition-colors hover:border-accent hover:text-accent sm:text-sm"
          >[ WhatsApp directo ]</a
        >
      </Fragment>

      <Fragment slot="aside">
        <WebcoreWindow title="contacto --canales" variant="sunken">
          <ul class="divide-y divide-frame">
            <li class="flex items-center gap-3 px-4 py-3">
              <span class="font-mono text-[11px] text-text-tertiary">[01]</span>
              <a href="mailto:contacto@mtsprz.org" class="truncate font-body text-sm text-text-primary transition-colors hover:text-accent">
                contacto@mtsprz.org
              </a>
              <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">
                email
              </span>
            </li>
            <li class="flex items-center gap-3 px-4 py-3">
              <span class="font-mono text-[11px] text-text-tertiary">[02]</span>
              <a
                href="https://wa.me/56966929818?text=Hola,%20vi%20su%20p%C3%A1gina%20y%20quiero%20una%20cotizaci%C3%B3n"
                target="_blank"
                rel="noopener noreferrer"
                class="truncate font-body text-sm text-text-primary transition-colors hover:text-accent"
              >
                +56 9 6692 9818
              </a>
              <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">
                whatsapp
              </span>
            </li>
            <li class="flex items-center gap-3 px-4 py-3">
              <span class="font-mono text-[11px] text-text-tertiary">[03]</span>
              <span class="truncate font-body text-sm text-text-primary">Puerto Varas · Los Lagos</span>
              <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">
                chile
              </span>
            </li>
          </ul>
          <div class="flex items-center justify-between border-t border-frame px-4 py-2.5 font-mono text-[11px]">
            <span class="text-text-tertiary">respuesta en 24 hrs</span>
            <a href="#formulario" class="text-text-secondary transition-colors hover:text-accent">
              ir al formulario ↓
            </a>
          </div>
        </WebcoreWindow>
      </Fragment>
    </PageHero>

    <!-- Contacto · información + formulario (v2 editorial full-width) -->
    <section id="formulario" class="w-full scroll-mt-20 bg-bg">
      <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <!-- Columna info · canales directos -->
          <div class="reveal-group lg:col-span-5">
            <p class="reveal-item font-mono text-xs uppercase tracking-[0.14em] text-accent">// información</p>

            <ul class="reveal-item mt-8 divide-y divide-frame/60 border-y border-frame/60">
              {CONTACTO.map(({ icon: Icon, label, value, href }, i) => (
                <li class="flex items-center gap-4 py-4">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[4px] border border-frame bg-surface text-text-tertiary">
                    <Icon size={16} stroke-width="1.5" aria-hidden="true" />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-text-tertiary">
                      [{String(i + 1).padStart(2, "0")}] {label}
                    </span>
                    {href ? (
                      <a href={href} class="block truncate font-body text-sm text-text-primary transition-colors hover:text-accent">
                        {value}
                      </a>
                    ) : (
                      <span class="block font-body text-sm text-text-primary">{value}</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>

            <div class="reveal-item mt-8 flex flex-wrap gap-2">
              {TRUST.map((t) => (
                <span class="inline-flex items-center gap-2 rounded-[4px] border border-frame bg-surface px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
                  <Check size={12} stroke-width="2.5" class="text-accent" aria-hidden="true" />
                  {t}
                </span>
              ))}
            </div>
          </div>

          <!-- Columna formulario -->
          <div class="reveal-group lg:col-span-7">
            <p class="reveal-item font-mono text-xs uppercase tracking-[0.14em] text-accent">// cuéntanos de tu proyecto</p>

            <form id="contact-form" class="reveal-item mt-8" novalidate>
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-2 block font-mono text-[11px] uppercase tracking-[0.1em] text-text-tertiary">Nombre</label>
                  <input
                    type="text" id="name" name="name" required
                    class="w-full rounded-[4px] border border-frame bg-surface px-3.5 py-2.5 font-body text-sm text-text-primary outline-none transition-colors placeholder:text-text-tertiary focus:border-accent"
                    placeholder="Tu nombre"
                  />
                </div>
                <div>
                  <label for="email" class="mb-2 block font-mono text-[11px] uppercase tracking-[0.1em] text-text-tertiary">Email</label>
                  <input
                    type="email" id="email" name="email" required
                    class="w-full rounded-[4px] border border-frame bg-surface px-3.5 py-2.5 font-body text-sm text-text-primary outline-none transition-colors placeholder:text-text-tertiary focus:border-accent"
                    placeholder="tu@email.com"
                  />
                </div>
              </div>

              <div class="mt-5">
                <label for="service" class="mb-2 block font-mono text-[11px] uppercase tracking-[0.1em] text-text-tertiary">Servicio de interés</label>
                <div class="relative">
                  <select
                    id="service" name="service" required
                    class="w-full cursor-pointer appearance-none rounded-[4px] border border-frame bg-surface px-3.5 py-2.5 pr-10 font-body text-sm text-text-primary outline-none transition-colors focus:border-accent"
                  >
                    <option value="" class="bg-surface">Selecciona tu servicio</option>
                    <option value="landing" class="bg-surface">Landing Page ($290K-$350K)</option>
                    <option value="web" class="bg-surface">Sitio Web Profesional ($690K-$800K)</option>
                    <option value="seo" class="bg-surface">SEO Mensual ($120K-$250K/mes)</option>
                    <option value="bot" class="bg-surface">Bot WhatsApp ($590K)</option>
                    <option value="pack" class="bg-surface">Pack Digital Completo ($1.1M)</option>
                    <option value="otro" class="bg-surface">Otro / No estoy seguro</option>
                  </select>
                  <ChevronDown size={16} stroke-width="1.5" class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-text-tertiary" aria-hidden="true" />
                </div>
              </div>

              <div class="mt-5">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.1em] text-text-tertiary">Presupuesto estimado</span>
                <div class="flex flex-wrap gap-2">
                  {BUDGETS.map((opt) => (
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-[4px] border border-frame bg-surface px-3.5 py-2 font-mono text-xs text-text-secondary transition-colors hover:border-frame-hover has-[:checked]:border-accent/60 has-[:checked]:bg-accent-subtle has-[:checked]:text-accent">
                      <input type="radio" name="budget" value={opt.value} class="accent-accent" />
                      {opt.label}
                    </label>
                  ))}
                </div>
              </div>

              <div class="mt-5">
                <label for="message" class="mb-2 block font-mono text-[11px] uppercase tracking-[0.1em] text-text-tertiary">Mensaje</label>
                <textarea
                  id="message" name="message" rows={4} required
                  class="w-full resize-none rounded-[4px] border border-frame bg-surface px-3.5 py-2.5 font-body text-sm text-text-primary outline-none transition-colors placeholder:text-text-tertiary focus:border-accent"
                  placeholder="Cuéntanos de tu proyecto..."
                ></textarea>
              </div>

              <div class="mt-6 flex flex-wrap items-center gap-4">
                <button
                  type="submit" id="submit-btn"
                  class="group inline-flex items-center gap-2.5 rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover sm:text-sm"
                >
                  <span id="btn-text">Enviar mensaje</span>
                  <ArrowRight size={16} stroke-width="2" class="transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true" />
                </button>
                <div id="form-status" role="status" aria-live="polite" class="hidden font-mono text-xs"></div>
              </div>

              <p class="mt-5 font-body text-sm text-text-tertiary">
                ¿Prefieres WhatsApp?{" "}
                <a href="https://wa.me/56966929818?text=Hola,%20vi%20su%20p%C3%A1gina%20y%20quiero%20una%20cotizaci%C3%B3n" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-2 transition-colors hover:text-accent-hover">Escríbenos directo →</a>
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <script>
          const form = document.getElementById("contact-form") as HTMLFormElement;
          const status = document.getElementById("form-status")!;
          const btn = document.getElementById("submit-btn") as HTMLButtonElement;
          const btnText = document.getElementById("btn-text")!;

          form.addEventListener("submit", async (e) => {
            e.preventDefault();
            btn.disabled = true;
            btnText.textContent = "Enviando...";
            status.className = "hidden font-mono text-xs";

            try {
              const res = await fetch("/api/contact", {
                method: "POST",
                body: new FormData(form),
              });
              const data = await res.json();

              if (res.ok) {
                if (window.trackEvent) window.trackEvent("contact_submitted");
                status.className = "font-mono text-xs text-accent";
                status.textContent = data.message || "Mensaje enviado correctamente";
                form.reset();
              } else {
                status.className = "font-mono text-xs text-danger";
                status.textContent = data.error || "Error al enviar el mensaje";
              }
            } catch {
              status.className = "font-mono text-xs text-danger";
              status.textContent = "Error de conexión. Intenta nuevamente.";
            }

            btn.disabled = false;
            btnText.textContent = "Enviar Mensaje";
          });
        </script>
  </main>
  <Footer />
</BaseLayout>
