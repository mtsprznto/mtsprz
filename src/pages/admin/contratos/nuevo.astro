    html += clauseText('El presente contrato constituye el acuerdo íntegro entre las partes respecto de su objeto, y reemplaza cualquier acuerdo o entendimiento previo, verbal o escrito, sobre la misma materia. Las partes declaran que no existen ni se considerarán incorporadas otras declaraciones, promesas o garantías distintas de las contenidas en este instrumento.');
    html += clauseItem('a', 'Modificación: Cualquier modificación del presente contrato requerirá acuerdo por escrito entre las partes.');
    html += clauseItem('b', 'Prevalencia: En caso de conflicto entre el cuerpo principal del contrato y el Anexo A, prevalecer\u00e1n las disposiciones del presente cuerpo principal, salvo respecto de la definici\u00f3n de d\u00edas h\u00e1biles, la descripci\u00f3n de la l\u00ednea base y la clasificaci\u00f3n de tareas contenidas en el Anexo A, que prevalecer\u00e1n en todo caso.');

    // ── 20. CESIÓN (VIGÉSIMA) · recíproca ──
    html += clauseTitle(19, 'CESIÓN DE POSICIÓN CONTRACTUAL');
    html += clauseText('Ninguna de las partes podrá ceder ni transferir su posición contractual ni las obligaciones derivadas del presente contrato sin el consentimiento previo, expreso y por escrito de la otra parte.');
    html += clauseItem('a', 'La cesión no libera al cedente de sus obligaciones contractuales, salvo pacto expreso en contrario.');
    html += clauseItem('b', 'Cualquier cesión no autorizada será nula y no producirá efecto alguno entre las partes.');

    // ── 21. DIVISIBILIDAD (VIGÉSIMA PRIMERA) ──
    html += clauseTitle(20, 'DIVISIBILIDAD');
    html += clauseText('Si cualquiera de las cláusulas del presente contrato fuere declarada nula, ilegal o inexigible por autoridad administrativa o judicial competente, dicha declaración no afectará la validez ni exigibilidad de las restantes cláusulas, las que subsistirán en pleno vigor y efecto. La cláusula afectada se tendrá por no escrita, y las partes se obligan a negociar de buena fe una cláusula sustitutoria que refleje la intención original de la cláusula invalidada.');

    // ── 22. FIRMAS (VIGÉSIMA SEGUNDA) ──
    html += '<div style="margin-top:24px;padding-top:16px;border-top:2px solid #e5e7eb;">';
    html += '<h3 style="font-size:13px;font-weight:700;color:#4f46e5;margin:0 0 12px;">VIG\u00C9SIMA SEGUNDA. · FIRMAS</h3>';
    html += '<p style="font-size:10px;color:#6b7280;margin:0 0 14px;font-style:italic;">"Las partes firman en señal de aprobación, aceptando todas y cada una de las cláusulas del presente contrato."</p>';
    html += '<div style="display:flex;justify-content:space-between;gap:20px;">';
    html += '<div style="flex:1;text-align:center;"><div style="height:50px;border-bottom:1px solid #9ca3af;margin-bottom:4px;"></div><p style="font-size:10px;color:#6b7280;margin:0;">Mtsprz · Soluciones Digitales</p><p style="font-size:9px;color:#9ca3af;margin:2px 0 0;">PRESTADOR</p></div>';
    html += '<div style="flex:1;text-align:center;"><div style="height:50px;border-bottom:1px solid #9ca3af;margin-bottom:4px;"></div><p style="font-size:10px;color:#6b7280;margin:0;">' + clientName + '</p><p style="font-size:9px;color:#9ca3af;margin:2px 0 0;">CLIENTE</p></div>';
    html += '</div></div>';

    // ── ANEXO A: ENTREGABLES Y PLAZOS (después de firmas) ──
    html += '<div style="margin-top:20px;padding-top:16px;border-top:2px solid #e5e7eb;">';
    html += '<h3 style="font-size:13px;font-weight:700;color:#111827;margin:0 0 8px;">ANEXO A · ENTREGABLES Y PLAZOS</h3>';
    html += clauseText('El presente anexo forma parte integrante del contrato y detalla los entregables, plazos y condiciones espec\u00edficas del servicio contratado.');
    html += clauseText('Para efectos del presente contrato, se entender\u00e1 por "d\u00edas h\u00e1biles" los d\u00edas lunes a viernes, excluidos los festivos en Chile.');
    if (isBlastUp) {
      html += clauseBold('Calendario del per\u00edodo: ', 'El per\u00edodo de ejecuci\u00f3n \u00fanico es de <strong>31 d\u00edas corridos</strong>, contados desde la fecha de acreditaci\u00f3n del pago. Semana 1 (d\u00edas 1-7), Semana 2 (d\u00edas 8-14), Semana 3 (d\u00edas 15-21), Semana 4 (d\u00edas 22-28), Cierre (d\u00edas 29-31).');
      html += clauseBold('Tope de horas del per\u00edodo: ', 'El honorario cubre hasta <strong>' + hourCap + ' horas</strong> de trabajo efectivo durante todo el per\u00edodo. Las horas no consumidas no son acumulables ni reembolsables. El Prestador pondr\u00e1 a disposici\u00f3n un registro del tiempo invertido, actualizado al menos semanalmente.');
      html += clauseBold('L\u00ednea base: ', 'La l\u00ednea base del servicio la constituyen los activos digitales preexistentes del Cliente (repositorios, base de datos, infraestructura, dominio), respecto de los cuales las partes declaran conocer su estado actual. El Prestador no garantiza la calidad, seguridad ni disponibilidad del c\u00f3digo o infraestructura preexistentes.');
      html += clauseBold('Naturaleza del servicio (obligaci\u00f3n de medios): ', 'El Prestador se obliga a desplegar los mejores esfuerzos t\u00e9cnicos y profesionales para ejecutar las tareas encomendadas, sin que ello implique una obligaci\u00f3n de resultados respecto de la completitud, correcci\u00f3n o desempe\u00f1o de la aplicaci\u00f3n como un todo.');
      html += clauseBold('V\u00eda de ingreso de requerimientos: ', 'El Cliente ingresa sus requerimientos a trav\u00e9s de la plataforma Notion. Cada requerimiento debe incluir una descripci\u00f3n suficiente y, cuando corresponda, criterios de aceptaci\u00f3n espec\u00edficos.');
    }
    for (var ai = 0; ai < svcs.length; ai++) {
      var asvc = svcs[ai];
      var monthlyTag = (asvc.is_monthly && !isBlastUp) ? ' <span style="color:#6b7280;font-weight:400;font-size:10px;">(mensual)</span>' : '';
      html += '<h4 style="font-size:12px;font-weight:600;color:#4f46e5;margin:12px 0 6px;">' + (ai + 1) + '. ' + asvc.name + monthlyTag + '</h4>';
      var plazoInicio = startDate || 'la fecha de inicio';
      var plazoFin = endDate || 'la fecha de término';
      if (asvc.is_monthly && !isBlastUp) {
        html += clauseBold('Modalidad: ', 'Servicio recurrente mensual. El valor de $' + (asvc.price || 0).toLocaleString('es-CL') + ' corresponde a cada mes de servicio. Se factura y paga mensualmente por adelantado.');
      } else if (asvc.is_monthly && isBlastUp) {
        html += clauseBold('Modalidad: ', 'Incluido en honorario fijo del per\u00edodo \u00fanico de 31 d\u00edas corridos desde la acreditaci\u00f3n del pago, por $' + blastNet.toLocaleString('es-CL') + ' l\u00edquidos. No existe renovaci\u00f3n autom\u00e1tica.');
      } else if (isBlastUp) {
        html += clauseBold('Plazo de ejecución: ', 'Per\u00edodo \u00fanico de 31 d\u00edas corridos desde la acreditaci\u00f3n del pago. Las partes acuerdan definir los hitos espec\u00edficos y sus fechas de entrega mediante comunicaci\u00f3n escrita dentro de los 3 d\u00edas h\u00e1biles siguientes a la fecha de acreditaci\u00f3n del pago.');
      } else {
        html += clauseBold('Plazo de ejecución: ', 'Fecha de inicio: ' + plazoInicio + ' · Fecha de término estimada: ' + plazoFin + '. Las partes acuerdan definir los hitos específicos y sus fechas de entrega mediante comunicación escrita dentro de los 5 días hábiles siguientes a la firma del contrato, los que se entenderán incorporados al presente Anexo A. La falta de definición en dicho plazo habilitará al Prestador para gestionar los entregables en el orden y tiempos que estime convenientes, dentro del plazo total.');
      }
      if (asvc.deliverables && asvc.deliverables.length > 0) {
        html += '<strong style="font-size:11px;color:#111827;">Entregables:</strong>';
        html += '<ul style="margin:4px 0 8px;padding-left:20px;font-size:11px;color:#374151;line-height:1.6;">';
        for (var di = 0; di < asvc.deliverables.length; di++) {
          var dl = asvc.deliverables[di];
          if (isBlastUp) dl = dl.replace(/\b1 ronda\b/g, revisionRounds + ' rondas');
          html += '<li>' + dl + '</li>';
        }
        html += '</ul>';
      } else {
        html += '<p style="font-size:11px;color:#9ca3af;font-style:italic;margin:2px 0 8px;">Entregables y especificaciones por definir entre las partes. Se entenderán incorporados al presente anexo una vez acordados por escrito.</p>';
      }
      if (isBlastUp) {
        html += '<p style="font-size:10px;color:#6b7280;margin:0 0 4px;"><strong>Criterio de aceptaci\u00f3n:</strong> La aceptaci\u00f3n de los entregables determina el inicio del per\u00edodo de garant\u00eda (' + warrantyDays + ' d\u00edas) durante el cual el Prestador corregir\u00e1 defectos de implementaci\u00f3n, con hasta ' + revisionRounds + ' ronda(s) de correcciones por avance. Dicha aceptaci\u00f3n no condiciona ni suspende la obligaci\u00f3n de pago del per\u00edodo, conforme a la cl\u00e1usula S\u00c9PTIMA.</p>';
        html += '<p style="font-size:10px;color:#6b7280;margin:0 0 4px;"><strong>Clasificaci\u00f3n de tareas:</strong> Correctivo (fallas que impiden operaci\u00f3n normal · prioridad m\u00e1xima) | Evolutivo (mejoras y nuevas funcionalidades contra tope de horas) | Excluido (cambios de arquitectura, integraciones no previstas, tareas que excedan horas disponibles del per\u00edodo). Las horas dedicadas a tareas correctivas consumen el tope de horas del per\u00edodo.</p>';
        html += '<p style="font-size:10px;color:#6b7280;margin:0 0 4px;"><strong>Disponibilidad:</strong> El Prestador organiza libremente su tiempo. Se compromete a acusar recibo de las comunicaciones del Cliente dentro de un plazo m\u00e1ximo de 8 horas h\u00e1biles y, trat\u00e1ndose de incidentes correctivos calificados como cr\u00edticos, a iniciar su atenci\u00f3n dentro de 8 horas h\u00e1biles. Las horas dedicadas a incidentes correctivos consumen el tope de horas del per\u00edodo.</p>';
      } else {
        html += '<p style="font-size:10px;color:#6b7280;margin:0 0 4px;"><strong>Criterio de aceptación:</strong> Cada entregable se considerará recibido conforme tras su revisión y aprobación por escrito del Cliente, o transcurrido el plazo de revisión sin observaciones (aprobación tácita).</p>';
      }
      if (!isBlastUp && asvc.deliverables && asvc.deliverables.some(function(d) { return d.toLowerCase().indexOf('hosting') !== -1 || d.toLowerCase().indexOf('cdn') !== -1; })) {
        html += '<p style="font-size:10px;color:#6b7280;margin:0 0 4px;"><strong>Nota sobre hosting:</strong> El servicio incluye alojamiento web con SSL y CDN por el período indicado en los entregables. Dicho período se contará desde la puesta en producción del sitio (una vez recibido el pago total). Transcurrido el período incluido, la renovación será por cuenta del Cliente. El Prestador no será responsable por caídas imputables al proveedor de infraestructura. El Cliente podrá solicitar migración a un proveedor de su elección. La titularidad del contenido alojado corresponde al Cliente desde el pago total de los honorarios.</p>';
      }
    }
    html += clauseText('Las partes declaran conocer y aceptar el contenido del presente Anexo A, que forma parte integrante del contrato para todos los efectos legales.');
    html += '</div>';

    // ── CLAUSULAS ESPECIALES (después de Anexo A) ──
    if (specialClauses) {
      html += '<div style="margin-top:20px;padding-top:16px;border-top:2px solid #e5e7eb;">';
      html += '<h3 style="font-size:13px;font-weight:700;color:#111827;margin:0 0 8px;">CL\u00C1USULAS ESPECIALES ADICIONALES</h3>';
      html += '<p style="font-size:11px;color:#374151;margin:0;line-height:1.6;white-space:pre-wrap;">' + specialClauses + '</p>';
      html += '</div>';
    }

    document.getElementById("previewDocument").innerHTML = html;
  }

  function openPreview() {
    renderContractPreview();
    document.getElementById("previewModal").classList.remove("hidden");
    document.getElementById("previewModal").classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closePreview() {
    document.getElementById("previewModal").classList.add("hidden");
    document.getElementById("previewModal").classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.getElementById("previewBtn").addEventListener("click", openPreview);
  document.getElementById("previewSubmitBtn").addEventListener("click", function() {
    closePreview();
    document.getElementById("submitBtn").click();
  });

  document.getElementById("contractForm").addEventListener("submit", async function(e) {
    e.preventDefault();
    var form = this;
    var formData = new FormData(form);
    var btn = document.getElementById("submitBtn");

    // Validar teléfono chileno: +56 9 + 8 dígitos
    var phone = (formData.get("client_phone") || "").replace(/[\s\-\(\)]/g, "");
    if (phone && !/^\+569\d{8}$/.test(phone)) {
      alert("El teléfono debe tener formato chileno: +56 9 seguido de 8 dígitos (ej: +56 9 7547 5781). Actual: " + (formData.get("client_phone") || "(vacío)"));
      return;
    }
    // Validar dirección: debe incluir comuna/ciudad
    var addr = (formData.get("client_address") || "").trim();
    if (addr && !/,\s*\S+\s*,/.test(addr)) {
      alert("La dirección debe incluir comuna, ciudad y región (ej: Av. Bosques de Montemar 30, Concón, Región de Valparaíso)");
      return;
    }

    btn.disabled = true;
    btn.innerHTML = '<svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Creando...';

    var services = getServices();
    var total = services.reduce(function(sum, s) { return sum + s.price; }, 0);

    // Find the active template_id (only the selected card has a non-empty value)
    var tplId = null;
    document.querySelectorAll("input[name='template_id']").forEach(function(inp) {
      if (inp.value) tplId = parseInt(inp.value);
    });
    var selectedType = document.querySelector("input[name='templateType']:checked")?.value || "";
    var isHonorarios = selectedType === "boleta_honorarios";
    var isBlastUp = /blast[-\s]?up/i.test(formData.get("client_name"));
    var netAmount = isHonorarios ? parseInt(formData.get("net_amount")) || 450000 : undefined;
    var retentionRate = isHonorarios ? parseFloat(formData.get("retention_rate")) || 15.25 : undefined;
    var grossAmount = isHonorarios ? parseInt(formData.get("gross_amount")) || Math.round(netAmount / (1 - retentionRate / 100)) : undefined;

    var body = {
      template_id: tplId,
      template_type: selectedType || undefined,
      client_name: formData.get("client_name"),
      client_rut: formData.get("client_rut"),
      client_nationality: (isHonorarios && !isBlastUp) ? undefined : (formData.get("client_nationality") || "Chilena"),
      client_profession: (isHonorarios && !isBlastUp) ? undefined : formData.get("client_profession"),
      client_email: formData.get("client_email"),
      client_phone: formData.get("client_phone"),
      client_address: formData.get("client_address"),
      prestador_rut: formData.get("prestador_rut") || undefined,
      prestador_nombre_civil: formData.get("prestador_nombre_civil") || undefined,
      client_representante: formData.get("client_representante") || undefined,
      client_notif_email: formData.get("client_notif_email") || undefined,
      services: (isHonorarios && !isBlastUp) ? [] : services,
      total_amount: isHonorarios ? netAmount : (parseInt(formData.get("total_amount")) || total),
      net_amount: netAmount,
      retention_rate: retentionRate,
      gross_amount: grossAmount,
      payment_method: isHonorarios ? "contado" : formData.get("payment_method"),
      payment_terms: (isHonorarios && !isBlastUp) ? undefined : formData.get("payment_terms"),
      warranty_days: (isHonorarios && !isBlastUp) ? undefined : (parseInt(formData.get("warranty_days")) || 15),
      revision_days: (isHonorarios && !isBlastUp) ? undefined : (parseInt(formData.get("revision_days")) || 5),
      subcontracting_allowed: (isHonorarios && !isBlastUp) ? undefined : formData.get("subcontracting_allowed") === "on",
      start_date: formData.get("start_date"),
      end_date: formData.get("end_date"),
      duration_months: (isHonorarios && !isBlastUp) ? 1 : (parseInt(formData.get("duration_months")) || 1),
      schedule: (isHonorarios && !isBlastUp) ? undefined : formData.get("schedule"),
      special_clauses: (isHonorarios && !isBlastUp) ? undefined : formData.get("special_clauses"),
      hour_cap: formData.get("hour_cap") ? parseInt(formData.get("hour_cap")) : undefined,
      extra_hour_rate: formData.get("extra_hour_rate") ? parseInt(formData.get("extra_hour_rate")) : undefined,
      client_tech_name: formData.get("client_tech_name") || undefined,
      client_tech_email: formData.get("client_tech_email") || undefined,
      revision_rounds: formData.get("revision_rounds") ? parseInt(formData.get("revision_rounds")) : undefined,
      include_pagare: formData.get("include_pagare") === "on",
      signing_date: formData.get("signing_date") || undefined,
    };

    try {
      var res = await fetch("/api/contracts", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      // Si la respuesta no es 2xx, intentamos leer el error
      if (!res.ok) {
        try {
          var errorData = await res.json();
          alert("Error: " + (errorData.error || "No se pudo crear el contrato"));
        } catch (_jsonErr) {
          alert("Error del servidor (" + res.status + "). Intenta de nuevo.");
        }
        btn.disabled = false;
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Crear y Enviar Contrato';
        return;
      }

      // Respuesta exitosa: intentamos leer el body JSON
      var data;
      try {
        data = await res.json();
      } catch (_jsonErr) {
        data = null;
      }

      // Save client as recurring if checkbox is checked
      if (document.getElementById("saveClient").checked) {
        var clientData = {
          name: formData.get("client_name"),
          company_name: formData.get("client_company") || formData.get("client_name"),
          rut: formData.get("client_rut"),
          email: formData.get("client_email"),
          phone: formData.get("client_phone"),
          address: formData.get("client_address"),
          nationality: formData.get("client_nationality") || "Chilena",
          profession: formData.get("client_profession"),
          notif_email: formData.get("client_notif_email") || null,
          representante: formData.get("client_representante") || null,
        };
        // Await save before redirect · evita que navegación aborte el fetch
        try {
          await fetch("/api/clients", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(clientData),
          });
        } catch (_clientErr) {
          // No bloqueamos redirect si falla el save del cliente
          console.warn("[Client Save] falló:", _clientErr);
        }
      }

      if (data && data.contract && data.contract.id) {
        window.location.href = "/admin/contratos/" + data.contract.id;
      } else {
        window.location.href = "/admin/contratos";
      }
    } catch (_e) {
      alert("Error de conexión: no se pudo enviar la solicitud. Verifica tu conexión a internet.");
      btn.disabled = false;
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Crear y Enviar Contrato';
    }
  });
</script>