---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/ui/PageHero.astro";
import WebcoreWindow from "../components/ui/WebcoreWindow.astro";
import Footer from "../components/Footer.astro";
import CiudadesRelacionadas from "../components/CiudadesRelacionadas.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola! Vi la página de automatización y quiero saber cómo puedo automatizar procesos en mi negocio.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";
const VIDEO_HERO = "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4";
---

<BaseLayout
  title="Automatización WhatsApp, CRM y Dashboards para Pymes | Los Lagos"
  description="Automatizamos tu pyme: bots WhatsApp 24/7, email marketing, integraciones CRM y dashboards de datos. Ahorra 10+ horas semanales. Puerto Varas, Osorno, Valdivia."
  image="/og/automatizacion.png"
  canonical="https://mtsprz.org/automatizacion"
  breadcrumbs={[{ name: "Automatización", path: "/automatizacion" }]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site}/automatizacion#service`,
    "name": "Automatización de Procesos con IA y n8n · Mtsprz",
    "description": "Bots de WhatsApp 24/7, automatización de Excel, flujos de email marketing, integraciones CRM, dashboards de datos en tiempo real y workflows con n8n para pymes en la Región de Los Lagos. Ahorra 10+ horas semanales.",
    "provider": { "@id": `${site}/#organization` },
    "category": "Transformación Digital / Automatización con IA",
    "serviceType": "Automatización de Procesos e Integración con IA",
    "audience": {
      "@type": "BusinessAudience",
      "audienceType": "Pequeñas y medianas empresas (pymes) que buscan eficiencia operativa en el sur de Chile"
    },
    "areaServed": [
      { "@type": "City", "@id": `${site}/#city-puerto-varas`, "name": "Puerto Varas" },
      { "@type": "City", "@id": `${site}/#city-osorno`, "name": "Osorno" },
      { "@type": "City", "@id": `${site}/#city-valdivia`, "name": "Valdivia" },
      { "@type": "City", "@id": `${site}/#city-puerto-montt`, "name": "Puerto Montt" }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Soluciones de Automatización",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Bot WhatsApp 24/7 con IA" }, "price": "590000", "priceCurrency": "CLP", "description": "Chatbot inteligente para WhatsApp Business API. Atiende clientes 24/7: cotizaciones, agendamiento, FAQ. Integración con Google Sheets. Responde en segundos. Implementación en 5-7 días. Pago único; mantenimiento mensual opcional $69.000/mes." },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Automatización de Reportes y CRM" }, "price": "490000", "priceCurrency": "CLP", "description": "Reportes Excel automatizados + integración CRM (HubSpot/Salesforce) + email marketing secuencial + webhooks. Workflows n8n personalizados. Elimina tareas manuales repetitivas. Implementación en 2-3 semanas." },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Workflow Completo + Dashboard Tiempo Real" }, "price": "690000", "priceCurrency": "CLP", "description": "Automatización integral: bot WhatsApp + CRM + email marketing + dashboard en tiempo real (Metabase) + webhooks + Backup automático. Flujos orquestados con n8n, datos actualizados al segundo, alertas inteligentes. 4-8 semanas." }
      ]
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "CLP",
      "lowPrice": 490000,
      "highPrice": 690000,
      "offerCount": 3,
      "availability": "https://schema.org/InStock"
    },
    "termsOfService": `${site}/politica-de-cookies`,
    "mainEntityOfPage": { "@type": "WebPage", "@id": `${site}/automatizacion` }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué procesos puedo automatizar en mi pyme?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Automatizamos Excel (reportes que se generan solos), WhatsApp (bots que atienden 24/7), email marketing (secuencias que nutren clientes), integración de CRM (datos que fluyen entre sistemas) y workflows completos con n8n."
        }
      },
      {
        "@type": "Question",
        "name": "¿Necesito conocimientos técnicos?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Nosotros configuramos todo. Tú solo usas las herramientas: tu bot de WhatsApp, tu dashboard, tus reportes automáticos. Incluimos capacitación básica."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto cuesta un bot de WhatsApp?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Desde $590.000 pago único para un bot con respuestas automáticas, menú interactivo y atención 24/7 con IA. Incluye hosting y soporte; mantenimiento mensual opcional $69.000/mes. Planes con integración CRM y dashboard desde $690.000."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto tiempo toma implementar una automatización?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Un bot de WhatsApp básico está listo en 3-5 días. Una automatización completa con CRM + dashboard toma 2-3 semanas."
        }
      },
      {
        "@type": "Question",
        "name": "¿Funciona con mi sistema actual?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Nos adaptamos a tus herramientas: Excel, Google Sheets, Salesforce, HubSpot, Mercado Pago, Transbank, y cualquier sistema con API o acceso a datos."
        }
      },
      {
        "@type": "Question",
        "name": "¿Puedo automatizar documentos como comprobantes o facturas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Con OCR + RAG + LLM transcribimos y procesamos comprobantes, facturas y contratos automáticamente. Caso real: un contador de Puerto Varas procesa 200 comprobantes al día sin digitarlos. Desde $1.900.000."
        }
      }
    ]
  })} />

  <Header />
  <link rel="preload" as="video" href={VIDEO_HERO} fetchpriority="high" />

  <main id="main-content" class="overflow-x-clip">

    <!-- ═══════════════════════════════════════════
         HERO · primitiva ui/PageHero (video §5.4 + aside automatizar --flujos)
    ═══════════════════════════════════════════ -->
    <PageHero
      ledLabel="bots activos · 24/7"
      eyebrow="// automatización · bots, datos y flujos"
      title="Automatiza"
      titleAccent="tu negocio."
      subtitle="Bots WhatsApp, dashboards, CRM e integraciones que recuperan horas de trabajo cada semana."
      videoUrl={VIDEO_HERO}
      breadcrumbs={[{ name: "Automatización", path: "/automatizacion" }]}
      meta="puerto varas · osorno · valdivia"
    >
      <Fragment slot="actions">
        <a
          href="/cotizar"
          class="inline-flex items-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover sm:text-sm"
          >[ Cotizar online ]</a
        >
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-wider text-text-primary transition-colors hover:border-accent hover:text-accent sm:text-sm"
          >[ Consultar ahora ]</a
        >
      </Fragment>

      <Fragment slot="aside">
        <WebcoreWindow title="automatizar --flujos" variant="sunken">
          <ul class="divide-y divide-frame">
            <li class="flex items-center gap-3 px-4 py-3">
              <span class="font-mono text-[11px] text-text-tertiary">[01]</span>
              <span class="truncate font-body text-sm text-text-primary">Bot WhatsApp con IA</span>
              <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">24/7</span>
            </li>
            <li class="flex items-center gap-3 px-4 py-3">
              <span class="font-mono text-[11px] text-text-tertiary">[02]</span>
              <span class="truncate font-body text-sm text-text-primary">Reportes Excel automáticos</span>
              <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">diario</span>
            </li>
            <li class="flex items-center gap-3 px-4 py-3">
              <span class="font-mono text-[11px] text-text-tertiary">[03]</span>
              <span class="truncate font-body text-sm text-text-primary">Emails que venden</span>
              <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">crm</span>
            </li>
            <li class="flex items-center gap-3 px-4 py-3">
              <span class="font-mono text-[11px] text-text-tertiary">[04]</span>
              <span class="truncate font-body text-sm text-text-primary">Datos en tiempo real</span>
              <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">kpis</span>
            </li>
          </ul>
          <div class="flex items-center justify-between border-t border-frame px-4 py-2.5 font-mono text-[11px]">
            <span class="text-text-tertiary">ahorra 10+ hrs/semana</span>
            <a href="#soluciones" class="text-text-secondary transition-colors hover:text-accent">
              ver soluciones ↓
            </a>
          </div>
        </WebcoreWindow>
      </Fragment>
    </PageHero>


    <!-- ═══════════════════════════════════════════
         ANSWER BLOCK · respuesta directa 40-60 palabras (GEO N1)
         Misma página, dos audiencias: humano + asistente IA
    ═══════════════════════════════════════════ -->
    <section class="relative w-full bg-bg">
      <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
        <div class="reveal-group grid gap-6 lg:grid-cols-12 lg:gap-12">
          <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent lg:col-span-3">
            // respuesta directa · automatización con IA
          </p>

          <div class="lg:col-span-9">
            <!-- Lead -->
            <p class="reveal-item max-w-3xl font-heading text-2xl font-bold leading-[1.3] tracking-[-0.02em] text-text-primary md:text-3xl">
              Automatizar procesos con IA en una pyme es conectar tus herramientas para
              eliminar tareas manuales repetitivas.
            </p>

            <!-- Capacidades -->
            <div class="reveal-item mt-8 grid gap-x-10 gap-y-5 sm:grid-cols-3">
              <div class="flex items-baseline gap-3">
                <span class="shrink-0 font-mono text-[11px] leading-none text-text-tertiary" aria-hidden="true">[01]</span>
                <p class="font-body text-sm font-light leading-relaxed text-text-secondary">
                  Bots de WhatsApp que atienden 24/7
                </p>
              </div>
              <div class="flex items-baseline gap-3">
                <span class="shrink-0 font-mono text-[11px] leading-none text-text-tertiary" aria-hidden="true">[02]</span>
                <p class="font-body text-sm font-light leading-relaxed text-text-secondary">
                  Reportes que se generan solos
                </p>
              </div>
              <div class="flex items-baseline gap-3">
                <span class="shrink-0 font-mono text-[11px] leading-none text-text-tertiary" aria-hidden="true">[03]</span>
                <p class="font-body text-sm font-light leading-relaxed text-text-secondary">
                  Flujos que integran Excel, CRM y email
                </p>
              </div>
            </div>

            <!-- Precio + CTA -->
            <div class="reveal-item mt-10 border-t border-frame/60 pt-6">
              <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                <div>
                  <p class="font-body text-sm text-text-secondary md:text-base">
                    En Mtsprz lo hacemos desde{' '}
                    <span class="font-heading font-bold text-accent">$590.000</span>{' '}
                    pago único · mantenimiento mensual opcional desde{' '}
                    <span class="font-heading font-bold text-accent">$69.000</span>
                  </p>
                  <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.14em] text-text-tertiary">
                    resultados en días · sin conocimientos técnicos
                  </p>
                </div>
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-fit shrink-0 items-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover sm:text-sm"
                  >[ Quiero mi diagnóstico ]</a
                >
              </div>
              <p class="mt-5 font-mono text-[11px] tracking-[0.08em] text-text-tertiary">
                Caso real: contador de Puerto Varas · 200 comprobantes al día sin digitar
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════
         SOLUCIONES · filas cinematográficas 55/45 · 45/55 (v2)
    ═══════════════════════════════════════════ -->
    <section id="soluciones" class="relative w-full scroll-mt-20 bg-bg">
      <!-- Fila 1 -->
      <div class="flex flex-col border-t border-frame md:flex-row">

        <!-- BOT WHATSAPP · dominante 55% -->
        <div class="relative flex min-h-[20rem] flex-col justify-end bg-surface transition-colors hover:bg-surface-hover sm:min-h-[24rem] md:min-h-[30rem] md:w-[55%]">
          <div class="reveal-group relative z-10 p-6 sm:p-10">
            <p class="reveal-item font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-text-tertiary">
              <span class="font-bold text-accent">[01]</span> · bot whatsapp
            </p>
            <h2 class="reveal-item mt-4 font-heading text-3xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl">
              Atención 24/7
            </h2>
            <p class="reveal-item mt-4 max-w-sm font-body text-sm font-light leading-relaxed text-text-secondary">
              Responde consultas, agenda citas, muestra catálogo y califica leads automáticamente. Funciona mientras duermes.
            </p>
            <div class="reveal-item mt-7 flex flex-wrap items-center gap-3">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-[4px] border border-frame bg-surface px-3.5 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary transition-colors hover:border-frame-hover hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
              >
                [ Consultar ]
              </a>
              <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-tertiary">80% consultas automáticas</span>
            </div>
          </div>
        </div>

        <!-- EXCEL & REPORTES · 45% -->
        <div class="relative flex min-h-[20rem] flex-col justify-end border-t border-frame bg-surface-sunken transition-colors hover:bg-surface sm:min-h-[24rem] md:min-h-[30rem] md:w-[45%] md:border-l md:border-t-0">
          <div class="reveal-group relative z-10 p-6 sm:p-10">
            <p class="reveal-item font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-text-tertiary">
              <span class="font-bold text-accent">[02]</span> · excel & reportes
            </p>
            <h2 class="reveal-item mt-4 font-heading text-2xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-3xl md:text-4xl">
              Reportes automáticos
            </h2>
            <p class="reveal-item mt-4 max-w-sm font-body text-sm font-light leading-relaxed text-text-secondary">
              Ventas diarias, inventario, comisiones. Tu Excel conectado a tu base de datos, actualizado en tiempo real.
            </p>
            <div class="reveal-item mt-7">
              <span class="inline-flex items-center rounded-[4px] border border-frame bg-surface px-3.5 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">10+ HRS/SEMANA</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Fila 2 -->
      <div class="flex flex-col border-t border-frame md:flex-row">

        <!-- EMAIL MARKETING · 45% -->
        <div class="relative flex min-h-[20rem] flex-col justify-end bg-surface-sunken transition-colors hover:bg-surface sm:min-h-[24rem] md:min-h-[30rem] md:w-[45%]">
          <div class="reveal-group relative z-10 p-6 sm:p-10">
            <p class="reveal-item font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-text-tertiary">
              <span class="font-bold text-accent">[03]</span> · email marketing
            </p>
            <h2 class="reveal-item mt-4 font-heading text-2xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-3xl md:text-4xl">
              Emails que venden
            </h2>
            <p class="reveal-item mt-4 max-w-sm font-body text-sm font-light leading-relaxed text-text-secondary">
              Secuencias de bienvenida, seguimiento, recuperación de carritos. Conectado a tu CRM.
            </p>
            <div class="reveal-item mt-7">
              <span class="inline-flex items-center rounded-[4px] border border-frame bg-surface px-3.5 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">3X MÁS APERTURA</span>
            </div>
          </div>
        </div>

        <!-- DASHBOARD · dominante 55% -->
        <div class="relative flex min-h-[20rem] flex-col justify-end border-t border-frame bg-surface transition-colors hover:bg-surface-hover sm:min-h-[24rem] md:min-h-[30rem] md:w-[55%] md:border-l md:border-t-0">
          <div class="reveal-group relative z-10 p-6 sm:p-10">
            <p class="reveal-item font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-text-tertiary">
              <span class="font-bold text-accent">[04]</span> · dashboard de datos
            </p>
            <h2 class="reveal-item mt-4 font-heading text-3xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl">
              Datos en tiempo real
            </h2>
            <p class="reveal-item mt-4 max-w-sm font-body text-sm font-light leading-relaxed text-text-secondary">
              Ventas, clientes, inventario. Visualiza tus KPIs desde cualquier dispositivo. Decisiones basadas en datos, no en intuición.
            </p>
            <div class="reveal-item mt-7 flex flex-wrap items-center gap-3">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-[4px] border border-frame bg-surface px-3.5 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary transition-colors hover:border-frame-hover hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
              >
                [ Consultar ]
              </a>
              <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-text-tertiary">Dashboard en 7 días</span>
            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════
         PLANES · líneas editoriales (v2)
    ═══════════════════════════════════════════ -->
    <section id="planes" class="relative w-full scroll-mt-20 border-t border-frame bg-bg">
      <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">

        <div class="reveal-group mb-12 md:mb-16">
          <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">// precios</p>
          <h2 class="reveal-item mt-4 max-w-3xl font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl">
            Planes de automatización
          </h2>
        </div>

        <div class="reveal-group border-t border-frame/60">
          {[
            {
              num: "01",
              price: "$290k",
              note: "Pago único",
              name: "Bot WhatsApp",
              badge: "",
              features: ["Respuestas automáticas", "Menú interactivo", "Horario configurable", "Estadísticas básicas", "Instalación en 3 días"],
              rowClass: "grid gap-x-8 gap-y-6 border-b border-frame/60 py-10 md:py-12 lg:grid-cols-12 lg:items-start",
              ctaClass: "inline-flex items-center justify-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60",
            },
            {
              num: "02",
              price: "$690k",
              note: "Desde / pago único",
              name: "Automatización Completa",
              badge: " · popular",
              features: ["Bot WhatsApp avanzado", "Integración CRM", "Dashboard de datos", "Email marketing", "Flujos n8n", "Reportes automáticos"],
              rowClass: "grid gap-x-8 gap-y-6 border-b border-frame/60 border-l-2 border-l-accent bg-surface/40 py-10 pl-5 sm:pl-6 md:py-12 lg:grid-cols-12 lg:items-start",
              ctaClass: "inline-flex items-center justify-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60",
            },
            {
              num: "03",
              price: "$490k",
              note: "Desde / pago único",
              name: "Dashboard + IA",
              badge: "",
              features: ["Dashboard interactivo", "Datos en tiempo real", "Conexión Excel/API", "Gráficos editables", "Acceso multi-dispositivo", "Soporte 30 días"],
              rowClass: "grid gap-x-8 gap-y-6 border-b border-frame/60 py-10 md:py-12 lg:grid-cols-12 lg:items-start",
              ctaClass: "inline-flex items-center justify-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60",
            },
          ].map((p) => (
            <div class={p.rowClass}>
              <div class="lg:col-span-3">
                <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-text-tertiary">
                  <span class="font-bold text-accent">[{p.num}]</span>{p.badge}
                </p>
                <p class="mt-3 font-heading text-4xl font-bold leading-none tracking-[-0.02em] text-text-primary md:text-5xl">
                  {p.price}
                </p>
                <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-tertiary">{p.note}</p>
              </div>
              <div class="lg:col-span-6">
                <h3 class="font-heading text-lg font-bold tracking-[-0.02em] text-text-primary md:text-xl">{p.name}</h3>
                <div class="mt-4 grid max-w-xl grid-cols-1 gap-x-10 gap-y-2.5 sm:grid-cols-2">
                  {p.features.map((f) => (
                    <span class="inline-flex items-center gap-2 font-body text-sm font-light text-text-secondary">
                      <svg class="h-3.5 w-3.5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      {f}
                    </span>
                  ))}
                </div>
              </div>
              <div class="flex lg:col-span-3 lg:justify-end">
                <a href={waUrl} target="_blank" rel="noopener noreferrer" class={p.ctaClass}>
                  [ Lo quiero ]
                </a>
              </div>
            </div>
          ))}
        </div>

        <p class="reveal-item mt-10 font-body text-sm font-light text-text-tertiary">
          ¿Necesitas algo distinto?{' '}
          <a href="/contacto" class="text-text-secondary underline underline-offset-4 transition-colors hover:text-accent">Cuéntanos tu caso →</a>
        </p>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════
         FAQ · accordion editorial (v2, criterio /servicios)
    ═══════════════════════════════════════════ -->
    <section id="faq" class="relative w-full scroll-mt-16 bg-bg">
      <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">

        <div class="reveal-group mb-12 md:mb-16">
          <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
            // preguntas frecuentes
          </p>
          <h2 class="reveal-item mt-4 max-w-3xl font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl">
            Lo que nos preguntan
          </h2>
        </div>

        <div class="reveal-group border-t border-frame/60">
          {[
            { q: "¿Qué procesos puedo automatizar en mi pyme?", a: "Automatizamos Excel (reportes que se generan solos), WhatsApp (bots que atienden 24/7), email marketing (secuencias que nutren clientes), integración de CRM (datos que fluyen entre sistemas) y workflows completos con n8n." },
            { q: "¿Necesito conocimientos técnicos?", a: "No. Nosotros configuramos todo. Tú solo usas las herramientas: tu bot de WhatsApp, tu dashboard, tus reportes automáticos. Incluimos capacitación básica." },
            { q: "¿Cuánto cuesta un bot de WhatsApp?", a: "Desde $590.000 pago único para un bot con respuestas automáticas, menú interactivo y atención 24/7 con IA. Incluye hosting y soporte; mantenimiento mensual opcional $69.000/mes. Planes con integración CRM y dashboard desde $690.000." },
            { q: "¿Cuánto tiempo toma implementar una automatización?", a: "Un bot de WhatsApp básico está listo en 3-5 días. Una automatización completa con CRM + dashboard toma 2-3 semanas." },
            { q: "¿Funciona con mi sistema actual?", a: "Sí. Nos adaptamos a tus herramientas: Excel, Google Sheets, Salesforce, HubSpot, Mercado Pago, Transbank, y cualquier sistema con API o acceso a datos." },
            { q: "¿Puedo automatizar documentos como comprobantes o facturas?", a: "Sí. Con OCR + RAG + LLM transcribimos y procesamos comprobantes, facturas y contratos automáticamente. Caso real: un contador de Puerto Varas procesa 200 comprobantes al día sin digitarlos. Desde $1.900.000." },
          ].map((faq, i) => (
            <details class="reveal-item group border-b border-frame/60">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-text-primary transition-colors hover:text-accent focus-visible:outline-none focus-visible:text-accent md:py-6 [&::-webkit-details-marker]:hidden">
                <span class="flex items-baseline gap-3 md:gap-4">
                  <span class="shrink-0 font-mono text-[11px] leading-none text-text-tertiary" aria-hidden="true">
                    [0{i + 1}]
                  </span>
                  <span class="font-heading text-base font-semibold leading-snug tracking-[-0.01em] md:text-lg">{faq.q}</span>
                </span>
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-[4px] border border-frame text-text-tertiary transition-colors duration-300 group-open:border-accent/60 group-open:text-accent"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="transition-transform duration-300 group-open:rotate-45"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
                </span>
              </summary>
              <div class="pb-6 md:pb-7">
                <p class="max-w-3xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════
         CTA FINAL · empieza hoy
    ═══════════════════════════════════════════ -->
    <section class="relative w-full border-t border-frame bg-bg">
      <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">

        <div class="reveal-group">
          <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">// empieza hoy</p>
          <h2 class="reveal-item mt-4 max-w-4xl font-heading text-4xl font-bold leading-[1.05] tracking-[-0.03em] text-text-primary sm:text-5xl md:text-6xl">
            Recupera<br /><span class="text-accent">tu tiempo</span>
          </h2>
          <p class="reveal-item mt-5 max-w-xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base">
            Cuéntanos qué proceso manual te quita más tiempo y te mostramos cómo automatizarlo.
          </p>
          <div class="reveal-item mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full items-center justify-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:w-auto"
            >
              [ WhatsApp ]
            </a>
            <a
              href="/cotizar"
              class="inline-flex w-full items-center justify-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:w-auto"
            >
              [ Cotizar online ]
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- CIUDADES RELACIONADAS -->
    <CiudadesRelacionadas current="puerto-varas" />
  </main>

  <Footer />

</BaseLayout>

