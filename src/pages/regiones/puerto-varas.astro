---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Puerto Varas en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-restaurante-puerto-varas",
    title: "SEO para restaurantes en Puerto Varas",
    desc: "Cómo posicionar tu restaurante en Google Maps y recibir más reservas." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en Puerto Varas y el sur de Chile." },
  { href: "/blog/automatizar-whatsapp-negocio-puerto-varas",
    title: "Cómo automatizar WhatsApp para tu negocio",
    desc: "Bots 24/7 que atienden a tus clientes mientras duermes." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Puerto Varas?",
    a: "Sí. Trabajamos con hospedajes, restaurantes, tour operators, corredoras de propiedades y servicios profesionales de Puerto Varas. Conocemos el mercado local del sur de Chile." },
  { q: "¿Cuánto cuesta una página web en Puerto Varas?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics. Sin costos ocultos." },
  { q: "¿Puedo aparecer en Google Maps si soy de Puerto Varas?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando tus clientes buscan servicios en Puerto Varas, Puerto Montt y Los Lagos." },
  { q: "¿Cuánto demora en verse resultados del SEO?",
    a: "Mejoras en Google Maps se ven en 2-4 semanas. Posicionamiento en búsquedas orgánicas toma 2-3 meses. Te entregamos reportes mensuales con evidencia." },
];
---

<BaseLayout
  title="Agencia Digital Puerto Varas · Web y SEO Local"
  description="Agencia digital en Puerto Varas: páginas web profesionales, posicionamiento en Google Maps y bots WhatsApp para pymes de Puerto Varas y Los Lagos. Desde $290.000 CLP."
  image="/og/puerto-varas.png"
  canonical="https://mtsprz.org/regiones/puerto-varas"
  breadcrumbs={[{ name: "Puerto Varas", path: "/regiones/puerto-varas" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/puerto-varas#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Puerto Varas?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico. Lee nuestra guía de precios." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Puerto Varas?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales como 'restaurante en Puerto Varas' o 'hotel en Puerto Varas'. Resultados en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Puerto Varas?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital. Todo enfocado en pymes del sur de Chile." }},
      { "@type": "Question", name: "¿Trabajan con negocios turísticos en Puerto Varas?", acceptedAnswer: { "@type": "Answer", text: "Sí. Trabajamos con hoteles, restaurantes, cabañas y servicios turísticos de Puerto Varas. Conocemos la estacionalidad y las necesidades del turismo en la Cuenca del Lago Llanquihue." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/puerto-varas#localbusiness`,
    name: "Mtsprz · Agencia Digital Puerto Varas",
    description: "Agencia digital en Puerto Varas. Páginas web, SEO local y automatizaciones para pymes de Puerto Varas y la Región de Los Lagos.",
    url: `${site}/regiones/puerto-varas`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Puerto Varas" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Puerto Varas",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -41.319, longitude: -72.985 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="puerto-varas"
      waUrl={waUrl}
      kicker="Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · sur de Chile"
      ctaKicker="Puerto Varas · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Puerto Varas."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
      quickAnswer={{
        question: "¿Cuánto cuesta una página web en Puerto Varas?",
        answer: "Una landing page cuesta desde $290.000 y un sitio corporativo desde $690.000; una tienda online desde $1.500.000. Incluye diseño, dominio + hosting por un año, SEO básico y Analytics. Trabajamos con hospedajes, restaurantes, tour operators y servicios profesionales de Puerto Varas.",
        facts: [
          "Landing desde $290.000 · corporativo desde $690.000",
          "Incluye dominio + hosting 1 año, SEO y Analytics",
          "Puerto Varas · 52.942 hab (INE, censo 2024)",
          "Sectores clave: turismo y hospedaje · gastronomía",
        ],
      }}
    />
  </main>
  <Footer />
</BaseLayout>
