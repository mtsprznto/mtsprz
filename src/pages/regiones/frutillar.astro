---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Frutillar en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/seo-restaurante-puerto-varas",
    title: "SEO para restaurantes en Puerto Varas",
    desc: "Cómo posicionar tu restaurante en Google Maps." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Frutillar?",
    a: "Sí. Trabajamos con casonas patrimoniales, restaurantes, tiendas de artesanía y servicios turísticos de Frutillar. Conocemos el mercado local del sur de Chile." },
  { q: "¿Cuánto cuesta una página web en Frutillar?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics. Sin costos ocultos." },
  { q: "¿Puedo aparecer en Google Maps si soy de Frutillar?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando tus clientes buscan servicios en Frutillar y la Región de Los Lagos." },
  { q: "¿Cuánto demora en verse resultados del SEO?",
    a: "Mejoras en Google Maps se ven en 2-4 semanas. Posicionamiento en búsquedas orgánicas toma 2-3 meses. Te entregamos reportes mensuales con evidencia." },
];
---

<BaseLayout
  title="Agencia Digital Frutillar · Web y SEO Local"
  description="Agencia digital en Frutillar: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Turismo, gastronomía, servicios locales."
  canonical="https://mtsprz.org/regiones/frutillar"
  breadcrumbs={[{ name: "Frutillar", path: "/regiones/frutillar" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/frutillar#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Frutillar?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Frutillar?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Frutillar?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Frutillar." }},
      { "@type": "Question", name: "¿Trabajan con negocios turísticos de Frutillar?", acceptedAnswer: { "@type": "Answer", text: "Sí. Frutillar es un polo turístico importante. Trabajamos con hoteles, restaurantes, cabañas y servicios turísticos que buscan captar clientes via Google." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/frutillar#localbusiness`,
    name: "Mtsprz · Agencia Digital Frutillar",
    description: "Agencia digital en Frutillar. Páginas web, SEO local y automatizaciones para pymes de Frutillar y la Región de Los Lagos.",
    url: `${site}/regiones/frutillar`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Frutillar" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Frutillar",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -41.123, longitude: -73.053 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="frutillar"
      waUrl={waUrl}
      kicker="Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · sur de Chile"
      ctaKicker="Frutillar · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Frutillar."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
