---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Osorno en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en Puerto Varas, Osorno y el sur de Chile." },
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/automatizar-whatsapp-negocio-puerto-varas",
    title: "Cómo automatizar WhatsApp para tu negocio",
    desc: "Bots 24/7 que atienden a tus clientes mientras duermes." },
];

const faqs = [
  { q: "¿Hacen páginas web para empresas en Osorno?",
    a: "Sí. Trabajamos con empresas de retail, salud, ganadería, servicios profesionales y comercio de Osorno. Conocemos las necesidades del mercado del sur de Chile." },
  { q: "¿Cuánto cuesta una página web en Osorno?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer primero en Google si soy de Osorno?",
    a: "Sí. Optimizamos tu Google Business Profile y sitio web para búsquedas locales como 'empresa [rubro] Osorno'. Resultados visibles en 4-8 semanas." },
  { q: "¿Qué automatizaciones son más útiles para empresas de Osorno?",
    a: "Bot de WhatsApp para atención al cliente, automatización de cotizaciones, integración con Excel/ERP y reportes de ventas automáticos. Sin conocimiento técnico de tu parte." },
];
---

<BaseLayout
  title="Agencia Digital Osorno · Web y SEO Local"
  description="Agencia digital en Osorno: páginas web profesionales, posicionamiento en Google Maps y bots WhatsApp para pymes. Sitio profesional en 7 días. Cotiza gratis."
  image="/og/osorno.png"
  canonical="https://mtsprz.org/regiones/osorno"
  breadcrumbs={[{ name: "Osorno", path: "/regiones/osorno" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/osorno#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Hacen páginas web para empresas en Osorno?", acceptedAnswer: { "@type": "Answer", text: "Sí. Trabajamos con empresas de retail, salud, ganadería, servicios profesionales y comercio de Osorno. Conocemos las necesidades del mercado del sur de Chile." }},
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Osorno?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio + hosting un año, SEO básico y Analytics." }},
      { "@type": "Question", name: "¿Puedo aparecer primero en Google si soy de Osorno?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile y sitio web para búsquedas locales como 'empresa [rubro] Osorno'. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué automatizaciones son más útiles para empresas de Osorno?", acceptedAnswer: { "@type": "Answer", text: "Bot de WhatsApp para atención al cliente, automatización de cotizaciones, integración con Excel/ERP y reportes de ventas automáticos. Sin conocimiento técnico de tu parte." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/osorno#localbusiness`,
    name: "Mtsprz · Agencia Digital Osorno",
    description: "Agencia digital en Osorno. Páginas web, SEO local y automatizaciones para pymes de Osorno y la Región de Los Lagos.",
    url: `${site}/regiones/osorno`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Osorno" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Osorno",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -40.574, longitude: -73.133 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="osorno"
      waUrl={waUrl}
      kicker="Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · sur de Chile"
      ctaKicker="Osorno · Los Lagos"
      webDesc="Para retail, salud, ganadería e industria de Osorno. Carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan proveedores en Osorno."
      autoDesc="Ideal para retail y servicios de Osorno. Atiende 24/7, ahorra 10+ horas semanales."
      servicesLayout="seo-first"
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
