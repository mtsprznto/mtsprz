---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Llanquihue en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/como-crear-pagina-web-emprendedores-sur-chile",
    title: "Cómo crear página web para emprendedores",
    desc: "Guía paso a paso para tu primer sitio web." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Llanquihue?",
    a: "Sí. Trabajamos con hoteles, cabañas, restaurantes, servicios pesqueros y locales de Llanquihue. Conocemos el mercado del lago y Los Lagos." },
  { q: "¿Cuánto cuesta una página web en Llanquihue?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer en Google Maps desde Llanquihue?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Llanquihue y la zona del lago." },
  { q: "¿Trabajan con turismo de lago en Llanquihue?",
    a: "Absolutamente. Llanquihue tiene una ribera turística activa. Creamos sitios web para cabañas, camping, tours lacustres y servicios gastronómicos." },
];
---

<BaseLayout
  title="Agencia Digital Llanquihue · Web y SEO"
  description="Agencia digital en Llanquihue: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Turismo, pesca, agricultura. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/llanquihue"
  breadcrumbs={[{ name: "Llanquihue", path: "/regiones/llanquihue" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/llanquihue#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Llanquihue?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Llanquihue?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Llanquihue?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Llanquihue." }},
      { "@type": "Question", name: "¿Trabajan con negocios turísticos de Llanquihue?", acceptedAnswer: { "@type": "Answer", text: "Sí. Llanquihue está a orillas del lago, con turismo, pesca y agricultura. Trabajamos con hoteles, cabañas y servicios locales." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/llanquihue#localbusiness`,
    name: "Mtsprz · Agencia Digital Llanquihue",
    description: "Agencia digital en Llanquihue. Páginas web, SEO local y automatizaciones para pymes de Llanquihue y Los Lagos.",
    url: `${site}/regiones/llanquihue`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Llanquihue" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Llanquihue",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -41.253, longitude: -73.003 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="llanquihue"
      waUrl={waUrl}
      kicker="Lago Llanquihue · Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · Lago, turismo y pesca"
      ctaKicker="Llanquihue · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Llanquihue."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
