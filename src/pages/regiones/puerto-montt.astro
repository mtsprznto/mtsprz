---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Puerto Montt en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/ecommerce-region-los-lagos",
    title: "E-commerce en la Región de Los Lagos",
    desc: "Guía para vender online desde el sur de Chile." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Puerto Montt?",
    a: "Sí. Trabajamos con comercios, servicios profesionales, gremios y empresas de Puerto Montt. Conocemos el mercado local del sur de Chile." },
  { q: "¿Cuánto cuesta una página web en Puerto Montt?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics. Sin costos ocultos." },
  { q: "¿Puedo aparecer en Google Maps si soy de Puerto Montt?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando tus clientes buscan servicios en Puerto Montt y la Región de Los Lagos." },
  { q: "¿Cuánto demora en verse resultados del SEO?",
    a: "Mejoras en Google Maps se ven en 2-4 semanas. Posicionamiento en búsquedas orgánicas toma 2-3 meses. Te entregamos reportes mensuales con evidencia." },
];
---

<BaseLayout
  title="Agencia Digital Puerto Montt · Web y SEO"
  description="Agencia digital en Puerto Montt: páginas web profesionales, SEO en Google Maps y automatizaciones para pymes. Atención local, resultados reales. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/puerto-montt"
  breadcrumbs={[{ name: "Puerto Montt", path: "/regiones/puerto-montt" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/puerto-montt#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Puerto Montt?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Puerto Montt?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales como 'servicio en Puerto Montt'. Resultados en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Puerto Montt?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Puerto Montt." }},
      { "@type": "Question", name: "¿Trabajan con empresas del sector salmonero?", acceptedAnswer: { "@type": "Answer", text: "Sí. Trabajamos con empresas del sector salmonero, alimenticio y comercial de Puerto Montt. Conocemos las necesidades del ecosistema productivo de Los Lagos." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/puerto-montt#localbusiness`,
    name: "Mtsprz · Agencia Digital Puerto Montt",
    description: "Agencia digital en Puerto Montt. Páginas web, SEO local y automatizaciones para pymes de Puerto Montt y la Región de Los Lagos.",
    url: `${site}/regiones/puerto-montt`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Puerto Montt" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Puerto Montt",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -41.469, longitude: -72.942 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="puerto-montt"
      waUrl={waUrl}
      kicker="Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · sur de Chile"
      ctaKicker="Puerto Montt · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Puerto Montt."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
