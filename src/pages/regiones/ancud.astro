---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Ancud en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/como-crear-pagina-web-emprendedores-sur-chile",
    title: "Cómo crear página web para emprendedores",
    desc: "Guía paso a paso para tu primer sitio web." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Ancud?",
    a: "Sí. Trabajamos con hoteles, restaurantes, tours de Chiloé y servicios locales de Ancud. Conocemos el mercado turístico y comercial de la isla." },
  { q: "¿Cuánto cuesta una página web en Ancud?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer en Google Maps desde Ancud?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Ancud y Chiloé." },
  { q: "¿Trabajan con turismo en Chiloé?",
    a: "Absolutamente. Ancud es puerta de entrada a la isla. Creamos sitios web para hoteles, restaurantes, tours y experiencias turísticas." },
];
---

<BaseLayout
  title="Agencia Digital Ancud · Web y SEO Local"
  description="Agencia digital en Ancud: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Turismo, comercio, servicios. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/ancud"
  breadcrumbs={[{ name: "Ancud", path: "/regiones/ancud" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/ancud#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Ancud?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Ancud?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Ancud?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Ancud." }},
      { "@type": "Question", name: "¿Trabajan con negocios turísticos de Ancud?", acceptedAnswer: { "@type": "Answer", text: "Sí. Ancud es puerta de entrada a Chiloé. Trabajamos con hoteles, restaurantes, tours y servicios turísticos." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/ancud#localbusiness`,
    name: "Mtsprz · Agencia Digital Ancud",
    description: "Agencia digital en Ancud. Páginas web, SEO local y automatizaciones para pymes de Ancud y Chiloé.",
    url: `${site}/regiones/ancud`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Ancud" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Ancud",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -41.868, longitude: -73.829 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="ancud"
      waUrl={waUrl}
      kicker="Chiloé · Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · Chiloé y sur de Chile"
      ctaKicker="Ancud · Chiloé · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Ancud."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
