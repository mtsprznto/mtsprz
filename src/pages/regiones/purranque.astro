---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Purranque en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/como-crear-pagina-web-emprendedores-sur-chile",
    title: "Cómo crear página web para emprendedores",
    desc: "Guía paso a paso para tu primer sitio web." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Purranque?",
    a: "Sí. Trabajamos con agricultores, lecherías, emprendimientos rurales, comercios y servicios locales de Purranque. Conocemos el sector agropecuario de Los Lagos." },
  { q: "¿Cuánto cuesta una página web en Purranque?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer en Google Maps desde Purranque?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Purranque y la zona." },
  { q: "¿Trabajan con el sector agropecuario?",
    a: "Absolutamente. Purranque es una zona clave de agricultura y lechería. Creamos sitios web para productores, agronegocios y servicios del campo." },
];
---

<BaseLayout
  title="Agencia Digital Purranque · Web y SEO Local"
  description="Agencia digital en Purranque: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Agricultura, lechería, gateway. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/purranque"
  breadcrumbs={[{ name: "Purranque", path: "/regiones/purranque" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/purranque#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Purranque?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Purranque?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Purranque?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Purranque." }},
      { "@type": "Question", name: "¿Trabajan con el sector agropecuario en Los Lagos?", acceptedAnswer: { "@type": "Answer", text: "Sí. Purranque es zona agrícola y ganadera. Trabajamos con agricultores, lecherías, emprendimientos rurales y servicios del campo." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/purranque#localbusiness`,
    name: "Mtsprz · Agencia Digital Purranque",
    description: "Agencia digital en Purranque. Páginas web, SEO local y automatizaciones para pymes de Purranque y Los Lagos.",
    url: `${site}/regiones/purranque`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Purranque" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Purranque",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -40.913, longitude: -73.167 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="purranque"
      waUrl={waUrl}
      kicker="Osorno · Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · Agricultura, lechería y campo"
      ctaKicker="Purranque · Osorno · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Purranque."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
