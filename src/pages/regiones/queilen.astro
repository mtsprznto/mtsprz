---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Queilén en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/como-crear-pagina-web-emprendedores-sur-chile",
    title: "Cómo crear página web para emprendedores",
    desc: "Guía paso a paso para tu primer sitio web." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Queilén?",
    a: "Sí. Trabajamos con pescadores artesanales, cabañas, restaurantes, artesanos y servicios locales de Queilén. Conocemos el sur profundo de Chiloé." },
  { q: "¿Cuánto cuesta una página web en Queilén?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer en Google Maps desde Queilén?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Queilén y la isla." },
  { q: "¿Trabajan con turismo rural en Queilén?",
    a: "Absolutamente. Queilén es un pueblo de pesca y tradiciones chilotas. Creamos sitios web que capturan la esencia rural y artesanal de la zona." },
];
---

<BaseLayout
  title="Agencia Digital Queilén · Web y SEO Local"
  description="Agencia digital en Queilén: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Pesca, turismo rural, tradiciones artesanales. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/queilen"
  breadcrumbs={[{ name: "Queilén", path: "/regiones/queilen" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/queilen#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Queilén?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Queilén?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Queilén?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Queilén." }},
      { "@type": "Question", name: "¿Trabajan con turismo rural en Queilén?", acceptedAnswer: { "@type": "Answer", text: "Sí. Queilén es un pueblo de pesca y tradiciones artesanales en Chiloé. Trabajamos con cabañas, restaurantes, artesanos y servicios locales." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/queilen#localbusiness`,
    name: "Mtsprz · Agencia Digital Queilén",
    description: "Agencia digital en Queilén. Páginas web, SEO local y automatizaciones para pymes de Queilén y Chiloé.",
    url: `${site}/regiones/queilen`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Queilén" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Queilén",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -42.883, longitude: -73.483 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="queilen"
      waUrl={waUrl}
      kicker="Chiloé · Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · Pesca, turismo rural y artesanía"
      ctaKicker="Queilén · Chiloé · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Queilén."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
