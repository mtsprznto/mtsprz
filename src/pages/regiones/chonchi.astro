---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Chonchi en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/como-crear-pagina-web-emprendedores-sur-chile",
    title: "Cómo crear página web para emprendedores",
    desc: "Guía paso a paso para tu primer sitio web." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Chonchi?",
    a: "Sí. Trabajamos con hoteles de palafitos, restaurantes, tours, artesanos y servicios turísticos de Chonchi. Conocemos el patrimonio UNESCO y el mercado turístico." },
  { q: "¿Cuánto cuesta una página web en Chonchi?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer en Google Maps desde Chonchi?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Chonchi y Chiloé." },
  { q: "¿Trabajan con turismo patrimonial en Chiloé?",
    a: "Absolutamente. Chonchi es uno de los pueblos patrimoniales más importantes. Creamos sitios web que resaltan la historia, arquitectura y experiencias únicas." },
];
---

<BaseLayout
  title="Agencia Digital Chonchi · Web y SEO Local"
  description="Agencia digital en Chonchi: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Patrimonio UNESCO, palafitos, turismo. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/chonchi"
  breadcrumbs={[{ name: "Chonchi", path: "/regiones/chonchi" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/chonchi#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Chonchi?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Chonchi?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Chonchi?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Chonchi." }},
      { "@type": "Question", name: "¿Trabajan con el turismo en Chonchi?", acceptedAnswer: { "@type": "Answer", text: "Sí. Chonchi es patrimonio UNESCO con palafitos icónicos. Trabajamos con hoteles, restaurantes, tours y servicios turísticos." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/chonchi#localbusiness`,
    name: "Mtsprz · Agencia Digital Chonchi",
    description: "Agencia digital en Chonchi. Páginas web, SEO local y automatizaciones para pymes de Chonchi y Chiloé.",
    url: `${site}/regiones/chonchi`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Chonchi" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Chonchi",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -42.623, longitude: -73.773 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="chonchi"
      waUrl={waUrl}
      kicker="Chiloé · Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · Patrimonio UNESCO, palafitos y turismo"
      ctaKicker="Chonchi · Chiloé · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Chonchi."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
