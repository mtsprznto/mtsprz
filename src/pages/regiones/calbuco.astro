---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Calbuco en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/como-crear-pagina-web-emprendedores-sur-chile",
    title: "Cómo crear página web para emprendedores",
    desc: "Guía paso a paso para tu primer sitio web." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Calbuco?",
    a: "Sí. Trabajamos con centros de pesca, salmoneras, tours de Isla Calbuco y comercio local. Conocemos el mercado pesquero, acuícola y turístico de la zona." },
  { q: "¿Cuánto cuesta una página web en Calbuco?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer en Google Maps desde Calbuco?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Calbuco y alrededores." },
  { q: "¿Trabajan con la industria pesquera y acuícola?",
    a: "Sí. Calbuco es polo pesquero y acuícola del sur de Chile. Creamos sitios web para centros de Pesca, salmoneras, proveedores del sector y servicios asociados." },
];
---

<BaseLayout
  title="Agencia Digital Calbuco · Web y SEO Local"
  description="Agencia digital en Calbuco: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Pesca, turismo, comercio. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/calbuco"
  breadcrumbs={[{ name: "Calbuco", path: "/regiones/calbuco" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/calbuco#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Calbuco?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Calbuco?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Calbuco?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Calbuco." }},
      { "@type": "Question", name: "¿Trabajan con negocios pesqueros y acuícolas de Calbuco?", acceptedAnswer: { "@type": "Answer", text: "Sí. Calbuco es polo pesquero y acuícola del sur. Trabajamos con centros de pesca, salmoneras, turismo y comercio local." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/calbuco#localbusiness`,
    name: "Mtsprz · Agencia Digital Calbuco",
    description: "Agencia digital en Calbuco. Páginas web, SEO local y automatizaciones para pymes de Calbuco y Los Lagos.",
    url: `${site}/regiones/calbuco`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Calbuco" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Calbuco",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -41.771, longitude: -73.129 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="calbuco"
      waUrl={waUrl}
      kicker="Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · Pesca, acuicultura y turismo"
      ctaKicker="Calbuco · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Calbuco."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
