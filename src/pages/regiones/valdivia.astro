---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Valdivia en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/guia-seo-pymes-sur-chile",
    title: "Guía completa de SEO para pymes",
    desc: "Estrategias SEO que funcionan en el sur de Chile." },
  { href: "/blog/automatizar-email-marketing-pymes",
    title: "Automatizar email marketing para pymes",
    desc: "Guía práctica para vender más con email automatizado." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Valdivia?",
    a: "Sí. Trabajamos con restaurantes, cervecerías, hospedajes turísticos, servicios profesionales y comercio de Valdivia. Entendemos la economía local y el turismo de Los Ríos." },
  { q: "¿Cuánto cuesta una página web en Valdivia?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todo incluye diseño, dominio + hosting un año, SEO básico y Google Analytics. Sin costos ocultos." },
  { q: "¿Cómo aparezco en Google cuando buscan en Valdivia?",
    a: "Optimizamos tu Google Business Profile y aplicamos SEO local para aparecer en búsquedas como 'restaurant Valdivia' o 'hospedaje río Valdivia'. Resultados en 4-8 semanas." },
  { q: "¿Pueden hacer una tienda online para mi negocio valdiviano?",
    a: "Sí. Creamos tiendas completas con Transbank/Mercado Pago, catálogo de productos, gestión de pedidos y envíos. Desde $1.500.000 con todo incluido." },
];
---

<BaseLayout
  title="Agencia Digital Valdivia · Web y SEO Local"
  description="Agencia digital en Valdivia: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Restaurantes, hoteles, servicios. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/valdivia"
  breadcrumbs={[{ name: "Valdivia", path: "/regiones/valdivia" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/valdivia#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Valdivia?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Valdivia?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Valdivia?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Valdivia y la Región de Los Ríos." }},
      { "@type": "Question", name: "¿Trabajan con la Universidad Austral de Chile?", acceptedAnswer: { "@type": "Answer", text: "Trabajamos con pymes y emprendedores de Valdivia. Si tienes un proyecto vinculado a la universidad o al sector académico, consúltanos." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/valdivia#localbusiness`,
    name: "Mtsprz · Agencia Digital Valdivia",
    description: "Agencia digital en Valdivia. Páginas web, SEO local y automatizaciones para pymes de Valdivia y la Región de Los Ríos.",
    url: `${site}/regiones/valdivia`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Valdivia" },
      { "@type": "AdministrativeArea", name: "Región de Los Ríos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Valdivia",
      addressRegion: "Los Ríos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -39.814, longitude: -73.246 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="valdivia"
      waUrl={waUrl}
      kicker="Los Ríos · Chile"
      subtitle="Diseño web · SEO local · Automatización · sur de Chile"
      ctaKicker="Valdivia · Los Ríos"
      webDesc="Para restaurantes, cervecerías, hospedajes y servicios de Valdivia."
      seoDesc="Aparece cuando turistas y valdivinos te buscan en Google."
      autoDesc="Ideal para hostelería y gastronomía valdiviana. Reservas automáticas, 24/7."
      servicesLayout="auto-first"
      colWeb={55}
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
