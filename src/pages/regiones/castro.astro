---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import CiudadesRelacionadas from "../../components/CiudadesRelacionadas.astro";
import LocalidadDatos from "../../components/LocalidadDatos.astro";
import FaqPreview from "../../components/FaqPreview.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Castro en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";
---

<BaseLayout
  title="Agencia Digital Castro | Páginas Web y SEO para Negocios"
  description="Agencia digital en Castro: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Turismo, gastronomía, artesanía. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/castro"
  breadcrumbs={[{ name: "Castro", path: "/regiones/castro" }]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/castro#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Castro?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Castro?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Castro?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Castro." }},
      { "@type": "Question", name: "¿Trabajan con negocios turísticos de Chiloé?", acceptedAnswer: { "@type": "Answer", text: "Sí. Castro es capital de Chiloé. Trabajamos con hoteles, restaurantes, tours, artesanos y gastronomía chilota." }}
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/castro#localbusiness`,
    name: "Mtsprz — Agencia Digital Castro",
    description: "Agencia digital en Castro. Páginas web, SEO local y automatizaciones para pymes de Castro y Chiloé.",
    url: `${site}/regiones/castro`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Castro" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Castro",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -42.472, longitude: -73.765 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" style="overflow-x: hidden;">

    <!-- HERO -->
    <section aria-label="Agencia digital en Castro" style="position:relative; width:100vw; height:100dvh; min-height:100vh; overflow:hidden; background:#010101;">
      <div style="position:absolute; inset:0; background: radial-gradient(ellipse at 20% 80%, #06b6d412 0%, transparent 50%), radial-gradient(ellipse at 80% 20%, #0a0a2e 0%, transparent 60%), linear-gradient(160deg, #010101 0%, #04080f 50%, #010101 100%);"></div>
      <div style="position:absolute; inset:0; opacity:0.025; mix-blend-mode:overlay; background-image:url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E'); background-size:256px;"></div>
      <div style="position:absolute; bottom:0; left:0; right:0; height:55%; background:linear-gradient(to top, #010101 0%, #010101 20%, transparent 100%); z-index:2;"></div>

      <div style="position:absolute; bottom:0; left:0; right:0; z-index:10; padding: 0 2.5rem 3.5rem;">
        <div style="max-width:100%; display:flex; flex-direction:column; align-items:flex-start;">
          <p style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:rgba(255,255,255,0.25); font-family:var(--font-body); margin-bottom:1rem;">Chiloé · Los Lagos · Chile</p>
          <h1 style="font-size:clamp(4.5rem, 14vw, 16rem); font-family:var(--font-heading); font-weight:800; color:#fff; line-height:0.85; letter-spacing:-0.04em; text-transform:uppercase; margin:0;">
            CASTRO
          </h1>
          <p style="margin-top:1.25rem; font-size:0.75rem; color:rgba(255,255,255,0.3); font-family:var(--font-body); font-weight:300; letter-spacing:0.05em;">
            Diseño web · SEO local · Automatización — Palafitos, gastronomía y artesanía chilota
          </p>
          <div style="margin-top:1.75rem; display:flex; gap:0.75rem; flex-wrap:wrap;">
            <a href={waUrl} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp desde Castro"
              style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.75rem 1.5rem; background:#1A1A1A; color:#fff; font-size:0.65rem; font-family:var(--font-body); font-weight:500; text-transform:uppercase; letter-spacing:0.2em; text-decoration:none; transition:background 0.2s; outline-offset:2px;"
              onmouseover="this.style.background='#25D366'" onmouseout="this.style.background='#1A1A1A'"
              onfocus="this.style.outline='2px solid #fff'" onblur="this.style.outline='none'">
              CONSULTAR AHORA
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/cotizar" aria-label="Cotizar proyecto digital gratis"
              style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.75rem 1.5rem; background:transparent; color:rgba(255,255,255,0.45); font-size:0.65rem; font-family:var(--font-body); font-weight:500; text-transform:uppercase; letter-spacing:0.2em; border:1px solid rgba(255,255,255,0.12); text-decoration:none; transition:all 0.2s; outline-offset:2px;"
              onmouseover="this.style.color='#fff'; this.style.borderColor='rgba(255,255,255,0.4)'" onmouseout="this.style.color='rgba(255,255,255,0.45)'; this.style.borderColor='rgba(255,255,255,0.12)'"
              onfocus="this.style.outline='2px solid #fff'" onblur="this.style.outline='none'">
              COTIZAR GRATIS
            </a>
          </div>
        </div>
      </div>

      <div style="position:absolute; bottom:2rem; right:2.5rem; z-index:20;">
        <Breadcrumbs items={[{ name: "Castro", path: "/regiones/castro" }]} />
      </div>
    </section>

    <!-- SERVICIOS -->
    <div class="services-columns-row" style="width:100vw;">
      <div class="cols-row-1">
        <a href="/desarrollo-web" class="service-col col-web" aria-label="Servicio de desarrollo web profesional en Castro" style="text-decoration:none; cursor:pointer;">
          <div style="position:absolute; inset:0; background: linear-gradient(145deg, #060810 0%, #0a0e1a 40%, #010101 100%);"></div>
          <div style="position:absolute; inset:0; background: radial-gradient(ellipse at 70% 30%, #1a237e18 0%, transparent 60%);"></div>
          <div style="position:absolute; bottom:0; left:0; right:0; height:65%; background:linear-gradient(to top, rgba(1,1,1,0.95) 0%, transparent 100%);"></div>
          <div style="position:relative; z-index:10; padding:2.5rem;">
            <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.2); font-family:var(--font-body); margin-bottom:0.75rem;">01 — DESARROLLO WEB</p>
            <h2 style="font-size:clamp(2rem, 5vw, 4.5rem); font-family:var(--font-heading); font-weight:800; color:#fff; line-height:0.9; letter-spacing:-0.03em; text-transform:uppercase; margin:0;">
              PÁGINAS WEB<br />PROFESIONALES
            </h2>
            <p style="margin-top:0.75rem; font-size:0.75rem; color:rgba(255,255,255,0.4); font-family:var(--font-body); font-weight:300; max-width:340px; line-height:1.6;">
              Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido.
            </p>
            <div style="margin-top:1.25rem; display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
              <span style="display:inline-block; padding:0.6rem 1.25rem; background:#1A1A1A; color:#fff; font-size:0.6rem; font-family:var(--font-body); text-transform:uppercase; letter-spacing:0.2em;">EXPLORAR →</span>
              <span style="font-size:0.7rem; color:rgba(255,255,255,0.25); font-family:var(--font-body);">Desde $290.000</span>
            </div>
          </div>
        </a>
        <a href="/seo-local" class="service-col col-seo" aria-label="SEO local en Castro" style="text-decoration:none; cursor:pointer;">
          <div style="position:absolute; inset:0; background: linear-gradient(155deg, #041209 0%, #061510 50%, #010101 100%);"></div>
          <div style="position:absolute; inset:0; background: radial-gradient(ellipse at 30% 40%, #05301a18 0%, transparent 60%);"></div>
          <div style="position:absolute; bottom:0; left:0; right:0; height:65%; background:linear-gradient(to top, rgba(1,1,1,0.95) 0%, transparent 100%);"></div>
          <div style="position:relative; z-index:10; padding:2.5rem;">
            <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.2); font-family:var(--font-body); margin-bottom:0.75rem;">02 — SEO LOCAL</p>
            <h2 style="font-size:clamp(2rem, 4vw, 3.5rem); font-family:var(--font-heading); font-weight:800; color:#fff; line-height:0.9; letter-spacing:-0.03em; text-transform:uppercase; margin:0;">
              GOOGLE<br />MAPS
            </h2>
            <p style="margin-top:0.75rem; font-size:0.75rem; color:rgba(255,255,255,0.4); font-family:var(--font-body); font-weight:300; max-width:280px; line-height:1.6;">
              Aparece primero cuando buscan en Castro.
            </p>
            <div style="margin-top:1.25rem; display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
              <span style="display:inline-block; padding:0.6rem 1.25rem; background:#1A1A1A; color:#fff; font-size:0.6rem; font-family:var(--font-body); text-transform:uppercase; letter-spacing:0.2em;">VER PLANES →</span>
              <span style="font-size:0.7rem; color:rgba(255,255,255,0.25); font-family:var(--font-body);">Desde $190.000</span>
            </div>
          </div>
        </a>
      </div>
      <a href="/automatizacion" class="service-col col-auto" aria-label="Automatización en Castro" style="text-decoration:none; cursor:pointer; width:100%;">
        <div style="position:absolute; inset:0; background: linear-gradient(135deg, #080808 0%, #0d0a04 50%, #010101 100%);"></div>
        <div style="position:absolute; bottom:0; left:0; right:0; height:70%; background:linear-gradient(to top, rgba(1,1,1,0.97) 0%, transparent 100%);"></div>
        <div style="position:relative; z-index:10; padding:2.5rem;">
          <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.2); font-family:var(--font-body); margin-bottom:0.75rem;">03 — AUTOMATIZACIÓN</p>
          <h2 style="font-size:clamp(1.75rem, 4vw, 3.25rem); font-family:var(--font-heading); font-weight:800; color:#fff; line-height:0.9; letter-spacing:-0.03em; text-transform:uppercase; margin:0;">
            BOT WHATSAPP · CRM · DASHBOARDS
          </h2>
          <p style="margin-top:0.75rem; font-size:0.75rem; color:rgba(255,255,255,0.4); font-family:var(--font-body); font-weight:300; max-width:480px; line-height:1.6;">
            Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales.
          </p>
        </div>
      </a>
    </div>

    <!-- GUÍAS -->
    <section style="width:100vw; background:#0A0A0A; position:relative; overflow:hidden;">
      <div style="position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(255,255,255,0.05),transparent);"></div>
      <div style="max-width:800px; margin:0 auto; padding:6rem 2.5rem;">
        <p style="font-size:0.6rem; letter-spacing:0.25em; text-transform:uppercase; color:rgba(255,255,255,0.2); font-family:var(--font-body); margin-bottom:2rem;">Guías para negocios en Castro</p>
        <div style="display:grid; gap:1rem;">
          <a href="/blog/seo-local-pymes-region-los-lagos" style="display:block; padding:1.25rem 1.5rem; border:1px solid rgba(255,255,255,0.06); border-radius:0.75rem; text-decoration:none; transition:border-color 0.3s;"
            onmouseover="this.style.borderColor='rgba(16,185,129,0.3)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.06)'">
            <p style="font-size:0.8rem; font-family:var(--font-heading); font-weight:600; color:rgba(255,255,255,0.75); margin:0;">SEO local para pymes en Los Lagos</p>
            <p style="font-size:0.7rem; color:rgba(255,255,255,0.3); font-family:var(--font-body); margin:0.35rem 0 0;">Guía completa para posicionar tu negocio en Google Maps.</p>
          </a>
          <a href="/blog/cuanto-cuesta-pagina-web-puerto-varas" style="display:block; padding:1.25rem 1.5rem; border:1px solid rgba(255,255,255,0.06); border-radius:0.75rem; text-decoration:none; transition:border-color 0.3s;"
            onmouseover="this.style.borderColor='rgba(99,102,241,0.3)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.06)'">
            <p style="font-size:0.8rem; font-family:var(--font-heading); font-weight:600; color:rgba(255,255,255,0.75); margin:0;">Cuánto cuesta una página web en 2026</p>
            <p style="font-size:0.7rem; color:rgba(255,255,255,0.3); font-family:var(--font-body); margin:0.35rem 0 0;">Precios reales de desarrollo web en el sur de Chile.</p>
          </a>
          <a href="/blog/como-crear-pagina-web-emprendedores-sur-chile" style="display:block; padding:1.25rem 1.5rem; border:1px solid rgba(255,255,255,0.06); border-radius:0.75rem; text-decoration:none; transition:border-color 0.3s;"
            onmouseover="this.style.borderColor='rgba(6,182,212,0.3)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.06)'">
            <p style="font-size:0.8rem; font-family:var(--font-heading); font-weight:600; color:rgba(255,255,255,0.75); margin:0;">Cómo crear página web para emprendedores</p>
            <p style="font-size:0.7rem; color:rgba(255,255,255,0.3); font-family:var(--font-body); margin:0.35rem 0 0;">Guía paso a paso para tu primer sitio web.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq-completo" style="width:100vw; background:#0A0A0A; position:relative; overflow:hidden;">
      <div style="position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(255,255,255,0.05),transparent);"></div>
      <div style="max-width:800px; margin:0 auto; padding:6rem 2.5rem;">
        <div class="reveal-group" style="margin-bottom:3rem;">
          <p class="reveal-item" style="font-size:0.6rem; letter-spacing:0.25em; text-transform:uppercase; color:rgba(255,255,255,0.2); font-family:var(--font-body); margin-bottom:1.25rem;">Preguntas frecuentes</p>
          <h2 class="reveal-item" style="font-size:clamp(2rem,5vw,4rem); font-family:var(--font-heading); font-weight:800; color:#fff; letter-spacing:-0.03em; text-transform:uppercase; line-height:0.92; margin:0;">
            LO QUE<br />NOS PREGUNTAN
          </h2>
        </div>

        <!-- FAQ Preview visible para LLMs (GEO) -->
        <div class="reveal-item mb-8">
          <FaqPreview city="Castro" />
        </div>
        <div class="reveal-group" style="border-top:1px solid rgba(255,255,255,0.06);">
          {[
            { q: "¿Hacen páginas web para negocios en Castro?", a: "Sí. Trabajamos con hoteles, restaurantes, artesanos, tiendas de souvenirs y servicios locales de Castro. Conocemos el mercado turístico y comercial de Chiloé." },
            { q: "¿Cuánto cuesta una página web en Castro?", a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
            { q: "¿Puedo aparecer en Google Maps desde Castro?", a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Castro y Chiloé." },
            { q: "¿Trabajan con gastronomía y artesanía en Chiloé?", a: "Absolutamente. Castro es capital gastronómica y artesanal de Chiloé. Creamos sitios web para restaurantes, cocinerías, artesanos y tiendas de productos locales." },
          ].map(faq => (
            <details class="reveal-item faq-item" style="border-bottom:1px solid rgba(255,255,255,0.06);">
              <summary style="display:flex; cursor:pointer; align-items:center; justify-content:space-between; gap:1rem; padding:1.5rem 0; font-size:0.875rem; font-family:var(--font-heading); font-weight:600; color:rgba(255,255,255,0.75); list-style:none; transition:color 0.2s;">
                <span>{faq.q}</span>
                <span class="faq-icon" style="flex-shrink:0; width:1.25rem; height:1.25rem; border:1px solid rgba(255,255,255,0.1); border-radius:50%; display:flex; align-items:center; justify-content:center; transition:all 0.3s;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                </span>
              </summary>
              <p style="padding-bottom:1.5rem; font-size:0.8rem; color:rgba(255,255,255,0.38); font-family:var(--font-body); font-weight:300; line-height:1.8; max-width:600px;">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CIUDADES RELACIONADAS -->
    <LocalidadDatos slug="castro" />

    <CiudadesRelacionadas current="castro" />
    <!-- CTA FINAL -->
    <section style="position:relative; width:100vw; min-height:70vh; overflow:hidden; background:#010101; display:flex; flex-direction:column; justify-content:flex-end;">
      <div style="position:absolute; inset:0; background:radial-gradient(ellipse at 40% 60%, #06b6d40e 0%, transparent 55%);"></div>
      <div style="position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(255,255,255,0.05),transparent);"></div>
      <div class="reveal-group" style="position:relative; z-index:10; padding:4rem 2.5rem 4rem;">
        <p class="reveal-item" style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:rgba(255,255,255,0.2); font-family:var(--font-body); margin-bottom:1.25rem;">Castro · Chiloé · Los Lagos</p>
        <h2 class="reveal-item" style="font-size:clamp(3rem,10vw,10rem); font-family:var(--font-heading); font-weight:800; color:#fff; line-height:0.85; letter-spacing:-0.04em; text-transform:uppercase; margin:0;">
          TU NEGOCIO,<br /><span style="color:rgba(255,255,255,0.15);">DIGITAL.</span>
        </h2>
        <p class="reveal-item" style="margin-top:1.25rem; font-size:0.78rem; color:rgba(255,255,255,0.3); font-family:var(--font-body); font-weight:300; max-width:320px; line-height:1.7;">
          Cuéntanos qué necesitas. Respuesta en menos de 24 horas.
        </p>
        <div class="reveal-item" style="margin-top:2rem; display:flex; gap:0.75rem; flex-wrap:wrap;">
          <a href={waUrl} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp desde Castro"
            style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.85rem 1.75rem; background:#1A1A1A; color:#fff; font-size:0.65rem; font-family:var(--font-body); font-weight:500; text-transform:uppercase; letter-spacing:0.2em; text-decoration:none; transition:background 0.2s; outline-offset:2px;"
            onmouseover="this.style.background='#25D366'" onmouseout="this.style.background='#1A1A1A'"
            onfocus="this.style.outline='2px solid #fff'" onblur="this.style.outline='none'">
            WHATSAPP AHORA
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/cotizar" aria-label="Cotizar proyecto digital online"
            style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.85rem 1.75rem; background:transparent; color:rgba(255,255,255,0.4); font-size:0.65rem; font-family:var(--font-body); font-weight:500; text-transform:uppercase; letter-spacing:0.2em; border:1px solid rgba(255,255,255,0.1); text-decoration:none; transition:all 0.2s; outline-offset:2px;"
            onmouseover="this.style.color='#fff'; this.style.borderColor='rgba(255,255,255,0.35)'" onmouseout="this.style.color='rgba(255,255,255,0.4)'; this.style.borderColor='rgba(255,255,255,0.1)'"
            onfocus="this.style.outline='2px solid #fff'" onblur="this.style.outline='none'">
            COTIZAR ONLINE
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />

  <style>
    .services-columns-row { display: flex; flex-direction: column; width: 100%; }
    .cols-row-1 { display: flex; flex-direction: column; width: 100%; }
    .service-col { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; min-height: 85vw; }
    .col-auto { min-height: 40vw; }
    @media (min-width: 768px) {
      .cols-row-1 { flex-direction: row; }
      .col-web { width: 60%; min-height: 72vh; }
      .col-seo { width: 40%; min-height: 72vh; border-left: 1px solid rgba(255,255,255,0.04); }
      .col-auto { min-height: 45vh; border-top: 1px solid rgba(255,255,255,0.04); }
    }
    .service-col:hover .col-hover-overlay { opacity: 1 !important; }
    .faq-item summary:hover { color: #fff !important; }
    .faq-item[open] summary { color: #fff !important; }
