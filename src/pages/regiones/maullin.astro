---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Maullín en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/como-crear-pagina-web-emprendedores-sur-chile",
    title: "Cómo crear página web para emprendedores",
    desc: "Guía paso a paso para tu primer sitio web." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Maullín?",
    a: "Sí. Trabajamos con pescadores artesanales, cabañas, restaurantes, turismo rural y servicios locales de Maullín. Conocemos la zona de Los Lagos y Chiloé." },
  { q: "¿Cuánto cuesta una página web en Maullín?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer en Google Maps desde Maullín?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Maullín y alrededores." },
  { q: "¿Trabajan con turismo rural en Maullín?",
    a: "Absolutamente. Maullín es un punto estratégico para acceder a Chiloé. Creamos sitios web para cabañas, experiencias gastronómicas y turismo artesanal." },
];
---

<BaseLayout
  title="Agencia Digital Maullín · Web y SEO Local"
  description="Agencia digital en Maullín: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Pesca, turismo rural, cercanía a Chiloé. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/maullin"
  breadcrumbs={[{ name: "Maullín", path: "/regiones/maullin" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/maullin#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Maullín?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Maullín?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Maullín?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Maullín." }},
      { "@type": "Question", name: "¿Trabajan con turismo rural en Maullín?", acceptedAnswer: { "@type": "Answer", text: "Sí. Maullín es puerta de paso a Chiloé, con pesca artesanal y turismo rural. Trabajamos con cabañas, restaurantes y servicios locales." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/maullin#localbusiness`,
    name: "Mtsprz · Agencia Digital Maullín",
    description: "Agencia digital en Maullín. Páginas web, SEO local y automatizaciones para pymes de Maullín y Los Lagos.",
    url: `${site}/regiones/maullin`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Maullín" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Maullín",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -41.610, longitude: -73.600 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="maullin"
      waUrl={waUrl}
      kicker="Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · Pesca artesanal y turismo rural"
      ctaKicker="Maullín · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Maullín."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
