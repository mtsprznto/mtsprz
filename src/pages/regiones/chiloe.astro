---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Chiloé en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/como-crear-pagina-web-emprendedores-sur-chile",
    title: "Cómo crear página web para emprendedores",
    desc: "Guía paso a paso para tu primer sitio web." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Chiloé?",
    a: "Sí. Trabajamos con hoteles, restaurantes, tours, artesanos, pesqueras y comercios de Chiloé. Conocemos el mercado turístico, artesanal y pesquero de la isla." },
  { q: "¿Cuánto cuesta una página web en Chiloé?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer en Google Maps desde Chiloé?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Castro, Ancud y toda la isla de Chiloé." },
  { q: "¿Trabajan con turismo y artesanías de Chiloé?",
    a: "Absolutamente. Chiloé es destino turístico y patrimonial. Creamos sitios web para hoteles, restaurantes, tours, talleres de artesanía y experiencias culturales." },
];
---

<BaseLayout
  title="Agencia Digital Chiloé · Web y SEO Local"
  description="Agencia digital en Chiloé: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Turismo, comercio, artesanías. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/chiloe"
  breadcrumbs={[{ name: "Chiloé", path: "/regiones/chiloe" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/chiloe#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Chiloé?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Chiloé?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Chiloé?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Chiloé." }},
      { "@type": "Question", name: "¿Trabajan con negocios turísticos de Chiloé?", acceptedAnswer: { "@type": "Answer", text: "Sí. Chiloé es destino turístico icónico. Trabajamos con hoteles, restaurantes, tours, artesanías y servicios pesqueros." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/chiloe#localbusiness`,
    name: "Mtsprz · Agencia Digital Chiloé",
    description: "Agencia digital en Chiloé. Páginas web, SEO local y automatizaciones para pymes de Chiloé y Los Lagos.",
    url: `${site}/regiones/chiloe`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Chiloé" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Castro",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -42.473, longitude: -73.764 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="chiloe"
      waUrl={waUrl}
      kicker="Chiloé · Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · Chiloé y sur de Chile"
      ctaKicker="Chiloé · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Chiloé."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
