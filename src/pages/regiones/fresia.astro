---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RegionPage from "../../components/RegionPage.astro";

const waPhone = "56966929818";
const waMsg = encodeURIComponent("Hola, vi la página de Fresia en Mtsprz y quiero información sobre sus servicios digitales.");
const waUrl = `https://wa.me/${waPhone}?text=${waMsg}`;
const site = "https://mtsprz.org";

const guides = [
  { href: "/blog/seo-local-pymes-region-los-lagos",
    title: "SEO local para pymes en Los Lagos",
    desc: "Guía completa para posicionar tu negocio en Google Maps." },
  { href: "/blog/cuanto-cuesta-pagina-web-puerto-varas",
    title: "Cuánto cuesta una página web en 2026",
    desc: "Precios reales de desarrollo web en el sur de Chile." },
  { href: "/blog/como-crear-pagina-web-emprendedores-sur-chile",
    title: "Cómo crear página web para emprendedores",
    desc: "Guía paso a paso para tu primer sitio web." },
];

const faqs = [
  { q: "¿Hacen páginas web para negocios en Fresia?",
    a: "Sí. Trabajamos con empresas forestales, agricultores, comercios locales y emprendedores de Fresia. Conocemos el sector productivo de Los Lagos." },
  { q: "¿Cuánto cuesta una página web en Fresia?",
    a: "Landing pages desde $290.000, sitios corporativos desde $690.000. Todos incluyen diseño, dominio + hosting un año, SEO básico y Analytics." },
  { q: "¿Puedo aparecer en Google Maps desde Fresia?",
    a: "Sí. Optimizamos tu perfil Google Business Profile para que aparezcas primero cuando buscan servicios en Fresia y la zona." },
  { q: "¿Trabajan con el sector forestal en Los Lagos?",
    a: "Absolutamente. Fresia es un polo forestal importante. Creamos sitios web para empresas forestales, aserraderos y servicios del rubro." },
];
---

<BaseLayout
  title="Agencia Digital Fresia · Web y SEO Local"
  description="Agencia digital en Fresia: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes. Forestal, agricultura, pequeños negocios. Cotiza gratis."
  canonical="https://mtsprz.org/regiones/fresia"
  breadcrumbs={[{ name: "Fresia", path: "/regiones/fresia" }]}
>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${site}/regiones/fresia#faq`,
    mainEntity: [
      { "@type": "Question", name: "¿Cuánto cuesta una página web en Fresia?", acceptedAnswer: { "@type": "Answer", text: "Landing pages desde $290.000, sitios corporativos desde $690.000, tiendas online desde $1.500.000. Incluye diseño, dominio, hosting y SEO básico." }},
      { "@type": "Question", name: "¿Puedo aparecer en Google Maps desde Fresia?", acceptedAnswer: { "@type": "Answer", text: "Sí. Optimizamos tu Google Business Profile para búsquedas locales. Resultados visibles en 4-8 semanas." }},
      { "@type": "Question", name: "¿Qué servicios digitales ofrecen en Fresia?", acceptedAnswer: { "@type": "Answer", text: "Desarrollo web con Astro, SEO local, automatización de WhatsApp, diseño gráfico y consultoría digital para pymes de Fresia." }},
      { "@type": "Question", name: "¿Trabajan con pequeños negocios en Fresia?", acceptedAnswer: { "@type": "Answer", text: "Sí. Fresia tiene un fuerte sector forestal y agrícola. Trabajamos con negocios locales, empresas del rubro forestal y emprendedores." }}
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site}/regiones/fresia#localbusiness`,
    name: "Mtsprz · Agencia Digital Fresia",
    description: "Agencia digital en Fresia. Páginas web, SEO local y automatizaciones para pymes de Fresia y Los Lagos.",
    url: `${site}/regiones/fresia`,
    telephone: "+56966929818",
    email: "contacto@mtsprz.org",
    areaServed: [
      { "@type": "City", name: "Fresia" },
      { "@type": "AdministrativeArea", name: "Región de Los Lagos" }
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Fresia",
      addressRegion: "Los Lagos",
      addressCountry: "CL"
    },
    geo: { "@type": "GeoCoordinates", latitude: -41.154, longitude: -73.422 },
    parentOrganization: { "@id": `${site}/#organization` }
  })} />

  <Header />
  <main id="main-content" class="overflow-x-clip">
    <RegionPage
      slug="fresia"
      waUrl={waUrl}
      kicker="Los Lagos · Chile"
      subtitle="Diseño web · SEO local · Automatización · Forestal, agricultura y negocios locales"
      ctaKicker="Fresia · Los Lagos"
      webDesc="Sitios ultrarrápidos con Astro. Diseño responsive, carga 1.5s, SEO incluido."
      seoDesc="Aparece primero cuando buscan en Fresia."
      autoDesc="Atiende clientes 24/7, genera reportes automáticos, ahorra 10+ horas semanales."
      guides={guides}
      faqs={faqs}
    />
  </main>
  <Footer />
</BaseLayout>
