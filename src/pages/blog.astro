---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BlogSearch from "../components/BlogSearch.astro";
import Footer from "../components/Footer.astro";
import { author } from "../data/author";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

// Sort by date, newest first
const sortedPosts = [...posts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const featured = sortedPosts[0];
const rest = sortedPosts.slice(1);

function readingTime(text: string): number {
  const words = text.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

function isRecent(d: Date): boolean {
  const weekAgo = new Date();
  weekAgo.setDate(weekAgo.getDate() - 7);
  return d >= weekAgo;
}

// Category label for overlay
function getCategoryLabel(tags: string[]): string {
  const lower = tags.map(t => t.toLowerCase());
  if (lower.some(t => ["seo", "seo local", "google maps", "posicionamiento"].includes(t))) return "SEO LOCAL";
  if (lower.some(t => ["automatización", "whatsapp", "bot", "crm", "email marketing"].includes(t))) return "AUTOMATIZACIÓN";
  if (lower.some(t => ["desarrollo web", "astro", "wordpress", "velocidad", "paginas web"].includes(t))) return "DESARROLLO WEB";
  if (lower.some(t => ["marketing digital", "agencia digital", "marketing"].includes(t))) return "MARKETING";
  return "DIGITAL";
}

// All unique tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))];
---

<BaseLayout
  title="Blog de Marketing Digital y SEO"
  description="Artículos sobre SEO local, marketing digital, desarrollo web y automatizaciones para pymes en la Región de Los Lagos y el sur de Chile."
  canonical="https://mtsprz.org/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://mtsprz.org/blog#blog",
    "name": "Blog de Marketing Digital y SEO | Mtsprz",
    "description": "Artículos sobre SEO local, marketing digital, desarrollo web y automatizaciones para pymes en la Región de Los Lagos y el sur de Chile.",
    "url": "https://mtsprz.org/blog",
    "publisher": { "@id": "https://mtsprz.org/#organization" },
    "blogPost": [
      ...posts.map((p) => ({
        "@type": "BlogPosting",
        "@id": `https://mtsprz.org/blog/${p.id.replace(/\.(md|mdx)$/, "")}#article`,
        "headline": p.data.title,
        "description": p.data.description,
        "datePublished": p.data.pubDate.toISOString(),
        "author": { "@type": "Person", "name": p.data.author || author.name, "url": "https://mtsprz.org/#person" },
      })),
    ],
  })} />
  <Header />
  <link rel="preload" as="video" href="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4" fetchpriority="high" />
  <main id="main-content">

    <!-- ═══════════════════════════════════════════
         HERO · Full-viewport cinematic intro
    ═══════════════════════════════════════════ -->
    <section class="relative w-screen h-[100dvh] md:h-screen overflow-hidden bg-[#0A0A0A]">
      <video
        src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4"
        autoplay loop muted playsinline
        preload="metadata"
        class="z-[1] brightness-[0.4] saturate-[0.55]"
        style="position: absolute !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: center !important; max-width: none !important; min-width: 0 !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; border: 0 !important; display: block !important;"
      />
      <!-- Scrim full-screen: anula las letras del video, lo deja como textura de movimiento -->
      <div style="position: absolute !important; inset: 0; z-index: 2;" class="bg-[#0A0A0A]/[0.8]"></div>
      <div style="position: absolute !important; top: 0; left: 0; width: 100%; height: 24%; z-index: 2;" class="bg-gradient-to-b from-[#0A0A0A] to-transparent"></div>
      <div style="position: absolute !important; bottom: 0; left: 0; width: 100%; height: 45%; z-index: 2;" class="bg-gradient-to-t from-[#0A0A0A] to-transparent"></div>

      <!-- Central content -->
      <div style="position: absolute !important; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center; pointer-events: none;">
        <div class="text-center px-6" style="pointer-events: auto;">
          <p class="text-[10px] md:text-xs uppercase tracking-[0.25em] text-[#6366f1] font-body font-medium mb-4">Blog</p>
          <h1 class="text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-heading font-bold text-white leading-[0.85] tracking-[-3px] md:tracking-[-5px]">
            BLOG
          </h1>
          <p class="mt-5 text-white/45 font-body font-light max-w-md mx-auto text-sm md:text-base leading-relaxed">
            Guías, estrategias y herramientas digitales para pymes del sur de Chile
          </p>
          <!-- Tag pills -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            {allTags.slice(0, 6).map((tag) => (
              <span class="inline-flex items-center px-3 py-1 text-[10px] font-body tracking-[0.08em] uppercase text-white/40 border border-white/[0.1] rounded-full hover:text-white/70 hover:border-white/20 transition-all cursor-default">
                {tag}
              </span>
            ))}
          </div>

          <!-- Search -->
          <div class="mt-8 flex justify-center">
            <BlogSearch />
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-0 w-full flex justify-center z-10">
        <div class="w-5 h-8 rounded-full border border-white/15 flex items-start justify-center pt-1.5">
          <div class="w-1 h-2 rounded-full bg-white/30" />
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         FEATURED · Full-bleed cinematic column
    ═══════════════════════════════════════════ -->
    {
      featured && (() => {
        const fSlug = featured.id.replace(/\.(md|mdx)$/, "");
        const fReadMin = readingTime(featured.body || "");
        const fImg = featured.data.image || "/logo.jpg";
        const fCat = getCategoryLabel(featured.data.tags || []);
        return (
          <section class="relative w-full overflow-hidden bg-[#0A0A0A]">
            <a href={`/blog/${fSlug}`} class="group block relative w-full h-[80dvh] md:h-[90vh] overflow-hidden">
              <!-- Base plate: fondo sólido tras la imagen -->
              <div class="absolute inset-0 bg-[#0A0A0A]" />
              <!-- Full-bleed image · se muestra como textura, no como texto legible -->
              <img
                src={featured.data.image || "/logo.jpg"}
                alt={featured.data.title}
                class="absolute inset-0 w-full h-full object-cover opacity-25 brightness-[0.85] transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <!-- Dark gradient overlay · bottom heavy, cubre el texto horneado del OG -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#0A0A0A]/70 to-transparent" />
              <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A]/50 via-transparent to-transparent h-32" />

              <!-- Content overlaid at bottom -->
              <div class="absolute bottom-0 left-0 right-0 z-10 px-6 md:px-12 lg:px-16 pb-12 md:pb-16 lg:pb-20">
                <div class="max-w-6xl mx-auto">
                  {/* Category · large bold label */}
                  <p class="text-[11px] md:text-xs uppercase tracking-[0.3em] font-body font-medium mb-3 md:mb-4" style="color: #6366f1;">
                    {fCat}
                  </p>

                  {/* Title · massive editorial */}
                  <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-bold text-white leading-[0.95] tracking-[-1px] md:tracking-[-2px] max-w-4xl group-hover:text-white/80 transition-colors duration-500">
                    {featured.data.title}
                  </h2>

                  {/* Meta + CTA row */}
                  <div class="mt-5 md:mt-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
                    <div class="flex items-center gap-3 text-[11px] md:text-xs text-white/40 font-body tracking-wide">
                      <time datetime={featured.data.pubDate.toISOString()}>
                        {featured.data.pubDate.toLocaleDateString("es-CL", {
                          year: "numeric",
                          month: "long",
                          day: "numeric",
                        })}
                      </time>
                      <span class="text-white/15">·</span>
                      <span>{fReadMin} min de lectura</span>
                      {featured.data.modifiedTime && (
                        <>
                          <span class="text-white/15">·</span>
                          <span class="text-emerald-400/70">Actualizado</span>
                        </>
                      )}
                    </div>

                    {/* CTA button · solid dark, editorial */}
                    <span class="inline-flex items-center gap-2.5 px-6 py-3 bg-white/[0.08] hover:bg-white/[0.14] text-white text-[11px] font-body font-medium tracking-[0.18em] uppercase transition-all duration-300 group-hover:gap-3.5">
                      Explorar guía
                      <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                    </span>
                  </div>
                </div>
              </div>
            </a>
          </section>
        );
      })()
    }

    <!-- ═══════════════════════════════════════════
         ARTÍCULOS · Editorial panel grid
         Cards: imagen arriba (arte) + texto abajo en panel sólido.
         Los OG traen el título horneado dentro de la imagen, por eso
         el texto va FUERA de la imagen. Cero texto sobre texto.
    ═══════════════════════════════════════════ -->
    <section class="relative w-full bg-[#0A0A0A]">
      <!-- Section label -->
      <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-16 pt-16 md:pt-24 pb-8 md:pb-12">
        <div class="flex items-end justify-between gap-6">
          <p class="text-[10px] md:text-xs uppercase tracking-[0.25em] font-body font-medium" style="color: #6366f1aa;">
            Últimos artículos
          </p>
          <p class="text-[10px] md:text-xs font-body tracking-[0.15em] text-white/25 hidden sm:block">
            {sortedPosts.length} artículos
          </p>
        </div>
      </div>

      <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-16 pb-16 md:pb-24 space-y-5 md:space-y-8" style="content-visibility:auto; contain-intrinsic-size: 2200px;">

        <!-- ─── Tier 1 · Dos grandes, asimétricos 7/5 ─── -->
        <div class="grid grid-cols-1 gap-5 md:grid-cols-12 md:gap-6">
        {rest.slice(0, 2).map((post, i) => {
          const postSlug = post.id.replace(/\.(md|mdx)$/, "");
          const readMin = readingTime(post.body || "");
          const img = post.data.image || "/logo.jpg";
          const cat = getCategoryLabel(post.data.tags || []);
          return (
            <a
              href={`/blog/${postSlug}`}
              class={`group relative flex h-full flex-col overflow-hidden rounded-lg border border-white/[0.05] bg-[#0D0D0F] transition-all duration-300 hover:border-white/[0.12] hover:bg-[#111114] ${i === 0 ? "md:col-span-7" : "md:col-span-5"}`}
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-[#0A0A0A]">
                <img
                  src={img}
                  alt={post.data.title}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                />
                {/* Fusión imagen → panel */}
                <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#0D0D0F] to-transparent" />
                {/* Recent badge */}
                {isRecent(post.data.pubDate) && (
                  <div class="absolute top-4 left-4 flex items-center gap-1.5 px-2.5 py-1 bg-[#0A0A0A]/70 backdrop-blur-sm text-white text-[10px] font-body font-medium tracking-[0.08em] uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#6366f1] animate-pulse" />
                    Nuevo
                  </div>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5 md:p-6">
                <p class="text-[10px] uppercase tracking-[0.25em] font-body font-medium mb-2" style="color: #6366f1;">
                  {cat}
                </p>
                <h2 class="font-heading font-bold text-white leading-[1.15] tracking-[-0.02em] text-xl md:text-2xl lg:text-[1.7rem] line-clamp-3 group-hover:text-white/80 transition-colors duration-300">
                  {post.data.title}
                </h2>
                <div class="mt-auto pt-5 flex items-center justify-between gap-4">
                  <div class="flex items-center gap-2 text-[11px] text-white/40 font-body tracking-wide">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString("es-CL", { month: "long", day: "numeric" })}
                    </time>
                    <span class="text-white/15">·</span>
                    <span>{readMin} min</span>
                    {post.data.modifiedTime && (
                      <>
                        <span class="text-white/15">·</span>
                        <span class="text-emerald-400/70">Actualizado</span>
                      </>
                    )}
                  </div>
                  <span class="inline-flex items-center gap-2 text-[10px] font-body font-medium tracking-[0.15em] uppercase text-white/50 group-hover:text-white transition-all duration-300 group-hover:gap-3">
                    Explorar
                    <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
        </div>

        <!-- ─── Tier 2 · Tres medianas ─── -->
        {rest.length > 2 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 md:gap-6">
            {rest.slice(2, 5).map((post) => {
              const postSlug = post.id.replace(/\.(md|mdx)$/, "");
              const readMin = readingTime(post.body || "");
              const img = post.data.image || "/logo.jpg";
              const cat = getCategoryLabel(post.data.tags || []);
              return (
                <a
                  href={`/blog/${postSlug}`}
                  class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-white/[0.05] bg-[#0D0D0F] transition-all duration-300 hover:border-white/[0.12] hover:bg-[#111114]"
                >
                  <div class="relative aspect-[4/3] overflow-hidden bg-[#0A0A0A]">
                    <img
                      src={img}
                      alt={post.data.title}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                    />
                    <div class="absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-[#0D0D0F] to-transparent" />
                    {isRecent(post.data.pubDate) && (
                      <div class="absolute top-3.5 left-3.5 flex items-center gap-1.5 px-2 py-0.5 bg-[#0A0A0A]/70 backdrop-blur-sm text-white text-[9px] font-body font-medium tracking-[0.08em] uppercase">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#6366f1] animate-pulse" />
                        Nuevo
                      </div>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col p-5">
                    <p class="text-[9px] uppercase tracking-[0.25em] font-body font-medium mb-2" style="color: #6366f1;">
                      {cat}
                    </p>
                    <h3 class="font-heading font-bold text-white leading-[1.2] tracking-[-0.02em] text-lg md:text-xl line-clamp-3 group-hover:text-white/80 transition-colors duration-300">
                      {post.data.title}
                    </h3>
                    <div class="mt-auto pt-4 flex items-center gap-2 text-[10px] text-white/35 font-body tracking-wide">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString("es-CL", { month: "short", day: "numeric" })}
                      </time>
                      <span class="text-white/15">·</span>
                      <span>{readMin} min</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}

        <!-- ─── Tier 3 · Cuatro compactas ─── -->
        {rest.length > 5 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
            {rest.slice(5, 9).map((post) => {
              const postSlug = post.id.replace(/\.(md|mdx)$/, "");
              const readMin = readingTime(post.body || "");
              const img = post.data.image || "/logo.jpg";
              const cat = getCategoryLabel(post.data.tags || []);
              return (
                <a
                  href={`/blog/${postSlug}`}
                  class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-white/[0.05] bg-[#0D0D0F] transition-all duration-300 hover:border-white/[0.12] hover:bg-[#111114]"
                >
                  <div class="relative aspect-[3/2] overflow-hidden bg-[#0A0A0A]">
                    <img
                      src={img}
                      alt={post.data.title}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                    />
                    <div class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-[#0D0D0F] to-transparent" />
                  </div>
                  <div class="flex flex-1 flex-col p-4 md:p-5">
                    <p class="text-[8px] uppercase tracking-[0.2em] font-body font-medium mb-1.5" style="color: #6366f1;">
                      {cat}
                    </p>
                    <h4 class="font-heading font-bold text-white leading-[1.25] tracking-[-0.01em] text-sm md:text-[15px] line-clamp-2 group-hover:text-white/80 transition-colors duration-300">
                      {post.data.title}
                    </h4>
                    <div class="mt-auto pt-3 flex items-center gap-2 text-[10px] text-white/30 font-body tracking-wide">
                      <time>{post.data.pubDate.toLocaleDateString("es-CL", { month: "short", day: "numeric" })}</time>
                      <span class="text-white/15">·</span>
                      <span>{readMin} min</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}

        <!-- ─── Tier 4 · Filas restantes ─── -->
        {rest.length > 9 && (
          <>
            <div class="h-[1px]" style="background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);" />
            <div class="pt-4 md:pt-6">
              {rest.slice(9).map((post) => {
                const postSlug = post.id.replace(/\.(md|mdx)$/, "");
                const readMin = readingTime(post.body || "");
                const cat = getCategoryLabel(post.data.tags || []);
                return (
                  <a
                    href={`/blog/${postSlug}`}
                    class="group flex items-center justify-between gap-4 py-4 border-b border-white/[0.04] hover:border-white/[0.1] transition-all duration-300"
                  >
                    <div class="flex items-center gap-4 min-w-0">
                      <span class="text-[9px] uppercase tracking-[0.15em] font-body font-medium shrink-0" style="color: #6366f1aa;">
                        {cat}
                      </span>
                      <h4 class="text-sm md:text-[15px] font-body font-medium text-white/55 group-hover:text-white transition-colors duration-300 truncate">
                        {post.data.title}
                      </h4>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                      <span class="text-[10px] text-white/20 font-body tracking-wide hidden sm:block">
                        {post.data.pubDate.toLocaleDateString("es-CL", { month: "short", day: "numeric" })}
                      </span>
                      <span class="text-[10px] text-white/20 font-body tracking-wide hidden md:block">
                        {readMin} min
                      </span>
                      <svg class="w-3 h-3 text-white/15 group-hover:text-white/50 transition-all group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                    </div>
                  </a>
                );
              })}
            </div>
          </>
        )}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         NEWSLETTER · Minimal CTA
    ═══════════════════════════════════════════ -->
    <section class="relative bg-[#0A0A0A] w-full overflow-hidden">
      <div class="absolute inset-0 opacity-30" style="background: radial-gradient(ellipse at 50% 50%, #6366f112 0%, transparent 60%);" />
      <div class="absolute top-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f122, transparent);" />

      <div class="relative mx-auto max-w-2xl px-6 py-20 md:py-28 text-center">
        <div class="reveal-group">
          <p class="reveal-item text-[10px] md:text-xs uppercase tracking-[0.25em] font-body font-medium mb-5" style="color: #6366f1aa;">No te pierdas nada</p>
          <h2 class="reveal-item text-2xl sm:text-3xl md:text-4xl font-heading font-bold text-white leading-[1.1] tracking-[-0.5px] md:tracking-[-1px]">
            Artículos sobre digital<br />para tu negocio
          </h2>
          <p class="reveal-item mt-3 text-sm text-white/40 font-body font-light">
            SEO, automatizaciones, desarrollo web y más. Directo a tu bandeja.
          </p>
          <form id="newsletter-form" class="reveal-item mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto" novalidate>
            <input
              id="newsletter-email"
              type="email"
              required
              placeholder="tu@email.com"
              class="w-full sm:flex-1 px-4 py-3 bg-white/[0.04] border border-white/[0.08] text-sm text-white font-body placeholder:text-white/25 focus:outline-none focus:border-[#6366f1]/50 transition-colors"
            />
            <button type="submit" id="newsletter-btn" class="w-full sm:w-auto px-6 py-3 bg-white/[0.08] hover:bg-white/[0.14] text-white text-[11px] font-body font-medium tracking-[0.15em] uppercase transition-all cursor-pointer">
              Suscribir
            </button>
          </form>
          <p id="newsletter-status" class="hidden text-xs font-body mt-3"></p>
        </div>
      </div>
    </section>
    <script is:inline>
    (function() {
      var form = document.getElementById('newsletter-form');
      if (!form) return;
      var emailInput = document.getElementById('newsletter-email');
      var status = document.getElementById('newsletter-status');
      var btn = document.getElementById('newsletter-btn');
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var email = (emailInput.value || '').trim().toLowerCase();
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          status.textContent = 'Ingresa un correo válido';
          status.className = 'text-xs font-body mt-3 text-red-400';
          return;
        }
        btn.disabled = true;
        btn.textContent = 'Enviando...';
        try {
          var res = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: '', email: email, source: 'web', service_interest: 'newsletter' }),
          });
          var data = await res.json();
          if (res.ok) {
            status.textContent = '¡Listo! Te avisamos de los próximos artículos.';
            status.className = 'text-xs font-body mt-3 text-emerald-400';
            emailInput.value = '';
            if (window.trackEvent) window.trackEvent('newsletter_subscribed');
          } else {
            status.textContent = data.error || 'Error al suscribir. Intenta de nuevo.';
            status.className = 'text-xs font-body mt-3 text-red-400';
          }
        } catch (err) {
          status.textContent = 'Error de conexión. Intenta de nuevo.';
          status.className = 'text-xs font-body mt-3 text-red-400';
        }
        btn.disabled = false;
        btn.textContent = 'Suscribir';
      });
    })();
    </script>
  </main>
  <Footer />
</BaseLayout>
