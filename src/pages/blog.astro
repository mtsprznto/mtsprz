    ═══════════════════════════════════════════ -->
    <section id="newsletter" class="relative w-full scroll-mt-20 overflow-hidden border-t border-frame/60 bg-bg">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background: radial-gradient(ellipse 60% 50% at 50% 0%, #00FF660D 0%, transparent 70%);" />

      <div class="relative mx-auto max-w-2xl px-4 py-20 text-center sm:px-6 md:py-28 lg:px-8">
        <div class="reveal-group">
          <p class="reveal-item font-mono text-[11px] uppercase tracking-[0.14em] text-accent">// no te pierdas nada</p>
          <h2 class="reveal-item mt-4 font-heading text-2xl font-bold leading-[1.1] tracking-[-0.02em] text-text-primary sm:text-3xl md:text-4xl">
            Artículos sobre digital<br />para tu negocio
          </h2>
          <p class="reveal-item mt-3 font-body text-sm text-text-secondary">
            SEO, automatizaciones, desarrollo web y más. Directo a tu bandeja.
          </p>
          <form id="newsletter-form" class="reveal-item mx-auto mt-8 flex max-w-md flex-col items-center justify-center gap-3 sm:flex-row" novalidate>
            <input
              id="newsletter-email"
              type="email"
              required
              placeholder="tu@email.com"
              class="w-full rounded-[4px] border border-frame bg-surface px-4 py-3 font-mono text-sm text-text-primary transition-colors placeholder:text-text-tertiary focus:border-accent focus:outline-none sm:flex-1"
            />
            <button type="submit" id="newsletter-btn" class="w-full cursor-pointer rounded-[4px] border border-accent/40 bg-accent-subtle px-5 py-3 font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-accent transition-colors hover:border-accent hover:bg-accent hover:text-bg sm:w-auto">
              Suscribir
            </button>
          </form>
          <p id="newsletter-status" class="mt-3 hidden font-mono text-[11px]"></p>
        </div>
      </div>
    </section>
    <script is:inline>
    (function() {
      var form = document.getElementById('newsletter-form');
      if (!form) return;
      var emailInput = document.getElementById('newsletter-email');
      var status = document.getElementById('newsletter-status');
      var btn = document.getElementById('newsletter-btn');
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var email = (emailInput.value || '').trim().toLowerCase();
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          status.textContent = 'Ingresa un correo válido';
          status.className = 'mt-3 font-mono text-[11px] text-danger';
          return;
        }
        btn.disabled = true;
        btn.textContent = 'Enviando...';
        try {
          var res = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: '', email: email, source: 'web', service_interest: 'newsletter' }),
          });
          var data = await res.json();
          if (res.ok) {
            status.textContent = '¡Listo! Te avisamos de los próximos artículos.';
            status.className = 'mt-3 font-mono text-[11px] text-accent';
            emailInput.value = '';
            if (window.trackEvent) window.trackEvent('newsletter_subscribed');
          } else {
            status.textContent = data.error || 'Error al suscribir. Intenta de nuevo.';
            status.className = 'mt-3 font-mono text-[11px] text-danger';
          }
        } catch (err) {
          status.textContent = 'Error de conexión. Intenta de nuevo.';
          status.className = 'mt-3 font-mono text-[11px] text-danger';
        }
        btn.disabled = false;
        btn.textContent = 'Suscribir';
      });
    })();
    </script>
