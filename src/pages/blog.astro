---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

// Sort by date, newest first
const sortedPosts = [...posts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const featured = sortedPosts[0];
const rest = sortedPosts.slice(1);

function readingTime(text: string): number {
  const words = text.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

function isRecent(d: Date): boolean {
  const weekAgo = new Date();
  weekAgo.setDate(weekAgo.getDate() - 7);
  return d >= weekAgo;
}

// All unique tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))];
---

<BaseLayout
  title="Blog de Marketing Digital y SEO — Mtsprz"
  description="Artículos sobre SEO local, marketing digital, desarrollo web y automatizaciones para pymes en la Región de Los Lagos y el sur de Chile."
  canonical="https://mtsprz.org/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://mtsprz.org/blog#blog",
    "name": "Blog de Marketing Digital y SEO | Mtsprz",
    "description": "Artículos sobre SEO local, marketing digital, desarrollo web y automatizaciones para pymes en la Región de Los Lagos y el sur de Chile.",
    "url": "https://mtsprz.org/blog",
    "publisher": { "@id": "https://mtsprz.org/#organization" },
    "blogPost": [
      ...posts.map((p) => ({
        "@type": "BlogPosting",
        "@id": `https://mtsprz.org/blog/${p.id.replace(/\.(md|mdx)$/, "")}#article`,
        "headline": p.data.title,
        "description": p.data.description,
        "datePublished": p.data.pubDate.toISOString(),
        "author": { "@type": "Person", "name": p.data.author || "Mtsprz", "url": "https://mtsprz.org/#person" },
      })),
    ],
  })} />
  <Header />
  <link rel="preload" as="video" href="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4" fetchpriority="high" />
  <main>
    <!-- Hero — video background full-bleed -->
    <section class="relative w-screen h-[70dvh] md:h-[80vh] overflow-hidden bg-[#010101]">
      <video
        src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4"
        autoplay loop muted playsinline
        preload="auto"
        class="z-[1]"
        style="position: absolute !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: center !important; max-width: none !important; min-width: 0 !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; border: 0 !important; display: block !important;"
      />
      <div style="position: absolute !important; top: 0; left: 0; width: 100%; height: 24%; z-index: 2;" class="bg-gradient-to-b from-[#010101] to-transparent sm:h-32"></div>
      <div style="position: absolute !important; bottom: 0; left: 0; width: 100%; height: 40%; z-index: 2;" class="bg-gradient-to-t from-[#010101] to-transparent sm:h-48"></div>

      <!-- Contenido central -->
      <div style="position: absolute !important; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center; pointer-events: none;">
        <div class="text-center px-6" style="pointer-events: auto;">
          <p class="text-[10px] md:text-xs uppercase tracking-[0.25em] text-[#6366f1] font-body font-medium mb-4">Blog</p>
          <h1 class="text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-heading font-bold text-white leading-[0.85] tracking-[-3px] md:tracking-[-5px]">
            BLOG
          </h1>
          <p class="mt-5 text-white/45 font-body font-light max-w-md mx-auto text-sm md:text-base leading-relaxed">
            Guías, estrategias y herramientas digitales para pymes del sur de Chile
          </p>
          <!-- Tag pills -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            {allTags.slice(0, 6).map((tag) => (
              <span class="inline-flex items-center px-3 py-1 text-[10px] font-body tracking-[0.08em] uppercase text-white/30 border border-white/[0.06] rounded-full hover:text-white/60 hover:border-white/15 transition-all cursor-default">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Breadcrumb -->
      <div class="absolute bottom-6 md:bottom-8 left-0 right-0 z-20 px-6">
        <div class="mx-auto max-w-6xl">
          <Breadcrumbs items={[{ name: "Blog", path: "/blog" }]} />
        </div>
      </div>
    </section>

    <!-- Featured post — editorial hero card -->
    {
      featured && (() => {
        const fSlug = featured.id.replace(/\.(md|mdx)$/, "");
        const fReadMin = readingTime(featured.body || "");
        const fImg = featured.data.image || "/logo.jpg";
        return (
          <section class="relative bg-[#0A0A0A] w-full overflow-hidden">
            <div class="absolute inset-0" style="background: #0A0A0A;" />
            <div class="absolute inset-0 opacity-40" style="background: radial-gradient(ellipse at 50% 0%, #6366f112 0%, transparent 60%);" />
            <div class="absolute top-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f144, transparent);" />

            <div class="relative mx-auto max-w-6xl px-6 pt-20 md:pt-28 pb-8 md:pb-12">
              <div class="reveal-group">
                <p class="reveal-item text-[10px] md:text-xs uppercase tracking-[0.25em] font-body font-medium mb-6 md:mb-8" style="color: #6366f1aa;">Artículo destacado</p>

                <a href={`/blog/${fSlug}`} class="reveal-item group block relative overflow-hidden rounded-lg md:rounded-xl bg-[#111113] border border-white/[0.04] hover:border-white/[0.08] transition-all duration-500">
                  <div class="flex flex-col lg:flex-row">
                    <!-- Image -->
                    <div class="relative w-full lg:w-[55%] aspect-[16/10] lg:aspect-auto lg:min-h-[420px] overflow-hidden">
                      <img
                        src={fImg}
                        alt={featured.data.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                        loading="eager"
                        decoding="async"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-transparent lg:to-[#111113]/90" />
                      {isRecent(featured.data.pubDate) && (
                        <div class="absolute top-4 left-4 flex items-center gap-1.5 px-2.5 py-1 bg-[#6366f1] text-white text-[10px] font-body font-medium tracking-[0.08em] uppercase rounded">
                          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse" />
                          Nuevo
                        </div>
                      )}
                    </div>

                    <!-- Content -->
                    <div class="relative flex-1 p-6 md:p-8 lg:p-10 flex flex-col justify-center">
                      <div class="flex flex-wrap items-center gap-2.5 text-[11px] text-white/30 font-body tracking-wide mb-4">
                        <time datetime={featured.data.pubDate.toISOString()}>
                          {featured.data.pubDate.toLocaleDateString("es-CL", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                          })}
                        </time>
                        <span class="text-white/15">&middot;</span>
                        <span>{fReadMin} min de lectura</span>
                        {featured.data.modifiedTime && (
                          <>
                            <span class="text-white/15">&middot;</span>
                            <span class="text-emerald-400/70">Actualizado</span>
                          </>
                        )}
                      </div>

                      <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-bold text-white leading-[1.05] tracking-[-0.5px] md:tracking-[-1px] group-hover:text-white/70 transition-colors duration-300">
                        {featured.data.title}
                      </h2>

                      <p class="mt-3 md:mt-4 text-sm md:text-[15px] text-white/45 font-body font-light leading-relaxed line-clamp-3">
                        {featured.data.description}
                      </p>

                      <div class="mt-5 md:mt-6 flex flex-wrap gap-2">
                        {(featured.data.tags || []).slice(0, 4).map((tag) => (
                          <span class="inline-flex items-center px-2.5 py-1 text-[10px] font-body tracking-[0.05em] uppercase text-white/25 border border-white/[0.06] rounded">
                            {tag}
                          </span>
                        ))}
                      </div>

                      <div class="mt-6 md:mt-8 flex items-center gap-2 text-[11px] font-body tracking-[0.1em] uppercase text-[#6366f1] group-hover:text-[#818cf8] transition-colors">
                        <span>Leer artículo</span>
                        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          </section>
        );
      })()
    }

    <!-- All posts — editorial grid -->
    <section class="relative bg-[#0A0A0A] w-full overflow-hidden">
      <div class="absolute inset-0" style="background: #0A0A0A;" />
      <div class="absolute inset-0 opacity-30" style="background: radial-gradient(ellipse at 70% 30%, #8b5cf608 0%, transparent 50%), radial-gradient(ellipse at 20% 80%, #6366f106 0%, transparent 50%);" />
      <div class="absolute inset-0 opacity-[0.012] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noise)\' opacity=\'1\'/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;" />
      <div class="absolute top-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f122, transparent);" />

      <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-24">
        <div class="reveal-group">
          <p class="reveal-item text-[10px] md:text-xs uppercase tracking-[0.25em] font-body font-medium mb-10 md:mb-14" style="color: #6366f1aa;">Últimos artículos</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
            {
              rest.map((post, i) => {
                const postSlug = post.id.replace(/\.(md|mdx)$/, "");
                const readMin = readingTime(post.body || "");
                const img = post.data.image || "/logo.jpg";
                const isLarge = i === 0; // first remaining post gets larger treatment
                return (
                  <article class={`reveal-item group ${isLarge ? 'md:col-span-2' : ''}`}>
                    <a
                      href={`/blog/${postSlug}`}
                      class={`block relative overflow-hidden rounded-lg bg-[#111113] border border-white/[0.04] hover:border-white/[0.08] transition-all duration-500 ${isLarge ? 'flex flex-col sm:flex-row' : ''}`}
                    >
                      <!-- Image -->
                      <div class={`relative overflow-hidden ${isLarge ? 'w-full sm:w-[45%] aspect-[16/10] sm:aspect-auto sm:min-h-[280px]' : 'aspect-[16/9]'}`}>
                        <img
                          src={img}
                          alt={post.data.title}
                          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                          loading="lazy"
                          decoding="async"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" />
                        {isRecent(post.data.pubDate) && (
                          <div class="absolute top-3 left-3 flex items-center gap-1.5 px-2 py-0.5 bg-[#6366f1]/90 text-white text-[9px] font-body font-medium tracking-[0.06em] uppercase rounded">
                            <span class="w-1 h-1 rounded-full bg-white animate-pulse" />
                            Nuevo
                          </div>
                        )}
                      </div>

                      <!-- Content -->
                      <div class={`flex-1 p-5 md:p-6 flex flex-col ${isLarge ? 'justify-center' : ''}`}>
                        <div class="flex flex-wrap items-center gap-2 text-[10px] md:text-[11px] text-white/30 font-body tracking-wide mb-2.5">
                          <time datetime={post.data.pubDate.toISOString()}>
                            {post.data.pubDate.toLocaleDateString("es-CL", {
                              year: "numeric",
                              month: "long",
                              day: "numeric",
                            })}
                          </time>
                          <span class="text-white/15">&middot;</span>
                          <span>{readMin} min</span>
                          {post.data.modifiedTime && (
                            <>
                              <span class="text-white/15">&middot;</span>
                              <span class="text-emerald-400/70">Act.</span>
                            </>
                          )}
                        </div>

                        <h2 class={`font-heading font-bold text-white leading-snug tracking-[-0.3px] md:tracking-[-0.5px] group-hover:text-white/60 transition-colors duration-300 ${isLarge ? 'text-xl sm:text-2xl md:text-3xl' : 'text-lg md:text-xl'}`}>
                          {post.data.title}
                        </h2>

                        <p class={`mt-2 text-sm text-white/40 font-body font-light leading-relaxed line-clamp-2 ${isLarge ? 'max-w-xl' : ''}`}>
                          {post.data.description}
                        </p>

                        <div class="mt-3 md:mt-4 flex flex-wrap gap-x-3 gap-y-1">
                          {(post.data.tags || []).slice(0, 3).map((tag) => (
                            <span class="text-[9px] md:text-[10px] text-white/20 font-body tracking-[0.05em] uppercase">
                              {tag}
                            </span>
                          ))}
                        </div>

                        <div class="mt-4 flex items-center gap-1.5 text-[10px] font-body tracking-[0.1em] uppercase text-[#6366f1]/70 group-hover:text-[#6366f1] transition-colors">
                          <span>Leer</span>
                          <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                        </div>
                      </div>
                    </a>
                  </article>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="relative bg-[#0A0A0A] w-full overflow-hidden">
      <div class="absolute inset-0" style="background: #0A0A0A;" />
      <div class="absolute inset-0 opacity-50" style="background: radial-gradient(ellipse at 50% 50%, #6366f118 0%, transparent 60%);" />
      <div class="absolute top-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f133, transparent);" />

      <div class="relative mx-auto max-w-2xl px-6 py-20 md:py-28 text-center">
        <div class="reveal-group">
          <p class="reveal-item text-[10px] md:text-xs uppercase tracking-[0.25em] font-body font-medium mb-5" style="color: #6366f1aa;">No te pierdas nada</p>
          <h2 class="reveal-item text-2xl sm:text-3xl md:text-4xl font-heading font-bold text-white leading-[1.1] tracking-[-0.5px] md:tracking-[-1px]">
            Artículos sobre digital<br />para tu negocio
          </h2>
          <p class="reveal-item mt-3 text-sm text-white/40 font-body font-light">
            SEO, automatizaciones, desarrollo web y más. Directo a tu bandeja.
          </p>
          <div class="reveal-item mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
            <input
              type="email"
              placeholder="tu@email.com"
              class="w-full sm:flex-1 px-4 py-3 bg-white/[0.04] border border-white/[0.08] rounded-lg text-sm text-white font-body placeholder:text-white/25 focus:outline-none focus:border-[#6366f1]/50 transition-colors"
            />
            <button class="w-full sm:w-auto px-6 py-3 bg-[#6366f1] hover:bg-[#818cf8] text-white text-sm font-medium tracking-[0.1em] uppercase rounded-lg transition-all cursor-pointer">
              Suscribir
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
