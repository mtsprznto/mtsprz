---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import BlogSearch from "../components/BlogSearch.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/ui/PageHero.astro";
import WebcoreWindow from "../components/ui/WebcoreWindow.astro";
import { author } from "../data/author";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

// Sort by date, newest first
const sortedPosts = [...posts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const featured = sortedPosts[0];
const rest = sortedPosts.slice(1);

function readingTime(text: string): number {
  const words = text.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

function isRecent(d: Date): boolean {
  const weekAgo = new Date();
  weekAgo.setDate(weekAgo.getDate() - 7);
  return d >= weekAgo;
}

// Category label for overlay
function getCategoryLabel(tags: string[]): string {
  const lower = tags.map(t => t.toLowerCase());
  if (lower.some(t => ["seo", "seo local", "google maps", "posicionamiento"].includes(t))) return "SEO LOCAL";
  if (lower.some(t => ["automatización", "whatsapp", "bot", "crm", "email marketing"].includes(t))) return "AUTOMATIZACIÓN";
  if (lower.some(t => ["desarrollo web", "astro", "wordpress", "velocidad", "paginas web"].includes(t))) return "DESARROLLO WEB";
  if (lower.some(t => ["marketing digital", "agencia digital", "marketing"].includes(t))) return "MARKETING";
  return "DIGITAL";
}

// Acento por categoría (DESIGN §2.3) — uso puntual: punto guía en labels, nunca texto
function getCategoryAccent(tags: string[]): string {
  switch (getCategoryLabel(tags)) {
    case "SEO LOCAL": return "#22E584";
    case "AUTOMATIZACIÓN": return "#22D3EE";
    case "DESARROLLO WEB": return "#00FF66";
    case "MARKETING": return "#EAB308";
    default: return "#A855F7";
  }
}

// All unique tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))];

const heroVideo =
  "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4";
const anio = new Date().getFullYear();
---

<BaseLayout
  title="Blog de Marketing Digital y SEO"
  description="Artículos sobre SEO local, marketing digital, desarrollo web y automatizaciones para pymes en la Región de Los Lagos y el sur de Chile."
  canonical="https://mtsprz.org/blog"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://mtsprz.org/blog#blog",
    "name": "Blog de Marketing Digital y SEO | Mtsprz",
    "description": "Artículos sobre SEO local, marketing digital, desarrollo web y automatizaciones para pymes en la Región de Los Lagos y el sur de Chile.",
    "url": "https://mtsprz.org/blog",
    "publisher": { "@id": "https://mtsprz.org/#organization" },
    "blogPost": [
      ...posts.map((p) => ({
        "@type": "BlogPosting",
        "@id": `https://mtsprz.org/blog/${p.id.replace(/\.(md|mdx)$/, "")}#article`,
        "headline": p.data.title,
        "description": p.data.description,
        "datePublished": p.data.pubDate.toISOString(),
        "author": { "@type": "Person", "name": p.data.author || author.name, "url": "https://mtsprz.org/#person" },
      })),
    ],
  })} />
  <Header />
  <link rel="preload" as="video" href={heroVideo} fetchpriority="high" />
  <main id="main-content">

    <!-- ═══════════════════════════════════════════
         Hero · primitiva reutilizable ui/PageHero (mismo patrón que home, /servicios, /portafolio y /casos)
    ═══════════════════════════════════════════ -->
    <PageHero
      ledLabel={`${posts.length} artículos publicados`}
      eyebrow="// blog · marketing digital y seo"
      title="Marketing digital y SEO"
      titleAccent="explicado para pymes."
      subtitle="Guías, estrategias y herramientas digitales para pymes del sur de Chile. Publicamos lo que probamos en proyectos reales: sin relleno y sin humo."
      videoUrl={heroVideo}
      breadcrumbs={[{ name: "Blog", path: "/blog" }]}
      meta={`© ${anio} mtsprz · puerto varas`}
    >
      <Fragment slot="actions">
        <a
          href="#articulos"
          class="inline-flex items-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover sm:text-sm"
          >[ Explorar artículos ]</a
        >
        <a
          href="#newsletter"
          class="inline-flex items-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-wider text-text-primary transition-colors hover:border-accent hover:text-accent sm:text-sm"
          >[ Suscribirme ]</a
        >
      </Fragment>

      <Fragment slot="aside">
        <WebcoreWindow title="blog --list" variant="sunken">
          <ul class="divide-y divide-frame">
            {sortedPosts.slice(0, 5).map((p, idx) => {
              const pSlug = p.id.replace(/\.(md|mdx)$/, "");
              return (
                <li class="flex items-center gap-3 px-4 py-3">
                  <span class="font-mono text-[11px] text-text-tertiary">
                    [{String(idx + 1).padStart(2, "0")}]
                  </span>
                  <a
                    href={`/blog/${pSlug}`}
                    class="min-w-0 truncate font-body text-sm text-text-primary transition-colors hover:text-accent"
                  >
                    {p.data.title}
                  </a>
                  <span class="ml-auto hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-text-tertiary sm:block">
                    {p.data.pubDate.toLocaleDateString("es-CL", { day: "2-digit", month: "short" })}
                  </span>
                </li>
              );
            })}
          </ul>
          <div class="flex items-center justify-between border-t border-frame px-4 py-2.5 font-mono text-[11px]">
            <span class="text-text-tertiary">{posts.length} artículos</span>
            <a href="#articulos" class="text-text-secondary transition-colors hover:text-accent">
              explorar ↓
            </a>
          </div>
        </WebcoreWindow>
      </Fragment>
    </PageHero>

    <!-- Strip de control · búsqueda + temas de portada (ex-hero v1) -->
    <section class="w-full border-b border-frame/60 bg-bg" aria-label="Buscar en el blog">
      <div class="flex w-full flex-col gap-4 px-4 py-5 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:px-8 xl:px-12">
        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 font-mono text-[11px] uppercase tracking-[0.14em] text-text-tertiary">temas:</span>
          {allTags.slice(0, 6).map((tag) => (
            <span class="inline-flex items-center rounded-[4px] border border-frame bg-surface px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
              {tag}
            </span>
          ))}
        </div>
        <div class="w-full lg:w-[380px] lg:shrink-0">
          <BlogSearch />
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         FEATURED · Columna cinematográfica full-bleed (§5.4) — post destacado
    ═══════════════════════════════════════════ -->
    {
      featured && (() => {
        const fSlug = featured.id.replace(/\.(md|mdx)$/, "");
        const fReadMin = readingTime(featured.body || "");
        const fCat = getCategoryLabel(featured.data.tags || []);
        return (
          <section class="relative w-full overflow-hidden border-b border-frame/60 bg-bg">
            <a
              href={`/blog/${fSlug}`}
              class="group relative block h-[420px] w-full overflow-hidden sm:h-[520px] lg:h-[600px]"
            >
              <!-- Base plate · fondo sólido tras la imagen -->
              <div class="absolute inset-0 bg-bg" aria-hidden="true" />
              <!-- Full-bleed image · textura, no texto legible -->
              <img
                src={featured.data.image || "/logo.jpg"}
                alt={featured.data.title}
                class="absolute inset-0 h-full w-full object-cover opacity-25 brightness-[0.85] transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <!-- Scrims · bottom-heavy, cubren el texto horneado del OG -->
              <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/70 to-transparent" aria-hidden="true" />
              <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-bg/50 to-transparent" aria-hidden="true" />

              <!-- Contenido anclado abajo · full width -->
              <div class="absolute inset-x-0 bottom-0 z-10 px-4 pb-10 sm:px-6 md:pb-14 lg:px-8 lg:pb-16 xl:px-12">
                <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
                  <div class="min-w-0">
                    {/* Eyebrow editorial */}
                    <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.14em] text-accent">
                      // destacado
                    </p>

                    {/* Título · mono v2 */}
                    <h2 class="max-w-4xl font-heading text-2xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary transition-colors duration-300 group-hover:text-accent sm:text-3xl md:text-4xl lg:text-5xl">
                      {featured.data.title}
                    </h2>

                    {/* Meta · chips mono */}
                    <div class="mt-4 flex flex-wrap items-center gap-2 md:mt-5">
                      <span class="inline-flex items-center rounded-[4px] border border-frame bg-surface px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
                        {fCat}
                      </span>
                      <time
                        datetime={featured.data.pubDate.toISOString()}
                        class="inline-flex items-center rounded-[4px] border border-frame bg-surface px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary"
                      >
                        {featured.data.pubDate.toLocaleDateString("es-CL", {
                          year: "numeric",
                          month: "short",
                          day: "2-digit",
                        })}
                      </time>
                      <span class="inline-flex items-center rounded-[4px] border border-frame bg-surface px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
                        {fReadMin} min de lectura
                      </span>
                      {featured.data.modifiedTime && (
                        <span class="inline-flex items-center rounded-[4px] border border-accent/40 bg-accent-subtle px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.08em] text-accent">
                          Actualizado
                        </span>
                      )}
                    </div>
                  </div>

                  {/* CTA · borde metálico */}
                  <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-[6px] border border-frame px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.14em] text-text-primary transition-colors duration-300 group-hover:border-accent group-hover:text-accent lg:self-end">
                    [ Leer artículo ]
                    <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </div>
            </a>
          </section>
        );
      })()
    }

    <!-- ═══════════════════════════════════════════
         ARTÍCULOS · Editorial panel grid
         Cards: imagen arriba (arte) + texto abajo en panel sólido.
         Los OG traen el título horneado dentro de la imagen, por eso
         el texto va FUERA de la imagen. Cero texto sobre texto.
    ═══════════════════════════════════════════ -->
    <section id="articulos" class="relative w-full scroll-mt-20 bg-bg">
      <!-- Header canónico · full width -->
      <div class="flex items-end justify-between gap-6 px-4 pb-8 pt-16 sm:px-6 md:pb-12 md:pt-20 lg:px-8 xl:px-12">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">
          // últimos artículos
        </p>
        <p class="hidden font-mono text-[11px] uppercase tracking-[0.14em] text-text-tertiary sm:block">
          {sortedPosts.length} artículos
        </p>
      </div>

      <div class="w-full space-y-5 px-4 pb-16 sm:px-6 md:space-y-8 md:pb-24 lg:px-8 xl:px-12" style="content-visibility:auto; contain-intrinsic-size: 2200px;">

        <!-- ─── Tier 1 · Dos grandes, asimétricos 7/5 ─── -->
        <div class="grid grid-cols-1 gap-5 md:grid-cols-12 md:gap-6">
        {rest.slice(0, 2).map((post, i) => {
          const postSlug = post.id.replace(/\.(md|mdx)$/, "");
          const readMin = readingTime(post.body || "");
          const img = post.data.image || "/logo.jpg";
          const cat = getCategoryLabel(post.data.tags || []);
          const accent = getCategoryAccent(post.data.tags || []);
          return (
            <a
              href={`/blog/${postSlug}`}
              class={`group relative flex h-full flex-col overflow-hidden rounded-[6px] border border-frame/60 bg-surface transition-colors duration-300 hover:border-frame-hover hover:bg-surface-hover ${i === 0 ? "md:col-span-7" : "md:col-span-5"}`}
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-surface-sunken">
                <img
                  src={img}
                  alt={post.data.title}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                />
                {/* Fusión imagen → panel */}
                <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-surface to-transparent" aria-hidden="true" />
                {/* Recent badge · LED accent */}
                {isRecent(post.data.pubDate) && (
                  <div class="absolute left-4 top-4 flex items-center gap-1.5 rounded-[4px] border border-accent/60 bg-bg/70 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.08em] text-accent backdrop-blur-sm">
                    <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true" />
                    Nuevo
                  </div>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5 md:p-6">
                <p class="mb-2 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-text-tertiary">
                  <span class="h-1.5 w-1.5 rounded-full" style={`background:${accent}`} aria-hidden="true" />
                  {cat}
                </p>
                <h2 class="font-heading text-xl font-bold leading-[1.15] tracking-[-0.02em] text-text-primary transition-colors duration-300 group-hover:text-accent line-clamp-3 md:text-2xl lg:text-[1.7rem]">
                  {post.data.title}
                </h2>
                <div class="mt-auto flex items-center justify-between gap-4 pt-5">
                  <div class="flex items-center gap-2 font-mono text-[11px] tracking-wide text-text-tertiary">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString("es-CL", { month: "short", day: "numeric" })}
                    </time>
                    <span class="text-frame" aria-hidden="true">·</span>
                    <span>{readMin} min</span>
                    {post.data.modifiedTime && (
                      <>
                        <span class="text-frame" aria-hidden="true">·</span>
                        <span class="text-accent">Actualizado</span>
                      </>
                    )}
                  </div>
                  <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-text-secondary transition-colors duration-300 group-hover:text-accent">
                    [ Explorar ]
                    <svg class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
        </div>

        <!-- ─── Tier 2 · Tres medianas ─── -->
        {rest.length > 2 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 md:gap-6">
            {rest.slice(2, 5).map((post) => {
              const postSlug = post.id.replace(/\.(md|mdx)$/, "");
              const readMin = readingTime(post.body || "");
              const img = post.data.image || "/logo.jpg";
              const cat = getCategoryLabel(post.data.tags || []);
              const accent = getCategoryAccent(post.data.tags || []);
              return (
                <a
                  href={`/blog/${postSlug}`}
                  class="group relative flex h-full flex-col overflow-hidden rounded-[6px] border border-frame/60 bg-surface transition-colors duration-300 hover:border-frame-hover hover:bg-surface-hover"
                >
                  <div class="relative aspect-[4/3] overflow-hidden bg-surface-sunken">
                    <img
                      src={img}
                      alt={post.data.title}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                    />
                    <div class="absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-surface to-transparent" aria-hidden="true" />
                    {isRecent(post.data.pubDate) && (
                      <div class="absolute left-3.5 top-3.5 flex items-center gap-1.5 rounded-[4px] border border-accent/60 bg-bg/70 px-2 py-0.5 font-mono text-[9px] uppercase tracking-[0.08em] text-accent backdrop-blur-sm">
                        <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true" />
                        Nuevo
                      </div>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col p-5">
                    <p class="mb-2 flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.14em] text-text-tertiary">
                      <span class="h-1.5 w-1.5 rounded-full" style={`background:${accent}`} aria-hidden="true" />
                      {cat}
                    </p>
                    <h3 class="font-heading text-lg font-bold leading-[1.2] tracking-[-0.02em] text-text-primary transition-colors duration-300 group-hover:text-accent line-clamp-3 md:text-xl">
                      {post.data.title}
                    </h3>
                    <div class="mt-auto flex items-center gap-2 pt-4 font-mono text-[10px] tracking-wide text-text-tertiary">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString("es-CL", { month: "short", day: "numeric" })}
                      </time>
                      <span class="text-frame" aria-hidden="true">·</span>
                      <span>{readMin} min</span>
                      {post.data.modifiedTime && (
                        <>
                          <span class="text-frame" aria-hidden="true">·</span>
                          <span class="text-accent">Actualizado</span>
                        </>
                      )}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}

        <!-- ─── Tier 3 · Cuatro compactas ─── -->
        {rest.length > 5 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
            {rest.slice(5, 9).map((post) => {
              const postSlug = post.id.replace(/\.(md|mdx)$/, "");
              const readMin = readingTime(post.body || "");
              const img = post.data.image || "/logo.jpg";
              const cat = getCategoryLabel(post.data.tags || []);
              const accent = getCategoryAccent(post.data.tags || []);
              return (
                <a
                  href={`/blog/${postSlug}`}
                  class="group relative flex h-full flex-col overflow-hidden rounded-[6px] border border-frame/60 bg-surface transition-colors duration-300 hover:border-frame-hover hover:bg-surface-hover"
                >
                  <div class="relative aspect-[3/2] overflow-hidden bg-surface-sunken">
                    <img
                      src={img}
                      alt={post.data.title}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                    />
                    <div class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-surface to-transparent" aria-hidden="true" />
                  </div>
                  <div class="flex flex-1 flex-col p-4 md:p-5">
                    <p class="mb-1.5 flex items-center gap-1.5 font-mono text-[8px] uppercase tracking-[0.12em] text-text-tertiary">
                      <span class="h-1 w-1 rounded-full" style={`background:${accent}`} aria-hidden="true" />
                      {cat}
                    </p>
                    <h4 class="font-heading text-sm font-bold leading-[1.25] tracking-[-0.01em] text-text-primary transition-colors duration-300 group-hover:text-accent line-clamp-2 md:text-[15px]">
                      {post.data.title}
                    </h4>
                    <div class="mt-auto flex items-center gap-2 pt-3 font-mono text-[10px] tracking-wide text-text-tertiary">
                      <time>{post.data.pubDate.toLocaleDateString("es-CL", { month: "short", day: "numeric" })}</time>
                      <span class="text-frame" aria-hidden="true">·</span>
                      <span>{readMin} min</span>
                      {post.data.modifiedTime && (
                        <>
                          <span class="text-frame" aria-hidden="true">·</span>
                          <span class="text-accent">Actualizado</span>
                        </>
                      )}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}

        <!-- ─── Tier 4 · Filas restantes · archivo paginado (5/página) ─── -->
        {rest.length > 9 && (
          <>
            <div class="h-px bg-frame/60" aria-hidden="true" />
            <div class="pt-4 md:pt-6" data-archive-list>
              {rest.slice(9).map((post) => {
                const postSlug = post.id.replace(/\.(md|mdx)$/, "");
                const readMin = readingTime(post.body || "");
                const cat = getCategoryLabel(post.data.tags || []);
                const accent = getCategoryAccent(post.data.tags || []);
                return (
                  <a
                    href={`/blog/${postSlug}`}
                    data-archive-item
                    class="group flex items-center justify-between gap-4 border-b border-frame/60 py-4 transition-colors duration-300 hover:border-frame-hover"
                  >
                    <div class="flex min-w-0 items-center gap-4">
                      <span class="flex shrink-0 items-center gap-2 font-mono text-[9px] uppercase tracking-[0.14em] text-text-tertiary">
                        <span class="h-1.5 w-1.5 rounded-full" style={`background:${accent}`} aria-hidden="true" />
                        {cat}
                      </span>
                      <h4 class="truncate font-heading text-sm font-medium text-text-secondary transition-colors duration-300 group-hover:text-accent md:text-[15px]">
                        {post.data.title}
                      </h4>
                    </div>
                    <div class="flex shrink-0 items-center gap-3">
                      <span class="hidden font-mono text-[10px] tracking-wide text-text-tertiary sm:block">
                        {post.data.pubDate.toLocaleDateString("es-CL", { month: "short", day: "numeric" })}
                      </span>
                      <span class="hidden font-mono text-[10px] tracking-wide text-text-tertiary md:block">
                        {readMin} min
                      </span>
                      {post.data.modifiedTime && (
                        <span class="hidden font-mono text-[10px] tracking-wide text-accent lg:block">Actualizado</span>
                      )}
                      <svg class="h-3 w-3 text-text-tertiary transition-all group-hover:translate-x-0.5 group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                    </div>
                  </a>
                );
              })}
            </div>
            <nav data-archive-pager class="flex flex-wrap items-center justify-center gap-2 pt-8 md:pt-10" aria-label="Paginación de artículos"></nav>
          </>
        )}
      </div>
    </section>

    <script>
      // Archivo Tier 4 · paginación progresiva (5 filas por página).
      // Sin JS todas las filas quedan visibles → HTML estático intacto para SEO.
      const ARCHIVE_PER_PAGE = 5;
      const archiveList = document.querySelector<HTMLElement>("[data-archive-list]");
      const archivePager = document.querySelector<HTMLElement>("[data-archive-pager]");

      if (archiveList && archivePager) {
        const items = Array.from(archiveList.querySelectorAll<HTMLElement>("[data-archive-item]"));
        const totalPages = Math.ceil(items.length / ARCHIVE_PER_PAGE);
        let page = 1;

        if (totalPages <= 1) {
          archivePager.style.display = "none";
        } else {
          const base = "inline-flex h-9 min-w-9 items-center justify-center rounded-[4px] border px-3 font-mono text-[11px] transition-colors";
          const clsIdle = `${base} cursor-pointer border-frame bg-surface text-text-secondary hover:border-frame-hover hover:text-text-primary`;
          const clsActive = `${base} border-accent/60 bg-accent-subtle text-accent`;
          const clsEdge = `${base} cursor-pointer border-frame bg-surface text-text-tertiary hover:border-frame-hover hover:text-text-primary disabled:cursor-not-allowed disabled:opacity-40`;

          const pageWindow = (): (number | "…")[] => {
            const out: (number | "…")[] = [];
            for (let i = 1; i <= totalPages; i++) {
              if (i === 1 || i === totalPages || (i >= page - 1 && i <= page + 1)) {
                out.push(i);
              } else if (out[out.length - 1] !== "…") {
                out.push("…");
              }
            }
            return out;
          };

          const scrollToArchive = () => {
            const top = archiveList.getBoundingClientRect().top + window.scrollY - 88;
            window.scrollTo({ top, behavior: "smooth" });
          };

          const renderArchive = (scroll: boolean) => {
            const start = (page - 1) * ARCHIVE_PER_PAGE;
            items.forEach((el, i) => {
              el.style.display = i >= start && i < start + ARCHIVE_PER_PAGE ? "" : "none";
            });

            archivePager.replaceChildren();

            const makeEdge = (label: string, target: number, disabled: boolean, aria: string) => {
              const btn = document.createElement("button");
              btn.type = "button";
              btn.className = clsEdge;
              btn.textContent = label;
              btn.disabled = disabled;
              btn.setAttribute("aria-label", aria);
              btn.addEventListener("click", () => {
                page = Math.min(totalPages, Math.max(1, target));
                renderArchive(true);
              });
              return btn;
            };

            archivePager.appendChild(makeEdge("←", page - 1, page === 1, "Página anterior"));

            pageWindow().forEach((p) => {
              if (p === "…") {
                const dots = document.createElement("span");
                dots.className = "px-1 font-mono text-[11px] text-text-tertiary";
                dots.textContent = "…";
                dots.setAttribute("aria-hidden", "true");
                archivePager.appendChild(dots);
                return;
              }
              const btn = document.createElement("button");
              btn.type = "button";
              btn.className = p === page ? clsActive : clsIdle;
              btn.textContent = String(p);
              btn.setAttribute("aria-label", `Página ${p}`);
              if (p === page) btn.setAttribute("aria-current", "page");
              btn.addEventListener("click", () => {
                if (page === p) return;
                page = p;
                renderArchive(true);
              });
              archivePager.appendChild(btn);
            });

            archivePager.appendChild(makeEdge("→", page + 1, page === totalPages, "Página siguiente"));

            if (scroll) scrollToArchive();
          };

          renderArchive(false);
        }
      }
    </script>

