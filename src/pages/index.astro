---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import StaggerText from "../components/StaggerText.astro";
import BlurText from "../components/BlurText.astro";
import CinematicColumn from "../components/CinematicColumn.astro";
import ScrollCard from "../components/ScrollCard.astro";
import Footer from "../components/Footer.astro";
import Testimonials from "../components/Testimonials.astro";
import testimonialsData from "../data/testimonials.json";
import projectsData from "../data/projects.json";
import { query, initDb } from "../lib/db";
import { toServiceDisplay } from "../lib/service-display";
import { ListChecks, Bot, MapPin } from "@lucide/astro";
import { LEAD_MAGNETS } from "../lib/marketing/lead-magnets";

await initDb();
const dbRows = await query(
  `SELECT DISTINCT ON (LOWER(TRIM(category))) slug, name, description, category
   FROM services WHERE is_active = true AND category IS NOT NULL
   ORDER BY LOWER(TRIM(category)), is_popular DESC, id`
);
const services = dbRows.rows.map((row: any) => toServiceDisplay(row as any));

// Feature-d sections for homepage diagnosis
const diagnosisSlugs = ["desarrollo-web", "seo", "automatizaciones"];
const diagnosisServices = services.filter((s: any) => diagnosisSlugs.includes(s.slug));
// Hardcoded fallbacks if DB doesn't have these categories yet
const diagnosisFallbacks = [
  { title: "Sitio Web Profesional", description: "Páginas ultrarrápidas con Astro, diseño responsive y SEO local incluido para tu negocio en el sur de Chile.", accent: "#6366f1", slug: "desarrollo-web", icon: "Code", tags: [], landingUrl: "/desarrollo-web" },
  { title: "Posicionamiento SEO Local", description: "Aparece en Google Maps y búsquedas locales en Puerto Varas, Osorno, Valdivia y toda la Región de Los Lagos.", accent: "#10b981", slug: "seo", icon: "Search", tags: [], landingUrl: "/seo-local" },
  { title: "Automatización de Procesos", description: "Bots para WhatsApp, flujos de email marketing, integraciones CRM y workflows que ahorran horas a tu pyme.", accent: "#06b6d4", slug: "automatizaciones", icon: "Bot", tags: [], landingUrl: "/automatizacion" },
];
const featured = diagnosisServices.length >= 3 ? diagnosisServices : diagnosisFallbacks;

// Recursos · biblioteca gratuita (misma fuente que /recursos)
const magnets = [...LEAD_MAGNETS].sort((a, b) => a.order - b.order);
const iconMap = {
  "list-checks": ListChecks,
  bot: Bot,
  "map-pin": MapPin,
};

// Portafolio · tipologías para el filtro del flujo Cobloc (derivadas de tags reales)
const tiposProyecto = (p: any): string[] => {
  const tipos = new Set<string>();
  if (p.tags.some((t: string) => /IA|LLM|GPT|agente|inteligencia/i.test(t))) tipos.add("IA");
  if (p.id === "fie" || p.id === "gestpass" || p.id === "blast-up") tipos.add("Web");
  if (p.id === "lllit" || p.tags.some((t: string) => /Visual|Mapping|Touch/i.test(t))) tipos.add("Visuales");
  if (p.tags.some((t: string) => /Three|WebGPU|3D/i.test(t)) || p.id === "novablast") tipos.add("3D");
  return [...tipos];
};

// Portafolio · acento de color por proyecto (projects.json no trae color)
const colorProyecto: Record<string, string> = {
  fie: "#6366f1",
  lllit: "#6ee7b7",
  gestpass: "#f59e0b",
  "blast-up": "#10b981",
  novablast: "#a5b4fc",
};

// Portafolio · muestrario de tecnologías (volúmenes CSS 3D del panel 3)
const volumenes = [
  { tech: "Next.js", color: "#6366f1", figura: "cubo" },
  { tech: "Astro", color: "#f97316", figura: "prisma" },
  { tech: "Python", color: "#6ee7b7", figura: "esfera" },
  { tech: "Three.js", color: "#a5b4fc", figura: "pirámide" },
  { tech: "PostgreSQL", color: "#f59e0b", figura: "cubo" },
  { tech: "TouchDesigner", color: "#fde68a", figura: "prisma" },
];

// Temporal realness (Kyle Chayka) · fecha renderizada por el servidor,
// no un timestamp estático: honesta, cambia cada día.
const mesesES = ["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
const _hoy = new Date();
const hoy = `${_hoy.getDate()} de ${mesesES[_hoy.getMonth()]} de ${_hoy.getFullYear()}`;
const anio = _hoy.getFullYear();
---

<BaseLayout
  title="Agencia Digital Puerto Varas, Los Lagos · Páginas Web, SEO y Automatización"
  description="Agencia digital en Puerto Varas: páginas web profesionales, SEO local en Google Maps y automatizaciones para pymes en la Región de Los Lagos. Cotiza gratis."
  video={{
    url: "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4",
    name: "Mtsprz Soluciones Digitales - Hero",
    description: "Agencia de soluciones digitales en la Región de Los Lagos, Chile. Desarrollo web, SEO local, automatizaciones y marketing digital.",
    thumbnailUrl: "https://mtsprz.org/logo.jpg",
    uploadDate: "2026-06-19T19:13:46Z",
  }}
>
  <link rel="preload" as="video" href="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4" fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": "https://mtsprz.org/#aboutpage",
    url: "https://mtsprz.org",
    description: "Mtsprz es una agencia de soluciones digitales en Puerto Varas, Región de Los Lagos, Chile. Ayudamos a pymes del sur de Chile a crecer con páginas web, SEO local, automatizaciones y diseño gráfico.",
    mainEntity: { "@id": "https://mtsprz.org/#organization" },
    significantLink: ["https://mtsprz.org/servicios", "https://mtsprz.org/portafolio", "https://mtsprz.org/blog"]
  })} />
  <Header />

  <main id="main-content">
    <section id="hero" class="relative w-full h-[100dvh] md:h-screen overflow-hidden bg-[#010101]">
      <video
        src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4"
        autoplay loop muted playsinline
        preload="auto"
        class="z-[1]"
        style="position: absolute !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: center !important; max-width: none !important; min-width: 0 !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; border: 0 !important; display: block !important;"
      />
      <div style="position: absolute !important; top: 0; left: 0; width: 100%; height: 24%; z-index: 2;" class="bg-gradient-to-b from-[#010101] to-transparent md:h-32"></div>
      <div style="position: absolute !important; bottom: 0; left: 0; width: 100%; height: 36%; z-index: 2;" class="bg-gradient-to-t from-[#010101] to-transparent md:h-48"></div>
      <div style="position: absolute !important; inset: 0; z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none;">
        <div class="w-full px-5 sm:px-8 md:px-12 lg:px-16" style="pointer-events: auto;">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

            <!-- Editorial left · full-width · proof of place -->
            <div data-gsap="editorial" class="lg:col-span-7 text-left">
              <!-- marca · firma a mano -->
              <div class="flex items-center gap-2.5 -rotate-1 w-fit font-hand text-lg md:text-xl" style="color: #f5efe0;">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="#6ee7b7" stroke="none"><path d="M12 0c.9 6.6 4.8 10.5 12 12-7.2 1.5-11.1 5.4-12 12-.9-6.6-4.8-10.5-12-12 7.2-1.5 11.1-5.4 12-12z"/></svg>
                Mtsprz · Soluciones Digitales
              </div>
              <!-- Coordenadas · proof of place, anotación a mano -->
              <p class="mt-3 w-fit -rotate-1 font-hand text-base md:text-lg" style="color: #a5b4fc;">
                41.32°S · 72.98°O — Puerto Varas, Región de Los Lagos
                <svg data-gsap="underline" class="block w-full h-1.5 mt-0.5" viewBox="0 0 300 6" preserveAspectRatio="none" fill="none" stroke="#6ee7b7" stroke-width="2" stroke-linecap="round"><path d="M2 4c40-4 80 4 120 0s80-4 120 0" /></svg>
              </p>

              <h1 class="mt-5 md:mt-7 font-heading font-bold text-white leading-[1.03] tracking-[-0.02em] text-[clamp(2.1rem,4.8vw,5.5rem)]">
                <StaggerText text="Soluciones digitales" as="span" className="block" staggerMs={0.04} />
                <span class="block mt-1 text-transparent bg-clip-text" style="background-image: linear-gradient(135deg, #6366f1 0%, #a5b4fc 55%, #8b5cf6 100%);">
                  hechas por personas
                </span>
                <!-- subrayado a mano · sobrio -->
                <svg data-gsap="underline" class="block w-[52%] -ml-1 h-2.5 mt-1" viewBox="0 0 300 10" preserveAspectRatio="none" fill="none" stroke="#6ee7b7" stroke-width="3" stroke-linecap="round"><path d="M3 7c50-5 100 5 150 0s100-5 144-1" /></svg>
              </h1>

              <p class="mt-5 md:mt-6 text-sm sm:text-base md:text-lg text-white/65 font-body font-light leading-relaxed max-w-xl">
                Creamos sitios web, posicionamos tu negocio en Google y automatizamos tus procesos.
                <span class="mt-2 block text-xs leading-relaxed text-white/50 sm:text-sm">Detrás de cada proyecto hay <span class="relative whitespace-nowrap text-white/75">personas reales<svg class="absolute -inset-x-1 -inset-y-1 w-[calc(100%+0.5rem)] h-[calc(100%+0.5rem)] -rotate-2" viewBox="0 0 200 24" preserveAspectRatio="none" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 5"><ellipse cx="100" cy="12" rx="99" ry="11" /></svg></span> en Puerto Varas — las mismas que te responden el WhatsApp.</span>
              </p>

              <div class="mt-7 md:mt-9 flex flex-wrap items-center gap-4 md:gap-5">
                <button onclick="window.openCotizarModal()" class="-rotate-1 px-7 sm:px-9 py-3.5 sm:py-4 text-xs sm:text-sm font-medium text-white tracking-[0.18em] uppercase flex items-center gap-2 transition-transform duration-300 hover:rotate-0 hover:scale-[1.04] cursor-pointer"
                  style="background: #6366f1; border-radius: 4px 18px 6px 16px / 16px 4px 18px 6px; box-shadow: 0 10px 30px rgba(99,102,241,0.35);">
                  Cotizar
                  <svg class="w-4 h-4 -rotate-6" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
                </button>
                <a href="/portafolio" class="group inline-flex items-center gap-2 -rotate-1 font-hand text-base md:text-xl transition-transform duration-300 hover:rotate-1" style="color: #fde68a;">
                  Ver trabajo real
                  <svg class="w-4 h-4 -rotate-6 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                </a>
              </div>

              <!-- temporal realness · anotación manuscrita -->
              <p class="mt-6 md:mt-8 w-fit rotate-1 font-hand text-base md:text-lg" style="color: #a5b4fc;">
                hoy es {hoy} · esto lo escribieron personas, no una plantilla
                <svg data-gsap="underline" class="block w-full h-1 mt-0.5" viewBox="0 0 300 5" preserveAspectRatio="none" fill="none" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"><path d="M2 3c50-2 100 2 150 0s100-2 146-1" /></svg>
              </p>
            </div>

            <!-- Proof of work · ficha técnica (desktop) -->
            <div data-gsap="sheet" class="hidden lg:flex lg:col-span-5 items-end justify-end">
              <!-- Nota adhesiva · ficha de trabajo
                   data-gsap="sheet-drag": hook para Draggable (se mueve SOLO
                   dentro de su grid, el wrapper data-gsap="sheet").
                   Sin transition-transform/hover:rotate: la transición CSS de
                   transform LAGUEARÍA en cada mousemove del drag y el hover
                   pelearía con GSAP. cursor-grab: el papel invita a tomarlo. -->
              <div data-gsap="sheet-drag" class="relative w-full max-w-sm -rotate-1 px-6 md:px-7 py-6 md:py-7 cursor-grab active:cursor-grabbing"
                style="background: #f5efe0; border-radius: 3px 22px 3px 24px / 24px 3px 22px 3px; box-shadow: 0 20px 50px rgba(0,0,0,0.55);">
                <!-- cinta adhesiva -->
                <div class="absolute left-1/2 -top-3.5 w-28 h-6 -translate-x-1/2 -rotate-2"
                  style="background: rgba(253,230,138,0.75); box-shadow: inset 0 1px 1px rgba(255,255,255,0.5), 0 1px 3px rgba(0,0,0,0.25); backdrop-filter: blur(1px);">
                </div>
                <div class="flex items-center justify-between border-b-2 border-dashed pb-3 mb-4" style="border-color: rgba(74,63,51,0.25);">
                  <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-[#4a3f33]">Ficha de trabajo</span>
                  <span class="font-mono text-[10px] text-[#4338ca]">N° {anio}</span>
                </div>
                <ul class="space-y-3 text-[12px] leading-relaxed" style="color: #4a3f33;">
                  <li class="flex gap-3"><span class="font-hand text-lg leading-none shrink-0" style="color: #f59e0b;">01</span>Sitios web a medida para pymes del sur de Chile</li>
                  <li class="flex gap-3"><span class="font-hand text-lg leading-none shrink-0" style="color: #10b981;">02</span>SEO local: Google Maps y búsquedas de la región</li>
                  <li class="flex gap-3"><span class="font-hand text-lg leading-none shrink-0" style="color: #6366f1;">03</span>Automatizaciones que te devuelven horas de trabajo</li>
                </ul>
                <p class="mt-4 pt-4 border-t-2 border-dashed font-hand text-base leading-snug" style="border-color: rgba(74,63,51,0.25); color: #2f2a22;">
                  Te atiende una sola persona, de principio a fin. Si automatizamos algo, te decimos exactamente qué es.
                </p>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Trust bar · full width -->
      <div data-gsap="trust" class="absolute bottom-0 left-0 w-full z-10 border-t border-white/10 bg-[#010101]/40 backdrop-blur-sm">
        <div class="w-full px-5 sm:px-8 md:px-12 lg:px-16 py-3.5 md:py-4 flex flex-wrap items-center justify-center md:justify-between gap-x-7 gap-y-2">
          <!-- chips artesanales · hand-drawn stickers sobre la cinta -->
          <span class="inline-flex items-center gap-2 -rotate-2 px-3.5 py-1.5 border-2 border-dashed font-hand text-lg md:text-xl transition-transform duration-300 hover:rotate-0"
            style="color: #fde68a; border-color: rgba(253,230,138,0.45); background: rgba(253,230,138,0.08); border-radius: 4px 12px 4px 14px / 14px 4px 12px 4px;">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="#f59e0b" stroke="none"><path d="M12 0c.9 6.6 4.8 10.5 12 12-7.2 1.5-11.1 5.4-12 12-.9-6.6-4.8-10.5-12-12 7.2-1.5 11.1-5.4 12-12z"/></svg>
            Sin compromiso
          </span>
          <span class="inline-flex items-center gap-2 rotate-1 px-3.5 py-1.5 border-2 border-dashed font-hand text-lg md:text-xl transition-transform duration-300 hover:rotate-0"
            style="color: #6ee7b7; border-color: rgba(110,231,183,0.4); background: rgba(110,231,183,0.08); border-radius: 4px 14px 4px 12px / 12px 4px 14px 4px;">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13l5 5L20 7"/></svg>
            Atención personalizada
          </span>
          <span class="inline-flex items-center gap-2 -rotate-1 px-3.5 py-1.5 border-2 border-dashed font-hand text-lg md:text-xl transition-transform duration-300 hover:rotate-0"
            style="color: #a5b4fc; border-color: rgba(165,180,252,0.45); background: rgba(165,180,252,0.08); border-radius: 4px 12px 4px 14px / 14px 4px 12px 4px;">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            Puerto Varas · Los Lagos
          </span>
        </div>
      </div>
    </section>

    <!-- Diagnóstico · editorial cinematic columns -->
    <section class="relative bg-[#0A0A0A] w-full" id="diagnostico">
      <!-- Header -->
      <div class="mx-auto max-w-5xl px-6 pt-20 md:pt-28 pb-14 md:pb-18 text-center">
        <div class="reveal-group">
          <p class="reveal-item text-xs uppercase tracking-[0.2em] text-white/40 font-body mb-3">Diagnóstico Rápido</p>
          <h2 class="reveal-item text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-white leading-[1.05] tracking-[-1px]">
            ¿Qué necesita tu negocio en <span style="color: #6366f1">Puerto Varas</span>, <span style="color: #10b981">Osorno</span> o <span style="color: #06b6d4">Valdivia</span>?
          </h2>
          <p class="reveal-item mt-3 text-sm md:text-base text-white/50 font-body font-light max-w-lg mx-auto">
            Cada pyme es diferente. Encuentra el servicio digital ideal para tu empresa en la Región de Los Lagos.
          </p>
        </div>
      </div>

      <!-- 3 editorial columns · full-bleed, cada una link a su landing si existe -->
      <div class="w-full overflow-hidden reveal-group">
        <div class="grid grid-cols-1 md:grid-cols-3">
          {featured.map((s, i) => (
            <div class="reveal-item">
              <CinematicColumn
                title={s.title}
                description={s.description}
                accent={s.accent}
                slug={s.slug}
                index={i}
                href={s.landingUrl || `/servicios/#${s.slug}`}
                ctaText="Explorar"
                compact
              />
            </div>
          ))}
        </div>
      </div>

      <!-- Full-width CTA + GEO Quick Answer · dibujado a mano (humanwashing) -->
      <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
        <div class="reveal-group">
          <!-- anotación manuscrita -->
          <p class="reveal-item font-hand text-xl md:text-2xl mb-6 -rotate-1" style="color: #a5b4fc;">
            hoja de ruta
            <svg class="inline-block w-5 h-5 ml-1 -rotate-3" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M6 13l6 6 6-6"/></svg>
          </p>

          <!-- CTA box · bordes irregulares de cuaderno -->
          <a href="/diagnostico" class="reveal-item group relative flex flex-col sm:flex-row sm:items-center justify-between gap-4 px-6 md:px-8 py-5 md:py-6 transition-all duration-300 hover:-translate-y-0.5"
            style="background: rgba(245,239,230,0.03); border: 2px solid rgba(245,239,230,0.35); border-radius: 12px 250px 14px 240px / 240px 14px 250px 12px;"
          >
            <div>
              <h3 class="text-sm md:text-base font-heading font-semibold text-white/80">
                ¿No sabes por dónde empezar?
                <svg class="block w-[105%] h-2 -mx-1 mt-0.5" viewBox="0 0 200 8" preserveAspectRatio="none" fill="none" stroke="#6ee7b7" stroke-width="2.5" stroke-linecap="round"><path d="M1 6c25-6 50 6 75 0s50-6 75 0 33-6 48-2" /></svg>
              </h3>
              <p class="mt-1 text-xs md:text-sm text-white/40 font-body">Cuéntanos tu situación y te recomendamos la solución ideal <span class="relative whitespace-nowrap">sin compromiso
                <svg class="absolute -inset-x-1.5 -inset-y-1 w-[calc(100%+0.75rem)] h-[calc(100%+0.5rem)] -rotate-2" viewBox="0 0 200 32" preserveAspectRatio="none" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-dasharray="6 6"><ellipse cx="100" cy="16" rx="99" ry="15" /></svg>
              </span>.</p>
            </div>
            <span class="shrink-0 inline-flex items-center gap-1.5 font-hand text-lg md:text-xl px-4 py-1.5 rotate-[1.5deg] transition-transform duration-300 group-hover:rotate-3"
              style="color: #fde68a; background: rgba(253,230,138,0.08); border: 1.5px dashed rgba(253,230,138,0.5); border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;"
            >
              Diagnóstico gratuito
              <svg class="w-4 h-4 -rotate-6" viewBox="0 0 24 24" fill="#f59e0b" stroke="none"><path d="M12 0c.8 6.5 4.5 10.2 12 12-7.5 1.8-11.2 5.5-12 12-.8-6.5-4.5-10.2-12-12C7.5 10.2 11.2 6.5 12 0z" /></svg>
            </span>
          </a>

          <!-- flecha punteada -->
          <div class="reveal-item flex justify-center my-2">
            <svg class="w-6 h-10" viewBox="0 0 24 40" fill="none" stroke="#6ee7b7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v28" stroke-dasharray="5 7" /><path d="M6 30l6 7 6-7" /></svg>
          </div>

          <!-- Nota adhesiva · GEO Quick Answer -->
          <div class="reveal-item relative mx-auto max-w-xl px-6 md:px-8 py-6 md:py-7 -rotate-1 transition-transform duration-300 hover:rotate-0"
            style="background: #f5efe0; border-radius: 3px 22px 3px 24px / 24px 3px 22px 3px; box-shadow: 0 14px 34px rgba(0,0,0,0.45);"
          >
            <div class="absolute left-1/2 -top-3.5 w-28 h-6 -translate-x-1/2 -rotate-2 opacity-80"
              style="background: rgba(253,230,138,0.75); box-shadow: inset 0 1px 1px rgba(255,255,255,0.5), 0 1px 3px rgba(0,0,0,0.25); backdrop-filter: blur(1px);"
            ></div>
            <p class="text-xs md:text-sm font-body leading-relaxed" style="color: #4a3f33;">
              <strong style="color: #2f2a22;">Respuesta rápida: </strong>
              La mayoría de las pymes en la Región de Los Lagos comienzan con un sitio web profesional optimizado para SEO local.
