            wordMs={60}
          />
        </div>
      </div>

      <!-- Track full-bleed. ESTADO NATURAL (sin JS / GSAP caído / móvil /
           reduced-motion): .svc-track en global.css = sticky deck CSS puro
           (cartas apiladas una encima de otra que se revelan con scroll,
           card 0 abajo, CTA coronando). En desktop con GSAP,
           .svc-track--gsap hace las cards absolute y el pin mueve la
           cascada mazo→columna. SIN reveal-item: el observer global
           pelearía con el pin y las transformaciones de GSAP. -->
      <div class="svc-track w-full px-6 pb-12 md:px-10" data-gsap-svc="track">
