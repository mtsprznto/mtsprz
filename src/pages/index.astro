  <!-- ============================================================
       HERO · Animación scroll bi-direccional (GSAP + ScrollTrigger)
       Estética "Made by Humans" · collage que se des-escribe
       ------------------------------------------------------------
       · GSAP vía CDN (jsdelivr) — no está en package.json
       · Solo transform + opacity + stroke-dashoffset → GPU (60fps)
       · scrub: 1 → progreso ligado al scroll en AMBAS direcciones
       · Entrada "destacado": subrayados se DIBUJAN como marcador al
         cargar (from() independiente del scrub, delays asimétricos)
       · Draggable: la ficha de trabajo se mueve SOLO en su grid
         (bounds = wrapper col-span-5). Interacción, no animación:
         matchMedia propio sin prefers-reduced-motion.
       · gsap.matchMedia() → móvil y reduced-motion ligero / apagado
       · Sin-JS seguro: nada se oculta (tweens con estado natural en 0)
       ============================================================ -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/Draggable.min.js"></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof window.gsap === "undefined" || typeof window.ScrollTrigger === "undefined") return;

      gsap.registerPlugin(ScrollTrigger);

      const hero = document.getElementById("hero");
      if (!hero) return;

      // Selectores scoped al hero (nunca clases globales)
      const q = gsap.utils.selector(hero);
      const video = q("video")[0];
      const editorial = q('[data-gsap="editorial"]')[0];
      const sheet = q('[data-gsap="sheet"]')[0];
      const trust = q('[data-gsap="trust"]')[0];
      const underlines = q('[data-gsap="underline"] path');

      // --- Construcción del collage (una sola timeline por viewport) ---
      function buildCollage(tl, videoScale) {
        // 1) Ken Burns · el video respira (scale base 1.15 evita huecos
        //    cuando el contenido sube — las gradientes top/bottom ya tapan)
        tl.fromTo(
          video,
          { scale: 1.15, willChange: "transform" },
          { scale: videoScale, duration: 1, ease: "none" },
          0
        );

        // 2) Subrayados manuscritos se "borran" (el collage se des-escribe)
        //    stroke-dashoffset nativo — sin DrawSVG (CDN gratis).
        //    En progreso 0 no se toca nada: el estado natural está dibujado.
        underlines.forEach((path) => {
          const len = path.getTotalLength();
          gsap.set(path, { strokeDasharray: len, strokeDashoffset: 0 });
          tl.to(path, { strokeDashoffset: len, duration: 0.35, ease: "none" }, 0.05);
        });

        // 3) Columna editorial: sube, rota orgánicamente y deja una traza
        //    (0.15) — como una pegatina que se despega del collage
        tl.to(
          editorial,
          {
            yPercent: -12, rotation: -2.5, opacity: 0.15,
            transformOrigin: "50% 80%", duration: 0.7, ease: "none",
          },
          0.1
        );

        // 4) Ficha técnica (desktop): se despega desde su esquina superior
        //    derecha — el mismo lenguaje de papel del resto del hero
        if (sheet) {
          tl.to(
            sheet,
            {
              yPercent: -18, rotation: 4, opacity: 0.12,
              transformOrigin: "88% 30%", duration: 0.75, ease: "none",
            },
            0.15
          );
        }

        // 5) Trust bar: cae con el scroll (se va por abajo, fuera del hero)
        tl.to(trust, { yPercent: 90, opacity: 0, duration: 0.4, ease: "none" }, 0.25);
      }

      gsap.matchMedia().add({
        // Desktop: collage completo
        desktop: "(min-width: 768px) and (prefers-reduced-motion: no-preference)",
        // Móvil: versión ligera (la ficha técnica no existe < lg)
        mobile: "(max-width: 767.98px) and (prefers-reduced-motion: no-preference)",
      }, (ctx) => {
        // PASO 1 — Timeline del scrub PRIMERO. Su gsap.set() escribe
        // strokeDasharray = longitud del path en cada subrayado (requisito
        // para que el borrado por dashoffset funcione) y deja dashoffset 0.
        const tl = gsap.timeline();
        buildCollage(tl, ctx.conditions.desktop ? 1.32 : 1.26);

        ScrollTrigger.create({
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: 1,          // sigue al scroll hacia abajo Y hacia arriba
          animation: tl,
        });

        // PASO 2 — Entrada "destacado" (se crea DESPUÉS de la timeline):
        // gsap.from() independiente del scrub. Como es el último tween en
        // escribirse, su dashoffset: len (subrayado aún invisible) gana la
        // batalla al instante; luego dibuja hasta 0 y queda completo.
        // Si el orden fuera inverso, el gsap.set() del scrub cortaría el
        // trazo a mitad de dibujo (flicker). El from() NO toca dasharray:
        // lo deja en len, que es lo que el scrub ya escribió.
        // El estado NATURAL del SVG (dibujado) vive en el HTML: si el JS
        // falla o hay reduced-motion, los subrayados se ven completos.
        // Delays y duraciones asimétricos — mano que dibuja: arranque,
        // pausa (espera al StaggerText del H1) y cierre rápido.
        const trazos = [
          { delay: 0.35, dur: 0.6 },  // coords · antes del H1
          { delay: 0.9,  dur: 0.7 },  // H1 · tras el char-by-char (~0.8-1s)
          { delay: 1.1,  dur: 0.5 },  // naranja · flick final, cierra en ~1.6s
        ];
        const entrada = gsap.timeline();
        underlines.forEach((path, i) => {
          const len = path.getTotalLength();
          entrada.from(path, {
            strokeDashoffset: len,
            immediateRender: true,
            ease: "power2.out",
            duration: trazos[i].dur,
          }, trazos[i].delay);
        });
      });

      // --- Draggable de la ficha de trabajo (nota adhesiva) ---------------
      // Interacción del usuario, NO animación → matchMedia PROPIO con solo
      // (min-width: 1024px): no hereda el no-preference del bloque anterior
      // (reduced-motion NO apaga el drag) y al bajar de lg se revierte solo.
      // bounds: wrapper data-gsap="sheet" (col-span-5) → la nota se mueve
      // SOLO dentro de su grid, nunca sale a toda la página.
      gsap.matchMedia().add("lg", "(min-width: 1024px)", () => {
        if (typeof window.Draggable === "undefined") return;
        gsap.registerPlugin(Draggable);

        const wrapper = q('[data-gsap="sheet"]')[0];
        const nota = q('[data-gsap="sheet-drag"]')[0];
        if (!wrapper || !nota) return;

        Draggable.create(nota, {
          type: "x,y",
          bounds: wrapper,           // su cajón: la columna 5 del grid
          inertia: false,            // papel: se queda donde la dejas
          edgeResistance: 0.7,       // el límite no se siente duro
          cursor: "grab",            // (además de la clase tailwind)
          activeCursor: "grabbing",
          allowContextMenu: true,    // clic derecho sigue funcionando
          zIndexBoost: false,        // no altera stacking (cinta, gradientes)
        });
      });
    });
  </script>

  <!-- ===== Script 2 · Servicios (AISLADO del hero) =====
       Un error en el hero ya NO mata este bloque. Estado NATURAL del
       track = sticky deck CSS puro (cartas apiladas que se revelan con
       scroll, visible sin JS / móvil / reduced-motion). GSAP desktop lo
       reemplaza por la cascada mazo→columna (pin + scrub). -->
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof window.gsap === "undefined" || typeof window.ScrollTrigger === "undefined") {
        console.warn("[mtsprz] GSAP no cargó (CDN) — servicios usa sticky deck CSS puro");
        return;
      }

      const svcSection = document.querySelector('[data-gsap-svc="section"]');
      const svcTrack = document.querySelector('[data-gsap-svc="track"]');
      if (svcSection && svcTrack) {
        const svcCards = gsap.utils.toArray(".svc-track .svc-card");
        console.log("[mtsprz] servicios GSAP activo —", svcCards.length, "cards");
        // Desktop: mazo de cartas → cascada vertical (pin + scrub).
        // Cada carta cae del mazo y se deposita en una columna; la siguiente
        // arranca al ~40% de la caída anterior (overlap suave).
        gsap.matchMedia().add(
          "svc-desktop",
          "(min-width: 768px) and (prefers-reduced-motion: no-preference)",
          () => {
            const cards = gsap.utils.toArray(".svc-track .svc-card");
            if (!cards.length) return;

            svcTrack.classList.add("svc-track--gsap");

            // Geometría en funciones → invalidateOnRefresh re-evalúa en resize.
            const vh = () => window.innerHeight;
            const cardH = () => Math.min(vh() * 0.38, 380);
            const gapY = () =>
              (vh() * 0.8 - cardH()) / Math.max(1, cards.length - 1); // columna en ~80vh
            const deckX = () => svcTrack.clientWidth / 2;
            const deckY = () => vh() * 0.3; // mazo arriba; columna crece hacia abajo
            const deckRot = (i) => (i % 2 === 0 ? -1.5 : 1.5);
            const deckOffX = (i) => (i % 2 === 0 ? 3 : -3);
            const deckOffY = (i) => i * 2.5;
            const deckShadow = (i) =>
              `0 ${6 + i * 2}px ${16 + i * 4}px rgba(0,0,0,${0.4 + i * 0.04})`;
            const finalY = (i) => deckY() + (cards.length - 1 - i) * gapY();
            const finalRot = (i) =>
              i === cards.length - 1 ? 0 : i % 2 === 0 ? -2 : 2; // CTA recto
            const finalShadow = () => "0 24px 60px rgba(0,0,0,0.5)";

            // Estado inicial: baraja — todas apiladas, centradas, con
            // micro-desplazamiento, rotación y sombra escalonada (card 0 arriba).
            gsap.set(cards, {
              position: "absolute",
              left: deckX(),
              top: deckY(),
              xPercent: -50,
              yPercent: -50,
              transformOrigin: "center",
            });
            cards.forEach((card, i) => {
              gsap.set(card, {
                x: deckOffX(i),
                y: deckOffY(i),
                rotation: deckRot(i),
                zIndex: 50 - i,
                boxShadow: deckShadow(i),
              });
            });

            const tl = gsap.timeline({
              defaults: { ease: "power3.inOut" },
              scrollTrigger: {
                trigger: svcSection,
                start: "top top",          // pin exacto cuando la sección llega arriba
                end: () => "+=" + cards.length * 220, // ~1760px con 8 cartas
                scrub: 1,                  // sigue al scroll en AMBAS direcciones
                pin: true,                 // ancla (pinSpacing true → spacer estándar)
                anticipatePin: 1,          // evita el salto brusco al activar el pin
                invalidateOnRefresh: true, // re-resuelve geometría al redimensionar
                animation: tl,
              },
            });

            const step = 1 / cards.length;
            const dur = step * 1.6; // overlap ~40% de la caída anterior
            cards.forEach((card, i) => {
              tl.to(
                card,
                {
                  y: () => finalY(i) - deckY(),
                  rotation: finalRot(i),
                  boxShadow: finalShadow(),
                  duration: dur,
                },
                step * i
              );
              // zIndex se mantiene ALTO durante el vuelo (50-i del mazo) y solo
              // baja al depositarse → vuela por encima de las depositadas.
              tl.set(card, { zIndex: i }, step * i + dur);
            });
          }
        );

        // Móvil / reduced-motion: NADA de pin ni transform → swipe nativo.
        // Remueve la clase por si quedó del estado desktop: matchMedia
        // revierte tweens/triggers pero NO las clases tocadas con classList.
        gsap.matchMedia().add(
          "svc-mobile",
          "(max-width: 767.98px), (prefers-reduced-motion: reduce)",
          () => {
            svcTrack.classList.remove("svc-track--gsap");
          }
        );

        // El scrollWidth puede variar tras cargar fuentes/imágenes: refresca
        // ScrollTrigger una vez que el documento terminó de cargar.
        window.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
      }
    });
  </script>

  <!-- ============================================================
       SECCIÓN SOBRE NOSOTROS · entrada editorial "Made by Humans"
       ------------------------------------------------------------
       · GSAP vía CDN ya cargado (gsap + ScrollTrigger)
       · Solo transform + opacity + stroke-dashoffset → GPU (60fps)
       · toggleActions play-none: entra UNA vez al llegar al 72%
       · Subrayado y garabato se DIBUJAN (pathLength="1" → dasharray 1)
       · Stickers: pop back.out con su data-rot; al final clearProps
         devuelve el control a CSS → hover:rotate-0 sigue funcionando
       · matchMedia no-preference: reduced-motion = sección estática
       · Sin-JS seguro: nada oculto por CSS (tweens solo hacia dentro)
       ============================================================ -->
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof window.gsap === "undefined" || typeof window.ScrollTrigger === "undefined") {
        console.warn("[mtsprz] GSAP no cargó (CDN) — sobre nosotros estático");
        return;
      }

      const section = document.querySelector('[data-gsap-about="section"]');
      if (!section) return;

      gsap.registerPlugin(ScrollTrigger);

      // Selectores scoped a la sección (nunca clases globales)
      const q = gsap.utils.selector(section);
      const eyebrow = q('[data-gsap-about="eyebrow"]')[0];
      const titleLine1 = q('[data-gsap-about="title-line-1"]')[0];
      const titleLine2 = q('[data-gsap-about="title-line-2"]')[0];
      const titleUnderline = q('[data-gsap-about="title-underline"] path')[0];
      const squiggle = q('[data-gsap-about="squiggle"] path')[0];
      const bodyCopy = q('[data-gsap-about="body-copy"]')[0];
      const accent1 = q('[data-gsap-about="body-accent-1"]')[0];
      const accent2 = q('[data-gsap-about="body-accent-2"]')[0];
      const handLine = q('[data-gsap-about="hand-line"]')[0];
      const stickers = q('[data-gsap-about="sticker"]');
      if (!eyebrow || !titleLine1 || !titleLine2 || !bodyCopy || !stickers.length) return;

      console.log("[mtsprz] sobre nosotros GSAP activo —", 1 + stickers.length, "elementos");

      gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
        // Los stickers traen transition-transform (hover:rotate-0): si no la
        // matamos, CSS ease cada frame de GSAP y la entrada se ve lerda.
        gsap.set(stickers, { transition: "none" });

        const tl = gsap.timeline({
          defaults: { ease: "power3.out" },
          scrollTrigger: {
            trigger: section,
            // "top bottom" = dispara EXACTO cuando el top de la sección cruza
            // el borde inferior del viewport (asomo). Es el disparo más
            // robusto posible: inmune a desviaciones de medición/pin de
            // servicios — nunca dispara "tarde" (la sección ya está
            // apareciendo cuando juega la timeline).
            start: "top bottom",
            toggleActions: "play none none none",
            // CRÍTICO: este trigger vive DESPUÉS del pin de servicios
            // (~1760px). refreshPriority 1 → en cada refresh ScrollTrigger
            // re-mide este trigger DESPUÉS de resolver el pin (default 0),
            // si no, la posición queda desfasada.
            refreshPriority: 1,
          },
        });

        tl.fromTo(eyebrow, { autoAlpha: 0, y: -10, rotation: -5 }, { autoAlpha: 1, y: 0, rotation: -1, duration: 0.5 }, 0)
          .fromTo(titleLine1, { autoAlpha: 0, y: 44, filter: "blur(6px)" }, { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.7 }, "-=0.25")
          .fromTo(titleLine2, { autoAlpha: 0, y: 44, filter: "blur(6px)" }, { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.7 }, "-=0.45")
          .fromTo(titleUnderline, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.7, ease: "power2.inOut" }, "-=0.35")
          .fromTo(squiggle, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.6, ease: "power2.inOut" }, "-=0.2")
          .fromTo(bodyCopy, { autoAlpha: 0, y: 22 }, { autoAlpha: 1, y: 0, duration: 0.7 }, "-=0.35")
          .fromTo(accent1, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.5, ease: "power2.inOut" }, "-=0.3")
          .fromTo(accent2, { autoAlpha: 0, scale: 0.8 }, { autoAlpha: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }, "-=0.35")
          .fromTo(handLine, { autoAlpha: 0, y: 12, rotation: -4 }, { autoAlpha: 1, y: 0, rotation: 1, duration: 0.5 }, "-=0.2")
          .fromTo(stickers,
            { autoAlpha: 0, scale: 0.6, rotation: (i, el) => (parseFloat(el.dataset.rot) || 0) - 12 },
            { autoAlpha: 1, scale: 1, rotation: (i, el) => parseFloat(el.dataset.rot) || 0, duration: 0.55, ease: "back.out(1.8)", stagger: 0.07 },
            "-=0.25"
          )
          // Restaura hover:rotate-0: limpia transform/opacity/transition
          // inline → CSS vuelve a mandar tras la entrada.
          .add(() => gsap.set(stickers, { clearProps: "transform,opacity,visibility,transition" }), "+=0.15");

        // Geometría cambia al cargar fuentes/imágenes → re-mide triggers.
        window.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
      });

      // Refresco robusto FUERA del matchMedia (corre siempre): el pin de
      // servicios arriba y las fuentes/imágenes que cargan tarde pueden
      // mover el top real de esta sección después del refresh inicial.
      // load + document.fonts.ready + timeout de seguridad cubren
      // bfcache / caché donde load pudo ocurrir antes del registro.
      const refresh = () => ScrollTrigger.refresh();
      window.addEventListener("load", refresh, { once: true });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(refresh);
      setTimeout(refresh, 800);
    });
  </script>

  <!-- ============================================================
       SECCIÓN PORTAFOLIO · "EL CATÁLOGO SOBRE LA MESA" — handmade
       ------------------------------------------------------------
       Concepto editorial "Made by Humans": las filas full-width
       (hojas de catálogo) se colocan sobre la mesa con rotación
       asimétrica MUY sutil (±0.8–1.5°, filas anchas no admiten
       rotaciones grandes), stagger orgánico, números que se
       estampan (elastic amplitud baja) y sellos "en producción".
       La regla superior y el subrayado se pintan como trazos.
       Sin fallos falsos.
       · Todos los dispositivos: eyebrow/título/regla/subrayado,
         filas con stagger, stickers numéricos, sellos, tags —
         fromTo, nada oculto por CSS sin JS.
       · pointer:fine + reduced-motion off: SIN tilt 3D (una fila
         full-width con perspectiva distorsiona borde dashed y
         texto — barroco, no humano). En su lugar micro-interacciones
         de oficio: foto enmarcada (la impresión sigue al cursor
         ±8px con quickTo), shine cursor, marco que se enciende
         (CSS), re-estampado del sello y micro-press del número.
       · min-width:768px: parallax generoso en el wrapper
         data-gsap-portfolio="media" (nunca en la <img>): scale
         base 1.12, yPercent -6→6 con scrub.
       · Sin plugins pro: core + ScrollTrigger únicamente.
       ============================================================ -->
  <script is:inline>
    // Inicializador real (extraído para reintentar si el CDN falló en el
    // primer intento — fallo transitorio de red — sin duplicar lógica).
    const initPortfolio = () => {
      if (typeof window.gsap === "undefined" || typeof window.ScrollTrigger === "undefined") {
        console.warn("[mtsprz] GSAP no cargó (CDN) — portafolio estático");
        return false;
      }

      // reduced-motion del SO → cero animación por diseño (a11y).
      // El log "portafolio GSAP activo" de abajo corre igual en ambos
      // casos: distingue diseño de bug en la consola.
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        console.info("[mtsprz] prefers-reduced-motion activo — animaciones desactivadas por diseño");
      }

      gsap.registerPlugin(ScrollTrigger);

      const section = document.querySelector('[data-gsap-portfolio="section"]');
      if (!section) return;

      // Selectores scoped a la sección: nunca clases globales.
      const q = gsap.utils.selector(section);
      const header = q('[data-gsap-portfolio="header"]')[0];
      const eyebrow = q('[data-gsap-portfolio="eyebrow"]')[0];
      const title = q('[data-gsap-portfolio="title"]')[0];
      const ruleTop = q('[data-gsap-portfolio="rule-top"]')[0];
      const underline = q('[data-gsap-portfolio="underline"] path')[0];
      const cards = q('[data-gsap-portfolio="card"]');
      const medias = q('[data-gsap-portfolio="media"]');
      const stickers = q('[data-gsap-portfolio="sticker"]');
      const stamps = q('[data-gsap-portfolio="stamp"]');
      const shines = q('[data-gsap-portfolio="shine"]');
      const tags = section.querySelectorAll('[data-gsap-portfolio="card"] .flex-wrap span');

      console.log("[mtsprz] portafolio GSAP activo —", cards.length, "cards");

      // TODO dentro de matchMedia con no-preference: reduced-motion →
      // cero animación, estado natural visible. Los fromTo solo ocultan
      // cuando el JS crea el tween aquí (sin-JS seguro).
      const mm = gsap.matchMedia();

      // ---- A) Cabecera · B) mazo · C) stickers · D) tags ----
      mm.add("portfolio-reveal", "(prefers-reduced-motion: no-preference)", () => {
        // A) Cabecera: regla + eyebrow + título + subrayado dibujado.
        if (header && eyebrow && title) {
          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: header,
              start: "top 85%",
              toggleActions: "play none none reverse",
              refreshPriority: 0,
            },
          });

          // Regla superior: trazo que se pinta de izquierda a derecha.
          if (ruleTop) {
            tl.fromTo(
              ruleTop,
              { scaleX: 0 },
              { scaleX: 1, duration: 0.8, ease: "power3.out" },
              0
            );
          }

          // Eyebrow: fade + blur + y. La rotación CSS (-rotate-1) la
          // conserva GSAP al componer transform (computed style).
          tl.fromTo(
            eyebrow,
            { autoAlpha: 0, y: 16, filter: "blur(6px)" },
            { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.6, ease: "power2.out" },
            0.1
          );

          // Título: fade + yPercent 8→0 (incluye el link completo).
          tl.fromTo(
            title,
            { autoAlpha: 0, yPercent: 8 },
            { autoAlpha: 1, yPercent: 0, duration: 0.7, ease: "power3.out" },
            "-=0.2"
          );

          // Subrayado: draw 1→0 (requiere pathLength="1" en el HTML),
          // luego la tinta se asienta: retira la cola 5% y vuelve.
          // Secuencia explícita SIN solapar tweens del mismo property
          // (evita keyframes anidados en fromTo — patrón ambiguo).
          if (underline) {
            tl.fromTo(
              underline,
              { strokeDasharray: 1, strokeDashoffset: 1 },
              { strokeDashoffset: 0, duration: 0.9, ease: "power3.out" },
              "-=0.4"
            );
            tl.to(underline, { strokeDashoffset: -0.05, duration: 0.25, ease: "power1.inOut" });
            tl.to(underline, { strokeDashoffset: 0, duration: 0.4, ease: "power2.out" });
          }
        }

        // B) El mazo: cards que se levantan de la mesa con rotación
        // irregular (imperfección real de mano) y stagger asimétrico.
        // C) + D) viven EN LA MISMA timeline → se estampan al entrar
        // en scroll (antes corrían con delay suelto sin trigger y
        // estampaban antes de ser visibles).
        if (cards.length) {
          // Rotación MUY sutil en filas anchas (±0.9–1.4°): la mano
          // asienta cada hoja con imperfección real, sin barroquismo.
          // Rotación más presente (±1.3–1.8°): la mano asienta cada hoja
          // con imperfección creíble, sin barroquismo.
          const deckRot = [1.5, -1.8, 1.3, -1.5, 1.6];
          // Stagger asimétrico más amplio: la ola de hojas se percibe
          // claramente al entrar (pares antes, impares después).
          const cardStagger = (i) => 0.16 + (i % 2) * 0.1;
          const deckTl = gsap.timeline({
            scrollTrigger: {
              trigger: cards[0],
              start: "top 85%",
              toggleActions: "play none none reverse",
              refreshPriority: 1,
            },
          });

          deckTl.fromTo(
            cards,
            { y: 80, autoAlpha: 0, scale: 0.98, rotation: (i) => deckRot[i % deckRot.length] },
            {
              y: 0, autoAlpha: 1, scale: 1, rotation: 0,
              duration: 1.15, ease: "power3.out",
              stagger: cardStagger,
            },
            0
          );

          // C) Stickers: elastic contenido (amplitud 1 → el número se
          // estampa con un asentamiento perceptible, sin rebote payaso).
          // Stagger alineado con las filas (cardStagger), offset 0 → el
          // número se estampa con su hoja. clearProps devuelve el
          // -rotate-3 real del CSS.
          if (stickers.length) {
            deckTl.fromTo(
              stickers,
              { scale: 0, autoAlpha: 0 },
              {
                scale: 1, autoAlpha: 1,
                duration: 0.85,
                ease: "elastic.out(1, 0.45)",
                stagger: cardStagger,
                clearProps: "transform",
              },
              0
            );
          }

          // C2) Sellos "en producción": se estampan con back.out(1.7)
          // (pisa con fuerza, sin rebote elástico). Offset 0 = estampa
          // con su fila. clearProps devuelve el rotate-2 del CSS.
          if (stamps.length) {
            deckTl.fromTo(
              stamps,
              { scale: 0.7, autoAlpha: 0, rotation: -4 },
              {
                scale: 1, autoAlpha: 1, rotation: 0,
                duration: 0.55, ease: "back.out(1.7)",
                stagger: cardStagger,
                clearProps: "transform",
              },
              0
            );
          }

          // D) Tags: cinta que se pega, overshoot mínimo (back 1.4).
          if (tags.length) {
            deckTl.fromTo(
              tags,
              { autoAlpha: 0, scale: 0.8, y: 6 },
              {
                autoAlpha: 1, scale: 1, y: 0,
                duration: 0.4,
                ease: "back.out(1.4)",
                stagger: 0.07,
              },
              ">-0.2"
            );
          }
        }
      });

      // ---- E) Foto enmarcada + shine + re-estampado + micro-press ----
      // SIN tilt 3D: una fila full-width con perspectiva distorsiona el
      // borde dashed y el texto — barroco, no humano. En su lugar, de
      // oficio: la impresión sigue al cursor ±8px (quickTo → 60fps),
      // el shine acompaña, el marco se enciende por CSS (group-hover)
      // y el sello se re-estampa al agarrar la hoja.
      // pointer:fine AND hover:hover: en laptops táctiles con mouse, un
      // toque al scrollear dispararía pointerenter → mediaX/Y ±8px sin
      // intención. Exigir hover real elimina ese micro-drag fantasma.
      mm.add("portfolio-touch", "(pointer: fine) and (hover: hover) and (prefers-reduced-motion: no-preference)", () => {
        if (!cards.length) return;

        // Base del parallax dinámica: si el bloque F no corre (<768px o
        // reduced-motion), la base es 1, no 1.12 → nunca queda escala
        // fantasma tras un resize.
        const parallaxBase = () =>
          window.matchMedia("(min-width: 768px) and (prefers-reduced-motion: no-preference)").matches
            ? 1.12
            : 1;

        cards.forEach((card, i) => {
          const shine = shines[i];
          const media = medias[i];
          const sticker = stickers[i];
          const stamp = stamps[i];

          // La impresión (wrapper media) sigue al cursor ±8px. GSAP
          // compone x/y con el scale + yPercent del parallax (bloque F)
          // sin conflicto: mismo transform, orígenes distintos.
          const mediaX = media && gsap.quickTo(media, "x", { duration: 0.4, ease: "power2.out" });
          const mediaY = media && gsap.quickTo(media, "y", { duration: 0.4, ease: "power2.out" });

          // Shine: overlay nace centrado en la card; se desplaza
          // (px - w/2) para llevar el centro del gradiente al puntero.
          const shineX = shine && gsap.quickTo(shine, "x", { duration: 0.5, ease: "power2.out" });
          const shineY = shine && gsap.quickTo(shine, "y", { duration: 0.5, ease: "power2.out" });
          const shineOp = shine && gsap.quickTo(shine, "opacity", { duration: 0.3, ease: "power2.out" });

          // Micro-press: el número se hunde un instante al agarrar.
          const pressSticker = () => {
            if (!sticker) return;
            gsap.to(sticker, {
              scale: 0.93, rotation: -2, duration: 0.2, ease: "power2.out",
              overwrite: "auto",
            });
          };
          const releaseSticker = () => {
            if (!sticker) return;
            gsap.to(sticker, {
              scale: 1, rotation: -2, duration: 0.4, ease: "back.out(2)",
              overwrite: "auto",
            });
          };

          // Re-estampado: el sello pisa de nuevo con fuerza (elastic
          // suave). clearProps al final devuelve el rotate-2 del CSS.
          const restamp = () => {
            if (!stamp) return;
            gsap.fromTo(
              stamp,
              { scale: 0.7, rotation: -3 },
              {
                scale: 1, rotation: 0, duration: 0.5,
                ease: "elastic.out(0.8, 0.45)",
                overwrite: "auto",
                clearProps: "transform",
              }
            );
          };

          // Hover de la impresión: base (1.12 con parallax / 1 sin él)
          // → 1.18 en desktop o 1.05 sin parallax. overwrite auto mata
          // el tween rival de scale al entrar/salir rápido.
          const hoverMedia = () => {
            if (!media) return;
            gsap.to(media, {
              scale: parallaxBase() === 1.12 ? 1.18 : 1.05,
              duration: 0.4, ease: "power3.out",
              overwrite: "auto",
            });
          };
          const unHoverMedia = () => {
            if (!media) return;
            gsap.to(media, {
              scale: parallaxBase(),
              duration: 0.5, ease: "back.out(1.4)",
              overwrite: "auto",
            });
          };

          const onMove = (e) => {
            const rect = card.getBoundingClientRect();
            const px = e.clientX - rect.left;
            const py = e.clientY - rect.top;
            const x = px / rect.width - 0.5;   // -0.5..0.5
            const y = py / rect.height - 0.5;
            if (mediaX && mediaY) {
              mediaX(x * 16);   // ±8px horizontal
              mediaY(y * 16);   // ±8px vertical
            }
            if (shineX && shineY && shineOp) {
              shineX(px - rect.width / 2);
              shineY(py - rect.height / 2);
              shineOp(1);
            }
          };

          const onLeave = () => {
            if (mediaX && mediaY) {
              mediaX(0);
              mediaY(0);
            }
            if (shineOp) shineOp(0);
            releaseSticker();
            unHoverMedia();
          };

          // Solo lectura: el <a> sigue siendo navegable (sin
          // preventDefault ni stopPropagation).
          card.addEventListener("pointermove", onMove, { passive: true });
          card.addEventListener("pointerleave", onLeave, { passive: true });
          card.addEventListener(
            "pointerenter",
            () => {
              pressSticker();
              restamp();
              hoverMedia();
            },
            { passive: true }
          );
        });
      });

      // ---- F) Parallax de las impresiones · desktop + no-preference ----
      // Vive en el wrapper data-gsap-portfolio="media" (no en la <img>)
      // para no matar el group-hover:scale-[1.04] del CSS.
      mm.add("portfolio-parallax", "(min-width: 768px) and (prefers-reduced-motion: no-preference)", () => {
        if (!medias.length) return;
        gsap.set(medias, { scale: 1.12 });
        medias.forEach((media) => {
          gsap.fromTo(
            media,
            { yPercent: -6 },
            {
              yPercent: 6,
              ease: "none",
              scrollTrigger: {
                trigger: media,
                start: "top bottom",
                end: "bottom top",
                scrub: 0.5,
              },
            }
          );
        });
      });

      // Refresco robusto FUERA del matchMedia (corre siempre): el pin de
      // servicios arriba y las fuentes/imágenes que cargan tarde pueden
      // mover el top real de esta sección después del refresh inicial.
      // load + document.fonts.ready + timeout de seguridad cubren
      // bfcache / caché donde load pudo ocurrir antes del registro.
      const refresh = () => ScrollTrigger.refresh();
      window.addEventListener("load", refresh, { once: true });
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(refresh);
      setTimeout(refresh, 800);

      return true;
    };

    // Intento 1: DOMContentLoaded — los CDN síncronos (líneas 732-734)
    // ya se ejecutaron, así que aquí gsap existe o falló en firme.
    window.addEventListener("DOMContentLoaded", () => {
      if (initPortfolio()) return;

      // Intento 2 (una sola vez, sin duplicar listeners): si el CDN
      // síncrono falló por un fallo transitorio de red, se re-inyecta
      // core + ScrollTrigger en window.load. Si sigue undefined ahí, es
      // bloqueo real (offline/adblocker) → guard de initPortfolio deja
      // el catálogo estático (sin-JS seguro, nada oculto por CSS).
      console.warn("[mtsprz] GSAP no disponible al DOMContentLoaded — reintento en load");
      window.addEventListener(
        "load",
        () => {
          if (typeof window.gsap !== "undefined" && typeof window.ScrollTrigger !== "undefined") {
            initPortfolio();
            return;
          }
          const inject = (src) =>
            new Promise((resolve, reject) => {
              const s = document.createElement("script");
              s.src = src;
              s.async = true;
              s.onload = resolve;
              s.onerror = reject;
              document.head.appendChild(s);
            });
          Promise.all([
            inject("https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"),
            inject("https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"),
          ])
            .then(() => {
              if (!initPortfolio()) {
                console.warn("[mtsprz] GSAP cargó pero la init falló — portafolio estático");
              }
            })
            .catch(() => {
              console.warn("[mtsprz] GSAP no cargó (CDN bloqueado u offline) — portafolio estático por diseño");
            });
        },
        { once: true }
      );
    });
  </script>
</BaseLayout>
