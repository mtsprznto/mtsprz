---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/ui/PageHero.astro";
import WebcoreWindow from "../../components/ui/WebcoreWindow.astro";
import { author } from "../../data/author";
import { getCategoryLabel, getCategoryAccent, readingTime } from "../../lib/blog-category";
import { getCollection } from "astro:content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const slug = post.id.replace(/\.(md|mdx)$/, "");
const { Content, headings } = await render(post);
const allPosts = await getCollection("blog");

const heroVideo =
  "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4";

const waPhone = "56966929818";
// CTA contextual según tags del post
const tags = (post.data.tags || []).map((t: string) => t.toLowerCase());
const isAutomatizacion = tags.some((t: string) => ["automatización", "whatsapp", "bot", "crm"].includes(t));
const isSEO = tags.some((t: string) => ["seo", "google maps", "posicionamiento", "seo local"].includes(t));
const ctaConfig = isAutomatizacion
  ? { service: "automatización", url: "/automatizacion", waMsg: "Hola! Leí el blog y quiero saber cómo automatizar mi negocio." }
  : isSEO
  ? { service: "SEO local", url: "/seo-local", waMsg: "Hola! Leí el blog y quiero posicionar mi negocio en Google." }
  : { service: "desarrollo web", url: "/desarrollo-web", waMsg: "Hola! Leí el blog y quiero cotizar una página web." };
const waCtaUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(ctaConfig.waMsg)}`;
const postTags = post.data.tags || [];
const postTagSet = new Set(postTags.map((t: string) => t.toLowerCase()));
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const pTags = (p.data.tags || []).map((t: string) => t.toLowerCase());
    const shared = pTags.filter((t: string) => postTagSet.has(t)).length;
    return { post: p, relevance: shared };
  })
  // Orden determinista: relevancia por tags y, en empate, más reciente primero.
  .sort(
    (a, b) =>
      b.relevance - a.relevance ||
      b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime()
  )
  .slice(0, 2)
  .map((r) => r.post);

// Extract HowTo steps from markdown body
function extractHowToSteps(body: string): { position: number; name: string; text: string }[] {
  const results: { position: number; name: string; text: string }[] = [];

  const pasoRegex = /^##\s+Paso\s+(\d+)[:\.]\s+(.+)\n\n([\s\S]*?)(?=\n\n##\s+|\n---|\n\[|$)/gim;
  let match;
  while ((match = pasoRegex.exec(body)) !== null) {
    const position = parseInt(match[1], 10);
    const name = match[2].trim();
    const rawText = match[3].trim();
    const text = rawText.split(/\n\n/)[0].replace(/\n/g, " ").slice(0, 500);
    if (text.length > 20) {
      results.push({ position, name, text });
    }
  }

  if (results.length === 0) {
    const numberedRegex = /^###\s+(\d+)[\.\)]\s+(.+)\n\n([\s\S]*?)(?=\n\n###\s+|\n\n##\s+|\n---|\n\[|$)/gm;
    while ((match = numberedRegex.exec(body)) !== null) {
      const position = parseInt(match[1], 10);
      const name = match[2].trim();
      const rawText = match[3].trim();
      const text = rawText.split(/\n\n/)[0].replace(/\n/g, " ").slice(0, 500);
      if (text.length > 20) {
        results.push({ position, name, text });
      }
    }
  }

  return results.sort((a, b) => a.position - b.position);
}

// Extract FAQ pairs from markdown body
function extractFAQ(body: string): { question: string; answer: string }[] {
  const results: { question: string; answer: string }[] = [];

  // Find FAQ section: "## Preguntas frecuentes..." or "## FAQ"
  const faqSectionRegex = /^##\s+(?:Preguntas frecuentes|FAQ)(?:\s+.*)?\n\n([\s\S]*?)(?=\n##\s+|\n---|\n\[|$)/gim;
  let sectionMatch;
  while ((sectionMatch = faqSectionRegex.exec(body)) !== null) {
    const section = sectionMatch[1];

    // Extract ### Question followed by answer text
    const qaRegex = /^###\s+(.+)\n\n([\s\S]*?)(?=\n###\s+|\n##\s+|\n---|\n\[|$)/gm;
    let qaMatch;
    while ((qaMatch = qaRegex.exec(section)) !== null) {
      const question = qaMatch[1].trim();
      const rawAnswer = qaMatch[2].trim();
      const answer = rawAnswer.split(/\n\n/)[0].replace(/\n/g, " ").slice(0, 300);
      if (question.length > 5 && answer.length > 20) {
        results.push({ question, answer });
      }
    }
  }

  return results.slice(0, 8); // Max 8 FAQ pairs per schema
}

const readMin = readingTime(post.body || "");
const postUrl = `https://mtsprz.org/blog/${slug}`;
const shareText = encodeURIComponent(post.data.title);
const categoryLabel = getCategoryLabel(postTags);
const categoryAccent = getCategoryAccent(postTags);

const fechaPublicado = post.data.pubDate.toLocaleDateString("es-CL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const fechaActualizado = post.data.modifiedTime
  ? post.data.modifiedTime.toLocaleDateString("es-CL", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

// H1 en dos líneas: parte el título por el primer delimitador natural.
function splitTitle(title: string): { line1: string; line2: string } {
  for (const d of [" — ", " – ", " | ", ": ", " · "]) {
    const i = title.indexOf(d);
    if (i > 0 && i < title.length - d.length) {
      return { line1: title.slice(0, i), line2: title.slice(i + d.length) };
    }
  }
  const j = title.lastIndexOf(". ");
  if (j > 10 && j < title.length - 3) {
    return { line1: title.slice(0, j + 1), line2: title.slice(j + 2) };
  }
  return { line1: title, line2: "" };
}
const { line1: titleLine1, line2: titleLine2 } = splitTitle(post.data.title);

// Build ToC from headings (h2 and h3 only) · excluye el heading que duplica el título del hero
const normalizeHeading = (text: string) =>
  text.toLowerCase().replace(/[^a-z0-9áéíóúñü]+/g, " ").trim();
const normalizedTitle = normalizeHeading(post.data.title);
const tocItems = headings
  .filter((h: any) => h.depth === 2 || h.depth === 3)
  .map((h: any) => ({
    depth: h.depth,
    text: h.text,
    slug: h.slug,
  }))
  .filter((item: any) => normalizeHeading(item.text) !== normalizedTitle);
const hasToc = tocItems.length >= 2;
const hideFirstHeading =
  headings.length > 0 && normalizeHeading(headings[0].text) === normalizedTitle;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={postUrl}
  image={post.data.image || undefined}
  breadcrumbs={[
    { name: "Blog", path: "/blog" },
    { name: post.data.title, path: `/blog/${slug}` },
  ]}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: (post.data.modifiedTime || post.data.pubDate).toISOString(),
    author: post.data.author,
    tags: post.data.tags,
    hasSpeakable: true,
  }}
>
  <Header />

  {
    (() => {
      const howToSteps = extractHowToSteps(post.body || "");
      if (howToSteps.length >= 2) {
        return <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "HowTo",
          "name": post.data.title,
          "description": post.data.description,
          "step": howToSteps.map((s) => ({
            "@type": "HowToStep",
            "position": s.position,
            "name": s.name,
            "text": s.text,
          })),
        })} />;
      }
      return null;
    })()
  }
  {
    (() => {
      const faqPairs = extractFAQ(post.body || "");
      if (faqPairs.length >= 2) {
        return <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": faqPairs.map((faq) => ({
            "@type": "Question",
            "name": faq.question,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": faq.answer,
            },
          })),
        })} />;
      }
      return null;
    })()
  }

  <!-- Reading progress bar -->
  <div id="reading-progress" class="pointer-events-none fixed left-0 right-0 top-0 z-[60] h-[3px] bg-transparent">
    <div id="reading-progress-bar" class="h-full bg-accent transition-[width] duration-100 ease-out" style="width: 0%;"></div>
  </div>

  <main id="main-content" class="overflow-x-clip">
    <!-- Hero canónico v2 (PageHero) · video §5.4 + LED + breadcrumbs -->
    <PageHero
      eyebrow={`// blog · ${categoryLabel.toLowerCase()}`}
      title={titleLine1}
      titleAccent={titleLine2}
      subtitle={post.data.description}
      note={`Por ${author.name} · ${fechaPublicado}`}
      ledLabel={`artículo — ${readMin} min de lectura`}
      videoUrl={heroVideo}
      breadcrumbs={[
        { name: "Blog", path: "/blog" },
        { name: post.data.title, path: `/blog/${slug}` },
      ]}
      meta={`publicado el ${fechaPublicado} · ${readMin} min de lectura`}
    >
      <Fragment slot="actions">
        <a
          href="#articulo"
          class="inline-flex items-center gap-2 rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
        >
          [ Leer artículo ]
        </a>
        <a
          href={waCtaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
        >
          [ Consultar ]
        </a>
      </Fragment>

      <Fragment slot="aside">
        <WebcoreWindow title="artículo --meta" variant="sunken">
          <dl class="space-y-3 px-5 py-5">
            <div class="flex items-baseline justify-between gap-4">
              <dt class="font-mono text-[10px] uppercase tracking-wider text-text-tertiary">autor</dt>
              <dd class="text-right font-mono text-xs text-text-secondary">{author.shortName}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="font-mono text-[10px] uppercase tracking-wider text-text-tertiary">publicado</dt>
              <dd class="text-right font-mono text-xs text-text-secondary">{fechaPublicado}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="font-mono text-[10px] uppercase tracking-wider text-text-tertiary">lectura</dt>
              <dd class="text-right font-mono text-xs text-text-secondary">{readMin} min</dd>
            </div>
            {
              fechaActualizado && (
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="font-mono text-[10px] uppercase tracking-wider text-text-tertiary">actualizado</dt>
                  <dd class="text-right font-mono text-xs text-accent">{fechaActualizado}</dd>
                </div>
              )
            }
          </dl>

          <div class="border-t border-frame px-5 py-4">
            <p class="font-mono text-[10px] uppercase tracking-wider text-text-tertiary">temas</p>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {
                postTags.map((tag) => (
                  <span class="inline-flex items-center gap-1.5 rounded-[4px] border border-frame px-2 py-1 font-mono text-[10px] uppercase tracking-[0.06em] text-text-secondary">
                    <span
                      class="h-1.5 w-1.5 shrink-0 rounded-full"
                      style={`background:${categoryAccent};`}
                      aria-hidden="true"
                    />
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>
        </WebcoreWindow>
      </Fragment>
    </PageHero>

    <!-- Article · grid 12 col (cuerpo 8 / ToC 4) -->
    <section id="articulo" class="w-full scroll-mt-16 border-t border-frame/60 bg-bg">
      <div class="grid w-full grid-cols-1 items-start gap-x-12 gap-y-10 px-4 py-14 sm:px-6 md:py-16 lg:grid-cols-12 lg:px-8 xl:px-12">
        <!-- Cuerpo -->
        <article class="min-w-0 lg:col-span-8">
          <!-- Back link -->
          <nav class="mb-8 md:mb-10">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.1em] text-text-tertiary transition-colors hover:text-accent"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
              volver al blog
            </a>
          </nav>

          <!-- Mobile ToC · details nativo, sin JS · sticky para no perderlo al leer -->
          {
            hasToc && (
              <div class="sticky top-16 z-20 mb-8 md:mb-10 lg:hidden">
                <details class="mobile-toc overflow-hidden rounded-[6px] border border-frame bg-surface/95 backdrop-blur-md">
                  <summary class="group flex cursor-pointer select-none list-none items-center justify-between px-5 py-4 [&::-webkit-details-marker]:hidden">
                    <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary">// en este artículo</span>
                    <svg class="h-3.5 w-3.5 text-text-tertiary transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                  </summary>
                  <nav class="max-h-[60vh] space-y-2.5 overflow-y-auto border-t border-frame/60 px-5 pb-5 pt-4">
                    {tocItems.map((item: any) => (
                      <a
                        href={`#${item.slug}`}
                        class={`block font-mono text-[13px] leading-snug transition-colors duration-200 hover:text-text-primary ${item.depth === 3 ? "pl-4 text-text-tertiary" : "text-text-secondary"}`}
                      >
                        {item.text}
                      </a>
                    ))}
                  </nav>
                </details>
              </div>
            )
          }

          <!-- GEO Answer Block · destacado editorial (speakable for Google Assistant) -->
          <div class="geo-answer mb-8 border-l-2 border-accent/50 pl-5 md:mb-10 md:pl-6">
            <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.2em] text-accent">// respuesta rápida</p>
            <p class="max-w-[65ch] font-body text-sm font-light leading-[1.8] text-text-secondary md:text-[15px]">
              {post.data.description}
            </p>
          </div>

          <!-- Article body · prose editorial (medida 65ch · DESIGN §3.3) -->
          <div class={`prose-blog max-w-[65ch]${hideFirstHeading ? " hide-first-heading" : ""}`}>
            <Content />
          </div>

          <!-- Author footer + sharing -->
          <footer class="mt-12 border-t border-frame pt-8 md:mt-16 md:pt-10">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-[6px] border border-frame bg-surface font-mono text-xs font-bold text-accent">
                  MP
                </div>
                <div>
                  <p class="font-body text-sm text-text-primary">{author.name}</p>
                  <p class="font-mono text-[11px] text-text-tertiary">{author.role}</p>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <span class="mr-1 font-mono text-[10px] uppercase tracking-[0.1em] text-text-tertiary">compartir</span>
                <a
                  href={`https://wa.me/?text=${shareText}%20${encodeURIComponent(postUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-8 w-8 items-center justify-center rounded-[4px] border border-frame text-text-tertiary transition-colors hover:border-accent hover:text-accent"
                  aria-label="Compartir en WhatsApp"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
                </a>
                <a
                  href={`https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(postUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-8 w-8 items-center justify-center rounded-[4px] border border-frame text-text-tertiary transition-colors hover:border-accent hover:text-accent"
                  aria-label="Compartir en X"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46L20 4"/></svg>
                </a>
                <a
                  href={`https://linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-8 w-8 items-center justify-center rounded-[4px] border border-frame text-text-tertiary transition-colors hover:border-accent hover:text-accent"
                  aria-label="Compartir en LinkedIn"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                </a>
                <button
                  type="button"
                  class="copy-link-btn flex h-8 w-8 items-center justify-center rounded-[4px] border border-frame text-text-tertiary transition-colors hover:border-accent hover:text-accent"
                  aria-label="Copiar enlace"
                  data-url={postUrl}
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
                </button>
              </div>
            </div>
          </footer>
        </article>

        <!-- Sidebar · Table of Contents (desktop only) -->
        {
          hasToc && (
            <aside class="hidden lg:col-span-4 lg:block">
              <div class="toc-scroll sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pr-1">
                <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary">// en este artículo</p>
                <nav class="toc-sidebar space-y-1">
                  {tocItems.map((item: any) => (
                    <a
                      href={`#${item.slug}`}
                      class={`block font-mono text-[13px] leading-snug transition-colors duration-200 ${item.depth === 3 ? "pl-4 text-text-tertiary hover:text-text-secondary" : "text-text-secondary hover:text-text-primary"}`}
                    >
                      {item.text}
                    </a>
                  ))}
                </nav>

                <!-- Mini author card in sidebar -->
                <div class="mt-8 border-t border-frame pt-6">
                  <div class="flex items-center gap-2.5">
                    <div class="flex h-8 w-8 items-center justify-center rounded-[6px] border border-frame bg-surface font-mono text-[10px] font-bold text-accent">
                      MP
                    </div>
                    <div>
                      <p class="font-body text-xs text-text-secondary">{author.shortName}</p>
                      <p class="font-mono text-[10px] text-text-tertiary">{author.role}</p>
                    </div>
                  </div>
                </div>
              </div>
            </aside>
          )
        }
      </div>
    </section>

    <!-- Related posts · mismas cards que el índice -->
    {
      related.length > 0 && (
        <section class="w-full border-t border-frame/60 bg-bg py-16 md:py-20">
          <div class="px-4 sm:px-6 lg:px-8 xl:px-12">
            <div class="reveal-group">
              <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
                <div>
                  <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">// sigue leyendo</p>
                  <h2 class="mt-2 font-heading text-2xl font-bold tracking-[-0.02em] text-text-primary md:text-3xl">
                    Artículos relacionados
                  </h2>
                </div>
                <a
                  href="/blog"
                  class="rounded-[6px] border border-frame px-4 py-2 font-mono text-[11px] uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent"
                >
                  [ Ver todo el blog ]
                </a>
              </div>

              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                {related.map((r) => {
                  const rSlug = r.id.replace(/\.(md|mdx)$/, "");
                  const rImg = r.data.image || "/logo.jpg";
                  const rReadMin = readingTime(r.body || "");
                  const rCat = getCategoryLabel(r.data.tags || []);
                  const rAccent = getCategoryAccent(r.data.tags || []);
                  return (
                    <article class="reveal-item">
                      <a
                        href={`/blog/${rSlug}`}
                        class="group block overflow-hidden rounded-[6px] border border-frame/60 bg-surface no-underline transition-colors hover:border-frame-hover hover:bg-surface-hover"
                      >
                        <div class="relative aspect-[16/10] overflow-hidden bg-surface-sunken">
                          <img
                            src={rImg}
                            alt={r.data.title}
                            class="h-full w-full object-cover opacity-70 transition-transform duration-700 group-hover:scale-[1.04]"
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent" aria-hidden="true" />
                        </div>

                        <div class="p-5 md:p-6">
                          <div class="mb-3 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.08em] text-text-tertiary">
                            <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${rAccent};`} aria-hidden="true" />
                            <span>{rCat}</span>
                            <span class="text-frame">·</span>
                            <time datetime={r.data.pubDate.toISOString()}>{rReadMin} min de lectura</time>
                          </div>

                          <h3 class="font-heading text-lg font-bold leading-snug tracking-[-0.01em] text-text-primary transition-colors group-hover:text-accent md:text-xl">
                            {r.data.title}
                          </h3>
                          <p class="mt-2 line-clamp-2 font-body text-sm font-light leading-relaxed text-text-secondary">
                            {r.data.description}
                          </p>

                          <span class="mt-4 inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-text-tertiary transition-colors group-hover:text-accent">
                            [ Leer ]
                            <svg class="h-3 w-3 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                          </span>
                        </div>
                      </a>
                    </article>
                  );
                })}
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA final · contextual según tema del post (ventana canónica §13[8]) -->
    <section id="contacto" class="w-full scroll-mt-16 border-t border-frame/60 bg-bg py-20 md:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="webcore-window">
          <!-- Title bar -->
          <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
            <span
              class="h-2 w-2 shrink-0 rounded-full bg-accent"
              style="box-shadow:0 0 8px var(--color-accent);"
              aria-hidden="true"></span>
            <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary">contact — iniciar conversación</span>
          </div>

          <!-- Body -->
          <div class="reveal-group px-6 py-12 text-center sm:px-8 md:py-16">
            <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">// aplica lo que leíste</p>

            <h2 class="reveal-item mx-auto mt-5 max-w-2xl font-heading text-3xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl">
              ¿Tu negocio necesita <span class="text-accent">{ctaConfig.service}?</span>
            </h2>

            <p class="reveal-item mx-auto mt-5 max-w-xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base">
              Somos Mtsprz · agencia digital del sur de Chile. Conversemos sin compromiso sobre cómo podemos ayudarte.
            </p>

            <div class="reveal-item mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
              <a
                href={waCtaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:w-auto"
              >
                [ WhatsApp ]
              </a>
              <a
                href={ctaConfig.url}
                class="inline-flex w-full items-center justify-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:w-auto"
              >
                [ Ver {ctaConfig.service} ]
              </a>
            </div>

            <p class="reveal-item mt-6 font-mono text-xs text-text-tertiary">
              o llama al <span class="text-text-secondary">+56 9 6692 9818</span>
            </p>

            <div class="reveal-item mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 border-t border-frame pt-8">
              {
                ["Sin compromiso", "Respuesta en 24 hrs", "Sur de Chile"].map((t) => (
                  <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
                    <svg
                      class="h-3.5 w-3.5 text-accent"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6L9 17l-5-5" />
                    </svg>
