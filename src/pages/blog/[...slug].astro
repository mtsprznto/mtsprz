---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Footer from "../../components/Footer.astro";
import { author } from "../../data/author";
import { getCollection } from "astro:content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const slug = post.id.replace(/\.(md|mdx)$/, "");
const { Content, headings } = await render(post);
const allPosts = await getCollection("blog");

const waPhone = "56966929818";
// CTA contextual según tags del post
const tags = (post.data.tags || []).map((t: string) => t.toLowerCase());
const isAutomatizacion = tags.some((t: string) => ["automatización", "whatsapp", "bot", "crm"].includes(t));
const isSEO = tags.some((t: string) => ["seo", "google maps", "posicionamiento", "seo local"].includes(t));
const ctaConfig = isAutomatizacion
  ? { service: "automatización", url: "/automatizacion", accent: "#06b6d4", gradient: "linear-gradient(135deg,#06b6d4,#0891b2)", waMsg: "Hola! Leí el blog y quiero saber cómo automatizar mi negocio." }
  : isSEO
  ? { service: "SEO local", url: "/seo-local", accent: "#10b981", gradient: "linear-gradient(135deg,#10b981,#059669)", waMsg: "Hola! Leí el blog y quiero posicionar mi negocio en Google." }
  : { service: "desarrollo web", url: "/desarrollo-web", accent: "#6366f1", gradient: "linear-gradient(135deg,#6366f1,#8b5cf6)", waMsg: "Hola! Leí el blog y quiero cotizar una página web." };
const waCtaUrl = `https://wa.me/${waPhone}?text=${encodeURIComponent(ctaConfig.waMsg)}`;
const postTags = post.data.tags || [];
const postTagSet = new Set(postTags.map((t: string) => t.toLowerCase()));
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const pTags = (p.data.tags || []).map((t: string) => t.toLowerCase());
    const shared = pTags.filter((t: string) => postTagSet.has(t)).length;
    return { post: p, relevance: shared };
  })
  .sort((a, b) => b.relevance - a.relevance || Math.random() - 0.5)
  .slice(0, 2)
  .map((r) => r.post);

function readingTime(text: string): number {
  const words = text.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

// Extract HowTo steps from markdown body
function extractHowToSteps(body: string): { position: number; name: string; text: string }[] {
  const results: { position: number; name: string; text: string }[] = [];

  const pasoRegex = /^##\s+Paso\s+(\d+)[:\.]\s+(.+)\n\n([\s\S]*?)(?=\n\n##\s+|\n---|\n\[|$)/gim;
  let match;
  while ((match = pasoRegex.exec(body)) !== null) {
    const position = parseInt(match[1], 10);
    const name = match[2].trim();
    const rawText = match[3].trim();
    const text = rawText.split(/\n\n/)[0].replace(/\n/g, " ").slice(0, 500);
    if (text.length > 20) {
      results.push({ position, name, text });
    }
  }

  if (results.length === 0) {
    const numberedRegex = /^###\s+(\d+)[\.\)]\s+(.+)\n\n([\s\S]*?)(?=\n\n###\s+|\n\n##\s+|\n---|\n\[|$)/gm;
    while ((match = numberedRegex.exec(body)) !== null) {
      const position = parseInt(match[1], 10);
      const name = match[2].trim();
      const rawText = match[3].trim();
      const text = rawText.split(/\n\n/)[0].replace(/\n/g, " ").slice(0, 500);
      if (text.length > 20) {
        results.push({ position, name, text });
      }
    }
  }

  return results.sort((a, b) => a.position - b.position);
}

// Extract FAQ pairs from markdown body
function extractFAQ(body: string): { question: string; answer: string }[] {
  const results: { question: string; answer: string }[] = [];

  // Find FAQ section: "## Preguntas frecuentes..." or "## FAQ"
  const faqSectionRegex = /^##\s+(?:Preguntas frecuentes|FAQ)(?:\s+.*)?\n\n([\s\S]*?)(?=\n##\s+|\n---|\n\[|$)/gim;
  let sectionMatch;
  while ((sectionMatch = faqSectionRegex.exec(body)) !== null) {
    const section = sectionMatch[1];

    // Extract ### Question followed by answer text
    const qaRegex = /^###\s+(.+)\n\n([\s\S]*?)(?=\n###\s+|\n##\s+|\n---|\n\[|$)/gm;
    let qaMatch;
    while ((qaMatch = qaRegex.exec(section)) !== null) {
      const question = qaMatch[1].trim();
      const rawAnswer = qaMatch[2].trim();
      const answer = rawAnswer.split(/\n\n/)[0].replace(/\n/g, " ").slice(0, 300);
      if (question.length > 5 && answer.length > 20) {
        results.push({ question, answer });
      }
    }
  }

  return results.slice(0, 8); // Max 8 FAQ pairs per schema
}

const readMin = readingTime(post.body || "");
const postUrl = `https://mtsprz.org/blog/${slug}`;
const shareText = encodeURIComponent(post.data.title);

// Build ToC from headings (h2 and h3 only) · excluye el heading que duplica el título del hero
const normalizeHeading = (text: string) =>
  text.toLowerCase().replace(/[^a-z0-9áéíóúñü]+/g, " ").trim();
const normalizedTitle = normalizeHeading(post.data.title);
const tocItems = headings
  .filter((h: any) => h.depth === 2 || h.depth === 3)
  .map((h: any) => ({
    depth: h.depth,
    text: h.text,
    slug: h.slug,
  }))
  .filter((item: any) => normalizeHeading(item.text) !== normalizedTitle);
const hasToc = tocItems.length >= 2;
const hideFirstHeading =
  headings.length > 0 && normalizeHeading(headings[0].text) === normalizedTitle;

const postImg = post.data.image || "/logo.jpg";
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={postUrl}
  image={post.data.image || undefined}
  breadcrumbs={[
    { name: "Blog", path: "/blog" },
    { name: post.data.title, path: `/blog/${slug}` },
  ]}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: (post.data.modifiedTime || post.data.pubDate).toISOString(),
    author: post.data.author,
    tags: post.data.tags,
    hasSpeakable: true,
  }}
>
  <Header />
  <link rel="preload" as="video" href="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4" fetchpriority="high" />
  {
    (() => {
      const howToSteps = extractHowToSteps(post.body || "");
      if (howToSteps.length >= 2) {
        return <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "HowTo",
          "name": post.data.title,
          "description": post.data.description,
          "step": howToSteps.map((s) => ({
            "@type": "HowToStep",
            "position": s.position,
            "name": s.name,
            "text": s.text,
          })),
        })} />;
      }
      return null;
    })()
  }
  {
    (() => {
      const faqPairs = extractFAQ(post.body || "");
      if (faqPairs.length >= 2) {
        return <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": faqPairs.map((faq) => ({
            "@type": "Question",
            "name": faq.question,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": faq.answer,
            },
          })),
        })} />;
      }
      return null;
    })()
  }

  <!-- Reading progress bar -->
  <div id="reading-progress" class="fixed top-0 left-0 right-0 h-[3px] z-[60] bg-transparent pointer-events-none">
    <div id="reading-progress-bar" class="h-full bg-[#6366f1] transition-[width] duration-100 ease-out" style="width: 0%;"></div>
  </div>

  <main id="main-content">
    <!-- Hero · video background with post image overlay -->
    <section class="relative w-screen h-[85dvh] md:h-screen overflow-hidden bg-[#010101]">
      <!-- Post featured image as background layer -->
      <div
        class="absolute inset-0 z-[1] bg-cover bg-center opacity-30"
        style={`background-image: url('${postImg}');`}
      />
      <!-- Video overlay -->
      <video
        src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4"
        autoplay loop muted playsinline
        preload="metadata"
        class="z-[2] opacity-60"
        style="position: absolute !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: center !important; max-width: none !important; min-width: 0 !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; border: 0 !important; display: block !important;"
      />
      <div style="position: absolute !important; top: 0; left: 0; width: 100%; height: 28%; z-index: 3;" class="bg-gradient-to-b from-[#010101] to-transparent sm:h-36"></div>
      <div style="position: absolute !important; bottom: 0; left: 0; width: 100%; height: 40%; z-index: 3;" class="bg-gradient-to-t from-[#010101] to-transparent sm:h-48"></div>

      <!-- Contenido central -->
      <div style="position: absolute !important; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center; pointer-events: none;">
        <div class="text-center px-6 max-w-4xl" style="pointer-events: auto;">
          <!-- Tags above title -->
          <div class="flex flex-wrap items-center justify-center gap-2 mb-5">
            {(post.data.tags || []).slice(0, 3).map((tag) => (
              <span class="inline-flex items-center px-3 py-1 text-[10px] font-body font-medium tracking-[0.08em] uppercase text-[#6366f1] border border-[#6366f1]/20 rounded-full bg-[#6366f1]/5">
                {tag}
              </span>
            ))}
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-bold text-white leading-[1.0] tracking-[-1.5px] md:tracking-[-2.5px]">
            {post.data.title}
          </h1>

          <div class="mt-5 md:mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[11px] md:text-xs text-white/35 font-body tracking-wide">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-full bg-gradient-to-br from-[#6366f1] to-[#8b5cf6] flex items-center justify-center text-[9px] font-bold text-white">
                MP
              </div>
              <span class="text-white/50">{author.name}</span>
            </div>
            <span class="text-white/15">&middot;</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("es-CL", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <span class="text-white/15">&middot;</span>
            <span>{readMin} min de lectura</span>
            {post.data.modifiedTime && (
              <>
                <span class="text-white/15">&middot;</span>
                <span style="color: #10b981aa;">Actualizado</span>
              </>
            )}
          </div>
        </div>
      </div>

      <!-- Breadcrumb · integrado en hero, esquina inferior -->
      <div class="absolute bottom-6 md:bottom-8 left-0 right-0 z-20 px-6">
        <div class="mx-auto max-w-6xl">
          <Breadcrumbs items={[
            { name: "Blog", path: "/blog" },
            { name: post.data.title, path: `/blog/${slug}` },
          ]} />
        </div>
      </div>
    </section>

    <!-- Article content · editorial layout with sidebar ToC -->
    <section class="relative bg-[#0A0A0A] w-full">
      <!-- Background -->
      <div class="absolute inset-0" style="background: #0A0A0A;" />
      <div class="absolute inset-0 opacity-40" style="background: radial-gradient(ellipse at 30% 0%, #6366f110 0%, transparent 50%), radial-gradient(ellipse at 70% 100%, #8b5cf606 0%, transparent 50%);" />
      <div class="absolute inset-0 opacity-[0.012] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noise)\' opacity=\'1\'/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;" />
      <div class="absolute top-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f144, transparent);" />

      <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-24">
        <div class="flex gap-12 lg:gap-16">
          <!-- Main article content -->
          <article class="reveal-group flex-1 min-w-0 max-w-3xl">
            <!-- Back link -->
            <nav class="reveal-item mb-8 md:mb-10">
              <a
                href="/blog"
                class="inline-flex items-center gap-2 text-[11px] text-white/30 hover:text-white/60 transition-colors font-body tracking-[0.1em] uppercase"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                Volver al blog
              </a>
            </nav>

            <!-- Author + meta · editorial card -->
            <div class="reveal-item mb-8 md:mb-10 p-5 md:p-6 rounded-xl bg-white/[0.02] border border-white/[0.04]">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-11 h-11 rounded-full bg-gradient-to-br from-[#6366f1] to-[#8b5cf6] flex items-center justify-center text-sm font-bold text-white shrink-0">
                    MP
                  </div>
                  <div>
                    <p class="text-sm text-white/70 font-body font-medium">{author.name}</p>
                    <p class="text-[11px] text-white/30 font-body">{author.role} · {author.company}</p>
                  </div>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {post.data.tags.map((tag) => (
                    <span class="inline-flex items-center px-2.5 py-1 text-[9px] md:text-[10px] text-white/25 font-body tracking-[0.05em] uppercase border border-white/[0.06] rounded">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Mobile ToC · details nativo, sin JS · sticky para no perderlo al leer -->
            {
              hasToc && (
                <div class="sticky top-16 z-20 lg:hidden mb-8 md:mb-10">
                  <details class="mobile-toc reveal-item rounded-xl bg-[#141416]/95 backdrop-blur-md border border-white/[0.08] overflow-hidden shadow-[0_8px_24px_rgba(0,0,0,0.45)]">
                    <summary class="group flex items-center justify-between px-5 py-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                      <span class="text-[10px] uppercase tracking-[0.2em] text-white/40 font-body font-medium">En este artículo</span>
                      <svg class="w-3.5 h-3.5 text-white/30 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>
                    <nav class="px-5 pb-5 pt-4 space-y-2.5 border-t border-white/[0.04] max-h-[60vh] overflow-y-auto">
                      {tocItems.map((item: any) => (
                        <a
                          href={`#${item.slug}`}
                          class={`block text-[13px] font-body leading-snug transition-colors duration-200 hover:text-white/70 ${item.depth === 3 ? "pl-4 text-white/30" : "text-white/45"}`}
                        >
                          {item.text}
                        </a>
                      ))}
                    </nav>
                  </details>
                </div>
              )
            }

            <!-- GEO Answer Block · destacado editorial (speakable for Google Assistant) -->
            <div class="reveal-item mb-8 md:mb-10">
              <div class="geo-answer relative pl-5 md:pl-6 border-l-2 border-[#6366f1]/40">
                <p class="text-[10px] uppercase tracking-[0.2em] text-[#6366f1]/70 font-body font-medium mb-2">Respuesta rápida</p>
                <p class="text-sm md:text-[15px] text-white/55 font-body font-light leading-[1.8]">
                  {post.data.description}
                </p>
              </div>
            </div>

            <!-- Article body · prose editorial -->
            <div class={`reveal-item prose-blog max-w-none${hideFirstHeading ? " hide-first-heading" : ""}`}>
              <Content />
            </div>

            <!-- Author footer + sharing · enhanced editorial -->
            <footer class="reveal-item mt-12 md:mt-16 pt-8 md:pt-10 border-t border-white/[0.06]">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#6366f1] to-[#8b5cf6] flex items-center justify-center text-sm font-bold text-white">
                    MP
                  </div>
                  <div>
                    <p class="text-sm text-white/70 font-body">{author.name}</p>
                    <p class="text-[11px] text-white/30 font-body">{author.role}</p>
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <span class="text-[10px] text-white/25 font-body uppercase tracking-[0.1em] mr-1">Compartir</span>
                  <a
                    href={`https://wa.me/?text=${shareText}%20${encodeURIComponent(postUrl)}`}
                    target="_blank" rel="noopener noreferrer"
                    class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center text-white/40 hover:text-white hover:border-white/30 transition-all"
                    aria-label="Compartir en WhatsApp"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
                  </a>
                  <a
                    href={`https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(postUrl)}`}
                    target="_blank" rel="noopener noreferrer"
                    class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center text-white/40 hover:text-white hover:border-white/30 transition-all"
                    aria-label="Compartir en Twitter"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46L20 4"/></svg>
                  </a>
                  <a
                    href={`https://linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
                    target="_blank" rel="noopener noreferrer"
                    class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center text-white/40 hover:text-white hover:border-white/30 transition-all"
                    aria-label="Compartir en LinkedIn"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                  </a>
                  <button
                    class="copy-link-btn w-8 h-8 rounded-full border border-white/10 flex items-center justify-center text-white/40 hover:text-white hover:border-white/30 transition-all"
                    aria-label="Copiar enlace"
                    data-url={postUrl}
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
                  </button>
                </div>
              </div>
            </footer>
          </article>

          <!-- Sidebar · Table of Contents (desktop only) -->
          {
            hasToc && (
              <aside class="hidden lg:block w-64 xl:w-72 shrink-0">
                <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto toc-scroll pr-1">
                  <p class="text-[10px] uppercase tracking-[0.2em] text-white/25 font-body font-medium mb-4">En este artículo</p>
                  <nav class="toc-sidebar space-y-1">
                    {tocItems.map((item: any) => (
                      <a
                        href={`#${item.slug}`}
                        class={`block text-[13px] font-body leading-snug transition-colors duration-200 hover:text-white/70 ${
                          item.depth === 3
                            ? 'pl-4 text-white/25 hover:text-white/50'
                            : 'text-white/40'
                        }`}
                      >
                        {item.text}
                      </a>
                    ))}
                  </nav>

                  <!-- Mini author card in sidebar -->
                  <div class="mt-8 pt-6 border-t border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#6366f1] to-[#8b5cf6] flex items-center justify-center text-[10px] font-bold text-white">
                        MP
                      </div>
                      <div>
                        <p class="text-xs text-white/50 font-body">{author.shortName}</p>
                        <p class="text-[10px] text-white/25 font-body">{author.role}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </aside>
            )
          }
        </div>
      </div>

      <div class="absolute bottom-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f122, transparent);" />
    </section>

    <!-- Related posts · editorial cards with images -->
    {
      related.length > 0 && (
        <section class="relative bg-[#0A0A0A] w-full overflow-hidden">
          <div class="absolute inset-0" style="background: #0A0A0A;" />
          <div class="absolute inset-0 opacity-40" style="background: radial-gradient(ellipse at 70% 0%, #8b5cf608 0%, transparent 50%), radial-gradient(ellipse at 30% 100%, #6366f106 0%, transparent 50%);" />
          <div class="absolute inset-0 opacity-[0.012] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noise)\' opacity=\'1\'/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;" />
          <div class="absolute top-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f144, transparent);" />
          <div class="absolute bottom-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f122, transparent);" />

          <div class="relative mx-auto max-w-6xl px-6 py-20 md:py-28">
            <div class="reveal-group">
              <p class="reveal-item text-[10px] md:text-xs uppercase tracking-[0.25em] font-body font-medium mb-8 md:mb-10" style="color: #6366f1aa;">Artículos relacionados</p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {related.map((r) => {
                  const rSlug = r.id.replace(/\.(md|mdx)$/, "");
                  const rImg = r.data.image || "/logo.jpg";
                  const rReadMin = readingTime(r.body || "");
                  return (
                    <article class="reveal-item group">
                      <a href={`/blog/${rSlug}`} class="block relative overflow-hidden rounded-lg bg-[#111113] border border-white/[0.04] hover:border-white/[0.08] transition-all duration-500 no-underline">
                        <!-- Image -->
                        <div class="relative aspect-[16/9] overflow-hidden">
                          <img
                            src={rImg}
                            alt={r.data.title}
                            class="w-full h-full object-cover opacity-50 transition-transform duration-700 group-hover:scale-[1.04]"
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
                        </div>

                        <!-- Content -->
                        <div class="p-5 md:p-6">
                          <div class="flex items-center gap-2 text-[10px] md:text-[11px] text-white/30 font-body tracking-wide mb-2.5">
                            <time datetime={r.data.pubDate.toISOString()}>
                              {r.data.pubDate.toLocaleDateString("es-CL", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                              })}
                            </time>
                            <span class="text-white/15">&middot;</span>
                            <span>{rReadMin} min</span>
                          </div>

                          <h3 class="text-lg md:text-xl font-heading font-bold text-white leading-snug group-hover:text-white/60 transition-colors duration-300 tracking-[-0.3px]">
                            {r.data.title}
                          </h3>
                          <p class="mt-2 text-sm text-white/40 font-body font-light leading-relaxed line-clamp-2">
                            {r.data.description}
                          </p>

                          <div class="mt-4 flex items-center gap-1.5 text-[10px] font-body tracking-[0.1em] uppercase text-[#6366f1]/70 group-hover:text-[#6366f1] transition-colors">
                            <span>Leer</span>
                            <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                          </div>
                        </div>
                      </a>
                    </article>
                  );
                })}
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA · contextual según tema del post -->
    <section class="relative bg-[#0A0A0A] w-full overflow-hidden">
      <div class="absolute inset-0" style="background: #0A0A0A;" />
      <div class="absolute inset-0 opacity-50" style={`background: radial-gradient(ellipse at 50% 0%, ${ctaConfig.accent}28 0%, transparent 50%);`} />
      <div class="absolute inset-0 opacity-[0.012] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noise)\' opacity=\'1\'/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;" />
      <div class="absolute top-0 left-0 right-0 h-[1px]" style={`background: linear-gradient(90deg, transparent, ${ctaConfig.accent}44, transparent);`} />
      <div class="absolute bottom-0 left-0 right-0 h-[1px]" style={`background: linear-gradient(90deg, transparent, ${ctaConfig.accent}22, transparent);`} />

      <div class="relative mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
        <div class="reveal-group">
          <p class="reveal-item text-[10px] md:text-xs uppercase tracking-[0.25em] font-body font-medium mb-6" style={`color: ${ctaConfig.accent}aa;`}>
            Aplica lo que leíste
          </p>

          <h2 class="reveal-item text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-[0.95] tracking-[-1.5px] md:tracking-[-2px]">
            ¿Tu negocio necesita<br />
            <span class="text-transparent bg-clip-text" style={`background-image: ${ctaConfig.gradient};`}>{ctaConfig.service}?</span>
          </h2>

          <div class="reveal-item mx-auto my-8 w-12 h-[1px]" style={`background: linear-gradient(90deg, transparent, ${ctaConfig.accent}66, transparent);`} />

          <p class="reveal-item mx-auto max-w-lg text-sm md:text-base text-white/50 font-body font-light leading-relaxed">
            Somos Mtsprz · agencia digital del sur de Chile. Conversemos sin compromiso sobre cómo podemos ayudarte.
          </p>

          <div class="reveal-item mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href={waCtaUrl} target="_blank" rel="noopener noreferrer"
              class="group inline-flex items-center gap-3 px-7 md:px-8 py-3.5 md:py-4 text-xs md:text-sm font-medium tracking-[0.15em] uppercase transition-all"
              style="color:#fff; background:#25D366;">
              <span>WhatsApp</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
            <a href={ctaConfig.url}
              class="group inline-flex items-center gap-3 px-7 md:px-8 py-3.5 md:py-4 text-xs md:text-sm font-medium tracking-[0.15em] uppercase transition-all"
              style={`color:#fff; background:${ctaConfig.gradient};`}>
              <span>Ver servicio</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
            </a>
          </div>

          <div class="reveal-item mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
            {[
              { label: "Sin compromiso" },
              { label: "Respuesta en 24 hrs" },
              { label: "Sur de Chile" },
            ].map((t) => (
              <span class="inline-flex items-center gap-2 text-[10px] md:text-xs font-medium tracking-[0.1em] uppercase" style="color: rgba(255,255,255,0.25);">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke={ctaConfig.accent} stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                {t.label}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
  (function() {
    // Copy link button
    var btn = document.querySelector(".copy-link-btn");
    if (btn) {
      btn.addEventListener("click", function() {
        var url = btn.getAttribute("data-url");
        navigator.clipboard.writeText(url).then(function() {
          var original = btn.innerHTML;
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
          setTimeout(function() { btn.innerHTML = original; }, 2000);
        });
      });
    }

    // Heading anchor links · permalink "#" visible on hover
    var prose = document.querySelector(".prose-blog");
    if (prose) {
      prose.querySelectorAll("h2[id], h3[id]").forEach(function(heading) {
        if (heading.querySelector(".heading-anchor")) return;
        var anchor = document.createElement("a");
        anchor.href = "#" + heading.id;
        anchor.className = "heading-anchor";
        anchor.setAttribute("aria-label", "Enlace directo: " + heading.textContent.trim());
        anchor.textContent = "#";
        heading.appendChild(anchor);
      });
    }

    // Mobile ToC auto-close on scroll · no tapar la lectura
    var mobileToc = document.querySelector(".mobile-toc");
    if (mobileToc) {
      window.addEventListener("scroll", function() {
        if (mobileToc.open && window.scrollY > 100) mobileToc.open = false;
      }, { passive: true });
    }

    // Reading progress bar
    var progressBar = document.getElementById("reading-progress-bar");
    if (progressBar) {
      window.addEventListener("scroll", function() {
        var scrollTop = window.scrollY;
        var docHeight = document.documentElement.scrollHeight - window.innerHeight;
        var progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = Math.min(progress, 100) + "%";
      }, { passive: true });
    }

    // ToC active state tracking
    var tocLinks = document.querySelectorAll(".toc-sidebar a");
    if (tocLinks.length > 0) {
      var headingIds = [];
      tocLinks.forEach(function(link) {
        var href = link.getAttribute("href");
        if (href && href.startsWith("#")) {
          headingIds.push(href.slice(1));
        }
      });

      function updateTocActive() {
        var scrollPos = window.scrollY + 120;
        var current = headingIds[0];
        for (var i = 0; i < headingIds.length; i++) {
          var el = document.getElementById(headingIds[i]);
          if (el && el.offsetTop <= scrollPos) {
            current = headingIds[i];
          }
        }
        tocLinks.forEach(function(link) {
          var href = link.getAttribute("href");
          if (href === "#" + current) {
            link.classList.add("toc-active");
            link.classList.remove("text-white/40");
            link.classList.add("text-white/80");
          } else {
            link.classList.remove("toc-active");
            link.classList.remove("text-white/80");
            if (!link.classList.contains("pl-4")) {
              link.classList.add("text-white/40");
            } else {
              link.classList.add("text-white/25");
            }
          }
        });
      }

      window.addEventListener("scroll", updateTocActive, { passive: true });
      updateTocActive();
    }
  })();
  </script>
</BaseLayout>
