---
/**
 * Header — Nav sticky (DESIGN §6.1 / §13 [1. NAVBAR])
 * v2: conserva liquid-glass; agrega StatusLed + AccessibilityModeToggle + CTA neón.
 * Sin JS: nav + overlay se ven como bloques; el toggle de menú móvil no oculta
 * contenido crítico (el overlay arranca pointer-events-none / opacity-0).
 */
import StatusLed from "./ui/StatusLed.astro";
import AccessibilityModeToggle from "./ui/AccessibilityModeToggle.astro";

const navLinks = [
  { href: "/servicios", label: "Servicios" },
  { href: "/portafolio", label: "Portafolio" },
  { href: "/casos", label: "Casos" },
  { href: "/blog", label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];
---

<header class="fixed top-3 sm:top-4 left-0 right-0 z-50 flex justify-center px-4 sm:px-0">
  <nav
    class="relative z-50 flex h-12 w-full max-w-6xl items-center gap-2 liquid-glass rounded-lg px-2 sm:h-14 sm:px-3 sm:w-[92%]"
    aria-label="Principal"
  >
    <a href="/" class="flex shrink-0 items-center gap-2 pl-1" aria-label="Mtsprz — inicio">
      <picture>
        <source srcset="/logo.avif" type="image/avif" />
        <source srcset="/logo.webp" type="image/webp" />
        <img
          src="/logo.jpg"
          alt=""
          width="28"
          height="28"
          class="h-7 w-7 rounded-sm object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <span class="hidden font-mono text-sm font-bold uppercase tracking-wider text-text-primary sm:inline"
        >mtsprz</span
      >
    </a>

    <div class="hidden md:flex flex-1 items-center justify-center gap-1">
      {navLinks.map((l) => (
        <a
          href={l.href}
          class="nav-link px-3 py-2 font-mono text-[13px] uppercase tracking-wide text-text-secondary transition-colors hover:text-text-primary"
          >{l.label}</a
        >
      ))}
    </div>

    <div class="flex items-center gap-2 ml-auto md:ml-0">
      <StatusLed label="ONLINE" class="hidden lg:inline-flex" />
      <AccessibilityModeToggle />

      <button
        type="button"
        onclick="window.openCotizarModal && window.openCotizarModal()"
        class="hidden md:inline-flex items-center whitespace-nowrap rounded-[6px] bg-accent px-3.5 py-2 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover"
        >[ Cotizar ]</button
      >

      <button
        id="nav-toggle"
        type="button"
        class="relative z-50 flex h-8 w-8 items-center justify-center rounded-sm border border-frame text-text-primary md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-overlay"
      >
        <svg
          id="nav-icon-open"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg
          id="nav-icon-close"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Full-screen mobile overlay -->
  <div
    id="nav-overlay"
    class="fixed inset-0 z-40 flex flex-col items-center justify-center gap-10 bg-bg opacity-0 pointer-events-none transition-all duration-300 ease-out md:hidden"
  >
    <StatusLed label="ALL SYSTEMS OPERATIONAL" status="ok" />
    <nav class="flex flex-col items-center gap-6" aria-label="Menú móvil">
      {navLinks.map((l) => (
        <a
          href={l.href}
          class="font-heading text-2xl font-bold uppercase tracking-wide text-text-secondary transition-colors hover:text-accent sm:text-3xl"
          >{l.label}</a
        >
      ))}
    </nav>
    <div class="flex flex-col items-center gap-4">
      <button
        type="button"
        onclick="window.openCotizarModal && window.openCotizarModal()"
        class="rounded-[6px] bg-accent px-10 py-3.5 font-mono text-sm font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover"
        >[ Cotizar ]</button
      >
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById("nav-toggle");
    var overlay = document.getElementById("nav-overlay");
    var openIcon = document.getElementById("nav-icon-open");
    var closeIcon = document.getElementById("nav-icon-close");
    if (!toggle || !overlay) return;

    function open() {
      overlay.classList.remove("pointer-events-none", "opacity-0");
      overlay.classList.add("pointer-events-auto", "opacity-100");
      openIcon.classList.add("hidden");
      closeIcon.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menú");
      document.body.style.overflow = "hidden";
    }

    function close() {
      overlay.classList.remove("pointer-events-auto", "opacity-100");
      overlay.classList.add("pointer-events-none", "opacity-0");
      openIcon.classList.remove("hidden");
      closeIcon.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú");
      document.body.style.overflow = "";
    }

    toggle.addEventListener("click", function () {
      if (overlay.classList.contains("opacity-100")) {
        close();
      } else {
        open();
      }
    });

    overlay.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", close);
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close();
    });
  })();
</script>
