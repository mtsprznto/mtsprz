---
/**
 * Diagnóstico Rápido · v2 "Technopunk Enterprise" (DESIGN §13 [3. MANIFIESTO])
 * - Rutas de servicio: tarjetas-ventana Webcore con acento por categoría (§2.3).
 * - Hoja de ruta: ventana de entrada (CTA neón) + conector + ventana de salida
 *   con la "Respuesta rápida" GEO (§7.3, texto citable en plano).
 * Sin font-hand, sin papel crema ni bordes irregulares (§0.7, §15).
 * Contenido y enlaces intactos: /diagnostico, landings de servicio, copy GEO.
 */
export interface Props {
  featured: any[];
}

const { featured } = Astro.props;
---

<section id="diagnostico" class="relative w-full scroll-mt-20 bg-bg">
  <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
    <!-- Header -->
    <div class="reveal-group mb-12 md:mb-16">
      <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
        // diagnóstico rápido
      </p>
      <h2
        class="reveal-item mt-4 font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl"
      >
        ¿Qué necesita tu negocio en Puerto Varas, Osorno o Valdivia?
      </h2>
      <p
        class="reveal-item mt-4 max-w-2xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base"
      >
        Cada pyme es diferente. Encuentra el servicio digital ideal para tu empresa
        en la Región de Los Lagos.
      </p>
    </div>

    <!-- Rutas de servicio · grid de ventanas -->
    <div class="reveal-group grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        featured.map((s, i) => {
          const num = String(i + 1).padStart(2, "0");
          const target = s.landingUrl || `/servicios/#${s.slug}`;
          return (
            <a
              href={target}
              id={s.slug}
              class="webcore-window reveal-item group flex h-full flex-col"
            >
              <!-- Chrome -->
              <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
                <span
                  class="h-2 w-2 shrink-0 rounded-full"
                  style={`background:${s.accent};box-shadow:0 0 8px ${s.accent}88;`}
                  aria-hidden="true"
                />
                <span class="truncate font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary">
                  ruta — {num}
                </span>
                <span class="ml-auto hidden truncate font-mono text-[11px] text-text-tertiary sm:block">
                  {target}
                </span>
              </div>

              <!-- Body -->
              <div class="flex flex-1 flex-col bg-surface-sunken p-5 sm:p-6">
                <h3 class="font-heading text-lg font-bold leading-snug tracking-[-0.01em] text-text-primary transition-colors duration-300 group-hover:text-accent">
                  {s.title}
                </h3>
                <p class="mt-2 font-body text-sm font-light leading-relaxed text-text-secondary">
                  {s.description}
                </p>
                <span class="mt-auto inline-flex items-center gap-2 pt-5 font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-text-primary transition-colors group-hover:text-accent">
                  [ Explorar ]
                  <svg
                    class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" /><path d="M12 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>

    <!-- Hoja de ruta · entrada (CTA) → salida (respuesta rápida GEO §7.3) · full width desktop -->
    <div class="reveal-group mt-16 md:mt-24">
      <!-- in — hoja de ruta -->
      <div class="reveal-item webcore-window">
        <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
          <span
            class="led-pulse h-2 w-2 shrink-0 rounded-full bg-accent"
            style="box-shadow:0 0 8px var(--color-accent);"
            aria-hidden="true"></span>
          <span class="truncate font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary">
            in — hoja de ruta
          </span>
          <span class="ml-auto shrink-0 font-mono text-[10px] uppercase tracking-[0.12em] text-text-tertiary">
            diagnóstico gratuito
          </span>
        </div>
        <div class="flex flex-col gap-6 bg-surface-sunken p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
          <div class="max-w-md">
            <h3
              class="font-heading text-lg font-bold leading-snug tracking-[-0.01em] text-text-primary md:text-xl"
            >
              ¿No sabes por dónde empezar?
            </h3>
            <p class="mt-2 font-body text-sm font-light leading-relaxed text-text-secondary">
              Cuéntanos tu situación y te recomendamos la solución ideal sin compromiso.
            </p>
          </div>
          <a
            href="/diagnostico"
            class="inline-flex w-full shrink-0 items-center justify-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-bg transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 sm:w-auto"
          >
            [ Solicitar diagnóstico ]
          </a>
        </div>
      </div>

      <!-- Conector (decorativo) -->
      <div class="reveal-item flex justify-center py-1" aria-hidden="true">
        <svg
          class="h-10 w-6 text-frame-hover"
          viewBox="0 0 24 40"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 2v28" stroke-dasharray="5 7" />
          <path d="M6 30l6 7 6-7" />
        </svg>
      </div>

      <!-- out — respuesta rápida -->
      <div class="reveal-item webcore-window">
        <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
          <span class="font-mono text-[13px] leading-none text-accent" aria-hidden="true">$</span>
          <span class="truncate font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary">
            out — respuesta rápida
          </span>
        </div>
        <div class="bg-surface-sunken p-6 md:p-8">
          <p class="font-body text-sm font-light leading-relaxed text-text-secondary md:text-base">
            <strong
              class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-accent"
              >Respuesta rápida:</strong
            >
            La mayoría de las pymes en la Región de Los Lagos comienzan con un sitio
            web profesional optimizado para SEO local. Si ya tienes página, el
            siguiente paso es el posicionamiento en Google Maps y búsquedas locales.
            Las automatizaciones son ideales cuando tu negocio empieza a recibir más
            clientes de los que puedes atender manualmente.
          </p>
          <a
            href="/diagnostico"
            class="mt-5 inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-[0.12em] text-text-primary transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
          >
            Solicita un diagnóstico
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" /><path d="M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
