---
import CinematicColumn from "../CinematicColumn.astro";

export interface Props {
  featured: any[];
}

const { featured } = Astro.props;
---

<!-- Diagnóstico · editorial cinematic columns -->
<section class="relative bg-[#0A0A0A] w-full" id="diagnostico">
  <!-- Header -->
  <div class="mx-auto max-w-5xl px-6 pt-20 md:pt-28 pb-14 md:pb-18 text-center">
    <div class="reveal-group">
      <p class="reveal-item text-xs uppercase tracking-[0.2em] text-white/40 font-body mb-3">Diagnóstico Rápido</p>
      <h2 class="reveal-item text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-white leading-[1.05] tracking-[-1px]">
        ¿Qué necesita tu negocio en <span style="color: #6366f1">Puerto Varas</span>, <span style="color: #10b981">Osorno</span> o <span style="color: #06b6d4">Valdivia</span>?
      </h2>
      <p class="reveal-item mt-3 text-sm md:text-base text-white/50 font-body font-light max-w-lg mx-auto">
        Cada pyme es diferente. Encuentra el servicio digital ideal para tu empresa en la Región de Los Lagos.
      </p>
    </div>
  </div>

  <!-- 3 editorial columns · full-bleed, cada una link a su landing si existe -->
  <div class="w-full overflow-hidden reveal-group">
    <div class="grid grid-cols-1 md:grid-cols-3">
      {featured.map((s, i) => (
        <div class="reveal-item">
          <CinematicColumn
            title={s.title}
            description={s.description}
            accent={s.accent}
            slug={s.slug}
            index={i}
            href={s.landingUrl || `/servicios/#${s.slug}`}
            ctaText="Explorar"
            compact
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Full-width CTA + GEO Quick Answer · dibujado a mano (humanwashing) -->
  <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
    <div class="reveal-group">
      <!-- anotación manuscrita -->
      <p class="reveal-item font-hand text-xl md:text-2xl mb-6 -rotate-1" style="color: #a5b4fc;">
        hoja de ruta
        <svg class="inline-block w-5 h-5 ml-1 -rotate-3" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M6 13l6 6 6-6"/></svg>
      </p>

      <!-- CTA box · bordes irregulares de cuaderno -->
      <a href="/diagnostico" class="reveal-item group relative flex flex-col sm:flex-row sm:items-center justify-between gap-4 px-6 md:px-8 py-5 md:py-6 transition-all duration-300 hover:-translate-y-0.5"
        style="background: rgba(245,239,230,0.03); border: 2px solid rgba(245,239,230,0.35); border-radius: 12px 250px 14px 240px / 240px 14px 250px 12px;"
      >
        <div>
          <h3 class="text-sm md:text-base font-heading font-semibold text-white/80">
            ¿No sabes por dónde empezar?
            <svg class="block w-[105%] h-2 -mx-1 mt-0.5" viewBox="0 0 200 8" preserveAspectRatio="none" fill="none" stroke="#6ee7b7" stroke-width="2.5" stroke-linecap="round"><path d="M1 6c25-6 50 6 75 0s50-6 75 0 33-6 48-2" /></svg>
          </h3>
          <p class="mt-1 text-xs md:text-sm text-white/40 font-body">Cuéntanos tu situación y te recomendamos la solución ideal <span class="relative whitespace-nowrap">sin compromiso
            <svg class="absolute -inset-x-1.5 -inset-y-1 w-[calc(100%+0.75rem)] h-[calc(100%+0.5rem)] -rotate-2" viewBox="0 0 200 32" preserveAspectRatio="none" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-dasharray="6 6"><ellipse cx="100" cy="16" rx="99" ry="15" /></svg>
          </span>.</p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-1.5 font-hand text-lg md:text-xl px-4 py-1.5 rotate-[1.5deg] transition-transform duration-300 group-hover:rotate-3"
          style="color: #fde68a; background: rgba(253,230,138,0.08); border: 1.5px dashed rgba(253,230,138,0.5); border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;"
        >
          Diagnóstico gratuito
          <svg class="w-4 h-4 -rotate-6" viewBox="0 0 24 24" fill="#f59e0b" stroke="none"><path d="M12 0c.8 6.5 4.5 10.2 12 12-7.5 1.8-11.2 5.5-12 12-.8-6.5-4.5-10.2-12-12C7.5 10.2 11.2 6.5 12 0z" /></svg>
        </span>
      </a>

      <!-- flecha punteada -->
      <div class="reveal-item flex justify-center my-2">
        <svg class="w-6 h-10" viewBox="0 0 24 40" fill="none" stroke="#6ee7b7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v28" stroke-dasharray="5 7" /><path d="M6 30l6 7 6-7" /></svg>
      </div>

      <!-- Nota adhesiva · GEO Quick Answer -->
      <div class="reveal-item relative mx-auto max-w-xl px-6 md:px-8 py-6 md:py-7 -rotate-1 transition-transform duration-300 hover:rotate-0"
        style="background: #f5efe0; border-radius: 3px 22px 3px 24px / 24px 3px 22px 3px; box-shadow: 0 14px 34px rgba(0,0,0,0.45);"
      >
        <div class="absolute left-1/2 -top-3.5 w-28 h-6 -translate-x-1/2 -rotate-2 opacity-80"
          style="background: rgba(253,230,138,0.75); box-shadow: inset 0 1px 1px rgba(255,255,255,0.5), 0 1px 3px rgba(0,0,0,0.25); backdrop-filter: blur(1px);"
        ></div>
        <p class="text-xs md:text-sm font-body leading-relaxed" style="color: #4a3f33;">
          <strong style="color: #2f2a22;">Respuesta rápida: </strong>
          La mayoría de las pymes en la Región de Los Lagos comienzan con un sitio web profesional optimizado para SEO local.
          Si ya tienes página, el siguiente paso es el posicionamiento en Google Maps y búsquedas locales.
          Las automatizaciones son ideales cuando tu negocio empieza a recibir más clientes de los que puedes atender manualmente.
          <a href="/diagnostico" class="font-hand text-base md:text-lg ml-1 underline underline-offset-4 decoration-2" style="color: #4338ca; text-decoration-color: rgba(67,56,202,0.4);">Solicita un diagnóstico →</a>
        </p>
      </div>
    </div>
  </div>
</section>
