---
/**
 * Services · v2 (DESIGN §13[4])
 * Grid de WebcoreWindow (ServiceCard) en lugar del carrusel con pin.
 * Reveal por capa CSS (.reveal-group/.reveal-item) — sin GSAP, sin pin.
 *
 * Capacidades honestas por línea de servicio. No se inventan métricas:
 * la ficha técnica lista stack/capacidades reales del estudio (§9).
 */
import ServiceCard from "../ServiceCard.astro";

export interface Props {
  services: any[];
}

const { services } = Astro.props;
---

<section id="servicios" class="relative w-full scroll-mt-20 bg-bg">
  <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
    <div class="reveal-group mb-12 md:mb-16">
      <p
        class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent"
      >
        // servicios
      </p>
      <h2
        class="reveal-item mt-4 max-w-3xl font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl"
      >
        Ingeniería, datos y automatización para tu negocio
      </h2>
      <p
        class="reveal-item mt-4 max-w-2xl font-body text-sm font-light leading-relaxed text-text-secondary md:text-base"
      >
        Cada servicio se entrega como un sistema verificable: alcance claro,
        métricas medibles y código que se mantiene.
      </p>
    </div>

    <div class="reveal-group grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-4">
      {
        services.map((s, i) => (
          <div class="reveal-item h-full">
            <ServiceCard
              icon={s.icon}
              title={s.title}
              description={s.description}
              tags={s.tags}
              number={i + 1}
              accent={s.accent}
              id={s.slug ? `servicio-${s.slug}` : undefined}
              href={s.landingUrl || "/servicios"}
              stack={s.stack}
            />
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <a
        href="/servicios"
        class="inline-flex items-center gap-2 rounded-[6px] border border-frame bg-surface px-5 py-3 font-mono text-xs font-bold uppercase tracking-[0.14em] text-text-primary transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
      >
        Ver catálogo completo
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M5 12h14" /><path d="M12 5l7 7-7 7" /></svg>
      </a>
    </div>
  </div>
</section>
