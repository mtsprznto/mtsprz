---
/**
 * Portafolio · v2 "Technopunk Enterprise" (DESIGN §13 [7. CASOS])
 * - Consola de deploys: ventana `deploys --status=production` con las 5 entradas
 *   en formato log (índice, LED de estado, host real, stack y captura verificable).
 * - Layout 100% width en desktop (directriz usuario) · responsive 1 col → 12 col.
 * - Capturas con <picture> nativo (AVIF/WebP/PNG ya generados en /public/portafolio).
 * GSAP retirado (§11) → reveal CSS puro. Copy/enlaces externos intactos (SEO).
 */
export interface Props {
  projects: any[];
}

const { projects } = Astro.props;

const items = projects.map((p) => {
  let host = p.url ?? "";
  try {
    host = new URL(p.url).host;
  } catch {
    /* host queda como url cruda */
  }
  const first = p.images?.[0];
  const shot = typeof first === "string" ? first.replace(/\.(png|jpe?g|webp|avif)$/i, "") : null;
  return { ...p, host, shot };
});
---

<section id="portafolio" class="relative w-full scroll-mt-20 bg-bg">
  <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
    <!-- Header -->
    <div class="reveal-group mb-12 md:mb-16">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p
            class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent"
          >
            // portafolio
          </p>
          <h2
            class="reveal-item mt-4 font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl"
          >
            Proyectos que<br /><span class="text-accent">ya están en producción</span>
          </h2>
        </div>
        <a
          href="/portafolio"
          class="reveal-item group inline-flex shrink-0 items-center gap-2 self-start border border-frame px-4 py-2 font-mono text-xs uppercase tracking-[0.12em] text-text-primary transition-colors hover:border-frame-hover hover:text-accent md:self-auto"
        >
          [ Ver portafolio completo ]
          <svg
            class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Consola de deploys · filas log full-width -->
    <div class="reveal-group">
      <div class="reveal-item webcore-window">
        <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
          <span
            class="h-2 w-2 shrink-0 rounded-full bg-accent"
            style="box-shadow:0 0 8px var(--color-accent);"
            aria-hidden="true"></span>
          <span class="truncate font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary">
            deploys --status=production
          </span>
          <span class="ml-auto hidden shrink-0 font-mono text-[11px] text-text-tertiary sm:block">
            {String(items.length).padStart(2, "0")} online
          </span>
        </div>

        <div class="bg-surface-sunken">
          {
            items.map((p, i) => (
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group grid grid-cols-1 gap-4 border-b border-frame/60 p-4 transition-colors last:border-b-0 hover:bg-surface md:grid-cols-12 md:items-center md:gap-6 md:p-5"
              >
                <!-- Captura verificable · 4/12 -->
                <div class="md:col-span-4">
                  <div class="relative aspect-[16/10] overflow-hidden rounded-[4px] border border-frame bg-bg">
                    {p.shot ? (
                      <picture>
                        <source srcset={`${p.shot}.avif`} type="image/avif" />
                        <source srcset={`${p.shot}.webp`} type="image/webp" />
                        <img
                          src={`${p.shot}.png`}
                          alt={`Captura de ${p.title}`}
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                        />
                      </picture>
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-surface">
                        <span class="px-4 text-center font-mono text-xs uppercase tracking-[0.14em] text-text-tertiary">
                          {p.title}
                        </span>
                      </div>
                    )}
                  </div>
                </div>

                <!-- Entrada log · 8/12 -->
                <div class="flex min-w-0 flex-col md:col-span-8">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px]">
                    <span class="text-text-tertiary">[{String(i + 1).padStart(2, "0")}]</span>
                    <span class="inline-flex items-center gap-1.5 uppercase tracking-[0.12em] text-accent">
                      <span class="led-pulse h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
                      en producción
                    </span>
                    <span class="ml-auto hidden text-text-tertiary lg:block">{p.host}</span>
                  </div>
                  <h3 class="mt-2 font-heading text-lg font-bold tracking-[-0.01em] text-text-primary transition-colors group-hover:text-accent md:text-xl">
                    {p.title}
                  </h3>
                  <p class="mt-2 max-w-2xl font-body text-sm font-light leading-[1.75] text-text-secondary">
                    {p.description}
                  </p>
                  <div class="mt-4 flex flex-wrap items-center gap-2">
                    {p.tags.slice(0, 4).map((t) => (
                      <span class="rounded-[4px] border border-frame bg-surface px-2 py-1 font-mono text-[11px] text-text-secondary">
                        {t}
                      </span>
                    ))}
                    <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.08em] text-text-primary transition-colors group-hover:text-accent">
                      [ Ver proyecto ]
                      <svg
                        class="h-3 w-3 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M7 17L17 7" />
                        <path d="M7 7h10v10" />
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>

        <p class="border-t border-frame bg-surface px-4 py-3 font-mono text-[11px] tracking-[0.08em] text-text-secondary sm:px-5">
          <span class="text-accent">→</span>
          {String(items.length).padStart(2, "0")} deploys en producción · cada enlace abre el sitio en vivo
        </p>
      </div>
    </div>
  </div>
</section>
