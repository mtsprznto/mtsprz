---
/**
 * HeroSection — Hero v2 "Technopunk Enterprise" (DESIGN §13 [2. HERO])
 * H1 mono · Terminal dual · CTA neón + CTA borde metálico · StatusLed.
 * El video queda como fondo cinematográfico (§5.4) atenuado (scrim).
 * Sin JS: H1 visible (noscript en BaseLayout), terminal estática, CTAs funcionan.
 */
import StaggerText from "../StaggerText.astro";
import TerminalWindow from "../ui/TerminalWindow.astro";
import StatusLed from "../ui/StatusLed.astro";

export interface Props {
  hoy: string;
  anio: number;
}

const { hoy, anio } = Astro.props;

const videoUrl =
  "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4";
---

<section id="hero" class="relative isolate flex min-h-[100svh] w-full flex-col overflow-hidden bg-bg">
  <!-- Fondo cinematográfico (decorativo) -->
  <video
    src={videoUrl}
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    aria-hidden="true"
    tabindex="-1"
    class="absolute inset-0 h-full w-full object-cover opacity-30"
    data-hero-video></video>
  <div class="absolute inset-0 bg-gradient-to-b from-bg via-bg/80 to-bg" aria-hidden="true"></div>

  <div class="relative z-10 flex w-full flex-1 items-center px-4 py-28 sm:px-6 lg:px-8 xl:px-12">
    <div class="grid w-full grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Columna ejecutiva + técnica (7/12) -->
      <div class="lg:col-span-7" data-hero-content>
        <StatusLed label="ALL SYSTEMS OPERATIONAL" status="ok" />

        <p class="mt-4 font-mono text-xs uppercase tracking-wider text-text-tertiary">
          // mtsprz · estudio de software · puerto varas, chile
        </p>

        <h1
          class="mt-5 font-heading font-bold leading-[1.05] tracking-[-0.02em] text-text-primary text-[clamp(2rem,4.6vw,4.4rem)]"
        >
          <StaggerText text="Soluciones digitales" as="span" className="block" staggerMs={0.03} />
          <span class="mt-1 block text-accent">que no se caen.</span>
        </h1>

        <p class="mt-5 max-w-xl font-body text-base leading-relaxed text-text-secondary sm:text-lg">
          Sitios web, SEO local y automatizaciones para pymes del sur de Chile.
          <span class="mt-2 block text-sm text-text-tertiary">
            Resultados medibles para tu negocio y sistemas que aguantan en producción.
          </span>
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <button
            type="button"
            onclick="window.openCotizarModal && window.openCotizarModal()"
            class="inline-flex items-center rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover sm:text-sm"
            >[ Cotizar Proyecto ]</button
          >
          <a
            href="/casos"
            class="inline-flex items-center rounded-[6px] border border-frame px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-wider text-text-primary transition-colors hover:border-accent hover:text-accent sm:text-sm"
            >[ Ver Casos ]</a
          >
        </div>
      </div>

      <!-- Terminal dual (5/12) -->
      <div class="lg:col-span-5" data-hero-terminal>
        <TerminalWindow />
      </div>
    </div>
  </div>

  <!-- Trust strip -->
  <div class="relative z-10 border-t border-frame bg-bg/60 backdrop-blur-sm">
    <div
      class="flex w-full flex-wrap items-center justify-center gap-x-8 gap-y-2 px-4 py-4 font-mono text-[11px] uppercase tracking-wider text-text-tertiary sm:justify-between sm:px-6 lg:px-8 xl:px-12"
    >
      <span>3+ empresas del sur</span>
      <span>Atención personalizada</span>
      <span>Puerto Varas · Los Lagos</span>
      <span>&copy; {anio} mtsprz · {hoy}</span>
    </div>
  </div>
</section>

<!-- Movimiento del hero (3ª capa, opcional): parallax suave del video al hacer scroll. -->
<script is:inline>
  (function () {
    function inject(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement("script");
        s.src = src;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    function init() {
      if (typeof window.gsap === "undefined" || typeof window.ScrollTrigger === "undefined") return;
      gsap.registerPlugin(ScrollTrigger);

      var hero = document.getElementById("hero");
      if (!hero) return;
      var video = hero.querySelector("[data-hero-video]");
      var content = hero.querySelector("[data-hero-content]");
      var terminal = hero.querySelector("[data-hero-terminal]");

      gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", function () {
        var tl = gsap.timeline();
        if (video) tl.to(video, { scale: 1.12, ease: "none" }, 0);
        if (content) tl.to(content, { yPercent: -8, opacity: 0.35, ease: "none" }, 0);
        if (terminal) tl.to(terminal, { yPercent: -12, opacity: 0.35, ease: "none" }, 0.05);

        ScrollTrigger.create({
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true,
          animation: tl,
        });
      });
    }
    if (typeof window.gsap === "undefined") {
      Promise.all([
        inject("https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"),
        inject("https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"),
      ])
        .then(init)
        .catch(function () {});
    } else {
      init();
    }
  })();
</script>
