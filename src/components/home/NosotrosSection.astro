---
/**
 * Sobre Nosotros · v2 "Technopunk Enterprise" (DESIGN §13 [6. EQUIPO])
 * - Manifiesto de marca en ventana `cat mision.md` + cobertura regional como
 *   listado `ls /regiones/` (5 rutas SEO-local con aria-label).
 * - Layout 100% width en desktop (directriz del usuario) · responsive 1 col → 12 col.
 * Sin font-hand, sin stickers, sin garabatos (§0.7, §15); GSAP retirado → reveal CSS puro.
 * Copy SEO y enlaces intactos: /regiones/{slug}, "Puerto Varas", "Región de Los Lagos".
 */
const regions = [
  { name: "Puerto Varas", slug: "puerto-varas" },
  { name: "Osorno", slug: "osorno" },
  { name: "Valdivia", slug: "valdivia" },
  { name: "Ancud", slug: "ancud" },
  { name: "Castro", slug: "castro" },
];
---

<section id="nosotros" class="relative w-full scroll-mt-20 bg-bg">
  <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
    <!-- Header -->
    <div class="reveal-group mb-12 md:mb-16">
      <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
        // sobre nosotros
      </p>
      <h2
        class="reveal-item mt-4 font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl"
      >
        Agencia Digital<span class="block text-accent">Región de Los Lagos</span>
      </h2>
    </div>

    <!-- Manifiesto + cobertura · grid 12 col -->
    <div class="reveal-group grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8">
      <!-- Manifiesto -->
      <div class="reveal-item webcore-window flex flex-col lg:col-span-7">
        <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
          <span
            class="h-2 w-2 shrink-0 rounded-full bg-accent"
            style="box-shadow:0 0 8px var(--color-accent);"
            aria-hidden="true"></span>
          <span class="truncate font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary">
            cat mision.md
          </span>
          <span class="ml-auto hidden shrink-0 font-mono text-[11px] text-text-tertiary sm:block">
            ~/mtsprz
          </span>
        </div>
        <div class="flex flex-1 flex-col bg-surface-sunken p-6 md:p-8">
          <p
            class="font-body text-sm font-light leading-[1.85] text-text-secondary md:text-base xl:columns-2 xl:gap-10"
          >
            Mtsprz nació en <span class="text-text-primary">Puerto Varas</span> con la misión de
            llevar soluciones digitales profesionales a las pymes del sur de Chile. Sabemos que
            las empresas de la Región de Los Lagos necesitan presencia digital de calidad
            <span class="text-text-primary">sin pagar precios de Santiago</span>. Por eso creamos
            sitios web ultrarrápidos con Astro, estrategias SEO locales que realmente posicionan
            en Google, automatizaciones que ahorran horas de trabajo y diseño gráfico que
            construye marcas memorables.
          </p>
        </div>
      </div>

      <!-- Cobertura regional -->
      <div class="reveal-item webcore-window flex flex-col lg:col-span-5">
        <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
          <span
            class="h-2 w-2 shrink-0 rounded-full bg-accent"
            style="box-shadow:0 0 8px var(--color-accent);"
            aria-hidden="true"></span>
          <span class="truncate font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary">
            ls /regiones/
          </span>
          <span class="ml-auto hidden shrink-0 font-mono text-[11px] text-text-tertiary sm:block">
            cobertura regional
          </span>
        </div>
        <div class="flex flex-1 flex-col bg-surface-sunken">
          {
            regions.map((r) => (
              <a
                href={`/regiones/${r.slug}`}
                class="group flex flex-1 items-center gap-3 border-b border-frame/60 px-4 py-3 transition-colors last:border-b-0 hover:bg-surface sm:px-5"
                aria-label={`Agencia digital en ${r.name}`}
              >
                <svg
                  class="h-3.5 w-3.5 shrink-0 text-accent"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
                <span class="font-mono text-sm font-medium tracking-[0.02em] text-text-secondary transition-colors group-hover:text-text-primary">
                  {r.name}
                </span>
                <span class="ml-auto hidden font-mono text-[11px] text-text-tertiary md:block">
                  /regiones/{r.slug}
                </span>
                <svg
                  class="h-3 w-3 shrink-0 text-text-tertiary transition-all duration-300 group-hover:translate-x-0.5 group-hover:text-accent"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="M12 5l7 7-7 7" />
                </svg>
              </a>
            ))
          }
        </div>
        <p class="border-t border-frame bg-surface px-4 py-3 font-mono text-[11px] tracking-[0.08em] text-text-secondary sm:px-5">
          <span class="text-accent">→</span>
          trabajamos con negocios de toda la región
        </p>
      </div>
    </div>
  </div>
</section>
