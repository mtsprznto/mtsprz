---
// Nosotros · editorial brand spread
// Props: none (static content + region stickers)
---

<!-- Nosotros · editorial brand spread -->
<section class="relative bg-[#0A0A0A] w-full overflow-hidden">
  <!-- Background cinematográfico · iluminación de estudio dramática -->
  <div class="absolute inset-0" style="background: #0A0A0A;" />
  <div class="absolute inset-0 opacity-60" style="background: radial-gradient(ellipse at 30% 20%, #6366f122 0%, transparent 50%), radial-gradient(ellipse at 70% 80%, #8b5cf615 0%, transparent 50%), radial-gradient(ellipse at 50% 50%, #0A0A0A 0%, transparent 70%);" />
  <div class="absolute inset-0 opacity-[0.012] mix-blend-overlay pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 256 256\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noise)\' opacity=\'1\'/%3E%3C/svg%3E'); background-repeat: repeat; background-size: 256px 256px;" />
  <!-- Línea decorativa superior -->
  <div class="absolute top-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f144, transparent);" />

  <div class="relative mx-auto max-w-6xl px-6 py-28 md:py-36 lg:py-44" data-gsap-about="section">
    <div class="text-center">
      <!-- Anotación manuscrita · sobre nosotros -->
      <div class="flex items-center justify-center gap-2.5 -rotate-1 w-fit mx-auto font-hand text-lg md:text-xl mb-6 md:mb-8" style="color: #fde68a;" data-gsap-about="eyebrow">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        Sobre nosotros
      </div>

      <!-- Título principal · full-width en desktop + subrayado a mano -->
      <h2 class="font-heading font-bold text-white leading-[0.92] tracking-[-2px] md:tracking-[-3px] lg:tracking-[-4px] uppercase"
          style="font-size: clamp(2.25rem, 7vw, 5.25rem);" data-gsap-about="title">
        <span class="block" data-gsap-about="title-line-1">Agencia Digital</span>
        <span class="block mt-1 md:mt-0 text-transparent bg-clip-text" style="background-image: linear-gradient(135deg, #6366f1, #a5b4fc);" data-gsap-about="title-line-2">Región de Los Lagos</span>
        <svg class="block w-[56%] mx-auto h-3 mt-2" viewBox="0 0 300 10" preserveAspectRatio="none" fill="none" stroke="#6ee7b7" stroke-width="3" stroke-linecap="round" data-gsap-about="title-underline"><path d="M3 7c50-5 100 5 150 0s100-5 144-1" pathLength="1" /></svg>
      </h2>
    </div>

    <div class="text-center max-w-4xl mx-auto" data-gsap-about="block">
      <!-- Garabato separador -->
      <svg class="mx-auto my-8 md:my-10 block w-24 h-2.5" viewBox="0 0 300 10" preserveAspectRatio="none" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" data-gsap-about="squiggle"><path d="M3 7c50-5 100 5 150 0s100-5 144-1" pathLength="1" /></svg>

      <!-- Cuerpo · texto editorial con acentos manuscritos -->
      <div class="max-w-3xl mx-auto">
        <p class="text-sm md:text-base lg:text-lg text-white/55 font-body font-light leading-[1.8] md:leading-[1.9] tracking-[0.01em]" data-gsap-about="body-copy">
          Mtsprz nació en <span class="text-white/80">Puerto Varas</span> con la misión de llevar <span class="relative whitespace-nowrap text-white/75">soluciones digitales<svg class="absolute -inset-x-1 -bottom-0.5 w-[calc(100%+0.5rem)] h-2 -rotate-1" viewBox="0 0 300 6" preserveAspectRatio="none" fill="none" stroke="#6ee7b7" stroke-width="2" stroke-linecap="round"><path d="M2 4c40-4 80 4 120 0s80-4 120 0" pathLength="1" data-gsap-about="body-accent-1" /></svg></span> profesionales a las pymes del sur de Chile. Sabemos que las empresas de la Región de Los Lagos necesitan presencia digital de calidad <span class="relative whitespace-nowrap text-white/75">sin pagar precios de Santiago<svg class="absolute -inset-x-1 -inset-y-1 w-[calc(100%+0.5rem)] h-[calc(100%+0.5rem)] rotate-1" viewBox="0 0 200 24" preserveAspectRatio="none" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 5"><ellipse cx="100" cy="12" rx="99" ry="11" data-gsap-about="body-accent-2" /></svg></span>. Por eso creamos sitios web ultrarrápidos con Astro, estrategias SEO locales que realmente posicionan en Google, automatizaciones que ahorran horas de trabajo y diseño gráfico que construye marcas memorables.
        </p>
        <p class="mt-7 md:mt-9 flex items-center justify-center gap-2.5 rotate-1 font-hand text-lg md:text-xl" style="color: #a5b4fc;" data-gsap-about="hand-line">
          trabajamos con negocios de toda la región
          <svg class="w-4 h-4 -rotate-6" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M19 12l-7 7-7-7"/></svg>
        </p>
      </div>

      <!-- Regiones · stickers artesanales -->
      <div class="mt-8 md:mt-10 flex flex-wrap justify-center gap-4" data-gsap-about="stickers">
        {[
          { name: "Puerto Varas", slug: "puerto-varas", color: "#6ee7b7", rot: "-rotate-2", rotVal: -2, br: "4px 14px 4px 12px / 12px 4px 14px 4px" },
          { name: "Osorno", slug: "osorno", color: "#f59e0b", rot: "rotate-1", rotVal: 1, br: "4px 12px 4px 14px / 14px 4px 12px 4px" },
          { name: "Valdivia", slug: "valdivia", color: "#a5b4fc", rot: "-rotate-1", rotVal: -1, br: "4px 14px 4px 12px / 12px 4px 14px 4px" },
          { name: "Ancud", slug: "ancud", color: "#fde68a", rot: "rotate-2", rotVal: 2, br: "4px 12px 4px 14px / 14px 4px 12px 4px" },
          { name: "Castro", slug: "castro", color: "#10b981", rot: "-rotate-2", rotVal: -2, br: "4px 14px 4px 12px / 12px 4px 14px 4px" },
        ].map((r) => (
          <a
            href={`/regiones/${r.slug}`}
            class={`group inline-flex items-center gap-2 ${r.rot} px-4 md:px-5 py-2 md:py-2.5 font-hand text-base md:text-lg border-2 border-dashed transition-transform duration-300 hover:rotate-0`}
            style={`color: ${r.color}; border-color: ${r.color}55; background: ${r.color}14; border-radius: ${r.br};`}
            aria-label={`Agencia digital en ${r.name}`}
            data-gsap-about="sticker"
            data-rot={r.rotVal}
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke={r.color} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            {r.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Línea decorativa inferior -->
  <div class="absolute bottom-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f122, transparent);" />
</section>

<!-- GSAP · entrance editorial -->
<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    if (typeof window.gsap === "undefined" || typeof window.ScrollTrigger === "undefined") {
      console.warn("[mtsprz] GSAP no cargó (CDN) — sobre nosotros estático");
      return;
    }

    const section = document.querySelector('[data-gsap-about="section"]');
    if (!section) return;

    gsap.registerPlugin(ScrollTrigger);

    const q = gsap.utils.selector(section);
    const eyebrow = q('[data-gsap-about="eyebrow"]')[0];
    const titleLine1 = q('[data-gsap-about="title-line-1"]')[0];
    const titleLine2 = q('[data-gsap-about="title-line-2"]')[0];
    const titleUnderline = q('[data-gsap-about="title-underline"] path')[0];
    const squiggle = q('[data-gsap-about="squiggle"] path')[0];
    const bodyCopy = q('[data-gsap-about="body-copy"]')[0];
    const accent1 = q('[data-gsap-about="body-accent-1"]')[0];
    const accent2 = q('[data-gsap-about="body-accent-2"]')[0];
    const handLine = q('[data-gsap-about="hand-line"]')[0];
    const stickers = q('[data-gsap-about="sticker"]');
    if (!eyebrow || !titleLine1 || !titleLine2 || !bodyCopy || !stickers.length) return;

    console.log("[mtsprz] sobre nosotros GSAP activo —", 1 + stickers.length, "elementos");

    gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
      gsap.set(stickers, { transition: "none" });

      const tl = gsap.timeline({
        defaults: { ease: "power3.out" },
        scrollTrigger: {
          trigger: section,
          start: "top bottom",
          toggleActions: "play none none none",
          refreshPriority: 1,
        },
      });

      tl.fromTo(eyebrow, { autoAlpha: 0, y: -10, rotation: -5 }, { autoAlpha: 1, y: 0, rotation: -1, duration: 0.5 }, 0)
        .fromTo(titleLine1, { autoAlpha: 0, y: 44, filter: "blur(6px)" }, { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.7 }, "-=0.25")
        .fromTo(titleLine2, { autoAlpha: 0, y: 44, filter: "blur(6px)" }, { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 0.7 }, "-=0.45")
        .fromTo(titleUnderline, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.7, ease: "power2.inOut" }, "-=0.35")
        .fromTo(squiggle, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.6, ease: "power2.inOut" }, "-=0.2")
        .fromTo(bodyCopy, { autoAlpha: 0, y: 22 }, { autoAlpha: 1, y: 0, duration: 0.7 }, "-=0.35")
        .fromTo(accent1, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.5, ease: "power2.inOut" }, "-=0.3")
        .fromTo(accent2, { autoAlpha: 0, scale: 0.8 }, { autoAlpha: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }, "-=0.35")
        .fromTo(handLine, { autoAlpha: 0, y: 12, rotation: -4 }, { autoAlpha: 1, y: 0, rotation: 1, duration: 0.5 }, "-=0.2")
        .fromTo(stickers,
          { autoAlpha: 0, scale: 0.6, rotation: (i, el) => (parseFloat(el.dataset.rot) || 0) - 12 },
          { autoAlpha: 1, scale: 1, rotation: (i, el) => parseFloat(el.dataset.rot) || 0, duration: 0.55, ease: "back.out(1.8)", stagger: 0.07 },
          "-=0.25"
        )
        .add(() => gsap.set(stickers, { clearProps: "transform,opacity,visibility,transition" }), "+=0.15");

      window.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
    });

    const refresh = () => ScrollTrigger.refresh();
    window.addEventListener("load", refresh, { once: true });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(refresh);
    setTimeout(refresh, 800);
  });
</script>
