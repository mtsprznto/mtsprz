---
/**
 * Recursos · v2 "Technopunk Enterprise" (J4 · biblioteca de lead magnets)
 * - Ventana `biblioteca --gratis`: índice de guías en formato log
 *   ([01] · LED acceso libre · slug real · icono · promesa · audiencia).
 * - Layout 100% width en desktop (directriz usuario) · 1 col móvil.
 * - Sin font-hand ni hex v1 (amber/indigo): solo tokens v2 + acento §2.3.
 * GSAP-free → reveal CSS puro. Slugs y copy intactos (SEO/GEO).
 */
import { ListChecks, Bot, MapPin } from "@lucide/astro";
import { LEAD_MAGNETS } from "../../lib/marketing/lead-magnets";

const magnets = [...LEAD_MAGNETS].sort((a, b) => a.order - b.order);
const iconMap = { "list-checks": ListChecks, bot: Bot, "map-pin": MapPin };
---

<!-- Recursos · biblioteca gratuita (puente a /recursos) -->
<section id="recursos" class="relative w-full scroll-mt-20 bg-bg">
  <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
    <!-- Header -->
    <div class="reveal-group mb-12 md:mb-16">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
            // recursos
          </p>
          <h2
            class="reveal-item mt-4 font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl"
          >
            Aprende gratis.<br /><span class="text-accent">Ponlo en práctica hoy.</span>
          </h2>
        </div>
        <a
          href="/recursos"
          class="reveal-item group inline-flex shrink-0 items-center gap-2 self-start border border-frame px-4 py-2 font-mono text-xs uppercase tracking-[0.12em] text-text-primary transition-colors hover:border-frame-hover hover:text-accent md:self-auto"
        >
          [ Biblioteca completa ]
          <svg
            class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Biblioteca · índice de guías en formato log -->
    <div class="reveal-group">
      <div class="reveal-item webcore-window">
        <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
          <span
            class="h-2 w-2 shrink-0 rounded-full bg-accent"
            style="box-shadow:0 0 8px var(--color-accent);"
            aria-hidden="true"></span>
          <span class="truncate font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary">
            biblioteca --gratis
          </span>
          <span class="ml-auto hidden shrink-0 font-mono text-[11px] text-text-tertiary sm:block">
            {String(magnets.length).padStart(2, "0")} assets
          </span>
        </div>

        <div class="bg-surface-sunken">
          {
            magnets.map((m) => {
              const Icon = iconMap[m.icon] || ListChecks;
              return (
                <a
                  href={`/recursos/${m.slug}`}
                  class="group flex gap-4 border-b border-frame/60 p-4 transition-colors last:border-b-0 hover:bg-surface md:gap-6 md:p-5"
                >
                  <!-- Icono · caja frame -->
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[4px] border border-frame bg-surface text-text-secondary transition-colors duration-300 group-hover:border-accent group-hover:text-accent md:h-11 md:w-11">
                    <Icon size={18} stroke-width="1.5" />
                  </span>

                  <!-- Entrada log -->
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px]">
                      <span class="text-text-tertiary">[{String(m.order).padStart(2, "0")}]</span>
                      <span class="inline-flex items-center gap-1.5 uppercase tracking-[0.12em] text-accent">
                        <span class="led-pulse h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
                        acceso libre
                      </span>
                      <span class="ml-auto hidden text-text-tertiary lg:block">/recursos/{m.slug}</span>
                    </div>
                    <h3 class="mt-2 font-heading text-lg font-bold tracking-[-0.01em] text-text-primary transition-colors group-hover:text-accent md:text-xl">
                      {m.title}
                    </h3>
                    <p class="mt-2 max-w-2xl font-body text-sm font-light leading-[1.75] text-text-secondary">
                      {m.promise}
                    </p>
                    <div class="mt-4 flex flex-wrap items-center gap-2">
                      <span class="rounded-[4px] border border-frame bg-surface px-2 py-1 font-mono text-[11px] text-text-secondary">
                        {m.audience}
                      </span>
                      <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.08em] text-text-primary transition-colors group-hover:text-accent">
                        [ Leer guía ]
                        <svg
                          class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M5 12h14" />
                          <path d="M12 5l7 7-7 7" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              );
            })
          }
        </div>

        <p class="border-t border-frame bg-surface px-4 py-3 font-mono text-[11px] tracking-[0.08em] text-text-secondary sm:px-5">
          <span class="text-accent">→</span>
          {String(magnets.length).padStart(2, "0")} recursos gratuitos · sin registro · para pymes del sur de Chile
        </p>
      </div>
    </div>
  </div>
</section>
