---
import { ListChecks, Bot, MapPin } from "@lucide/astro";
import { LEAD_MAGNETS } from "../../lib/marketing/lead-magnets";

const magnets = [...LEAD_MAGNETS].sort((a, b) => a.order - b.order);
const iconMap = { "list-checks": ListChecks, bot: Bot, "map-pin": MapPin };
---

<!-- Recursos · biblioteca gratuita (puente a /recursos) -->
<section class="relative bg-[#010101] w-full overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f144, transparent);" />

  <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="reveal-group">
      <div class="reveal-item flex items-center gap-2.5 -rotate-1 w-fit font-hand text-lg md:text-xl mb-6 md:mb-8" style="color: #fde68a;">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="#6ee7b7" stroke="none"><path d="M12 0c.9 6.6 4.8 10.5 12 12-7.2 1.5-11.1 5.4-12 12-.9-6.6-4.8-10.5-12-12 7.2-1.5 11.1-5.4 12-12z"/></svg>
        Recursos gratuitos
      </div>
      <div class="reveal-item flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white leading-[1.05] tracking-[-1px] max-w-2xl">
          Aprende gratis.<br /><span class="block text-transparent bg-clip-text" style="background-image: linear-gradient(135deg, #6366f1, #a5b4fc);">Ponlo en práctica hoy.</span>
          <svg class="block w-[48%] -ml-1 h-2.5 mt-1.5" viewBox="0 0 300 10" preserveAspectRatio="none" fill="none" stroke="#6ee7b7" stroke-width="3" stroke-linecap="round"><path d="M3 7c50-5 100 5 150 0s100-5 144-1" /></svg>
        </h2>
        <a href="/recursos" class="group inline-flex items-center gap-2 -rotate-1 shrink-0 font-hand text-base md:text-xl transition-transform duration-300 hover:rotate-1" style="color: #fde68a;">
          Biblioteca completa
          <svg class="w-4 h-4 -rotate-6 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Índice editorial de guías · filas horizontales -->
    <div class="reveal-group border-t-2 border-dashed divide-y-2 divide-dashed" style="border-color: rgba(255,255,255,0.12);">
      {magnets.map((m) => {
        const Icon = iconMap[m.icon] || ListChecks;
        return (
          <a
            href={`/recursos/${m.slug}`}
            class="reveal-item group flex items-center gap-5 md:gap-10 py-6 md:py-7 transition-colors duration-300"
          >
            <span class="w-10 md:w-20 shrink-0 font-hand text-3xl md:text-4xl leading-none -rotate-3 transition-transform duration-300 group-hover:rotate-0" style={{ color: ["#f59e0b", "#10b981", "#a5b4fc"][Number(m.order) % 3] }}>
              {String(m.order).padStart(2, "0")}
            </span>
            <span class="hidden md:flex h-12 w-12 shrink-0 items-center justify-center border-2 border-dashed transition-all duration-300 group-hover:border-[#6366f1]/50 group-hover:text-[#a5b4fc]" style="border-radius: 6px 14px 6px 12px / 12px 6px 14px 6px; color: rgba(255,255,255,0.7); border-color: rgba(255,255,255,0.15);">
              <Icon size={20} stroke-width="1.5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="relative inline-block font-heading text-lg md:text-2xl font-bold tracking-[-0.01em] text-white transition-colors duration-300 group-hover:text-white/90">
                {m.title}
                <svg class="absolute -bottom-1.5 left-0 w-full h-1.5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" viewBox="0 0 300 6" preserveAspectRatio="none" fill="none" stroke="#6ee7b7" stroke-width="2" stroke-linecap="round"><path d="M2 4c40-4 80 4 120 0s80-4 120 0" /></svg>
              </span>
              <span class="mt-1 block font-body text-xs md:text-sm leading-[1.6] text-white/45 line-clamp-1">
                {m.promise}
              </span>
            </span>
            <span class="hidden lg:inline shrink-0 font-hand text-base md:text-lg rotate-1 transition-transform duration-300 group-hover:rotate-0" style="color: #a5b4fc;">
              {m.audience}
            </span>
            <svg class="w-4 h-4 shrink-0 -rotate-6 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        );
      })}
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-[1px]" style="background: linear-gradient(90deg, transparent, #6366f122, transparent);" />
</section>
