---
/**
 * TerminalWindow — componente central del Hero (DESIGN §6.2)
 * Doble comportamiento:
 *  - NO técnico: intro + botones rápidos (siempre visibles, sin JS).
 *  - Técnico: input real con comandos help/stack/services/contact/clear.
 * El contenido es visible SIN JS (transcript estático + botones).
 * El auto-type se desactiva con prefers-reduced-motion.
 */
interface Props {
  title?: string;
  class?: string;
}
const { title = "bash — visitante@mtsprz", class: className = "" } = Astro.props;

const transcript = [
  "$ whoami",
  "estudio de software · puerto varas, chile",
  "$ cat stack.json",
  "{",
  '  "frontend": ["astro", "typescript", "tailwind"],',
  '  "backend":  ["node", "postgres", "docker"],',
  '  "focus":    "sistemas que no se caen"',
  "}",
  "$ stack --short",
  "astro · typescript · node · postgres · docker",
  "$ _",
].join("\n");
---

<section class={`webcore-window ${className}`} data-window>
  <header class="flex h-9 items-center gap-3 border-b border-frame bg-surface px-3">
    <span class="flex items-center gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
      <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
      <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
    </span>
    <span class="truncate font-mono text-[11px] font-medium uppercase tracking-wider text-text-secondary">{title}</span>
  </header>

  <div class="win-body bg-surface-sunken p-4" data-win-body>
    <p data-term-boot class="mb-3 min-h-[1.25rem] font-mono text-sm text-accent"></p>

    <pre
      data-term-out
      aria-label="Salida de la terminal"
      class="max-h-64 overflow-auto whitespace-pre-wrap break-words font-mono text-[13px] leading-relaxed text-text-secondary"
    >{transcript}</pre>

    <form data-term-form class="mt-3 flex items-center gap-2 border-t border-frame pt-3">
      <label for="terminal-input" class="sr-only">Escribe un comando de terminal</label>
      <span aria-hidden="true" class="font-mono text-sm text-accent">$</span>
      <input
        id="terminal-input"
        data-term-input
        name="command"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="help"
        class="w-full bg-transparent font-mono text-sm text-text-primary placeholder:text-text-tertiary focus:outline-none"
      />
    </form>

    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href="#servicios"
        class="rounded-md border border-frame px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-text-primary transition-colors hover:border-accent"
        >[ Ver Servicios ]</a
      >
      <a
        href="#contacto"
        class="rounded-md bg-accent px-4 py-2 font-mono text-[11px] font-medium uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover"
        >[ Agendar Llamada ]</a
      >
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var root = document.currentScript.previousElementSibling;
  if (!root) return;

  var form = root.querySelector("[data-term-form]");
  var input = root.querySelector("[data-term-input]");
  var out = root.querySelector("[data-term-out]");
  var boot = root.querySelector("[data-term-boot]");
  var reduce =
    window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  var RESPONSES = {
    help: "comandos disponibles: help · stack · services · contact · clear",
    stack:
      '{\n  "frontend": ["astro", "typescript", "tailwind"],\n  "backend":  ["node", "postgres", "docker"]\n}',
    services: "diseño · desarrollo web · automatización · seo\n→ /#servicios",
    contact: "contacto@mtsprz.org\n→ /#contacto",
    clear: "",
  };

  function print(line) {
    if (!out) return;
    out.textContent += "\n" + line;
    out.scrollTop = out.scrollHeight;
  }

  if (form && input && out) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var raw = input.value.trim();
      if (!raw) return;
      print("$ " + raw);
      var cmd = raw.split(/\s+/)[0].toLowerCase();
      if (cmd === "clear") {
        out.textContent = "$ type 'help' to list commands";
      } else if (Object.prototype.hasOwnProperty.call(RESPONSES, cmd)) {
        if (RESPONSES[cmd]) print(RESPONSES[cmd]);
      } else {
        print("command not found: " + cmd + " — try 'help'");
      }
      input.value = "";
    });
  }

  // Auto-type de la intro (cancelable; off con reduced-motion)
  if (boot) {
    var text = "hola, somos un estudio de software. escribimos sistemas que no se caen.";
    var stopped = false;
    if (input) input.addEventListener("focus", function () { stopped = true; });
    if (reduce) {
      boot.textContent = text;
    } else {
      var i = 0;
      (function tick() {
        if (stopped) { boot.textContent = text; return; }
        if (i <= text.length) {
          boot.textContent = text.slice(0, i);
          i++;
          setTimeout(tick, 32);
        }
      })();
    }
  }
})();
</script>
