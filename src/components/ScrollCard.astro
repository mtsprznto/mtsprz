---
/**
 * ScrollCard · card editorial para el carousel horizontal de servicios.
 *
 * Replica la estética cinematográfica de CinematicColumn (gradiente único
 * por accent, número editorial manuscrito, H3 enorme uppercase, CTA
 * carbono) pero diseñada para VIAJAR dentro del track con transform
 * (pin + ScrollTrigger).
 *
 * NO lleva reveal-item/reveal-group a propósito: el IntersectionObserver
 * global pelearía con las transformaciones de GSAP y el pin. La entrada
 * es el propio movimiento horizontal del carousel.
 */

export interface Props {
  title: string;
  description: string;
  accent: string;
  index: number;
  href: string;
  ctaText?: string;
}

const { title, description, accent, index, href, ctaText = "Explorar" } = Astro.props;

// Luz lateral alternante por índice (misma técnica que CinematicColumn)
const lightSide = index % 2 === 0 ? "70% 30%" : "30% 70%";

// Fondo 100% OPACO (nada de glass): la card tapa por completo lo que hay
// detrás → al scrollear (cascada GSAP o sticky deck) el texto de la card
// anterior NO se mezcla con la que llega. El accent queda como tint cálido
// dentro del gradiente, nunca como translucidez.
const bgBase = `
  radial-gradient(ellipse at ${lightSide}, ${accent}30 0%, transparent 55%),
  linear-gradient(160deg, #1A1A1A 0%, #121212 45%, #0C0C0C 100%)
`;
---

<a
  href={href}
  class="svc-card group relative block h-full overflow-hidden rounded-3xl border border-white/[0.1] no-underline transition-colors duration-300 hover:border-white/[0.18] focus-visible:ring-2 focus-visible:ring-indigo-400/60 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0A0A0A]"
  style={`--i: ${index}; background: ${bgBase}; box-shadow: 0 24px 60px rgba(0,0,0,0.4);`}
>
  <!-- Lienzo fotográfico editorial · luz lateral según índice -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.12] mix-blend-screen transition-opacity duration-700 group-hover:opacity-40"
    style={`background: radial-gradient(ellipse at ${lightSide}, ${accent}33 0%, transparent 60%);`}
  />

  <!-- Grano fotográfico sutil (.grain en global.css) -->
  <div class="grain pointer-events-none absolute inset-0 opacity-[0.03] mix-blend-overlay" />

  <!-- Contenido · número y título arriba; descripción + CTA al fondo.
       (en cascada GSAP el borde superior de cada carta queda visible) -->
  <div class="relative flex h-full flex-col p-7 md:p-10">
    <!-- Número manuscrito (font-hand), como anotación de cuaderno -->
    <span class="font-hand text-5xl leading-none md:text-6xl" style={`color: ${accent}dd;`}>
      {String(index + 1).padStart(2, "0")}
    </span>

    <h3 class="mt-3 font-heading text-3xl font-bold uppercase leading-[0.95] tracking-[-1.5px] text-white sm:text-4xl md:text-5xl md:tracking-[-2px]">
      {title}
    </h3>

    <div class="mt-auto">
      <p class="max-w-md font-body text-xs font-light leading-relaxed text-white/60 md:text-sm">
        {description}
      </p>
      <span
        class="mt-7 inline-flex items-center gap-2.5 border border-white/[0.06] bg-white/[0.04] px-5 py-2.5 text-[10px] font-medium uppercase tracking-[0.15em] transition-all duration-300 group-hover:gap-4"
        style={`color: ${accent}cc;`}
      >
        {ctaText}
        <svg class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" /><path d="M12 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </div>
</a>
