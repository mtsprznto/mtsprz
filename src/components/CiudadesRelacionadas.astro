---
// Cross-linking regional: muestra ciudades cercanas según la actual
// Cada página regional incluye esto para crear malla de internal links
// v2: tokens Technopunk (surface/frame/mono), sin indigo ni white/opacity
export interface Props {
  current: string;
}

const { current } = Astro.props;

const ciudades: Record<string, { name: string; slug: string }[]> = {
  "puerto-varas": [
    { name: "Puerto Montt", slug: "puerto-montt" },
    { name: "Osorno", slug: "osorno" },
    { name: "Frutillar", slug: "frutillar" },
    { name: "Llanquihue", slug: "llanquihue" },
  ],
  osorno: [
    { name: "Puerto Varas", slug: "puerto-varas" },
    { name: "Valdivia", slug: "valdivia" },
    { name: "Purranque", slug: "purranque" },
  ],
  valdivia: [
    { name: "Osorno", slug: "osorno" },
    { name: "Puerto Varas", slug: "puerto-varas" },
    { name: "La Unión", slug: "" }, // placeholder, no tenemos página aún
  ],
  "puerto-montt": [
    { name: "Puerto Varas", slug: "puerto-varas" },
    { name: "Calbuco", slug: "calbuco" },
    { name: "Ancud", slug: "ancud" },
  ],
  ancud: [
    { name: "Castro", slug: "castro" },
    { name: "Puerto Montt", slug: "puerto-montt" },
    { name: "Chonchi", slug: "chonchi" },
  ],
  castro: [
    { name: "Ancud", slug: "ancud" },
    { name: "Queilén", slug: "queilen" },
    { name: "Chonchi", slug: "chonchi" },
  ],
  chiloe: [
    { name: "Castro", slug: "castro" },
    { name: "Ancud", slug: "ancud" },
    { name: "Chonchi", slug: "chonchi" },
  ],
  frutillar: [
    { name: "Puerto Varas", slug: "puerto-varas" },
    { name: "Llanquihue", slug: "llanquihue" },
    { name: "Puerto Montt", slug: "puerto-montt" },
  ],
  llanquihue: [
    { name: "Puerto Varas", slug: "puerto-varas" },
    { name: "Frutillar", slug: "frutillar" },
    { name: "Puerto Montt", slug: "puerto-montt" },
  ],
  calbuco: [
    { name: "Puerto Montt", slug: "puerto-montt" },
    { name: "Puerto Varas", slug: "puerto-varas" },
    { name: "Ancud", slug: "ancud" },
  ],
  purranque: [
    { name: "Osorno", slug: "osorno" },
    { name: "Puerto Varas", slug: "puerto-varas" },
    { name: "Frutillar", slug: "frutillar" },
  ],
  fresia: [
    { name: "Puerto Varas", slug: "puerto-varas" },
    { name: "Frutillar", slug: "frutillar" },
    { name: "Llanquihue", slug: "llanquihue" },
  ],
  maullin: [
    { name: "Puerto Montt", slug: "puerto-montt" },
    { name: "Calbuco", slug: "calbuco" },
    { name: "Puerto Varas", slug: "puerto-varas" },
  ],
  queilen: [
    { name: "Castro", slug: "castro" },
    { name: "Chonchi", slug: "chonchi" },
    { name: "Ancud", slug: "ancud" },
  ],
  chonchi: [
    { name: "Castro", slug: "castro" },
    { name: "Queilén", slug: "queilen" },
    { name: "Ancud", slug: "ancud" },
  ],
};

const related = ciudades[current] || [];
---

<section class="relative w-full border-t border-frame bg-bg">
  <div class="w-full px-4 py-12 sm:px-6 md:py-16 lg:px-8 xl:px-12">
    <div class="reveal-group">
      <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
        // también trabajamos en
      </p>

      <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
        {related.filter((c) => c.slug).map((ciudad) => (
          <a
            href={`/regiones/${ciudad.slug}`}
            class="reveal-item group rounded-[6px] border border-frame bg-surface p-4 no-underline transition-colors hover:border-frame-hover hover:bg-surface-hover md:p-5"
          >
            <p class="font-heading text-sm font-semibold text-text-primary md:text-base">
              {ciudad.name}
            </p>
            <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.08em] text-text-tertiary transition-colors group-hover:text-text-secondary">
              Servicios digitales →
            </p>
          </a>
        ))}
        {related.filter((c) => !c.slug).map((ciudad) => (
          <div class="reveal-item rounded-[6px] border border-frame/60 bg-surface-sunken p-4 md:p-5">
            <p class="font-heading text-sm font-semibold text-text-tertiary md:text-base">
              {ciudad.name}
            </p>
            <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.08em] text-text-tertiary">
              Próximamente
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
