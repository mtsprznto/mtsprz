---
/**
 * CookieBanner — LGPD/RGPD consent banner
 *
 * Design: liquid-glass, bottom-left corner, dark theme
 * Accessibility: ARIA live region, keyboard navigation, focus trap
 * Pattern: Observer (listens to cookie-consent-change events)
 */
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="dialog"
  aria-label="Politica de cookies"
  aria-describedby="cookie-banner-desc"
  tabindex="-1"
>
  <div class="cookie-banner-inner">
    <!-- Icon -->
    <div class="cookie-banner-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5" />
        <path d="M8.5 8.5v.01" />
        <path d="M16 15.5v.01" />
        <path d="M12 12v.01" />
        <path d="M11 17v.01" />
        <path d="M7 14v.01" />
      </svg>
    </div>

    <!-- Text -->
    <div class="cookie-banner-text">
      <p id="cookie-banner-desc" class="cookie-banner-title">
        Utilizamos cookies para optimizar su experiencia.
      </p>
      <p class="cookie-banner-subtitle">
        Puede aceptar, denegar o configurar sus preferencias.
        <a href="/politica-de-cookies" class="cookie-banner-link">Mas informacion</a>
      </p>
    </div>

    <!-- Actions -->
    <div class="cookie-banner-actions">
      <button
        id="cookie-accept-all"
        type="button"
        class="cookie-btn cookie-btn-primary"
      >
        Aceptar Todas
      </button>
      <button
        id="cookie-reject-all"
        type="button"
        class="cookie-btn cookie-btn-secondary"
      >
        Denegar
      </button>
      <button
        id="cookie-configure"
        type="button"
        class="cookie-btn cookie-btn-ghost"
      >
        Configurar
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  var banner = document.getElementById("cookie-banner");
  if (!banner) return;

  var acceptBtn = document.getElementById("cookie-accept-all");
  var rejectBtn = document.getElementById("cookie-reject-all");
  var configBtn = document.getElementById("cookie-configure");

  function show() {
    banner.classList.add("cookie-banner--visible");
    banner.focus();
  }

  function hide() {
    banner.classList.remove("cookie-banner--visible");
  }

  // Listen for consent manager events
  window.addEventListener("cookie-banner:show", show);
  window.addEventListener("cookie-consent-change", function(e) {
    hide();
  });

  // Button handlers
  acceptBtn.addEventListener("click", function() {
    var mgr = window.__cookieConsent;
    if (mgr) mgr.acceptAll();
  });

  rejectBtn.addEventListener("click", function() {
    var mgr = window.__cookieConsent;
    if (mgr) mgr.rejectAll();
  });

  configBtn.addEventListener("click", function() {
    var mgr = window.__cookieConsent;
    if (mgr) mgr.showPreferences();
    window.dispatchEvent(new CustomEvent("cookie-preferences:show"));
  });

  // Keyboard: Escape closes banner
  banner.addEventListener("keydown", function(e) {
    if (e.key === "Escape") {
      // Escape = reject all (safe default)
      var mgr = window.__cookieConsent;
      if (mgr) mgr.rejectAll();
    }
  });
})();
</script>

<style>
  /* ─── Banner Container ─────────────────────────────────────────────── */
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9998;
    padding: 16px;
    pointer-events: none;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cookie-banner--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ─── Inner Glass Card ─────────────────────────────────────────────── */
  .cookie-banner-inner {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 24px;
    border-radius: 16px;
    background: rgba(10, 10, 11, 0.75);
    background-blend-mode: luminosity;
    backdrop-filter: blur(50px);
    -webkit-backdrop-filter: blur(50px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.5),
      0 2px 8px rgba(0, 0, 0, 0.3),
      inset 0 1px 1px rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.06);
    position: relative;
    overflow: hidden;
  }

  .cookie-banner-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.12) 0%,
      rgba(255, 255, 255, 0.03) 30%,
      rgba(255, 255, 255, 0) 50%,
      rgba(255, 255, 255, 0.03) 70%,
      rgba(255, 255, 255, 0.12) 100%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* ─── Icon ─────────────────────────────────────────────────────────── */
  .cookie-banner-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.15);
    color: #818cf8;
    flex-shrink: 0;
  }

  /* ─── Text ─────────────────────────────────────────────────────────── */
  .cookie-banner-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cookie-banner-title {
    font-family: var(--font-heading, "Poppins", system-ui, sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: rgba(250, 250, 250, 0.92);
    letter-spacing: -0.01em;
    line-height: 1.4;
    margin: 0;
  }

  .cookie-banner-subtitle {
    font-family: var(--font-body, "Inter", system-ui, sans-serif);
    font-size: 12px;
    color: rgba(250, 250, 250, 0.45);
    line-height: 1.5;
    margin: 0;
  }

  .cookie-banner-link {
    color: #818cf8;
    text-decoration: underline;
    text-decoration-color: rgba(129, 140, 248, 0.3);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s ease;
  }

  .cookie-banner-link:hover {
    text-decoration-color: #818cf8;
  }

  /* ─── Actions ──────────────────────────────────────────────────────── */
  .cookie-banner-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cookie-btn {
    font-family: var(--font-body, "Inter", system-ui, sans-serif);
    font-size: 12px;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .cookie-btn:focus-visible {
    outline: 2px solid #6366f1;
    outline-offset: 2px;
  }

  .cookie-btn-primary {
    background: #6366f1;
    color: #fff;
  }

  .cookie-btn-primary:hover {
    background: #818cf8;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }

  .cookie-btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(250, 250, 250, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cookie-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(250, 250, 250, 0.9);
  }

  .cookie-btn-ghost {
    background: transparent;
    color: rgba(250, 250, 250, 0.4);
    padding: 8px 12px;
  }

  .cookie-btn-ghost:hover {
    color: rgba(250, 250, 250, 0.7);
    background: rgba(255, 255, 255, 0.04);
  }

  /* ─── Mobile ───────────────────────────────────────────────────────── */
  @media (max-width: 480px) {
    .cookie-banner {
      padding: 12px;
    }

    .cookie-banner-inner {
      padding: 16px 18px;
      gap: 12px;
    }

    .cookie-banner-actions {
      flex-direction: column;
    }

    .cookie-btn {
      width: 100%;
      text-align: center;
      padding: 10px 16px;
    }
  }

  /* ─── Reduced motion ───────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .cookie-banner {
      transition: opacity 0.1s ease;
      transform: none;
    }

    .cookie-btn:hover {
      transform: none;
    }
  }
</style>
