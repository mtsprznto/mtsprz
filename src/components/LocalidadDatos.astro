---
// Sección de datos locales por comuna · information gain + E-E-A-T (fuente INE Censo 2024).
// Hace cada página región única y citable por LLMs (GEO).
import { getRegion } from "../data/regiones";

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const info = getRegion(slug) ?? {
  slug,
  nombre: "tu ciudad",
  region: "Región de Los Lagos",
  poblacion: 0,
  distanciaKm: 0,
  sectores: ["servicios profesionales", "comercio local"],
  hitos: ["atención remota desde Puerto Varas"],
};

const poblacionFormateada = new Intl.NumberFormat("es-CL").format(info.poblacion);
const distancia = info.distanciaKm === 0
  ? "Base de operaciones"
  : `${info.distanciaKm} km desde Puerto Varas${info.notaDistancia ? ` (${info.notaDistancia})` : ""}`;
---

<section style="width:100vw; background:#0A0A0A; position:relative; overflow:hidden;">
  <div style="position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(255,255,255,0.05),transparent);"></div>
  <div style="max-width:800px; margin:0 auto; padding:5rem 2.5rem;">
    <div class="reveal-group" style="margin-bottom:2.5rem;">
      <p class="reveal-item" style="font-size:0.6rem; letter-spacing:0.25em; text-transform:uppercase; color:rgba(255,255,255,0.2); font-family:var(--font-body); margin-bottom:1.25rem;">Datos locales · Censo 2024</p>
      <h2 class="reveal-item" style="font-size:clamp(2rem,5vw,3.75rem); font-family:var(--font-heading); font-weight:800; color:#fff; letter-spacing:-0.03em; text-transform:uppercase; line-height:0.92; margin:0;">
        {info.nombre}<br /><span style="color:rgba(255,255,255,0.15);">EN CIFRAS</span>
      </h2>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; margin-bottom:2.5rem;">
      <div class="reveal-item" style="padding:1.5rem; border:1px solid rgba(255,255,255,0.06); border-radius:0.75rem; background:rgba(255,255,255,0.015);">
        <p style="font-size:0.55rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.25); font-family:var(--font-body); margin-bottom:0.5rem;">Población</p>
        <p style="font-size:1.75rem; font-family:var(--font-heading); font-weight:800; color:#fff; margin:0;">{poblacionFormateada}</p>
        <p style="font-size:0.65rem; color:rgba(255,255,255,0.3); font-family:var(--font-body); margin:0.4rem 0 0;">habitantes · {info.region}</p>
      </div>
      <div class="reveal-item" style="padding:1.5rem; border:1px solid rgba(255,255,255,0.06); border-radius:0.75rem; background:rgba(255,255,255,0.015);">
        <p style="font-size:0.55rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.25); font-family:var(--font-body); margin-bottom:0.5rem;">Cobertura</p>
        <p style="font-size:1.1rem; font-family:var(--font-heading); font-weight:700; color:#fff; margin:0; line-height:1.3;">{distancia}</p>
        <p style="font-size:0.65rem; color:rgba(255,255,255,0.3); font-family:var(--font-body); margin:0.4rem 0 0;">asistencia presencial y remota</p>
      </div>
    </div>

    <div class="reveal-item" style="margin-bottom:2rem;">
      <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.25); font-family:var(--font-body); margin-bottom:1rem;">Sectores donde trabajamos en {info.nombre}</p>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
        {info.sectores.map(s => (
          <span style="display:inline-block; padding:0.5rem 1rem; border:1px solid rgba(255,255,255,0.08); border-radius:999px; font-size:0.65rem; font-family:var(--font-body); color:rgba(255,255,255,0.55);">
            {s}
          </span>
        ))}
      </div>
    </div>

    <div class="reveal-item">
      <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:rgba(255,255,255,0.25); font-family:var(--font-body); margin-bottom:1rem;">Contexto local</p>
      <ul style="margin:0; padding:0; list-style:none;">
        {info.hitos.map(h => (
          <li style="display:flex; gap:0.75rem; align-items:flex-start; padding:0.75rem 0; border-bottom:1px solid rgba(255,255,255,0.04); font-size:0.78rem; color:rgba(255,255,255,0.45); font-family:var(--font-body); font-weight:300; line-height:1.6;">
            <span style="color:#10b981; flex-shrink:0;">→</span>
            {h}
          </li>
        ))}
      </ul>
      <p style="font-size:0.6rem; color:rgba(255,255,255,0.2); font-family:var(--font-body); margin-top:1.5rem;">
        Fuente: Instituto Nacional de Estadísticas (INE), Censo de Población y Vivienda 2024.
      </p>
    </div>
  </div>
</section>
