---
// Sección de datos locales por comuna · information gain + E-E-A-T (fuente INE Censo 2024).
// Hace cada página región única y citable por LLMs (GEO).
// v2: tokens Technopunk (surface-sunken/frame/mono), full width responsive.
import { getRegion } from "../data/regiones";

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const info = getRegion(slug) ?? {
  slug,
  nombre: "tu ciudad",
  region: "Región de Los Lagos",
  poblacion: 0,
  distanciaKm: 0,
  sectores: ["servicios profesionales", "comercio local"],
  hitos: ["atención remota desde Puerto Varas"],
};

const poblacionFormateada = new Intl.NumberFormat("es-CL").format(info.poblacion);
const distancia = info.distanciaKm === 0
  ? "Base de operaciones"
  : `${info.distanciaKm} km desde Puerto Varas${info.notaDistancia ? ` (${info.notaDistancia})` : ""}`;
---

<section id="datos-locales" class="relative w-full scroll-mt-16 border-t border-frame bg-surface-sunken">
  <div class="w-full px-4 py-20 sm:px-6 md:py-28 lg:px-8 xl:px-12">
    <div class="reveal-group mb-12 md:mb-16">
      <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em] text-accent">
        // datos locales · censo 2024
      </p>
      <h2 class="reveal-item mt-4 font-heading text-3xl font-bold leading-[1.08] tracking-[-0.02em] text-text-primary sm:text-4xl md:text-5xl">
        {info.nombre} en cifras
      </h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="reveal-item rounded-[6px] border border-frame bg-surface p-6 md:p-8">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary">población</p>
        <p class="mt-3 font-heading text-3xl font-bold tracking-[-0.02em] text-text-primary md:text-4xl">
          {poblacionFormateada}
        </p>
        <p class="mt-2 font-body text-xs font-light text-text-secondary md:text-sm">
          habitantes · {info.region}
        </p>
      </div>
      <div class="reveal-item rounded-[6px] border border-frame bg-surface p-6 md:p-8">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary">cobertura</p>
        <p class="mt-3 font-heading text-lg font-bold leading-snug tracking-[-0.01em] text-text-primary md:text-xl">
          {distancia}
        </p>
        <p class="mt-2 font-body text-xs font-light text-text-secondary md:text-sm">
          asistencia presencial y remota
        </p>
      </div>
    </div>

    <div class="reveal-item mt-10">
      <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary">
        sectores donde trabajamos en {info.nombre}
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        {info.sectores.map((s) => (
          <span class="inline-flex rounded-full border border-frame bg-surface px-4 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-text-secondary">
            {s}
          </span>
        ))}
      </div>
    </div>

    <div class="reveal-item mt-10">
      <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary">contexto local</p>
      <ul class="mt-4">
        {info.hitos.map((h) => (
          <li class="flex items-start gap-3 border-b border-frame/60 py-3 font-body text-sm font-light leading-relaxed text-text-secondary">
            <span class="shrink-0 text-accent" aria-hidden="true">→</span>
            {" "}
            {h}
          </li>
        ))}
      </ul>
      <p class="mt-6 font-mono text-[10px] uppercase tracking-wider text-text-tertiary">
        fuente: INE · Censo de Población y Vivienda 2024
      </p>
    </div>
  </div>
</section>
