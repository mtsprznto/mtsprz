---
/**
 * CotizarModal — captura en 2 pasos (email → código 6 dígitos) · v2 Technopunk Enterprise
 * Ventana de sistema reutilizando el chrome canónico (.webcore-window + .win-ctl):
 * title bar con dots + `cotizar --gratis`, body sunken, status bar con LED.
 * Lógica intacta: ids, /api/send-code, /api/verify-code, trackEvent, openCotizarModal.
 * a11y: aria-hidden se alterna al abrir/cerrar · Escape cierra · foco al email al abrir.
 */
import StatusLed from "./ui/StatusLed.astro";
---

<div id="cotizar-modal" class="fixed inset-0 z-[100] flex items-end justify-center opacity-0 pointer-events-none transition-opacity duration-300 sm:items-center" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Cotización">

  <!-- Backdrop -->
  <div id="cotizar-overlay" class="absolute inset-0 bg-bg/85 backdrop-blur-sm"></div>

  <!-- Panel · ventana de sistema (chrome canónico v2) -->
  <div class="webcore-window w-full sm:max-w-md">

    <header class="flex h-9 items-center gap-3 border-b border-frame bg-surface px-3">
      <span class="flex items-center gap-1.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
        <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
        <span class="h-2.5 w-2.5 rounded-full border border-frame"></span>
      </span>
      <span class="truncate font-mono text-[11px] font-medium uppercase tracking-wider text-text-secondary">cotizar --gratis</span>
      <button id="cotizar-close" type="button" class="win-ctl win-ctl--close ml-auto" aria-label="Cerrar">✕</button>
    </header>

    <div class="bg-surface-sunken px-6 py-7 sm:px-8 sm:py-8">

      <!-- STEP 1: Email -->
      <div id="cotizar-step-1">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">// paso 1 de 2</p>
        <h3 class="mt-3 font-heading text-2xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-3xl">
          Cotiza <span class="text-text-tertiary">gratis</span>
        </h3>
        <p class="mt-3 font-body text-sm leading-relaxed text-text-secondary">
          Déjanos tu correo y te enviamos un código para comenzar.
        </p>
        <div class="mt-6 flex flex-col gap-2.5">
          <input
            type="email"
            id="cotizar-email"
            placeholder="tu@correo.com"
            autocomplete="email"
            class="w-full rounded-[4px] border border-frame bg-surface px-3.5 py-2.5 font-body text-sm text-text-primary outline-none transition-colors placeholder:text-text-tertiary focus:border-accent"
          />
          <p id="cotizar-email-error" class="hidden font-mono text-xs text-danger"></p>
          <button
            id="cotizar-send-btn"
            type="button"
            class="group flex w-full items-center justify-center gap-2.5 rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover"
          >
            <span id="cotizar-send-text">Enviar código</span>
            <svg id="cotizar-send-spinner" class="hidden h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.3"/><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>

      <!-- STEP 2: Código -->
      <div id="cotizar-step-2" class="hidden">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">// paso 2 de 2</p>
        <h3 class="mt-3 font-heading text-2xl font-bold leading-[1.05] tracking-[-0.02em] text-text-primary sm:text-3xl">
          Código <span class="text-text-tertiary">de 6 dígitos</span>
        </h3>
        <p class="mt-3 font-body text-sm leading-relaxed text-text-secondary">
          Enviamos el código a <strong id="cotizar-email-display" class="font-medium text-text-primary"></strong>
        </p>
        <div class="mt-6 flex flex-col gap-2.5">
          <div class="flex justify-center gap-1.5 sm:gap-2">
            <input type="text" id="cotizar-code-0" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="one-time-code" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
            <input type="text" id="cotizar-code-1" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
            <input type="text" id="cotizar-code-2" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
            <span aria-hidden="true" class="flex items-center px-0.5 font-mono text-sm text-frame">·</span>
            <input type="text" id="cotizar-code-3" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
            <input type="text" id="cotizar-code-4" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
            <input type="text" id="cotizar-code-5" maxlength="1" inputmode="numeric" pattern="[0-9]" class="h-14 w-10 rounded-[4px] border border-frame bg-surface text-center font-heading text-xl font-bold text-text-primary outline-none transition-colors focus:border-accent sm:w-11" />
          </div>
          <p id="cotizar-code-error" class="hidden text-center font-mono text-xs text-danger"></p>
          <button
            id="cotizar-verify-btn"
            type="button"
            class="flex w-full items-center justify-center gap-2.5 rounded-[6px] bg-accent px-6 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-bg transition-colors hover:bg-accent-hover"
          >
            <span id="cotizar-verify-text">Verificar código</span>
            <svg id="cotizar-verify-spinner" class="hidden h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.3"/><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
          </button>
          <button
            id="cotizar-resend-btn"
            type="button"
            class="mt-1 self-center font-mono text-[11px] uppercase tracking-wider text-text-tertiary underline underline-offset-2 transition-colors hover:text-accent"
          >
            Reenviar código
          </button>
        </div>
      </div>

    </div>

    <footer class="flex h-8 items-center border-t border-frame bg-surface px-3">
      <StatusLed label="verificación en 2 pasos" />
    </footer>
  </div>
</div>

<script is:inline>
(function() {
  var $ = function(id) { return document.getElementById(id); };

  var modal = $('cotizar-modal');
  if (!modal) return;

  var overlay = $('cotizar-overlay');
  var close = $('cotizar-close');
  var step1 = $('cotizar-step-1');
  var step2 = $('cotizar-step-2');
  var emailInput = $('cotizar-email');
  var emailError = $('cotizar-email-error');
  var emailDisplay = $('cotizar-email-display');
  var sendBtn = $('cotizar-send-btn');
  var sendText = $('cotizar-send-text');
  var sendSpinner = $('cotizar-send-spinner');
  var verifyBtn = $('cotizar-verify-btn');
  var verifyText = $('cotizar-verify-text');
  var verifySpinner = $('cotizar-verify-spinner');
  var codeError = $('cotizar-code-error');
  var resendBtn = $('cotizar-resend-btn');
  var codeInputs = [
    $('cotizar-code-0'), $('cotizar-code-1'), $('cotizar-code-2'),
    $('cotizar-code-3'), $('cotizar-code-4'), $('cotizar-code-5'),
  ];

  var currentEmail = '';

  function openModal() {
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    step1.classList.remove('hidden');
    step2.classList.add('hidden');
    emailInput.value = '';
    emailError.classList.add('hidden');
    codeError.classList.add('hidden');
    codeInputs.forEach(function(inp) { if (inp) inp.value = ''; });
    setTimeout(function() { if (emailInput) emailInput.focus(); }, 200);
    if (window.trackEvent) window.trackEvent('cotizar_modal_open', { page: window.location.pathname });
  }

  function closeModal() {
    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function showError(el, msg) {
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  function setLoading(btn, spinner, text, loading) {
    if (!btn || !spinner || !text) return;
    if (loading) {
      btn.disabled = true;
      spinner.classList.remove('hidden');
      text.textContent = '...';
    } else {
      btn.disabled = false;
      spinner.classList.add('hidden');
      text.textContent = text.getAttribute('data-restore') || text.textContent;
    }
  }

  if (overlay) overlay.addEventListener('click', closeModal);
  if (close) close.addEventListener('click', closeModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('opacity-100')) closeModal();
  });

  if (emailInput) {
    emailInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && sendBtn) sendBtn.click();
    });
  }

  if (sendBtn) {
    sendBtn.addEventListener('click', async function() {
      if (!emailInput || !emailError || !sendText || !sendSpinner) return;
      var email = emailInput.value.trim().toLowerCase();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError(emailError, 'Ingresa un correo electrónico válido');
        return;
      }
      emailError.classList.add('hidden');

      sendText.setAttribute('data-restore', 'Enviar código');
      setLoading(sendBtn, sendSpinner, sendText, true);

      try {
        var res = await fetch('/api/send-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email }),
        });
        var data = await res.json();
        if (!res.ok) {
          showError(emailError, data.error || 'Error al enviar el código');
          setLoading(sendBtn, sendSpinner, sendText, false);
          return;
        }
        currentEmail = email;
        if (emailDisplay) emailDisplay.textContent = email;
        if (window.trackEvent) window.trackEvent('email_submitted', { email_domain: email.split('@')[1] || '' });
        step1.classList.add('hidden');
        step2.classList.remove('hidden');
        if (codeInputs[0]) codeInputs[0].focus();
      } catch(e) {
        showError(emailError, 'Error de conexión. Intenta de nuevo.');
      }
      setLoading(sendBtn, sendSpinner, sendText, false);
    });
  }

  if (codeInputs[0]) {
    codeInputs.forEach(function(inp, i) {
      if (!inp) return;
      inp.addEventListener('input', function() {
        if (this.value.length >= 1 && i < codeInputs.length - 1 && codeInputs[i + 1]) {
          codeInputs[i + 1].focus();
        }
        if (codeError) codeError.classList.add('hidden');
      });
      inp.addEventListener('keydown', function(e) {
        if (e.key === 'Backspace' && !this.value && i > 0 && codeInputs[i - 1]) {
          codeInputs[i - 1].focus();
        }
        if (e.key === 'Enter' && verifyBtn) {
          verifyBtn.click();
        }
      });
      inp.addEventListener('paste', function(e) {
        e.preventDefault();
        var paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
        for (var j = 0; j < paste.length; j++) {
          if (codeInputs[j]) codeInputs[j].value = paste[j];
        }
        var next = Math.min(paste.length, 5);
        if (codeInputs[next]) codeInputs[next].focus();
      });
    });
  }

  if (verifyBtn) {
    verifyBtn.addEventListener('click', async function() {
      if (!codeInputs || !codeError || !verifyText || !verifySpinner) return;
      var code = codeInputs.map(function(inp) { return inp ? inp.value : ''; }).join('');
      if (code.length !== 6) {
        showError(codeError, 'Ingresa el código completo de 6 dígitos');
        return;
      }

      verifyText.setAttribute('data-restore', 'Verificar código');
      setLoading(verifyBtn, verifySpinner, verifyText, true);

      try {
        var res = await fetch('/api/verify-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: currentEmail, code: code }),
        });
        var data = await res.json();
        if (!res.ok) {
          showError(codeError, data.error || 'Código incorrecto');
          setLoading(verifyBtn, verifySpinner, verifyText, false);
          if (window.trackEvent) window.trackEvent('verify_failure');
          return;
        }
        if (window.trackEvent) window.trackEvent('verify_success');
        window.location.href = '/cotizar';
      } catch(e) {
        showError(codeError, 'Error de conexión. Intenta de nuevo.');
      }
      setLoading(verifyBtn, verifySpinner, verifyText, false);
    });
  }

  if (resendBtn) {
    resendBtn.addEventListener('click', function() {
      if (!currentEmail) return;
      resendBtn.disabled = true;
      resendBtn.textContent = 'Enviando...';
      fetch('/api/send-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: currentEmail }),
      }).then(function() {
        resendBtn.textContent = '¡Reenviado!';
        if (window.trackEvent) window.trackEvent('email_resend');
        setTimeout(function() {
          resendBtn.disabled = false;
          resendBtn.textContent = 'Reenviar código';
        }, 3000);
      }).catch(function() {
        resendBtn.disabled = false;
        resendBtn.textContent = 'Reenviar código';
      });
    });
  }

  window.openCotizarModal = openModal;
  window.closeCotizarModal = closeModal;
})();
</script>
