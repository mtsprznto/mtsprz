---
/**
 * ServiceCard · v2 (DESIGN §6.4)
 * Contenedor tipo WebcoreWindow con DOS capas:
 *  - Ejecutiva (visible): titular de negocio + beneficio + tags + CTA.
 *  - Técnica (<details>): stack/capacidades. Métricas etiquetadas como objetivo
 *    (§9 honestidad): nunca se inventan cifras de resultados.
 *
 * El `accent` por categoría (§2.3) se usa SOLO de forma decorativa (punto, icono,
 * bullets) — nunca como color de texto pequeño (falla AA en #A855F7, §15).
 */
export interface Props {
  icon: string;
  title: string;
  description: string;
  tags: string[];
  number: number;
  accent: string;
  id?: string;
  /** Página de aterrizaje del servicio (enlaza el titular). Sin `href`, el titular no es enlace. */
  href?: string;
  /** Capacidades/stack honesto de la línea de servicio. */
  stack?: string[];
  /** Texto del CTA inferior (default: "Solicitar diagnóstico"). */
  ctaText?: string;
  /** Destino del CTA inferior (default: "/cotizar"). */
  ctaHref?: string;
}

const {
  icon,
  title,
  description,
  tags,
  number,
  accent,
  id,
  href,
  stack = [],
  ctaText = "Solicitar diagnóstico",
  ctaHref = "/cotizar",
} = Astro.props;

const icons: Record<string, string> = {
  Code: "M7.5 3.75L2.25 12l5.25 8.25m9-16.5L21.75 12l-5.25 8.25",
  Search: "M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z",
  Bot: "M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z",
  Palette:
    "M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072",
  TrendingUp:
    "M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941",
  BarChart3:
    "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z",
  Globe:
    "M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418",
};

const pathData = icons[icon] || icons.Code;
const num = String(number).padStart(2, "0");
const headline = href;
---

<article
  class="service-card webcore-window group flex h-full flex-col scroll-mt-28"
  data-service-card
  data-accent={accent}
  {id}
>
  <!-- Title bar · chrome de ventana -->
  <div class="flex h-9 items-center gap-2 border-b border-frame bg-surface px-3">
    <span
      class="h-2 w-2 shrink-0 rounded-full"
      style={`background:${accent};box-shadow:0 0 8px ${accent}88;`}
      aria-hidden="true"></span>
    <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-secondary"
      >svc — {num}</span>
    <span class="ml-auto truncate font-mono text-[11px] text-text-tertiary">
      {tags[0] ?? ""}
    </span>
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <!-- Icono -->
    <div
      class="mb-4 flex h-10 w-10 items-center justify-center rounded-[6px] border border-frame transition-colors duration-300 group-hover:border-accent"
      style={`color:${accent};`}
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d={pathData} /></svg>
    </div>

    <!-- Titular (capa ejecutiva) -->
    <h3
      class="font-heading text-lg font-bold leading-snug tracking-[-0.01em] text-text-primary"
    >
      {headline ? (
        <a href={headline} class="transition-colors duration-300 hover:text-accent">
          {title}
        </a>
      ) : (
        title
      )}
    </h3>

    <p class="mt-2 font-body text-sm font-light leading-relaxed text-text-secondary">
      {description}
    </p>

    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="rounded-[4px] border border-frame px-2 py-0.5 font-mono text-[10px] leading-none text-text-secondary">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <!-- Capa técnica (desplegable, sin JS) -->
    <details class="group/det mt-4 border-t border-frame pt-3">
      <summary
        class="cursor-pointer list-none font-mono text-[11px] uppercase tracking-[0.12em] text-text-secondary transition-colors hover:text-accent focus-visible:outline-none focus-visible:text-accent"
      >
        ▸ ficha técnica
      </summary>
      <div class="mt-3 space-y-3">
        {
          stack.length > 0 ? (
            <ul class="space-y-1.5">
              {stack.map((item) => (
                <li class="flex items-start gap-2 font-mono text-[11px] leading-relaxed text-text-secondary">
                  <span
                    class="mt-[4px] h-1 w-1 shrink-0 rounded-full"
                    style={`background:${accent};`}
                    aria-hidden="true"
                  />
                  {item}
                </li>
              ))}
            </ul>
          ) : (
            <p class="font-mono text-[11px] leading-relaxed text-text-secondary">
              Detalle técnico disponible bajo solicitud.
            </p>
          )
        }
        <p class="font-mono text-[10px] leading-relaxed text-text-tertiary">
          Las cifras de rendimiento se etiquetan por proyecto y se miden; no publicamos
          estimaciones inventadas.
        </p>
      </div>
    </details>

    <!-- CTA -->
    <div class="mt-auto pt-5">
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 font-mono text-[11px] font-bold uppercase tracking-[0.12em] text-text-primary transition-colors hover:text-accent focus-visible:outline-none focus-visible:text-accent"
      >
        <span>{ctaText}</span>
        <svg
          class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1"
          style={`color:${accent};`}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M5 12h14" /><path d="M12 5l7 7-7 7" /></svg>
      </a>
    </div>
  </div>
</article>
