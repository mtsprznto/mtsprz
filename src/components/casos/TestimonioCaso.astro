---
/**
 * TestimonioCaso · Testimonio de un caso o placeholder honesto (J1: no inventar).
 * Se usa en /casos/[slug]. Si caso.testimonio es null renderiza una
 * "pantalla apagada" de cine: el visual del caso, badge REC y estado RESERVADO.
 * Nunca una cita inventada. Coherente con TestimoniosReservados (butacas).
 */
import type { Caso } from "../../data/casos";
import { getCasoVisual } from "../../lib/caso-visuals";

export interface Props {
  caso: Caso;
}

const { caso } = Astro.props;
const visual = getCasoVisual(caso.slug);
---

<div class="reveal-group max-w-4xl">
  <p class="reveal-item font-body text-[10px] font-medium uppercase tracking-[0.25em] text-white/30">03 · Testimonio</p>

  {caso.testimonio ? (
    <figure class="reveal-item mt-10">
      <blockquote class="font-heading font-bold leading-[1.2] tracking-[-0.02em] text-white [font-size:clamp(1.5rem,4vw,2.5rem)]">
        "{caso.testimonio.cita}"
      </blockquote>
      <figcaption class="mt-6 flex flex-wrap items-center gap-3 border-t border-white/[0.08] pt-5">
        <span class="font-heading text-sm font-semibold text-white/85">{caso.testimonio.nombre}</span>
        <span class="h-1 w-1 rounded-full bg-white/20" aria-hidden="true" />
        <span class="font-body text-xs font-light text-white/40">{caso.testimonio.cargo}</span>
        <span class="ml-auto font-body text-[10px] uppercase tracking-[0.18em] text-emerald-300">{caso.testimonio.empresa}</span>
      </figcaption>
    </figure>
  ) : (
    <div class="reveal-item mt-10">
      <div class="relative aspect-[16/9] overflow-hidden">
        <div class="absolute inset-0" style="background: #010101;" />
        <div class="absolute inset-0" style={`background: ${visual.bg};`} />
        <div class="absolute inset-0" style={`background-image: ${visual.patternUrl}; background-size: 48px 48px;`} />
        <div class="absolute inset-0" style="background: radial-gradient(60% 45% at 50% 0%, rgba(255,255,255,0.06), transparent 70%);" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-black/40" />

        <div class="absolute inset-x-0 top-0 flex items-center justify-between px-5 py-4 md:px-8 md:py-5">
          <span class="inline-flex items-center gap-2 font-mono text-[10px] tracking-[0.2em] text-white/60">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
            </span>
            REC
          </span>
          <span class="font-mono text-[10px] tracking-[0.2em] text-white/40">{caso.industria}</span>
        </div>

        <div class="absolute inset-x-0 bottom-0 px-5 pb-5 md:px-8 md:pb-7">
          <p class="font-heading text-lg font-semibold tracking-[-0.01em] text-white/90 md:text-2xl">
            Grabación reservada
          </p>
          <p class="mt-1.5 max-w-md font-body text-xs font-light leading-[1.8] text-white/50 md:text-sm">
            No inventamos testimonios. Si tu historia entra al programa fundador, esta pantalla se enciende con tu voz y tus números.
          </p>
          <p class="mt-3 inline-flex items-center gap-2 font-body text-[10px] uppercase tracking-[0.18em] text-emerald-300">
            <span class="h-1 w-1 rounded-full bg-emerald-300" />
            RESERVADO
          </p>
        </div>
      </div>
    </div>
  )}
</div>
