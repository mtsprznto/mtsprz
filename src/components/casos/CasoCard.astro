---
/**
 * CasoCard · Fila del archivo de casos v2 (showcase de /casos).
 * Cada caso es una fila editorial full-width: visual real (screenshot, proof
 * of work) en marco v2 + ficha con índice mono, estado, industria, título,
 * métricas y CTA. Cero decoración manuscrita (lenguaje v1 retirado).
 * - Stretched link: toda la fila es clickeable (enlace absoluto).
 * - Filtrable por industria vía data-industria (script del page /casos).
 * - NO lleva reveal-item: el reveal lo hace GSAP (data-gsap-casos="row")
 *   con matchMedia; el observer de BaseLayout no debe tocarlo (doble
 *   animación). Sin GSAP / reduced-motion: fila visible por defecto.
 */
import { ArrowUpRight } from "@lucide/astro";
import type { Caso } from "../../data/casos";
import { getCasoVisual } from "../../lib/caso-visuals";

export interface Props {
  caso: Caso;
  index?: number;
}

const { caso, index = 0 } = Astro.props;

const visual = getCasoVisual(caso.slug);
const numero = String(index + 1).padStart(2, "0");
const isFundador = caso.tipo === "Cliente fundador";
const par = index % 2 === 0;
---

<article
  data-caso-card
  data-industria={caso.industria}
  data-gsap-casos="row"
  class="group relative w-full overflow-hidden border-b border-frame/60"
>
  <!-- Stretched link (toda la fila clickeable) -->
  <a
    href={`/casos/${caso.slug}`}
    aria-label={`Ver caso completo: ${caso.titulo}`}
    class="absolute inset-0 z-30"
  />

  <div class="relative mx-auto flex w-full max-w-[110rem] flex-col gap-10 px-6 py-14 sm:px-8 md:py-20 lg:grid lg:grid-cols-12 lg:items-center lg:gap-0 lg:px-12 lg:py-24 xl:px-16 2xl:px-24">
    <!-- Visual del caso · captura real del proyecto (proof of work) en marco v2 -->
    <!-- relative: ancla el índice/stamp al cajón del visual (no al article) -->
    <div class={`relative order-1 lg:row-start-1 ${par ? "lg:col-span-5 lg:col-start-1" : "lg:col-span-5 lg:col-start-8"}`}>
      <div class="relative aspect-[16/11] min-h-[220px] overflow-hidden rounded-[6px] border border-frame/60 bg-bg transition-colors duration-500 group-hover:border-frame-hover sm:min-h-[280px]">
        <!-- Sin transition-transform en CSS: GSAP conduce x/y/scale/yPercent
             (quickTo + parallax scrub). CSS transition + GSAP en la misma
             propiedad = motion mushy (cada tick re-arranca la transición). -->
        <div
          data-gsap-casos="media"
          class="absolute inset-0"
          style={`background: ${visual.bg};`}
        >
          <!-- Captura real (avif→webp→png, object-top como el portafolio).
               Decorativa: el stretched-link ya lleva aria-label. -->
          <picture class="absolute inset-0 block">
            <source srcset={visual.image.replace(/\.(png|jpg|jpeg)$/i, ".avif")} type="image/avif" />
            <source srcset={visual.image.replace(/\.(png|jpg|jpeg)$/i, ".webp")} type="image/webp" />
            <img
              src={visual.image}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover object-top"
            />
          </picture>
          <div class="absolute inset-0" style="background: radial-gradient(60% 45% at 50% 0%, rgba(255,255,255,0.05), transparent 70%);" />
        </div>
        <!-- Shine: acompaña al cursor (pointer fine + hover) -->
        <div
          data-gsap-casos="shine"
          class="pointer-events-none absolute inset-0 opacity-0"
          style="background: radial-gradient(220px 220px at 0 0, rgba(255,255,255,0.1), transparent 60%);"
        />
      </div>

      <!-- Índice editorial (se estampa al entrar; clearProps devuelve el transform) -->
      <span
        data-gsap-casos="sticker"
        aria-hidden="true"
        class={`pointer-events-none absolute z-20 select-none font-mono text-[3.5rem] font-bold leading-none text-text-tertiary/70 md:text-[5rem] ${par ? "-right-2 top-4 lg:-right-10 lg:top-6" : "-left-2 top-4 lg:-left-10 lg:top-6"}`}
      >
        {numero}
      </span>

      <!-- Sello de estado (se estampa al entrar / se re-estampa al agarrar) -->
      <span
        data-gsap-casos="stamp"
        aria-hidden="true"
        class={`pointer-events-none absolute bottom-4 z-20 select-none rounded-[4px] border px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] backdrop-blur-sm ${par ? "right-4" : "left-4"} ${isFundador ? "border-accent/60 bg-bg/70 text-accent" : "border-frame/80 bg-bg/70 text-text-secondary"}`}
      >
        {isFundador ? "Fundador −30%" : "Caso interno"}
      </span>
    </div>

    <!-- Ficha editorial -->
    <div class={`order-2 lg:row-start-1 ${par ? "lg:col-span-6 lg:col-start-7" : "lg:col-span-6 lg:col-start-1"}`}>
      <!-- Meta · índice + estado + industria -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[11px]">
        <span class="text-text-tertiary">[{numero}]</span>
        <span class={`inline-flex items-center gap-1.5 uppercase tracking-[0.12em] ${isFundador ? "text-accent" : "text-text-secondary"}`}>
          <span class={`h-1.5 w-1.5 rounded-full ${isFundador ? "led-pulse bg-accent" : "bg-text-tertiary"}`} aria-hidden="true" />
          {caso.tipo}
        </span>
        <span class="ml-auto hidden uppercase tracking-[0.12em] text-text-tertiary sm:block">{caso.industria}</span>
      </div>

      <h3 class="mt-4 font-heading text-2xl font-bold leading-[1.04] tracking-[-0.02em] text-text-primary transition-colors group-hover:text-accent md:text-3xl xl:text-4xl">
        {caso.titulo}
      </h3>
      <p class="mt-4 max-w-xl font-body text-sm font-light leading-[1.75] text-text-secondary md:text-base">
        {caso.resumen}
      </p>

      <!-- Métricas · sin cajas, separadas por línea editorial -->
      <div class="mt-8 grid max-w-xl grid-cols-3 divide-x divide-frame/60 border-t border-frame/60 pt-6">
        {caso.metricas.slice(0, 3).map((m, mi) => (
          <div class={`${mi === 0 ? "pl-0" : "pl-4"} pr-4`}>
            <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-text-tertiary">{m.label}</p>
            <p class="mt-1.5 font-heading text-sm font-semibold text-text-primary md:text-base">{m.valor}</p>
          </div>
        ))}
      </div>

      <span class="mt-8 inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-[0.14em] text-text-primary transition-colors group-hover:text-accent">
        [ Ver caso completo ]
        <ArrowUpRight class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
      </span>
    </div>
  </div>
</article>
