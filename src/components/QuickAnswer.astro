---
/**
 * QuickAnswer.astro · Bloque answer-first (GEO/AEO) · Ronda 3 · PRD G1.
 * Pregunta (h2) + respuesta directa 40–60 palabras + hechos con datos reales.
 * Sin JS · extractable ("chunkable") para motores generativos · WCAG AA.
 *
 * Usage: <QuickAnswer question="..." answer="..." facts={["...", "..."]} />
 *        <QuickAnswer ...>
 *          …CTA opcional (slot default, se renderiza al fondo del bloque)…
 *        </QuickAnswer>
 *
 * Regla RF-3: los hechos SOLO usan datos ya publicados/verificables del sitio.
 */
export interface Props {
  question: string;
  answer: string;
  facts?: string[];
  eyebrow?: string;
  /** color de acento del bloque (default: accent del design system) */
  accent?: string;
}

const {
  question,
  answer,
  facts = [],
  eyebrow = "respuesta directa",
  accent = "#00FF66",
} = Astro.props;
---

<!-- QuickAnswer · answer-first GEO (Ronda 3 · G1) -->
<section class="relative w-full border-t border-frame bg-bg" aria-label="Respuesta rápida">
  <div class="w-full px-4 py-16 sm:px-6 md:py-20 lg:px-8 xl:px-12">
    <div class="reveal-group mx-auto max-w-4xl">
      <p class="reveal-item font-mono text-xs uppercase tracking-[0.2em]" style={`color:${accent}`}>
        // {eyebrow}
      </p>
      <h2
        class="reveal-item mt-4 max-w-3xl font-heading text-2xl font-bold leading-[1.15] tracking-[-0.02em] text-text-primary sm:text-3xl md:text-4xl"
      >
        {question}
      </h2>
      <p
        class="reveal-item mt-5 max-w-3xl font-body text-base font-light leading-relaxed text-text-secondary md:text-lg"
      >
        {answer}
      </p>

      {facts.length > 0 && (
        <ul class="reveal-item mt-8 grid gap-x-10 gap-y-4 border-t border-frame/60 pt-6 sm:grid-cols-2">
          {facts.map((fact, i) => (
            <li class="flex items-baseline gap-3">
              <span
                class="shrink-0 font-mono text-[11px] leading-none text-text-tertiary"
                aria-hidden="true"
              >
                [{String(i + 1).padStart(2, "0")}]
              </span>
              <span class="font-body text-sm font-light leading-relaxed text-text-secondary">
                {fact}
              </span>
            </li>
          ))}
        </ul>
      )}

      <slot />
    </div>
  </div>
</section>
