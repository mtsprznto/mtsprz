RESEND_API_KEY=re_xxxxxxxxxxxx
# Remitente visible en emails de marketing (ej: "Mtsprz <hola@mtsprz.org>")
RESEND_FROM=mtsprz@mtsprz.org

# Link real de reseña Google del negocio (https://g.page/r/XXXX/review)
GOOGLE_REVIEW_URL=https://g.page/r/CTtH8EKjoy9cEBM/review

# Secret del cron de secuencias de email (Vercel: Settings → Cron Jobs)
CRON_SECRET=cambia-esto-openssl-rand-hex-32

# Neon PostgreSQL (crear en neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require

# Secreto para firmar tokens de verificación biométrica (generar con: openssl rand -hex 32)
BIOMETRIC_SECRET=cambia-esto-en-produccion

# WhatsApp WAHA (https://waha.devlike.pro)
# Local: docker compose up -d en scripts/waha (generar key: openssl rand -hex 24)
WAHA_URL=http://localhost:3000
WAHA_API_KEY=change-me-openssl-rand-hex-24
WAHA_SESSION=mtsprz
