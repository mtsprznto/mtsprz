# WAHA — WhatsApp HTTP API (local Docker Desktop)
# Docs: https://waha.devlike.pro/docs/overview/introduction/
# ===================================================
# Copiar como .env y editar valores:
#   cp .env.example .env
# En Windows:  copy .env.example .env

# === API key (CAMBIA ESTO) ===
# Obligatoria — header X-Api-Key en todas las llamadas.
# Generar:  openssl rand -hex 24
WAHA_API_KEY=change-me-openssl-rand-hex-24

# Puerto expuesto en localhost
WAHA_PORT=3000

# Engine: WEBJS (default, más features) | WPP | GOWS | NOWEB
WHATSAPP_DEFAULT_ENGINE=WEBJS

# Imagen: latest (Chromium) | chrome (soporta video) | noweb | gows | arm | noweb-arm
WAHA_IMAGE=devlikeapro/waha:latest

# Device name en WhatsApp → Linked Devices (solo QR scan)
WAHA_CLIENT_DEVICE_NAME=Mtsprz WAHA
WAHA_CLIENT_BROWSER_NAME=Chrome

# Logs
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info

# Zona horaria
TZ=America/Santiago
