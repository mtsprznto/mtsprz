{
  "name": "mtsprz",
  "private": true,
  "version": "1.0.0",
  "description": "Landing page profesional para Soluciones Digitales en la Región de Los Lagos, Chile",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-nft-symlink.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/clean-vercel.mjs",
    "build": "node scripts/generate-image-sitemap.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "sync": "astro sync",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed-templates.mjs",
    "test:emails": "node --env-file=.env scripts/test-emails.mjs",
    "test:emails:send": "node --env-file=.env scripts/test-emails.mjs --send"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/vercel": "^11.0.3",
    "@lucide/astro": "^1.25.0",
    "@neondatabase/serverless": "^1.1.0",
    "@rolldown/binding-linux-x64-gnu": "^1.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "resend": "^6.17.2",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^5.8.0"
  }
}
